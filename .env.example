# Base de datos (Supabase PostgreSQL)
DATABASE_URL=""

# Supabase Auth (mismo proyecto que DATABASE_URL — vincula auth.users con AppUser)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""  # admin key, server-only — para operaciones que bypasean RLS

# Supabase Storage (bucket "client-documents" para archivos subidos).
# Si SUPABASE_URL/SUPABASE_SECRET_KEY no están, lib/storage/client.ts cae a
# NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (el proyecto principal).
# Definir estas SOLO si el Storage vive en un proyecto Supabase distinto.
SUPABASE_URL=""          # opcional — fallback a NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SECRET_KEY=""   # opcional — fallback a SUPABASE_SERVICE_ROLE_KEY

# HubSpot OAuth
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3004/api/auth/callback"

# Google Workspace (Service Account + Domain-Wide Delegation).
# Usado para: sync de Google Meet/Calendar, lectura de Gemini Notes, y lectura
# de archivos de Drive (Docs/Slides/Sheets) cuando un CSE pega un link.
GOOGLE_SERVICE_ACCOUNT_KEY=""  # JSON completo de la service account (client_email + private_key)
GOOGLE_ADMIN_EMAIL=""          # super admin del dominio para impersonación DWD (Directory API)

# Anthropic (Claude API). UNA sola key por entorno: PRODUCCION usa la del .env del VPS y solo
# esa; cada PC usa una key DISTINTA, con nombre propio en la consola de Anthropic, para que el
# gasto se pueda atribuir por maquina y cotejar contra /integrations/gasto-ia. Hoy hay mas de
# una repartida en los tres .env (B-12, pendiente de Elias).
# [[Elias: nombre de la key de PRODUCCION en la consola de Anthropic: ______]]
ANTHROPIC_API_KEY=""

# App
APP_URL="http://localhost:3004"

# El "Data Lake" (un Supabase secundario con notas de HubSpot) se retiro el 2026-08-17:
# su contenido no era de Smarteam y entraba al prompt del handoff sin filtro de empresa.
# Las envs DATA_LAKE_* ya no las lee nadie; se pueden borrar del .env del servidor.

# Apify (scraping de inspiracion LinkedIn - modulo Contenido)
APIFY_TOKEN=""
# APIFY_LINKEDIN_POSTS_ACTOR="apimaestro~linkedin-profile-posts"
# CRON_ENABLED="1"  # solo PROD (docker-compose ya lo setea)

# Jobs OPT-IN del scheduler (lib/jobs/defs.ts). Sin estas dos en "1", CINCO jobs se apagan EN
# SILENCIO al reconstruir el VPS (B-11, 2026-09-04): cs-signals-daily, cs-partner-daily,
# cs-watchdog-daily y cs-watchdog-debounce (CS_WATCHDOG_ENABLED) y cobranza-quincenal
# (COBRANZA_CRON_ENABLED). En PROD van en "1", obligatorio. En una PC de dev quedan vacias A
# PROPOSITO: el vigilante tiene que correr en UNA sola instancia (lib/cs/watchdog.ts). Si faltan,
# el semaforo de Integraciones los muestra en gris («nunca corrio»): esa es la señal.
CS_WATCHDOG_ENABLED=""      # PROD: "1"
COBRANZA_CRON_ENABLED=""    # PROD: "1"
# Espejo de Odoo (odoo-espejo-daily, solo lectura): sin ODOO_PASSWORD ni se intenta — un intento
# en vano cuenta para el bloqueo por IP de Odoo. ODOO_SYNC_ENABLED="0" lo apaga sin sacar la clave.
ODOO_PASSWORD=""
# ODOO_SYNC_ENABLED="0"

# Guard anti-prod (scripts/lib/guard.ts): las escrituras por script/CLI contra Supabase
# exigen esta variable en "1" POR COMANDO. No la dejes fija en este archivo ni en .env:
# si queda FIJA en .env, el guard aborta todo script de escritura hasta que la saques (B-01).
# db push / migrate reset / migrate dev contra Supabase no se destraban con nada.
# ALLOW_PROD_WRITE="1"

# Pool de Postgres del runtime (lib/db/prisma.ts): default 10 en prod / 4 en dev.
# El pooler compartido da ~15 slots entre PROD + 2 PCs + scripts (RUNBOOK inv. #3).
# DB_POOL_MAX="4"

# Sentry (opcional; sin DSN queda inerte). El NEXT_PUBLIC_* se INLINEA en build.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Export PDF en dev Windows (lib/print/pdf-runner.ts): ruta a chrome.exe.
# PUPPETEER_EXECUTABLE_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Presupuesto diario de IA (lib/ai/presupuesto.ts). Se INSTALA APAGADO a proposito: no se puede
# fijar un tope sensato antes de saber cuanto es lo normal, y el medidor recien arranco el
# 2026-08-17. Sin PRESUPUESTO_IA_BLOQUEA="1" solo avisa por consola; la llamada sale igual.
# El presupuesto AUTOMATICO (lo que se dispara solo: watchdog, crons, post-proceso) es el
# estricto; el HUMANO es generoso porque cortar un handoff a la mitad es peor que el gasto.
# El gasto real se mira en /settings/gasto-ia.
# PRESUPUESTO_IA_AUTOMATICO_USD_DIA="15"
# PRESUPUESTO_IA_HUMANO_USD_DIA="60"
# PRESUPUESTO_IA_BLOQUEA="1"
