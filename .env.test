# .env.test — la base de TEST (integration de vitest). SIN SECRETOS: es el Postgres LOCAL
# embebido (npm run db:local), base nexus_test, auth trust en loopback. Se versiona a
# propósito para que `npm run test:int` funcione con cero setup tras `npm install` +
# `npm run db:local -- bootstrap`.
#
# ⚠ test/setup.integration.ts ABORTA si este DATABASE_URL apunta a un host de Supabase:
#   los tests truncan TODAS las tablas antes de cada caso.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nexus_test"
