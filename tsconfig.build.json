// Lo que chequea `next build` (next.config.ts › typescript.tsconfigPath): tsconfig.json SIN los tests.
// Next ya descarta sus errores (runTypeCheck ignora *.test.*, *.spec.*, __tests__ y __mocks__), así que
// chequearlos en el build solo costaba memoria. `npx tsc --noEmit` y el CI siguen chequeando TODO con
// tsconfig.json. El include es el mismo de tsconfig.json y lo vigila lib/db/tsconfig-del-build.test.ts.
// Ver RUNBOOK › Deploy.
{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-alt/types/**/*.ts",
    ".next-alt/dev/types/**/*.ts",
    ".next-plan/types/**/*.ts",
    ".next-plan/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__mocks__/**"
  ]
}
