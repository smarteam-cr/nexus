generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DocumentType {
  CALL_TRANSCRIPT
  BRIEF
  FREE_TEXT
  URL
  FILE
}

enum AgentStatus {
  ACTIVE
  DRAFT
}

enum AgentRunStatus {
  PENDING
  RUNNING
  DONE
  ERROR
  ARCHIVED
}

enum AgentOutputType {
  CARDS
  STREAM
  FLOWCHART
  CARDS_AND_FLOWCHARTS
  CARDS_AND_CHARTS
  AUDIT_REPORT
}

enum AgentScope {
  CLIENT
  GLOBAL
}

enum AgentType {
  SECTION // Agente de subetapa — genera cards/flowcharts para una sección
  CANVAS_PROJECT // Agente transversal — actualiza canvas de proyecto
  CANVAS_CLIENT // Agente transversal — actualiza canvas de empresa
  SESSION_PROCESSOR // Agente de procesamiento de sesión — lee Fireflies y genera cards
}

enum ProjectType {
  BASE_IMPLEMENTATION // Implementación base — activación de herramientas, superficial y general
  USE_CASE // Caso de uso — específico y profundo, resolución de un reto particular
}

// ⛔ RETIRADO el 2026-08-12 — PASO 1 DE 2. La app ya NO lee ni escribe este enum: el tipo de
// implementación es un TAG del catálogo (`implementacion` / `reimplementacion` en
// lib/tags/catalog.ts, grupo excluyente `tipo_implementacion`), igual que el resto de la
// clasificación. Se conserva —con las dos columnas y su dato— como red de seguridad hasta el
// DROP, que es un cambio aparte con el sistema nuevo ya probado en uso.
// ⚠ NO volver a usarlo: una guarda lo impide (lib/tags/catalog.test.ts, "la columna retirada
// no vuelve"). Dos respuestas a la misma pregunta es el estado del que esta tanda salió.
enum ImplementationType {
  IMPLEMENTATION // Nueva implementación — el cliente arranca con HubSpot por primera vez
  REIMPLEMENTATION // Re-implementación — ya usa HubSpot o viene de otro CRM
}

enum CardSource {
  AGENT // Generada íntegramente por el agente
  HUMAN // Creada manualmente por el consultor
  MODIFIED // Generada por el agente y luego editada por el consultor
}

enum CardType {
  TEXT // Card de texto (default)
  FLOWCHART // Diagrama de React Flow (nodos + edges guardados en diagramData)
  CHART // Gráfico de ECharts (configuración en chartConfig)
}

// ─── Block system (canvases no-default) ─────────────────────────────────────

enum BlockType {
  TEXT
  HEADING
  TABLE
  METRIC
  CALLOUT
  CARD
  FLOWCHART
  CHART
  IMAGE
}

enum BlockSource {
  AGENT
  HUMAN
  MODIFIED // generado por IA, editado por un humano (CSE)
}

enum BlockStatus {
  DRAFT
  CONFIRMED
}

// ─── Business Cases (Ventas) ─────────────────────────────────────────────────

enum BusinessCaseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BusinessCaseBlockType {
  HERO
  PAIN_POINTS
  BEFORE_AFTER
  SOLUTION
  ROI_METRICS
  TIMELINE
  INVESTMENT
  PARTNER
  CTA
}

enum BusinessCaseTranscriptSource {
  PASTED
  UPLOADED
}

// ─── Client (nueva entidad raíz) ──────────────────────────────────────────────

model Client {
  id                String     @id @default(cuid())
  name              String
  company           String?
  industry          String?
  notes             String?    @db.Text
  hubspotCompanyId  String?    @unique // La empresa en el HubSpot de Smarteam. Única desde R7b (2026-10-24): DECISIONS «Las llaves de la empresa»
  emailDomains      String[] // dominios de email para matching automático de sesiones (ej: "ice.go.cr")
  // Siglas con que el EQUIPO nombra a este cliente en los títulos de sus reuniones («CAV» por
  // Club de Amantes del Vino). Una reunión 100 % interna solo se puede atribuir por título, y el
  // match por palabras descarta las de menos de 4 letras: «[Sales & Service handoff] CAV» quedó
  // sin dueño y fuera del handoff de SHP (2026-09-15). Una sigla declarada acá cuenta como el
  // nombre entero. Las escribe una persona en la ficha; nada las deduce. Ver lib/sessions/match-por-titulo.ts.
  siglas            String[]   @default([])
  logoUrl           String? // URL pública del logo del cliente (bucket public-assets) — se muestra en kickoff/cronograma externos
  // Segundo archivo de logo, para las superficies de fondo OSCURO (el hero de TODOS los
  // documentos del motor de landing). Es la ALTERNATIVA del primario, no un asset suelto:
  // borrar `logoUrl` borra también este (un logo para fondo oscuro es tinta clara y sobre
  // el blanco del cronograma desaparecería). Sin él, el hero cae al filtro histórico
  // `brightness(0) invert(1)`, que pinta cualquier logo como silueta blanca.
  logoDarkUrl       String?
  // Tamaño del logo como PORCENTAJE del alto base de cada superficie (50-200, paso 5).
  // NULL = sin configurar, que NO es lo mismo que "alguien eligió 100": si mañana se
  // re-afina un alto base, los NULL siguen el default nuevo y los 100 explícitos no.
  // Porcentaje y no px porque las tres superficies tienen altos distintos y ya afinados
  // (30 sobre navy, 40 en el cronograma del cliente, 36 en el interno) — ver lib/ui/logo-scale.ts.
  logoScale         Int?
  // El dueño de la empresa en HubSpot (`hubspot_owner_id`) y su correo, copiados por la copia de negocios abiertos
  // (lib/ventas/sync-negocios-abiertos.ts, 2026-10-14). Es la mitad de «la cartera de un vendedor» (la otra mitad son
  // sus negocios abiertos). nullable: no toda empresa tiene dueño ni empresa de HubSpot.
  hubspotOwnerId    String?
  hubspotOwnerEmail String?
  // QUÉ ES esta empresa. Fuente ÚNICA de "¿cuenta como cliente de CS?" — una empresa es
  // UNA sola cosa, así que reemplaza al booleano `isProspect`. El filtro de los listados
  // NO se escribe a mano en cada query: sale de `lib/clients/kind.ts` (CS_CLIENT_WHERE).
  kind              ClientKind @default(CLIENTE)
  // DEPRECATED — eliminar después del 2026-09-30. Reemplazado por `kind` (2026-07-24):
  // `isProspect: true` ≡ `kind: PROSPECTO`. Ya NO se lee ni se escribe en ningún lado; la
  // columna sobrevive solo para poder auditar el backfill. Si al llegar la fecha `kind`
  // no dio problemas, se dropea.
  isProspect        Boolean    @default(false)
  // Mercado total direccionable de esta empresa, en USD — cuánto podría facturar Smarteam
  // si le vendiera todo lo que necesita. Desde el 2026-10-24 lo CALCULA Nexus (el TAM estimado v1,
  // lib/clients/tam-v1.ts) y una persona con `clientes.decidirDatos` lo puede corregir; `tamFuente`
  // dice cuál de los dos fue. Sumado sobre la cartera da el "potencial estimado". Nullable =
  // todavía no estimado, que NO es lo mismo que 0. Ver DECISIONS «Qué ES una empresa».
  tamUsd            Decimal?   @db.Decimal(12, 2)

  // ── Los datos de la empresa (R1, 2026-10-24) ─────────────────────────────────────────────────
  // Cada valor con su fuente y su fecha. El catálogo (tipo, opciones, quién manda, la propiedad de
  // HubSpot) es lib/clients/datos-de-la-empresa.ts; todo cambio pasa por
  // lib/clients/datos-de-la-empresa-server.ts, que deja su fila en `PropuestaDeDato`. La fuente es
  // una de: hubspot · investigacion · reunion · persona · nexus · preventa · test. nullable = sin dato.
  // Ver DECISIONS «Los datos de la empresa».
  tamFuente                 String?
  tamAt                     DateTime?
  // Cómo se calculó el TAM: la versión de la fórmula, lo que leyó y cada línea con su monto.
  tamCalculo                Json?
  industryFuente            String?
  industryAt                DateTime?
  empleados                 Int?
  empleadosFuente           String?
  empleadosAt               DateTime?
  facturacionAnualUsd       Decimal?  @db.Decimal(14, 2)
  facturacionAnualUsdFuente String?
  facturacionAnualUsdAt     DateTime?
  pais                      String?
  paisFuente                String?
  paisAt                    DateTime?
  sitioWeb                  String?
  sitioWebFuente            String?
  sitioWebAt                DateTime?
  // La industria con la lista de Smarteam («Industria (Smarteam)» en HubSpot, 17 opciones). Decide
  // la edición de la escala.
  industriaSmarteam         String?
  industriaSmarteamFuente   String?
  industriaSmarteamAt       DateTime?
  // La clave de la edición de la escala (`turismo`…); null = la escala general.
  edicionEscala             String?
  edicionEscalaFuente       String?
  edicionEscalaAt           DateTime?
  // estandar · corporativo · gobierno.
  segmento                  String?
  segmentoFuente            String?
  segmentoAt                DateTime?
  // independiente · casa_matriz · filial, y cuántas filiales tiene una casa matriz.
  estructura                String?
  estructuraFuente          String?
  estructuraAt              DateTime?
  filiales                  Int?
  filialesFuente            String?
  filialesAt                DateTime?
  // El perfil de negocio, con las palabras de la escala: a quién le vende (empresas · personas · ambos),
  // cómo cierra (con equipo · transaccional · mixta) y qué pasa después (única · recompra · continua).
  aQuienVende               String?
  aQuienVendeFuente         String?
  aQuienVendeAt             DateTime?
  perfilCierre              String?
  perfilCierreFuente        String?
  perfilCierreAt            DateTime?
  perfilDespues             String?
  perfilDespuesFuente       String?
  perfilDespuesAt           DateTime?
  // Rangos del catálogo (visitas al mes; contactos que aceptaron recibir comunicaciones).
  trafico                   String?
  traficoFuente             String?
  traficoAt                 DateTime?
  baseConsentimiento        String?
  baseConsentimientoFuente  String?
  baseConsentimientoAt      DateTime?
  // lista · casi_lista · todavia_no · sin_evaluar.
  calificaInsider           String?
  calificaInsiderFuente     String?
  calificaInsiderAt         DateTime?
  // Procedencia de fuente externa (regla Cobranza fuente + id_externo → upsert
  // idempotente: re-sincronizar NO duplica). null = creado por flujos previos.
  source                    String? // "manual" | "sheet" (futuro: "hubspot" | "odoo")
  sourceExternalId          String? // id estable en la fuente (columna id del sheet o slug del nombre)

  // hubspotServiceId de los proyectos BORRADOS a mano desde Nexus — el sync NO los vuelve
  // a crear (supresión durable: sobrevive al borrado del Project, que no puede llevar el
  // flag). Se limpia para "re-agregar a mano". Ver lib/hubspot/sync-projects.ts.
  ignoredHubspotServiceIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canvas           Json? // Client Canvas — DEPRECATED — su lugar lo tomó `ficha`. Ningún agente lo lee desde la Etapa 0 de la memoria (2026-10-09); queda la ruta /api/clients/[id]/canvas (GET y PUT, sin pantalla), que se retira antes del DROP. Eliminar después de 2026-12-31
  canvasConfidence Json? // { section: "confirmed" | "inferred" } per section
  // LA ficha del cliente (lib/clients/ficha.ts): una sola por empresa, la leen los agentes y al
  // confirmarla el CSE se escribe en la empresa de HubSpot (propiedades + nota). Reemplaza a
  // `canvas` y a las secciones stakeholders/retos/oportunidades del canvas client-info, que
  // estaban vacías en prod (0/188 al 2026-09-27). Nullable = todavía sin ficha.
  ficha            Json?

  hubspotAccount           HubspotAccount?
  audits                   Audit[]
  knowledge                Knowledge[]
  documents                ClientDocument[]
  stageNotes               StageNote[]
  agentRuns                AgentRun[]
  contextCards             ClientContextCard[]
  projects                 Project[]
  casosDeUso               CasoDeUso[] // el camino de crecimiento de la empresa (docs/smartloop-plan.md)
  versionesDeLaEscala      VersionDeLaEscala[] // la escala de la empresa en el tiempo (ficha B, 2026-10-17)
  canvasSuggestions        CanvasSuggestion[]
  actionItems              ActionItem[]
  pedidosFueraDeAlcance    PedidoFueraDeAlcance[]
  licencias                LicenciaCliente[]
  appUsers                 AppUser[] // F2: usuarios externos vinculados (kind=EXTERNAL)
  assignments              ClientAssignment[] // F2: overrides manuales CSE↔Cliente
  handoffs                 Handoff[] // entidad Handoff (1:N por cliente, ver model Handoff)
  businessCases            BusinessCase[] // Ventas: casos de negocio (1:N por cliente)
  csAlerts                 CsAlert[] // Éxito del cliente: alertas del watchdog
  csSignals                ClientCsSignals? // Éxito del cliente: snapshot de señales HubSpot
  partnerSnapshot          ClientPartnerSnapshot? // CS360: snapshot del objeto Partner Clients de HubSpot
  clasificacion            ClasificacionDeCuenta? // Éxito del cliente: relación, potencial y momento confirmados por la CSL
  correccionesDeSalud      CorreccionDeSalud[] // Éxito del cliente: el color corregido a mano y el «en espera del cliente»
  accountBrief             CsAccountBrief? // CS360: resumen ejecutivo citado (agente)
  cuentaFinanciera         CuentaFinanciera? // Cobranza: perfil de cobro 1:1 (ver sección Cobranza)
  ingresosVariables        IngresoVariable[]         @relation("IngresosVariablesDeCliente") // Finanzas: entradas fuera del ciclo
  comisionesPartner        ComisionPartner[]         @relation("ComisionesDePartner") // lo que Smarteam GANA de este aliado
  ventasGanadas            VentaGanada[]             @relation("VentasDelCliente") // los tratos ganados en HubSpot (el espejo de lo VENDIDO)
  negociosAbiertos         NegocioAbierto[]          @relation("NegociosDelCliente") // los tratos ABIERTOS en HubSpot (2026-10-14)
  siguientesPasos          SiguientePaso[]           @relation("SiguientesPasosDelCliente") // el siguiente paso de cada equipo (2026-10-15)
  contactosDeHubspot       ContactoDeHubspot[]       @relation("ContactosDeHubspot") // la copia de sus contactos de HubSpot (2026-10-16)
  ticketsDeHubspot         TicketDeHubspot[]         @relation("TicketsDeHubspot") // la copia de sus tickets de HubSpot (2026-10-16)
  comunicacionesDeHubspot  ComunicacionDeHubspot[]   @relation("ComunicacionesDeHubspot") // correos, notas y llamadas de HubSpot (2026-10-18)
  leadsDeHubspot           LeadDeHubspot[]           @relation("LeadsDeHubspot") // la copia de sus leads de HubSpot (B3 etapa 1, 2026-10-25)
  notasDeLaCuenta          NotaDeLaCuenta[]          @relation("NotasDeLaCuenta") // lo que pasó por WhatsApp, una llamada o un correo (2026-10-16)
  reglasComisionVendedor   ReglaComisionVendedor[]   @relation("ReglasDeComisionVendedor") // ⚠ SUPER_ADMIN-only
  importFilasAplicadas     ImportacionFila[] // Cobranza: trazabilidad del importador
  escalaComentarios        EscalaComentario[] // Escala: comentarios «no calza con este cliente» (SET NULL)
  exploracionesDeVenta     ExploracionDeVenta[] // Ventas: el lienzo de la exploración (una VIVA por empresa)
  preguntasDeTiempo        PreguntaDeTiempo[] // Tiempos: «¿cuánto te tomó?» de su trabajo (SET NULL)
  respuestasDeCuenta       RespuestaDeCuenta[] // Preguntas sobre la cuenta: lo que Customer Success sabe de ella (SET NULL)
  tareas                   Tarea[]                   @relation("TareasDelCliente") // Tareas internas: para quién (SET NULL)
  proyectosDeTareas        ProyectoDeTareas[]        @relation("ProyectosDeTareasDelCliente")
  vinculosDeTareas         TareaVinculo[]            @relation("VinculosDeTareasDelCliente")
  hechosDeReuniones        HechoDeReunion[]          @relation("HechosDelCliente") // memoria de la cuenta: los hechos de sus reuniones (CASCADE)
  hilosDeChat              HiloDeChat[]              @relation("HilosDeChatDeLaCuenta") // el chat de Nexus sobre la cuenta (2026-10-17, CASCADE)
  propuestasDeRentabilidad PropuestaDeRentabilidad[] @relation("PropuestasDeRentabilidad")
  // R7 (2026-10-24): las reuniones de las que es dueña (RESTRICT: no se borra una empresa con reuniones; el DELETE y la
  // fusión las sueltan o las mudan antes) y las que alguien le asignó a mano (SET NULL).
  reunionesResueltas       FirefliesSession[]        @relation("ReunionesResueltas")
  reunionesAsignadasAMano  FirefliesSession[]        @relation("ReunionesAsignadasAMano")
  propuestasDeReuniones    PropuestaDeEmpresa[]      @relation("PropuestasDeEmpresa") // T3: las reuniones que Nexus le propone (SET NULL)
  analisisDeVenta          AnalisisDeVenta[]         @relation("AnalisisDeVentaDeLaEmpresa") // S3: los análisis de sus reuniones de venta (CASCADE)
  propuestasDeDatos        PropuestaDeDato[]         @relation("PropuestasDeDatosDeLaEmpresa") // R1: propuestas e historia de sus datos (CASCADE)
  investigaciones          InvestigacionDeEmpresa[]  @relation("InvestigacionesDeLaEmpresa") // R5: lo que Nexus encontró en la web (CASCADE)
  documentosDeLaEmpresa    ProjectCanvas[]           @relation("DocumentosDeLaEmpresa") // R3: los documentos sin proyecto ni propuesta (CASCADE)
  personas                 PersonaDeLaEmpresa[]      @relation("PersonasDeLaEmpresa") // R6: una persona del cliente con su rol (CASCADE)
  perfil                   PerfilDeLaEmpresa?        @relation("PerfilDeLaEmpresa") // R13: el perfil de la empresa que usa Nexus (hoy Smarteam)
  clienteIdeal             IcpItem[]                 @relation("ClienteIdealDeLaEmpresa") // R13 (SET NULL)
  buyerPersonas            BuyerPersona[]            @relation("BuyerPersonasDeLaEmpresa") // R13 (SET NULL)
  intentosDelTest          IntentoDelTest[]          @relation("IntentosDelTestDeLaEmpresa") // Área O: los tests de su gente (SET NULL)

  @@unique([source, sourceExternalId]) // NULLs no colisionan en Postgres — los legacy conviven
}

/// Una propuesta de cambio a un dato de la empresa, y la historia de cada cambio (R1 y R9, 2026-10-24). La propone la
/// IA, una persona, HubSpot o la carga inicial; la decide quien tiene `clientes.decidirDatos`. Toda escritura de un dato
/// deja su fila acá (estado `aplicada` cuando no hubo nada que decidir). Catálogo: lib/clients/datos-de-la-empresa.ts.
/// SQL: scripts/sql/2026-10-25-datos-de-la-empresa.sql.
model PropuestaDeDato {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation("PropuestasDeDatosDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  /// La clave del dato en el catálogo (`empleados`, `tamUsd`…).
  campo         String
  /// El valor propuesto, con el tipo del catálogo (número, texto o una opción).
  valor         Json
  /// Lo que había cuando se decidió: con esto se vuelve atrás, y es lo único que guarda el valor viejo de HubSpot (R2).
  valorAnterior Json?
  /// Lo que quedó: igual a `valor` al usarla; lo que la persona escribió al editarla.
  valorDecidido Json?
  /// hubspot · investigacion · reunion · persona · nexus · preventa · test.
  fuente        String
  /// Quién la propuso, si fue una persona. nullable porque la IA, HubSpot y la carga no son personas.
  autorId       String?
  autor         TeamMember? @relation("PropuestasDeDatosDelAutor", fields: [autorId], references: [id], onDelete: SetNull)
  /// El porqué: la cita de la reunión o de la página, o lo que escribió la persona.
  cita          String?     @db.Text
  enlace        String?
  /// pendiente · usada · editada · descartada · aplicada · reemplazada.
  estado        String      @default("pendiente")
  /// nullable porque una pendiente todavía no la decidió nadie, y una `aplicada` por Nexus o HubSpot no tiene persona.
  decididaPorId String?
  decididaPor   TeamMember? @relation("DecisionesDeDatos", fields: [decididaPorId], references: [id], onDelete: SetNull)
  decididaAt    DateTime?
  createdAt     DateTime    @default(now())

  // ── Lo que se escribió en HubSpot por esta decisión (R2, 2026-10-25) ──
  // Lo escribe SOLO lib/clients/escritura-en-hubspot-server.ts; lo lee el script de vuelta
  // (scripts/hubspot-empresa-volver-atras.ts). nullable = no se escribió (la bandera apagada, o no le tocaba).
  /// La propiedad de la empresa de HubSpot que se escribió.
  hubspotPropiedad String?
  /// Lo que tenía esa propiedad en HubSpot justo antes ("" = vacía). Con esto se vuelve atrás.
  hubspotAnterior  String?
  hubspotEscritaAt DateTime?
  /// Por qué no se pudo escribir (el estado y el mensaje de HubSpot). null = se escribió o no se intentó.
  hubspotError     String?

  @@index([clientId, campo, estado])
  @@index([estado, createdAt])
  @@index([hubspotEscritaAt])
}

/// Lo que Nexus encontró de una empresa en la web, con su fecha y sus fuentes (R5, 2026-10-24). Es de la empresa, no de
/// la preventa: se rehace cuando vence (6 meses) o cuando alguien la actualiza. Lo que encuentra pasa por la regla de quién
/// manda (llena lo vacío de lo que manda HubSpot, propone lo demás). Agente: lib/clients/investigacion/. SQL:
/// 2026-10-25-datos-de-la-empresa.sql.
model InvestigacionDeEmpresa {
  id             String              @id @default(cuid())
  clientId       String
  client         Client              @relation("InvestigacionesDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  hechaAt        DateTime
  venceAt        DateTime
  /// actualizar (el botón de la ficha) · preventa (mudada desde una preventa) · carga.
  origen         String
  /// La preventa de la que se mudó. nullable porque las de la ficha no salen de una preventa.
  exploracionId  String?
  exploracion    ExploracionDeVenta? @relation("InvestigacionesDeLaPreventa", fields: [exploracionId], references: [id], onDelete: SetNull)
  /// La corrida del agente. nullable porque las mudadas no tienen corrida propia.
  agentRunId     String?
  agentRun       AgentRun?           @relation("InvestigacionesDeLaCorrida", fields: [agentRunId], references: [id], onDelete: SetNull)
  /// A qué se dedica, en dos o tres frases.
  resumen        String?             @db.Text
  /// Lo demás que encontró: sector, modelos, herramientas, hitos con su enlace, la industria y los datos con su cita.
  contenido      Json
  /// [{ url, titulo }]: cada enlace que salió en las búsquedas y se usó.
  fuentes        Json                @default("[]")
  /// [{ puesto, url, fecha? }]: los puestos que está buscando.
  contrataciones Json                @default("[]")
  /// { empleados?, rango?, cita, url }: el tamaño que encontró, con de dónde. null = no lo encontró.
  tamanoEstimado Json?
  createdAt      DateTime            @default(now())

  @@index([clientId, hechaAt])
}

// ─── SystemConfig (config GLOBAL de Nexus, singleton — no por usuario) ─────────
// Un solo row (id="system"; se upsert). Hoy guarda el logo de Smarteam
// configurable (se muestra en el chrome externo, con fallback a /logo-smarteam.png).
model SystemConfig {
  id              String   @id @default("system")
  smarteamLogoUrl String? // URL pública del logo de Smarteam (bucket public-assets)
  hubspotLogoUrl  String? // logo de HubSpot — brand-row de business cases + kickoffs
  insiderLogoUrl  String? // logo de Insider One — ídem
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Project ──────────────────────────────────────────────────────────────────

model Project {
  id                 String              @id @default(cuid())
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  status             String              @default("active") // active | paused | completed
  projectType        ProjectType         @default(USE_CASE) // Tipo de proyecto: implementación base o caso de uso
  implementationType ImplementationType? // ⛔ RETIRADA (2026-08-12) — vive en `tags`. Solo respaldo hasta el DROP; ver el enum.
  serviceType        String? // loop_marketing | loop_sales | loop_service | proyecto_temporal
  hubspotDealId      String? // ID del deal de HubSpot asociado a este proyecto
  hubspotServiceId   String?             @unique // ID del objeto Service en HubSpot (para sync)
  // ⛔ RETIRADAS (2026-08-18). Eran del subsistema de ETAPAS (Diagnóstico/Planificación/Adopción
  // × pasos), cuya ÚNICA pantalla escritora se borró. Nadie las escribe: el valor está congelado.
  // NO se dropean —un DROP es irreversible y no hace falta— pero NO SE LEEN: mostrarlas afirma una
