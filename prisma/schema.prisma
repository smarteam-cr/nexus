// ── Desarrollo (requerimiento técnico) ────────────────────────────────────────
// Estimación de esfuerzo del equipo técnico para un proyecto, tras leer el
// requerimiento del canvas Desarrollo. APPEND-ONLY: cada re-estimación es una FILA
// NUEVA (nunca un update) → queda el historial "estimamos 40h y terminó en 90h", que
// es lo que permite calibrar. La VIGENTE es la más reciente por createdAt.
//
// Vive en tabla propia y NO dentro de `CanvasBlock.data` a propósito: las horas tienen
// que ser CONSULTABLES (sumar el esfuerzo de un período, reportar por proyecto) y
// parsear Json de todas las filas para eso no escala. La sección `estimacion` del canvas
// la LEE por ctx — el dato no se duplica (ARCHITECTURE §2.1).
model DevEstimate {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hours          Int? // nullable porque se puede estimar SOLO por fecha
  estimatedDate  DateTime? // nullable porque se puede estimar SOLO por horas
  note           String?   @db.Text // por qué cambió respecto a la anterior
  // Quién estimó. Texto (no FK a TeamMember) para que el historial sobreviva a la baja
  // de una persona del equipo — el mismo criterio de `Particularidad.createdByEmail`.
  createdByEmail String
  createdAt      DateTime  @default(now())

  @@index([projectId, createdAt])
}

// D.3 panel — salud del proyecto para el panel de cartera. Es el OVERRIDE curado; la salud
// derivada (automática) se calcula al vuelo en lib/portfolio a partir de las señales de riesgo.
// PAUSADO espeja el caso Project.status="paused".
enum ProjectHealth {
  SALUDABLE
  EN_FRICCION
  EN_RIESGO
  PAUSADO
}

// ─── Ciclo de vida del proyecto (lib/lifecycle) ───────────────────────────────
// Fuente de verdad: Nexus. La etapa NO se materializa: se INFIERE al vuelo de los
// gates cumplidos (cascada en lib/lifecycle/stage-engine.ts) y el CSE puede pisarla
// con Project.lifecycleStageOverride. Slugs ESTABLES: son el internal value de la
// futura propiedad de HubSpot (sync bidireccional) — NO renombrar.
// Distinto de TimelineActivityType (tipos de actividad del Gantt) y de
// Project.currentStage (navegación del editor 1-3).
enum ProjectLifecycleStage {
  HAND_OFF // Ventas transfiere; sale cuando el kickoff se publica (kickoffPublishedAt)
  EXPLORACION // entender el negocio; sale con ENTENDIMIENTO_CERRADO
  DIAGNOSTICO // entregable de valor; sale con DIAGNOSTICO_COMPARTIDO
  PLANIFICACION // arquitectura + cronograma; sale con CRONOGRAMA_CONSENSUADO
  CONFIGURACION_TECNICA // construcción sobre HubSpot; sale con DEMO_APROBADA
  ADOPCION // directa o por pilotos (adoptionMode); sale con CLIENTE_OPERANDO
  VALIDACION_USO // sale con USO_VALIDADO (UUS >= umbral, o CSE)
  ENTREGA // cierre formal + handoff comercial; sale con ENTREGA_REALIZADA
  OPERACION_CONTINUA // ciclo corto (continuidad/soporte/bolsa de horas)
  FINALIZADO // cierre; isSuccessCase marca "Caso de éxito"
}

// Validaciones de SALIDA de cada etapa ("lo que mueve la tarjeta"). La salida de
// HAND_OFF no necesita gate: es Project.kickoffPublishedAt (señal dura existente).
enum ProjectStageGateKey {
  ENTENDIMIENTO_CERRADO // salida EXPLORACION (CSE marca; señal blanda: sesión + minuta REVIEWED)
  DIAGNOSTICO_COMPARTIDO // salida DIAGNOSTICO (CSE marca; señal: canvas "Diagnóstico" con bloques)
  CRONOGRAMA_CONSENSUADO // salida PLANIFICACION (v1: CSE marca cuando el cliente aprueba)
  DEMO_APROBADA // salida CONFIGURACION_TECNICA (CSE marca)
  CLIENTE_OPERANDO // salida ADOPCION (CSE marca; señales: sesiones adopción + hubspotAdoptionState)
  USO_VALIDADO // salida VALIDACION_USO (sistema: UUS >= umbral; o CSE)
  ENTREGA_REALIZADA // salida ENTREGA (CSE marca; note lleva la sugerencia para Ventas)
}

// Gate cumplido = EVENTO duro con fecha + quién + origen (tabla, no JSON: unicidad
// por proyecto+gate, queryable para backfill/motor batch, reversible por DELETE).
model ProjectStageGate {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gate      ProjectStageGateKey
  markedAt  DateTime            @default(now())
  markedBy  String? // email del CSE; null = sistema
  source    String              @default("cse") // "cse" | "system" | "backfill"
  note      String?             @db.Text // p.ej. sugerencia de cross-selling en ENTREGA_REALIZADA
  evidence  Json? // ⛔ RETIRADA (2026-09-04): nadie la LEE — el drill a la señal nunca se construyó. La siguen escribiendo lib/lifecycle/load.ts y scripts/backfill-lifecycle-stage.ts hasta el DROP. Guarda: lib/projects/etapa-retirada.test.ts

  @@unique([projectId, gate])
  @@index([projectId])
}

// ─── Handoff (entidad cliente-level) ──────────────────────────────────────────
// Un handoff nace cuando se gana un deal: lleva la info de ventas a CS y arranca el
// proyecto. 1:N bajo el Client (un cliente acumula varios en el tiempo), 1:1 con un
// Project y con el deal ancla. Su CONTENIDO vive en el canvas "Handoff" del Project
// (1:1) — no se duplica acá. El sync a HubSpot (crear el record "projects" + propiedad
// en la company) es aparte y eventual; lo gobierna hubspotSyncStatus.
model Handoff {
  id            String  @id @default(cuid())
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String  @unique // 1:1 con el Project (su contenido = canvas "Handoff" del project)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hubspotDealId String? @unique // deal ancla de HubSpot (1 handoff por deal)

  // Sync a HubSpot (eventual + reintentable; ver decisión #2 del plan)
  hubspotProjectId       String? // id del record "projects" creado en HubSpot (post-sync)
  hubspotSyncStatus      String  @default("pending") // pending | synced | failed
  hubspotSyncError       String? @db.Text
  // Owner de HubSpot a setear en el record "projects" SOLO cuando el sync lo CREA de
  // cero (handoff nacido del stepper de ventas). null = sin owner forzado (handoffs
  // viejos / generados in-project). Se aplica una sola vez, en CASO B del sync.
  hubspotOwnerIdOnCreate String?

  generatedByAgentRunId String? // trazabilidad de la corrida del agente de handoff

  // Exclusiones de contexto del CSE (texto libre, ej. "ignorá el proyecto DocuSign").
  // Se inyectan como reglas negativas duras en el prompt del agente de handoff.
  contextExclusions String? @db.Text

  // Engagements de HubSpot (por engagement id v1) EXCLUIDOS a mano de ESTE handoff — la
  // "X" de la columna HubSpot del Contexto. Por defecto todas las reuniones/notas de la
  // company alimentan (era completas, previas resumidas); acá se sacan las que el humano
  // marca como de otro proyecto. Por-proyecto (Handoff es 1:1 con Project).
  excludedEngagementIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ─── HandoffSource — fuente MANUAL del handoff (transcript/resumen pegado a mano) ──
// Para reuniones que NO entraron por el sync de Google Workspace (ej. un Zoom ajeno):
// ventas pega el transcript/resumen y el agente de handoff lo usa como UNA fuente más,
// ETIQUETADA como manual (distinta de las sesiones verificadas del sync). Keyed por
// projectId (el handoff es 1:1 con el project; persiste aunque el Handoff aún no exista
// o se recree → reproducible/auditable). El analyze la re-lee en CADA corrida, así una
// regeneración la vuelve a incluir. La leen el handoff y el mapeo de procesos del cliente;
// NO se muestra en el tab Documentos. ⚠ Por eso las notas del CRONOGRAMA no viven acá: van en
// `TimelineSource` (ningún lector de ésta filtra por tipo).
model HandoffSource {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String? // etiqueta opcional para identificarla
  content        String    @db.Text // el texto pegado (transcript/resumen)
  kind           String    @default("manual") // futuro-proof: otros tipos de fuente manual
  createdByEmail String? // quién la pegó (del guard de sesión)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // soft-delete (auditable; el read filtra deletedAt:null)

  @@index([projectId, createdAt])
}

// ─── TimelineSource — nota MANUAL del cronograma (2026-09-23) ──────────────────
// El «Contexto del cronograma»: lo que el CSE pega a mano para que el agente arme fases y
// tareas (una decisión que no quedó en ninguna reunión, un cambio de prioridades, etc.).
// Hermana de HandoffSource pero en tabla PROPIA: aquélla la leen el handoff, el mapeo de
// procesos de todo el cliente y el gate de material del handoff, sin filtrar por tipo.
// Keyed por projectId y no por el cronograma: sobrevive a borrarlo y regenerarlo.
// La leen SOLO los agentes del cronograma (detalle, «Pedir cambio con IA» y avance), vía
// lib/contexto/cargar.ts. RLS encendida en su SQL (2026-09-23-contexto-cronograma.sql).
model TimelineSource {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String?
  content        String    @db.Text
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([projectId, createdAt])
}

// Notas que el CSE pega en el «Contexto» de un DOCUMENTO (diagnóstico hoy; planificación e
// implementación después): una por pieza del registro (`pieza` = slug: "diagnosis"…). Tabla genérica
// a propósito — el cronograma tiene la suya (TimelineSource) por historia, y sumar una tabla por
// documento sería repetir el SQL, el RLS y las rutas cada vez. La lee SOLO el runner de su pieza.
// RLS encendida en su SQL (2026-09-28-contexto-diagnostico.sql).
model NotaDeContexto {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pieza          String
  title          String?
  content        String    @db.Text
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([projectId, pieza, createdAt])
}

// ─── ProjectTimeline + TimelinePhase ──────────────────────────────────────────
// Cronograma estructurado del proyecto (Fase 2 del módulo externo).
//
// Lo propone el agente "Handoff Sales→CS" a partir de las transcripciones de
// ventas (donde típicamente se acuerda la secuencia: "kick-off + arquitectura
// + 6 sesiones de set up + 6 de onboarding, 10 semanas total"). El CSE lo
// edita libremente. Las fases tienen duración en SEMANAS, sin fechas concretas
// — el `anchorStartDate` (opcional) es el ancla; las fechas reales del landing
// se calculan en runtime como `anchorStartDate + sum(durationWeeks_anteriores) * 7 días`.
//
// Patrón de re-ejecución: el agente solo crea el cronograma si NO existe. Si
// ya hay uno, la nueva propuesta queda en AgentRun.output (trazabilidad) pero
// no se aplica — para regenerar, el CSE borra explícitamente y vuelve a correr.

model ProjectTimeline {
  id                           String    @id @default(cuid())
  projectId                    String    @unique
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  anchorStartDate              DateTime? // null hasta que el CSE la fije; cuando exista, define la conversión semanas → fechas
  // Tanda K — cierre FIJADO A MANO por el CSE, mismo criterio que el arranque: null = usar el
  // proyectado (projectedEnd, derivado de anchor+fases). Con valor, GANA sobre el derivado — y
  // si el derivado se recalcula distinto (nueva propuesta, edición de duración), la UI pregunta
  // en vez de pisarlo en silencio (ver lib/timeline/weeks.ts: displayedEnd/closeDateDiverges).
  closeDateOverride            DateTime?
  // LÍMITES ACORDADOS CON EL CLIENTE (2026-10-02, lib/timeline/limites.ts). Distintos del cierre
  // fijado a mano: ese dice qué fecha se MUESTRA; estos dicen hasta dónde PUEDE llegar el plan. Los
  // escribe una persona (Ventas; si no, el CSL o el CSE), nunca la IA: la IA los propone en
  // `limitesPropuestos`. Moverlos pide motivo y con quién se acordó (queda en TimelineChange).
  fechaLimite                  DateTime? // el día en que todo tiene que estar listo para el cliente
  duracionVendidaSemanas       Int? // las semanas que se vendieron, SIN contar la Semana 0
  // Quién confirmó cada límite: { fechaLimite?: {por, rol, en, fuente}, duracionVendida?: {...} }.
  limitesConfirmacion          Json?
  // Lo que propuso la IA del handoff y nadie confirmó todavía, con la frase de donde lo sacó:
  // { runId, en, fechaLimite?: {valor, cita, citaVerificada}, duracionVendida?: {...}, noCabe? }.
  limitesPropuestos            Json?
  lastEditedByHuman            DateTime? // se actualiza en cada PUT que toca fases (no en el create del agente)
  // D.3 staging — el cliente ve SOLO este SNAPSHOT (shape client-safe de readClientTimeline)
  // congelado al "Subir". La vista externa NUNCA lee en vivo: si está publicado y el snapshot
  // es null (timeline pre-D.3), readPublishedClientTimeline hace un backfill perezoso (congela
  // el vivo actual una vez); si no hay timeline, devuelve vacío (fail-closed).
  publishedSnapshot            Json?
  generatedByAgentRunId        String? // de qué AgentRun salió la propuesta inicial (trazabilidad)
  generatedByAgentRun          AgentRun? @relation(fields: [generatedByAgentRunId], references: [id], onDelete: SetNull)
  // D.1 — cronograma detallado:
  detailConfirmedAt            DateTime? // gate de la vista cliente: las tareas solo cruzan al kickoff externo si != null
  detailGeneratedByAgentRunId  String? // de qué AgentRun salió el detalle (tareas/tipos) — trazabilidad
  detailGeneratedByAgentRun    AgentRun? @relation("TimelineDetailGenerator", fields: [detailGeneratedByAgentRunId], references: [id], onDelete: SetNull)
  // Re-generación en proyectos en curso: cuando el agente re-deriva un cronograma y YA existe uno,
  // la propuesta NO se aplica (protege ediciones/progreso) — se guarda acá, reconciliada al shape del
  // PUT (fases con id existente cuando matchean, SIN `tasks` para preservar el detalle), y el canvas
  // la muestra como vista previa aplicable. null = sin propuesta pendiente. Se limpia al aplicar/descartar.
  pendingProposal              Json?
  pendingProposalRunId         String? // AgentRun del que salió la propuesta pendiente (trazabilidad)
  // D.2 — BORRADOR DE AVANCE (hermano de pendingProposal; NO se mezcla). El agente de
  // avance detecta qué fases/tareas están hechas y dónde cae el "hoy", y lo guarda acá
  // SIN tocar status (eso lo confirma el CSE). Shape: { currentPhaseId, asOfSessionId,
  // reasoning, phases:[{id,done}], tasks:[{id,done}] }. Se reemplaza en cada corrida;
  // se limpia al aplicar (timeline/progress/apply) o descartar (DELETE timeline/progress).
  pendingProgress              Json?
  pendingProgressRunId         String? // AgentRun del que salió el borrador de avance (trazabilidad)
  // Particularidades — BORRADOR (hermano de pendingProgress, NO se mezcla). El agente de avance
  // propone desviaciones curadas (atraso/solicitud/compromiso) del transcript; el CSE acepta ítem
  // por ítem en el banner y recién ahí se crean las filas Particularidad. Se limpia al aplicar
  // (timeline/particularidades/apply) o descartar. Shape: { reasoning, items:[{kind,party,title,detail,weeksImpact}] }.
  pendingParticularidades      Json?
  pendingParticularidadesRunId String? // AgentRun del que salió el borrador de particularidades
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  phases           TimelinePhase[]
  changes          TimelineChange[] // #4 — historial de ediciones (razón + snapshot) para D.3
  baselines        TimelineBaseline[] // D.3 — baselines "vendidos" congelados al publicar (versionados)
  particularidades Particularidad[] // desviaciones curadas (atribución cliente/Smarteam), cara al cliente

  @@index([projectId])
}

model TimelinePhase {
  id                   String                @id @default(cuid())
  timelineId           String
  timeline             ProjectTimeline       @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  name                 String // "Kick-off", "Arquitectura", etc.
  order                Int // 0-indexed, posición en la secuencia
  durationWeeks        Int                   @default(1) // 1+
  // Inicio EXPLÍCITO (offset 0-based desde anchorStartDate). null = contigua tras la fase anterior
  // (comportamiento por defecto). Habilita fases EN PARALELO (dos con el mismo inicio se solapan):
  // típico, una integración/desarrollo que corre en paralelo a la implementación del hub.
  startWeek            Int?
  sessionCount         Int? // opcional — algunas fases no son por sesiones
  notes                String?               @db.Text // texto libre opcional (contexto editable)
  activityType         TimelineActivityType? // D.1: tipo de actividad (nullable — fases pre-D.1 quedan sin tipo, render neutro)
  source               TimelinePhaseSource   @default(AGENT)
  // El agente del handoff marca true cuando ESTIMÓ la fase/duración sin dato real en ventas
  // (badge "estimada" + banner). Se limpia cuando el CSE edita la fase (PUT). Interno — NO cruza al cliente.
  needsValidation      Boolean               @default(false)
  // D.2 — avance a nivel fase (reusa el enum de tarea). DONE = fase completada;
  // IN_PROGRESS = la fase en curso (el "hoy"); PENDING = por delante. Lo escribe SOLO
  // el CSE (mismo invariante que TimelineTask.status); el agente lo PROPONE en pendingProgress.
  status               TimelineTaskStatus    @default(PENDING)
  // Procedencia del ESTADO actual (ortogonal a `source`, que describe el CONTENIDO): HUMAN = lo
  // resolvió el CSE a mano; AI_CONFIRMED = el detector de avance lo detectó y el CSE lo confirmó en
  // el banner. Hace explícito el invariante que antes era implícito ("status != PENDING ⟹ humano").
  statusSource         TimelineStatusSource  @default(HUMAN)
  statusChangedByEmail String?
  statusChangedAt      DateTime?
  // D.3 fundación — fechas REALES de ejecución, MONÓTONAS (no se auto-borran):
  // actualStart la 1ra vez que va a IN_PROGRESS/DONE; actualEnd al DONE. Volver a
  // PENDING/IN_PROGRESS NO las borra — el status manda para "¿hecho hoy?", las fechas son histórico.
  actualStart          DateTime?
  actualEnd            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  tasks            TimelineTask[]
  particularidades Particularidad[] // desviaciones ancladas a esta fase (opcional; SetNull al borrar la fase)
  casosDeUso       CasoDeUso[] // ficha E — en un servicio recurrente, el caso de uso que es esta fase

  @@index([timelineId, order])
}

// D.1 — tarea de una fase del cronograma. weekIndex es RELATIVO a la fase
// (0-indexed, rango [0, durationWeeks)); en UI se muestra 1-based.
// El estado vive separado del contenido a propósito: D.2 podrá regenerar
// contenido preservando estados humanos por id. Invariante D.1: el agente
// solo crea PENDING → todo status != PENDING es humano por definición. `statusSource`
// hace ese invariante EXPLÍCITO y auditable por-tarea (ver TimelinePhase.statusSource).
model TimelineTask {
  id                   String               @id @default(cuid())
  phaseId              String
  phase                TimelinePhase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title                String
  weekIndex            Int // 0-indexed, relativo a la fase
  order                Int                  @default(0) // orden dentro de la semana
  status               TimelineTaskStatus   @default(PENDING)
  // Procedencia del ESTADO (ver TimelinePhase.statusSource): HUMAN = check manual del CSE;
  // AI_CONFIRMED = avance detectado por IA y confirmado por el CSE en el banner.
  statusSource         TimelineStatusSource @default(HUMAN)
  statusChangedByEmail String?
  statusChangedAt      DateTime?
  // #4 — override manual de fechas por tarea. INTENCIÓN: cuando estén seteadas deben
  // ganar sobre la fecha DERIVADA de la semana (anchor + offset de fase + weekIndex) y
  // cruzar al cronograma compartible como fecha efectiva. Se editan con datepicker en el
  // drawer (chip "manual"). ESTADO: se PERSISTEN, pero el consumo en el render (Gantt
  // interno + vista externa) está PENDIENTE — hoy ningún render prefiere el override sobre
  // la fecha derivada. null = derivar (default).
  startDateOverride    DateTime?
  dueDateOverride      DateTime?
  // D.3 fundación — fechas REALES de ejecución (ver TimelinePhase).
  actualStart          DateTime?
  actualEnd            DateTime?
  notes                String?              @db.Text
  needsValidation      Boolean              @default(false) // tarea típica inventada por el agente con handoff flaco — el Gantt la grita; NUNCA cruza al cliente
  // B — dueño de la tarea en el plan de alineación compartido. CLIENTE entrega/hace;
  // SMARTEAM configura; AMBOS trabajo conjunto. Nullable = sin asignar (data pre-B).
  // Cruza al cronograma compartible del cliente (gated por "Subir"); el Kickoff embebido NO lo muestra.
  party                TaskParty?
  // ¿la tarea es una SESIÓN (reunión con el cliente) o una TASK (acción/entregable)?
  // Nullable = sin tipar (efectivo = TASK). Cruza al cronograma compartible SOLO si es SESSION.
  // Mapeo a futuro (NO se sincroniza hoy): SESSION → HubSpot Meeting (0-47); TASK → HubSpot Task (0-27).
  type                 TimelineTaskType?
  source               TimelinePhaseSource  @default(AGENT) // reuso consciente del enum (mismo ciclo AGENT→MODIFIED/HUMAN); renombrarlo = recrear tipo en PG por cero ganancia
  // ── Tarea nacida de un COMPROMISO detectado en sesión ──────────────────────────
  // Fecha que se ACORDÓ en la sesión. Es dato CRUDO, no un segundo criterio de atraso: el
  // vencimiento lo sigue calculando el predicado único (weekIndex + anchor → isOverdueByDate).
  // Sirve para el texto ("se comprometió para el 2 de junio") y para proponer las semanas cuando
  // vence. Distinta de dueDateOverride, que es un override MANUAL del CSE.
  committedDueDate     DateTime?
  // Huella del hecho que la originó (misma que Particularidad.dedupeKey). Es lo que evita que el
  // agente re-cree la misma tarea en cada corrida — corre por sesión, 26 veces en un proyecto real.
  originFingerprint    String?
  preguntasDeTiempo    PreguntaDeTiempo[] // Tiempos: «¿cuánto te tomó?» al marcarla hecha (SET NULL)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([phaseId, weekIndex, order])
  @@index([originFingerprint]) // NO único a propósito, igual que Particularidad.dedupeKey
}

enum TimelinePhaseSource {
  AGENT // generada por la IA, sin tocar humano
  MODIFIED // generada por IA, editada por humano (al pasar por PUT con id existente)
  HUMAN // creada desde cero por humano (PUT con phase sin id)
}

// Procedencia del ESTADO (status) de una fase/tarea — distinto de `source` (procedencia del
// CONTENIDO). El detector de avance NUNCA escribe status directo: todo estado terminal nace de
// una acción humana, sea directa (HUMAN) o confirmando una detección de IA en el banner (AI_CONFIRMED).
enum TimelineStatusSource {
  HUMAN // el CSE resolvió el estado a mano (check/desmarcado directo)
  AI_CONFIRMED // el avance lo detectó la IA y el CSE lo confirmó (botón "Aplicar avance")
}

// B — dueño de una tarea del cronograma, desde la óptica del plan compartido con el cliente.
enum TaskParty {
  CLIENTE // lo entrega o hace el cliente (insumos: documentación, bases, listados, accesos)
  SMARTEAM // configuración técnica en HubSpot (pipeline, propiedades, automatizaciones, integraciones)
  AMBOS // trabajo conjunto (sesiones, talleres, validaciones, onboarding, seguimiento)
  DEV // #7 — desarrollo/integración (equipo técnico). Tareas de la fase "Desarrollo / Integración".
}

// Tipo de tarea del cronograma. Mapea a futuro (sin sync hoy):
// SESSION → HubSpot Meeting (objeto 0-47); TASK → HubSpot Task (objeto 0-27, hs_task_type=TODO).
enum TimelineTaskType {
  SESSION // reunión / sesión de trabajo con el cliente (kickoff, revisión, demo, capacitación)
  TASK // acción / entregable / configuración (no es una reunión)
}

// PARTICULARIDAD — desviación CURADA del cronograma, con atribución (¿quién la causó?).
// El propósito: exponerle al cliente POR QUÉ y QUIÉN movió el cronograma, sin mostrarle el log
// de auditoría crudo (TimelineChange, cuyos `reason` son autogenerados = ruido de máquina).
// Scoped al timeline (mismo cascade/lifecycle que TimelineChange/TimelineBaseline). El CSE la
// crea a mano o acepta una propuesta del agente; solo cruza al cliente si visibleExternal=true.
model Particularidad {
  id               String               @id @default(cuid())
  timelineId       String
  timeline         ProjectTimeline      @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  phaseId          String? // ancla opcional a una fase; SetNull para no perder la particularidad al borrar la fase
  phase            TimelinePhase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  kind             ParticularidadKind
  party            TaskParty // reusa el enum de tarea (CLIENTE/SMARTEAM/AMBOS/DEV) — misma atribución/chips
  title            String // corto, en lenguaje cliente
  detail           String?              @db.Text
  sourceQuote      String?              @db.Text // cita interna que respalda el hecho ([fecha] «fragmento»); NUNCA cruza al cliente
  weeksImpact      Int? // semanas de corrimiento que causó; null si no movió fechas
  visibleExternal  Boolean              @default(false) // gate por-registro; se respeta en el chokepoint (como SUSPENDED)
  source           ParticularidadSource @default(HUMAN)
  needsValidation  Boolean              @default(false) // true mientras es propuesta del agente sin confirmar
  createdByEmail   String? // quién la creó/confirmó (del guard)
  occurredAt       DateTime             @default(now()) // cuándo ocurrió la desviación (editable; default = ahora)
  // IDENTIDAD DEL HECHO (espeja CsAlert). El agente re-deriva las particularidades desde los MISMOS
  // transcripts en cada corrida, con redacción apenas distinta; sin identidad, aceptar dos borradores
  // creaba dos filas del mismo hecho y el corrimiento se contaba dos veces (Wherex: 13 semanas
  // mostradas, 8 reales). `dedupeKey` = timelineId:kind:huella — la huella la emite el agente y la
  // reusa entre corridas. Index NO único A PROPÓSITO: una fila que el CSE borró puede volver a nacer.
  dedupeKey        String? // null = creada a mano por el CSE (sin identidad de agente)
  occurrences      Int                  @default(1) // veces que el agente re-detectó el MISMO hecho
  lastDetectedAt   DateTime             @default(now())
  // ── CONVERSIÓN EN TRABAJO ──────────────────────────────────────────────────────
  // Una particularidad es HISTORIA (qué pasó y cuánto movió el plan). Cuando el hecho detectado es
  // en realidad trabajo que alguien debe —un compromiso, un insumo del cliente— el CSE lo convierte
  // en TAREA: ahí tiene dueño, fecha, vence y el cliente lo ve. La fila NO se borra al convertir
  // (así "deshacer" es borrar la tarea y nulear esto; borrarla la recrearía sin dedupeKey y el
  // agente la re-propondría). El link vive acá y no en la tarea porque quien lo lee en cada render
  // es la lista de particularidades, para decidir en qué grupo cae cada fila.
  convertedTaskId  String? // null = nadie está persiguiendo este hecho
  convertedAt      DateTime?
  convertedByEmail String?
  // ── ¿SIGUE VIGENTE? ────────────────────────────────────────────────────────────
  // ⛔ CERRADA no significa «no ocurrió»: las semanas que costó SIGUEN contando, porque el
  // calendario ya se movió y cerrar no lo devuelve. Lo que se apaga es la ACCIÓN (dejar de
  // perseguir el compromiso, dejar de pedir las semanas), no el registro. Confundir las dos
  // cosas haría que una publicación al cliente diga que el plan se movió menos de lo que se
  // movió — el Gantt corrido y la frase debajo contándose distinto.
  // NOT NULL con default a propósito: nullable dejaría el 100% del corpus en NULL el día del
  // deploy, y `estado = 'ABIERTA'` no matchea NULL en SQL. Ver el .sql para el detalle.
  estado           ParticularidadEstado @default(ABIERTA)
  resueltaEn       DateTime?
  resueltaPor      String? // email del guard
  resueltaNota     String? // por qué; sin esto, «cerrada» no se distingue de «alguien limpió»
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([timelineId, occurredAt])
  @@index([timelineId, visibleExternal])
  @@index([dedupeKey])
}

// Tipo de particularidad de cara al cliente:
enum ParticularidadKind {
  ATRASO // algo se atrasó (weeksImpact OBLIGATORIO en creación/edición nueva; una party responsable)
  SOLICITUD // @deprecated — insumo del cliente = tarea party=CLIENTE, no particularidad. Ya no se propone/crea; se conserva por filas legacy (fallback de render). Ver docs/DECISIONS.md (eje DESTINO).
  COMPROMISO // un acuerdo/hito comprometido en una sesión que fija/mueve una fecha del plan
  AVISO // nota libre del CSE al cliente que NO mueve fechas (ej. "pausamos la próxima semana"). SOLO humana: el agente nunca la emite, y weeksImpact va null (no suma al corrimiento ni a la atribución).
}

// ¿La desviación sigue vigente? ⚠ Solo DOS valores, y es deliberado: «descartar» ya existe y
// borra la fila (es una propuesta que no era cierta), así que un tercer estado para eso sería
// dos formas de decir lo mismo. Y un `VISTA` como el de las alertas de cobranza inventaría un
// paso de workflow que nadie pidió.
enum ParticularidadEstado {
  ABIERTA // el hecho sigue vigente y hay algo que atender
  CERRADA // se resolvió. Sus semanas SIGUEN contando: cerrar no devuelve calendario
}

// Procedencia de la particularidad (distinto de `party`, que es la ATRIBUCIÓN de la causa).
enum ParticularidadSource {
  AGENT // propuesta por el agente de avance y confirmada por el CSE
  HUMAN // creada a mano por el CSE
}

// #4 — historial de cambios del cronograma. Cada edición lleva una razón OBLIGATORIA
// y guarda un snapshot del estado resultante (no es un log efímero) para que D.3 pueda
// comparar el cronograma "vendido" (primer snapshot) contra el "real" (último) y
// explicar los desvíos con su motivo.
model TimelineChange {
  id             String             @id @default(cuid())
  timelineId     String
  timeline       ProjectTimeline    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  reason         String             @db.Text // obligatoria — el "por qué" del cambio
  kind           TimelineChangeKind @default(MANUAL)
  instruction    String?            @db.Text // si kind=AI_ASSIST, la instrucción dada al asistente
  changedByEmail String? // quién hizo el cambio (del guard de sesión)
  snapshot       Json // estado resultante: { anchorStartDate, phases:[{...,tasks:[...]}] }
  createdAt      DateTime           @default(now())

  @@index([timelineId, createdAt])
}

enum TimelineChangeKind {
  MANUAL // edición manual del CSE ("Guardar cronograma")
  AI_ASSIST // aplicada desde una propuesta del asistente de IA
  PROGRESS // D.3 — confirmación de avance (D.2): registra qué se marcó y quién (delta compacto, sin snapshot completo)
  REANCHOR // ciclo de vida — re-anclaje automático al Kick Off real (reason lleva el before; reversible en el Gantt)
}

// D.3 fundación — BASELINE "vendido" congelado al PUBLICAR el cronograma al cliente.
// Snapshot prístino e independiente de si el CSE editó a mano: es la promesa contra la
// que D.3 (después) compara lo ejecutado. Versionado: cada publish con estructura distinta
// crea una versión nueva (isActive=true) y desactiva la anterior — se conservan todas.
// El snapshot incluye fechas planeadas por ítem + needsValidation + source para que las
// alarmas distingan "te desviaste de algo firme" de "de un relleno del agente".
model TimelineBaseline {
  id               String          @id @default(cuid())
  timelineId       String
  timeline         ProjectTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  version          Int // 1, 2, 3… (max+1 por timeline)
  isActive         Boolean         @default(true) // la última publicada; D.3 compara contra esta
  anchorStartDate  DateTime? // ancla al momento de congelar
  snapshot         Json // estructura frozen: fases+tareas con planned dates, needsValidation, source
  firmness         Json // resumen de firmeza: { taskCount, needsValidationCount, firmPct, label, ... }
  publishedByEmail String? // quién publicó (del guard)
  capturedAt       DateTime        @default(now())

  @@index([timelineId, isActive])
  @@index([timelineId, version])
}

// D.1 — los 5 tipos de actividad de una implementación (orden de negocio fijo).
// Mapean a colores/leyenda en el Gantt interno; el cliente no los ve.
enum TimelineActivityType {
  EXPLORACION
  PLANIFICACION
  CONFIGURACION
  ADOPCION
  SEGUIMIENTO
}

enum TimelineTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SUSPENDED // E — tarea aparcada/descartada: resuelta (no pendiente ni vencida), no se ejecutó
}

// ─── ProjectExternalAccess ────────────────────────────────────────────────────
// Mecanismo de acceso del cliente externo al landing de SU proyecto.
// Combinación token (URL) + contraseña hasheada (form). Necesita ambos.
// 1:1 con Project. El CSE genera/regenera/revoca desde el panel del proyecto.
// La contraseña se devuelve EN PLANO una sola vez al generarla; después solo
// queda el hash (bcrypt 12 rounds). Si se pierde, hay que regenerar.
// Project.shareToken quedó RETIRADA (2026-09-04): la vista pública sin contraseña nunca existió.

model ProjectExternalAccess {
  id             String      @id @default(cuid())
  projectId      String      @unique
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessToken    String      @unique // 64 chars hex (crypto.randomBytes(32))
  passwordHash   String // bcrypt(12 rounds) — lo usa verify-access
  accessPassword String? // texto plano (visible para el CSE en el panel; igual se entrega al cliente en claro). Null en accesos viejos pre-migración.
  enabledAt      DateTime    @default(now())
  revokedAt      DateTime? // si != null → acceso bloqueado
  lastUsedAt     DateTime? // se actualiza en cada verify OK
  createdById    String? // FK a TeamMember que generó el acceso (auditoría)
  createdBy      TeamMember? @relation("ExternalAccessCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([accessToken])
  @@index([projectId])
}

// Canvas dentro de un proyecto (default = "Canvas de servicio", custom = secciones libres)
model ProjectCanvas {
  id             String        @id @default(cuid())
  // Dueño flexible: el canvas cuelga de un Project (kickoff/diagnóstico/…) O de un
  // BusinessCase (Ventas). Exactamente uno seteado (validado en código).
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessCaseId String?
  businessCase   BusinessCase? @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  // R3 (2026-10-25) — un documento de la EMPRESA, sin proyecto ni propuesta (un diagnóstico para un prospecto, el
  // documento de resultados de la preventa). nullable porque SOLO se llena en esos documentos: el dueño de los demás
  // sale de su proyecto o su propuesta (lib/clients/documentos-de-la-empresa.ts › empresaDelDocumento). La base impide
  // las dos cosas a la vez (CHECK ProjectCanvas_un_solo_dueno) y hay un único parcial (clientId, slug) como el de
  // (projectId, slug). SQL: 2026-10-25-empresa-parte-2.sql.
  clientId       String?
  client         Client?       @relation("DocumentosDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  // NOMBRE VISIBLE. Editable sin consecuencias: ningún lookup del código lo usa
  // como identidad (esa es `slug`). Para los canvases de BusinessCase, `name` es la
  // VERSIÓN ("Plantilla", "Propuesta 1"), no la pieza.
  name           String
  // IDENTIDAD de la pieza (lib/pieces/registry.ts): inglés, estable, NUNCA cambia.
  // Es lo que resuelve agente, renderer, permiso, vista externa y contexto. Antes
  // ese papel lo hacía `name`, repetido en 8+ lugares, y por eso renombrar una
  // pieza rompía ruteo/permisos/vista a la vez y dejaba canvases huérfanos.
  // nullable: los canvases custom del CSE no son una pieza registrada.
  slug           String?
  isDefault      Boolean       @default(false)
  order          Int           @default(0) // orden de aparición en el dropdown de canvases
  // Versionado (business case): cada "Generar" crea un canvas nuevo; isActive marca
  // el vivo/editable. En proyectos queda version=1/isActive=true (sin uso).
  // OJO: `isActive` es del BUSINESS CASE. Para "el CSE apagó esta pieza del proyecto"
  // es `disabledAt` — son dos cosas distintas y confundirlas rompe el versionado del BC.
  version        Int           @default(1)
  isActive       Boolean       @default(true)

  // PIEZA APAGADA por decisión del CSE (scope project). Ausente = activa. Fecha y no
  // booleano porque interesa CUÁNDO, que es parte del historial del proyecto. Apagar
  // NUNCA borra contenido: el interruptor vive en la misma fila que el contenido
  // justamente para que no exista un camino donde apagar toque secciones o bloques.
  // El filtro por estas columnas va SOLO en consultas de LISTADO — nunca en las de
  // EXISTENCIA (`canvasOf`), porque los find-or-create crearían un canvas duplicado.
  disabledAt     DateTime?
  disabledBy     String? // correo, no FK: el rastro sobrevive a que la persona salga del equipo
  disabledReason String?
  sections       Json      @default("[]") // Array de { key, label, brief?, previousBrief? } — brief = guía del agente por sección (BC), acá y no en columna para sobrevivir db push entre las 2 PCs (ver lib/business-cases/section-briefs.ts)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // D.3 staging — el cliente ve el SNAPSHOT publicado; el contenido vivo es borrador hasta "Subir".
  // publishedSnapshot = foto client-safe al subir; contentUpdatedAt se toca al editar/confirmar bloques
  // (dispara "cambios sin subir" si contentUpdatedAt > publishedSnapshotAt).
  publishedSnapshot   Json?
  publishedSnapshotAt DateTime?
  contentUpdatedAt    DateTime?

  // 2026-10-02 — El ESTADO del documento (hoy solo el diagnóstico, lib/canvas/estado-del-documento.ts):
  // null = borrador · "presentado" · "aprobado" (por el cliente, con evidencia). `versionDocumento` es
  // la vN que se está trabajando o presentando: regenerar después de presentar abre la siguiente.
  // SQL: scripts/sql/2026-10-02-estado-del-documento.sql (⛔ nunca `db push`).
  estadoDocumento  String?
  versionDocumento Int     @default(1)

  cards          ClientContextCard[]
  canvasSections CanvasSection[]
  versiones      VersionDeDocumento[]
  hitos          HitoDeDocumento[]
  // OJO — en la base hay además un índice ÚNICO PARCIAL que Prisma no sabe declarar:
  //   ProjectCanvas_projectId_slug_key ON ("projectId", slug)
  //   WHERE "projectId" IS NOT NULL AND slug IS NOT NULL
  // (scripts/sql/2026-07-24-projectcanvas-slug.sql). Es lo que impide dos canvases de
  // la misma pieza en un proyecto sin bloquear los canvases custom (slug null) ni los
  // del Business Case (projectId null). No aparece acá: si alguien lee solo el schema
  // va a creer que ProjectCanvas no tiene unique, que es justo la conclusión peligrosa.
  // R3 (2026-10-25) suma el mismo para los documentos de la empresa: ProjectCanvas_clientId_slug_key ON
  // ("clientId", slug) WHERE "clientId" IS NOT NULL AND slug IS NOT NULL (scripts/sql/2026-10-25-empresa-parte-2.sql).

  @@index([projectId])
  @@index([businessCaseId])
  @@index([clientId])
}

// Sección de un canvas no-default (entidad de primer nivel)
model CanvasSection {
  id                      String        @id @default(cuid())
  canvasId                String
  canvas                  ProjectCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  key                     String
  label                   String
  titleOverride           String? // Título de cara al cliente editado por el CSE (landing Kickoff). null = título por defecto de la plantilla (SECTION_META).
  eyebrowOverride         String? // Eyebrow (título pequeño) editado por el CSE. null = eyebrow por defecto de la plantilla.
  // NOTA: la "guía del agente" por sección (business case) NO vive acá. Se guarda en
  // ProjectCanvas.sections (Json) para sobrevivir db push entre las 2 PCs que comparten
  // la DB de prod. Ver lib/business-cases/section-briefs.ts.
  // Deshacer de 1 nivel (persistido): valor inmediatamente anterior de title/eyebrow. null = nada que deshacer.
  previousTitleOverride   String?
  previousEyebrowOverride String?
  order                   Int           @default(0)
  layout                  Json? // RGL layout: [{ i: blockId, x, y, w, h }]
  createdAt               DateTime      @default(now())

  blocks CanvasBlock[]

  @@unique([canvasId, key])
  @@index([canvasId])
}

// Bloque de contenido dentro de una sección (text, heading, table, metric, callout, etc.)
// La FOTO de un documento antes de que algo lo reescriba (lib/canvas/versiones.ts, 2026-09-28).
// Regenerar un documento con IA pisaba sus bloques sin dejar rastro: el diagnóstico viejo perdía su
// Escala —el punto de partida que lee la Entrega— sin forma de volver. Cada foto guarda TODAS las
// secciones con sus bloques tal como estaban, para consultarla, traer una sección al documento
// actual o restaurarla entera. RLS encendida en su SQL (2026-09-28-versiones-de-documento.sql).
model VersionDeDocumento {
  id        String            @id @default(cuid())
  canvasId  String
  canvas    ProjectCanvas     @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  pieza     String? // slug de la pieza (null en canvases custom)
  /// Por qué se tomó: «Antes de regenerar», «Antes de restaurar», «Respaldo inicial».
  origen    String
  creadaPor String? // correo; null = la tomó el sistema (una corrida en segundo plano)
  /// Huella del contenido: dos fotos iguales seguidas no se guardan dos veces.
  huella    String
  /// [{ key, label, order, titleOverride, eyebrowOverride, blocks: [{ blockType, content, data, … }] }]
  secciones Json
  createdAt DateTime          @default(now())
  /// 2026-10-02 — Lo que se le PRESENTÓ o APROBÓ el cliente: no se borra con el tope de 30 ni se salta
  /// por ser igual a la anterior (es la evidencia de qué vio y qué aprobó).
  protegida Boolean           @default(false)
  hitos     HitoDeDocumento[]

  @@index([canvasId, createdAt])
}

/// Un HITO del estado de un documento (2026-10-02): se presentó, lo aprobó el cliente, se reabrió.
/// Solo se inserta: es el historial de qué versión vio el cliente y quién la aprobó, con qué evidencia.
model HitoDeDocumento {
  id       String              @id @default(cuid())
  canvasId String
  canvas   ProjectCanvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  /// La vN del documento a la que se refiere.
  version  Int
  /// presentado · aprobado · reabierto
  tipo     String
  porEmail String?
  /// La foto protegida de lo que se presentó o aprobó.
  fotoId   String?
  foto     VersionDeDocumento? @relation(fields: [fotoId], references: [id], onDelete: SetNull)

  /// Aprobación: quién del cliente, cuándo, y la evidencia (el correo pegado y/o un documento).
  aprobadoPorNombre    String?
  aprobadoPorEmail     String?
  aprobadoEl           DateTime?
  evidencia            String?   @db.Text
  evidenciaDocumentoId String?
  /// La nota que quedó en la empresa en HubSpot (o el error, si no se pudo escribir).
  hubspotNotaId        String?
  hubspotError         String?
  /// Reabrir: por qué.
  motivo               String?

  createdAt DateTime @default(now())

  @@index([canvasId, createdAt])
}

model CanvasBlock {
  id              String        @id @default(cuid())
  sectionId       String
  section         CanvasSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  blockType       BlockType     @default(TEXT)
  content         String?       @db.Text
  data            Json?
  // Deshacer de 1 nivel (persistido): contenido/data inmediatamente anterior. null = nada que deshacer.
  previousContent String?       @db.Text
  previousData    Json?
  order           Int           @default(0)
  colSpan         Int           @default(4) // 1-4 columns width
  colStart        Int? // 1-4 column start position (null = auto)
  rowSpan         Int           @default(4) // height in grid rows
  source          BlockSource   @default(AGENT)
  status          BlockStatus   @default(DRAFT)
  agentRunId      String?
  agentRun        AgentRun?     @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([sectionId])
  @@index([agentRunId])
}

// Notas/contenido guardadas por etapa y paso dentro del workspace de un cliente
// DEPRECATED — 0 filas; ningún agente la lee desde la Etapa 0 de la memoria (2026-10-09). Todavía la lee
// lib/clients/last-interaction.ts (stageNote.groupBy, la última interacción): sacar ese lector antes del DROP.
// Eliminar después de 2026-12-31
model StageNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Int // 1 = Diagnóstico | 2 = MVP | 3 = Adopción
  step      Int // número de paso dentro de la etapa (1-indexed)
  content   String   @default("") @db.Text

  updatedAt DateTime @updatedAt

  @@unique([clientId, stage, step])
}

// Documentos adjuntos al workspace de un cliente (transcripciones, briefs, URLs, etc.)
model ClientDocument {
  id        String       @id @default(cuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Int? // null = global (tab Documentos), 1 o 2 o 3 = etapa específica
  step      Int? // paso específico (opcional)
  title     String
  type      DocumentType
  content   String?      @db.Text // para FREE_TEXT / CALL_TRANSCRIPT pegado / texto extraído de FILE
  url       String? // para URL, Fireflies links, o Supabase Storage URL
  fileName  String? // nombre original del archivo (para FILE)
  fileSize  Int? // tamaño en bytes (para FILE)
  mimeType  String? // tipo MIME (para FILE)

  // Cuestionario previo (2026-09-25): el cliente adjunta un documento a UNA pestaña y dice qué es.
  // `descripcion` viaja con el texto al contexto de los agentes: sin ella, el agente lee un PDF
  // sin saber si es el organigrama o una cotización vieja.
  descripcion           String?              @db.Text
  /// Desde qué «Contexto adicional» se subió (2026-10-07): `preventa` · `propuesta` · `handoff` ·
  /// `cronograma` · la pieza de un documento (`diagnosis`…) · `exploracion`. null = subido en
  /// Documentos. Con origen, el texto ya entra por esa pieza: el contexto general de los agentes no lo
  /// vuelve a leer (lib/documents/origen-del-adjunto.ts). SQL: 2026-10-07-exploracion-del-proyecto.sql.
  origen                String?
  cuestionarioPestanaId String?
  cuestionarioPestana   CuestionarioPestana? @relation(fields: [cuestionarioPestanaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cards de contexto del cliente (sección editable sobre la relación comercial, dolor, etc.)
// Desde la Etapa 0 de la memoria (2026-10-09) salió del mensaje del handoff y de todo agente no encadenado; los
// agentes encadenados por paso (`associatedStep`) TODAVÍA leen las del paso anterior y las HUMAN del cliente
// (app/api/clients/[id]/analyze/route.ts). La usan además pantallas legacy (deuda #24)
model ClientContextCard {
  id         String     @id @default(cuid())
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // null = card manual/legacy; set = generada por un AgentRun específico
  agentRunId String?
  agentRun   AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  title      String
  content    String     @default("") @db.Text
  order      Int        @default(0)
  source     CardSource @default(HUMAN)
  cardType   CardType   @default(TEXT)

  // Canvas integration
  canvasId      String? // null = canvas default del proyecto
  canvas        ProjectCanvas? @relation(fields: [canvasId], references: [id], onDelete: SetNull)
  canvasSection String? // Sección del canvas donde vive (null = no está en canvas)
  canvasOrder   Int? // Orden dentro de la sección del canvas (para drag & drop)
  canvasStatus  String         @default("confirmed") // "draft" = auto-poblado por agente, pendiente de revisión; "confirmed" = aceptado por CSE

  // Card hierarchy (para clones al enviar al canvas)
  parentCardId String?
  parentCard   ClientContextCard?  @relation("CardClones", fields: [parentCardId], references: [id], onDelete: SetNull)
  clones       ClientContextCard[] @relation("CardClones")

  // Datos estructurados por tipo
  diagramData Json? // Para FLOWCHART: { nodes: [...], edges: [...] }
  chartConfig Json? // Para CHART: configuración de ECharts

  // Vista del cliente
  publishedToClient Boolean @default(false) // Si true, visible en la vista externa del cliente
  publishedContent  String? @db.Text // Versión alternativa del contenido para el cliente (lenguaje suavizado)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cards de un mismo run no pueden tener el mismo título
  @@unique([agentRunId, title])
  @@index([clientId, agentRunId])
  @@index([agentRunId])
  @@index([canvasId])
  @@index([canvasSection])
  @@index([parentCardId])
}

// ─── HubspotAccount (ahora hijo de Client) ───────────────────────────────────

model HubspotAccount {
  id               String    @id @default(cuid())
  isSystem         Boolean   @default(false) // true = cuenta del sistema (Smarteam), false = cuenta de cliente
  clientId         String?   @unique // nullable en transición — se hará NOT NULL en Fase 5
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hubspotPortalId  String    @unique
  hubName          String?
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  portalSnapshot   Json?
  portalSnapshotAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relaciones legacy (se eliminan en Fase 5 una vez migrada toda la data)
  audits    Audit[]
  knowledge Knowledge[]
}

// ─── Knowledge ────────────────────────────────────────────────────────────────

model Knowledge {
  id        String         @id @default(cuid())
  accountId String
  account   HubspotAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId  String? // se poblará en migración de datos (Fase 5)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  content   String         @db.Text
  category  String         @default("general")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model Audit {
  id        String          @id @default(cuid())
  accountId String? // nullable en transición (Fase 3 lo migra a clientId)
  account   HubspotAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId  String? // nuevo FK a Client (se poblará en Fase 3)
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  data      Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Los modelos `Implementation`, `Message` y `ExecutionLog` vivían acá: eran el chat viejo
// "HubSpot AI Implementer". Se retiraron el 2026-08-17 (Tanda T) junto con sus endpoints, que
// escribían en el portal de HubSpot con solo estar logueado. Las tablas se droppean por SQL
// DESPUÉS del deploy — ver scripts/sql/2026-08-17-retirar-chat-viejo.sql.

// ─── Agent ────────────────────────────────────────────────────────────────────

model Agent {
  id                     String          @id @default(cuid())
  name                   String
  description            String?
  systemPrompt           String          @db.Text
  additionalInstructions String?         @db.Text
  status                 AgentStatus     @default(DRAFT)
  // Etapas asociadas: [] = aplica a todas, [1] = solo Etapa 1, [1,2] = ambas
  associatedStages       Int[]
  associatedStep         Int?
  sectionLabel           String? // Bloque visual dentro de la subetapa (ej. "Contexto del cliente")
  outputType             AgentOutputType @default(CARDS)
  scope                  AgentScope      @default(CLIENT)
  agentType              AgentType       @default(SECTION)
  defaultCanvasSection   String? // Sección del canvas de proyecto sugerida al enviar cards (ej. "procesos")
  // Agrupación por propósito (reemplaza stages/steps para la UI)
  agentGroup             String? // handoff | preparacion | diagnostico | planificacion | ejecucion | adopcion (ver lib/agent-groups.ts)
  groupOrder             Int             @default(0) // Orden DENTRO de su grupo (no del grupo). Para chaining: agentes con groupOrder menor se inyectan como contexto a los mayores del mismo grupo.
  /// Tipo de proyecto al que aplica (key de PROJECT_PIPELINES: customer-success | development | web).
  /// NULL = sirve para TODOS, y es el fallback: por eso el agente de handoff de hoy queda en NULL y
  /// una Implementación sigue resolviendo exactamente la misma fila. Ver lib/agents/resolver.ts.
  pipelineKey            String?
  // IDs de KnowledgeDocument inyectados sin truncar al prompt del agente (referencia principal)
  pinnedKnowledgeIds     String[]        @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AgentRun[]

  @@index([associatedStep])
  // El resolver de `lib/agents/resolver.ts` consulta SIEMPRE por este par.
  @@index([agentGroup, pipelineKey])
}

model AgentRun {
  id               String         @id @default(cuid())
  agentId          String?
  agent            Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // nullable porque los reportes de cartera agregada (Cobranza fase 3) no
  // pertenecen a UN cliente — todos los demás writers siguen seteándolo.
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessCaseId   String?
  businessCase     BusinessCase?  @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  stage            Int?
  step             Int?
  stepLabel        String? // nombre legible de la subetapa (ej. "Análisis inicial")
  sectionLabel     String? // sección dentro de la subetapa (ej. "Contexto del cliente")
  serviceType      String? // tipo de servicio al momento de la ejecución
  status           AgentRunStatus @default(PENDING)
  // Fase actual legible para el polling de UI en operaciones largas
  // ("Leyendo contexto…", "Generando secciones…"). Aditivo, opcional — los
  // flujos que no la escriben siguen igual (F5.2 del plan de mejoras).
  currentPhase     String?
  output           String?        @db.Text // JSON raw de Claude (backup)
  // Quién apretó el botón (email del TeamMember). Lo usa el centro de corridas para
  // avisarte SOLO de lo tuyo cuando termina mientras navegás por otra parte de Nexus.
  // nullable a propósito: las corridas de SISTEMA (watchdog CS, post-proceso de
  // sesiones, clasificador) no tienen humano detrás → quedan null y NUNCA notifican.
  triggeredByEmail String?

  // ── Análisis contextuales desde /sessions (Fase 9) ──────────────────────────
  sourceSessionIds String[] @default([]) // ids de FirefliesSession usados como input
  filters          Json? // snapshot de filtros: { from, to, teamRoles[], onlyWithContent }
  agentSlug        String? // identificador estable: "sales-analysis" | "service-analysis"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards                    ClientContextCard[]
  blocks                   CanvasBlock[]
  generatedTimelines       ProjectTimeline[]
  detailGeneratedTimelines ProjectTimeline[]         @relation("TimelineDetailGenerator")
  csAlerts                 CsAlert[] // Éxito del cliente: alertas emitidas por esta corrida
  lecturasDeTareas         LecturaDeReunion[]        @relation("LecturasDeTareasDelAgente") // Tareas internas: la lectura de una reunión
  hechos                   HechoDeReunion[]          @relation("HechosDelAgente") // memoria de la cuenta: los hechos de la lectura (SET NULL)
  propuestasDeRentabilidad PropuestaDeRentabilidad[] @relation("PropuestasDeRentabilidad") // la lectura de los números (SET NULL)
  investigacionesDeEmpresa InvestigacionDeEmpresa[]  @relation("InvestigacionesDeLaCorrida") // R5

  @@index([status])
  @@index([clientId, agentSlug, createdAt])
}

/**
 * Una fila por llamada a la API de Claude. El libro de gasto de IA.
 * ── POR QUÉ TABLA PROPIA Y NO COLUMNAS EN AgentRun ───────────────────────────
 * Hay 26 llamadas a Claude en producción y solo 16 sitios que crean un `AgentRun`. Medir dentro
 * de esa tabla perdería ~40% del gasto — entre otros el assist del cronograma, el refresh de
 * canvas, las dos pasadas del motor de secciones y todo marketing (que lleva su propio registro
 * de corridas). `agentRunId` queda opcional para poder cruzarlas cuando la corrida existe.
 * ⛔ Punteros BLANDOS a propósito: ni `@relation` ni FK contra Client / Project / AgentRun. Un
 * libro de gasto no puede desaparecer porque alguien borró el cliente — con `onDelete: Cascade`
 * (que es lo que usan esas tres relaciones) el registro de lo que YA se gastó se iría con él, y
 * el total del mes cambiaría hacia atrás.
 * ⚠ `costUsd` es una ESTIMACIÓN calculada con `lib/ai/precios.ts`, no lo facturado. La verdad la
 * tiene la consola de Anthropic; esto sirve para ver la forma del gasto y frenarlo a tiempo.
 * `null` = modelo sin tarifa conocida (se midieron los tokens igual).
 */
model LlmCall {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  model      String
  ok         Boolean  @default(true)
  errorType  String?
  durationMs Int?

  inputTokens         Int    @default(0)
  outputTokens        Int    @default(0)
  cacheReadTokens     Int    @default(0)
  cacheCreationTokens Int    @default(0)
  costUsd             Float?

  // Atribución — TODA opcional: se mide el 100% desde el día uno y se atribuye de a poco.
  // `triggeredByEmail` vacío significa "lo disparó el sistema", que es la distinción que decide
  // contra qué presupuesto se cobra (ver lib/ai/contexto-de-corrida.ts).
  agentSlug        String?
  agentRunId       String?
  clientId         String?
  projectId        String?
  triggeredByEmail String?
  origen           String?
  /// La respondió la API Batch (lib/ai/lotes-server.ts): costó la mitad. SQL: scripts/sql/2026-10-18-gasto-de-ia.sql.
  lote             Boolean @default(false)

  @@index([at])
  @@index([agentSlug, at])
  @@index([triggeredByEmail, at])
}

// Un pedido a Claude que no apura y va por la API Batch (la mitad del precio, respuesta en minutos u horas). La única
// puerta es lib/ai/lotes-server.ts: encola, envía los pendientes en un lote, mira los enviados y, cuando terminan, le
// pasa cada respuesta al manejador de su `tipo` (lib/ai/lotes-manejadores.ts). Interna: RLS + deny.
// SQL: scripts/sql/2026-10-18-gasto-de-ia.sql.
model PedidoEnLote {
  id          String    @id @default(cuid())
  /// Qué manejador recibe la respuesta («vigia-barrido»…). Texto, no enum: sumar uno no pide ALTER TYPE.
  tipo        String
  /// Lo mismo no se encola dos veces («vigia:<proyecto>:<día>»).
  claveUnica  String    @unique
  /// Los parámetros de messages.create, tal cual se mandan.
  pedido      Json
  /// Lo que el manejador necesita para aplicar la respuesta.
  contexto    Json
  /// en_espera | enviado | listo | error | vencido
  estado      String    @default("en_espera")
  /// El id del lote en Anthropic, una vez enviado.
  loteId      String?
  enviadoAt   DateTime?
  terminadoAt DateTime?
  error       String?
  agentSlug   String?
  clientId    String?
  projectId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([estado, createdAt])
  @@index([loteId])
}

// Lo que facturó Anthropic cada mes, anotado a mano desde la consola, para compararlo con lo que midió Nexus
// (/integrations/gasto-ia › Factura). Una fila por mes. Solo dirección. SQL: scripts/sql/2026-10-18-gasto-de-ia.sql.
model FacturaDeAnthropic {
  id              String   @id @default(cuid())
  /// «2026-09»: el mes de la factura.
  mes             String   @unique
  montoUsd        Decimal  @db.Decimal(12, 2)
  notas           String?
  anotadaPorEmail String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Business Cases (Ventas) — generador de casos de negocio ─────────────────
// Entidad 1:N bajo Client (NO bajo Project). Flujo: generar (agente) →
// editar/confirmar (vendedor) → publicar (snapshot congelado + acceso
// token+password, mismo patrón que ProjectExternalAccess).

model BusinessCase {
  id               String             @id @default(cuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hubspotCompanyId String? // empresa de HubSpot asociada al caso
  hubspotDealId    String? // deal de HubSpot (opcional)
  name             String
  slug             String             @unique // referencia interna (URLs de admin)
  status           BusinessCaseStatus @default(DRAFT)

  // Idioma del caso (código ISO 639-1, ej. "es"/"en") — fuente de verdad persistente
  // para que TODAS las secciones generen/editen en el mismo idioma. Antes vivía solo
  // como key no-schema `__lang` en el data del bloque hero (frágil); ahora se persiste
  // acá y el hero queda como fallback para casos viejos pre-migración.
  // SIN @default: si tuviera default, Postgres lo aplicaría (virtualmente) a las filas
  // YA EXISTENTES sin rewrite de tabla — casos viejos en inglés leerían "es" acá y
  // el fallback al __lang del hero (que sí tiene el idioma correcto) nunca se activaría.
  language String?

  // Clasificación — MISMO catálogo que Project (lib/tags/catalog.ts): productos, alcance, tipo
  // de implementación y modalidad, TODO en `tags`. El agente del BC los detecta; el CSE corrige.
  // Se PROPAGAN al Project al crear el handoff (match por hubspotDealId).
  tags               String[]            @default([])
  implementationType ImplementationType? // ⛔ RETIRADA (2026-08-12) — respaldo hasta el DROP; ver el enum.

  // Tipo de caso (slug del catálogo TS en lib/business-cases/case-types.ts) — determina
  // template de landing + tags seed. String? y NO enum (agregar tipos sin migración;
  // valor desconocido degrada al default). null = implementación HubSpot (legacy/default).
  // Respaldo dual-PC: la entry `__meta` del Json sections del canvas v0 (template-meta.ts).
  caseType    String?
  caseSubtype String? // sub-tipo (website: "ecommerce" | "informativo")

  // Engagements de HubSpot (id de la API v1) EXCLUIDOS a mano del contexto de ESTA propuesta
  // — la "X" de la columna HubSpot del Contexto, espejo de `Handoff.excludedEngagementIds`.
  // Por defecto TODAS las notas/llamadas/reuniones de la company alimentan la generación;
  // acá se sacan las que no son de esta venta.
  //
  // Por PROPUESTA y no por cliente a propósito: un prospecto puede tener varias propuestas
  // vivas, y podar el contexto de una no puede podárselo a las otras.
  excludedEngagementIds String[] @default([])

  // D.3 staging — el prospecto ve el SNAPSHOT publicado; el contenido vivo es
  // borrador hasta "Publicar". publishedSnapshot = foto client-safe de bloques.
  publishedAt       DateTime?
  publishedSnapshot Json?

  // ── Aprobación DEL CLIENTE (2026-08-20) ─────────────────────────────────────
  // El prospecto aprueba desde la propia propuesta dejando solo su correo (sin login):
  // POST /api/external/business-case/approve. Vive en el BusinessCase y NO en el acceso
  // externo porque es un hecho del NEGOCIO ("el cliente dijo que sí"), no del link:
  // revocar o regenerar el acceso no debe borrar que aprobó.
  approvedAt         DateTime?
  approvedByEmail    String?
  approvedByName     String?
  // `publishedAt` vigente en el instante de aprobar. Si el CSE republica después,
  // `publishedAt > approvedSnapshotAt` ⇒ el cliente aprobó OTRA versión, y la UI lo avisa.
  // Sin esta columna, republicar convertiría en silencio una aprobación vieja en el
  // respaldo de un contenido que nadie aprobó.
  approvedSnapshotAt DateTime?

  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // La exploración de venta de la que salió (lib/exploraciones): la generación la usa como fuente
  // principal. Nullable porque casi todas las propuestas no vienen de una exploración (las de antes
  // y las que se arman a mano). SQL: scripts/sql/2026-10-01-exploracion-de-venta.sql
  exploracionId String?
  exploracion   ExploracionDeVenta? @relation(fields: [exploracionId], references: [id], onDelete: SetNull)

  blocks           BusinessCaseBlock[] // (v1 — se elimina en la limpieza F7)
  canvases         ProjectCanvas[] // canvases versionados (cada "Generar" = uno nuevo)
  sessions         BusinessCaseSession[] // sesiones de contexto incluidas/excluidas
  transcripts      BusinessCaseTranscript[]
  useCases         BusinessCaseUseCase[] // checklist del catálogo de casos de uso
  modulosGuardados ModuloDePropuesta[] // módulos de la biblioteca que salieron de esta propuesta
  access           BusinessCaseExternalAccess?
  agentRuns        AgentRun[]

  /// El asistente que conversa: un hilo por documento y por persona.
  hilosDeChat         HiloDeChat[]
  vinculosDeTareas    TareaVinculo[]      @relation("VinculosDeTareasDeLaPropuesta") // Tareas internas (CASCADE)
  /// Las fotos de la escala que se amarraron a esta propuesta (VersionDeLaEscala, 2026-10-18).
  versionesDeLaEscala VersionDeLaEscala[]

  @@index([clientId])
  @@index([exploracionId])
}

// ─── Exploraciones de venta (2026-10-01) ──────────────────────────────────────
// SQL: scripts/sql/2026-10-01-exploracion-de-venta.sql (⛔ nunca `db push`). RLS encendida en su SQL.
// El lienzo con el que el vendedor amplía el diagnóstico de un prospecto para cerrar la primera
// venta (lib/exploraciones). Una VIVA por empresa: el índice único parcial vive solo en el SQL
// (Prisma no modela índices parciales). El agente PROPONE en `propuesta`; lo confirmado vive en
// `contenido`. Estados en String y no enum (INV4).
model ExploracionDeVenta {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// La exploración de un PROYECTO (2026-10-07): el mismo lienzo y la misma guía que la preventa, con
  /// las preguntas de Customer Success. null = una preventa. Una VIVA por proyecto (índice parcial en el
  /// SQL); toda lectura de Ventas filtra `projectId: null` (`DE_LA_PREVENTA`, lib/exploraciones/marco.ts).
  /// nullable porque la preventa no tiene proyecto. SQL: 2026-10-07-exploracion-del-proyecto.sql.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Qué se explora: `venta` (la arquitectura de la venta) · `cs` (la estrategia del cliente).
  marco     String   @default("venta")

  /// Edición por industria de la escala (`ecommerce-retail`…); null = la escala general.
  edicion       String?
  /// El perfil de negocio, con las palabras de la escala: `con equipo` · `transaccional` · `mixta`.
  perfilCierre  String?
  /// `única` · `recompra` · `continua`.
  perfilDespues String?
  /// Las áreas en juego (`1`, `2`, `3`) en el orden en que se eligieron: decide qué va primero.
  areas         String[] @default([])

  /// Lo confirmado por el vendedor (lib/exploraciones/contenido.ts).
  contenido Json  @default("{}")
  /// Lo que propone el agente, con sus fuentes, hasta que el vendedor lo usa o lo descarta.
  propuesta Json?
  /// Lo leído del test de marketing: hipótesis, con la escala anterior.
  test      Json?

  responsableEmail String?
  creadaPor        String
  /// Concurrencia optimista: sube con cada cambio de lo confirmado (no con lo que propone el agente).
  version          Int       @default(0)
  archivadaEn      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Las propuestas que salieron de esta exploración.
  propuestas                 BusinessCase[]
  /// Las sesiones y los documentos que el vendedor sumó a mano.
  documentos                 ExploracionDocumento[]
  vinculosDeTareas           TareaVinculo[]           @relation("VinculosDeTareasDeLaPreventa") // Tareas internas (CASCADE)
  /// Las fotos de la escala que salieron de esta exploración (VersionDeLaEscala).
  versionesDeLaEscala        VersionDeLaEscala[]
  /// R5: las investigaciones que se mudaron de esta preventa a su empresa.
  investigacionesDeLaEmpresa InvestigacionDeEmpresa[] @relation("InvestigacionesDeLaPreventa")

  @@index([clientId])
  @@index([projectId])
  @@index([updatedAt])
}

// Una sesión o un documento que el vendedor suma a mano a su exploración (pegó el texto o subió un
// archivo: el resumen del Smartflow, una minuta). El agente lo lee igual que una transcripción. Se
// guarda solo el texto extraído, nunca el archivo. `origen`: `pegado` · `archivo` (String, INV4).
model ExploracionDocumento {
  id            String             @id @default(cuid())
  exploracionId String
  exploracion   ExploracionDeVenta @relation(fields: [exploracionId], references: [id], onDelete: Cascade)

  titulo        String
  origen        String
  nombreArchivo String?
  /// La fecha de la reunión (`AAAA-MM-DD`), si es una sesión.
  fecha         String?
  texto         String
  creadoPor     String
  createdAt     DateTime @default(now())

  @@index([exploracionId])
}

// ─── Catálogo de casos de uso (Ventas) ────────────────────────────────────────
// Checklist INTERNO del vendedor: casos de uso pre-armados con precio que se marcan
// por BC y se materializan determinísticamente en la sección `casos_de_uso` (el
// agente NUNCA los genera → precios exactos). 100% opcional: sin filas aplicables,
// el flujo de texto libre sigue idéntico. Tabla propia (NO KnowledgeDocument: los
// docs PUBLISHED se inyectan al contexto de OTROS agentes y esto lleva precios).
model UseCase {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text // markdown corto (checklist + landing)
  price          String? // TEXTO libre mostrable ("USD 1.200", "desde $X/mes") — NUNCA numérico (sin calculadora, por diseño)
  appliesTo      String[] @default([]) // slugs de caseType (case-types.ts); [] = aplica a TODOS los tipos
  tags           String[] @default([]) // slugs del catálogo lib/tags (mismo vocabulario que BusinessCase.tags)
  active         Boolean  @default(true)
  order          Int      @default(0)
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessCases BusinessCaseUseCase[]

  @@index([active])
}

// Pivote BC ↔ caso de uso — espejo de BusinessCaseSession. SEMÁNTICA: sin fila = no
// seleccionado; la fila se crea recién al primer toggle (un seed que cree filas para
// todos los candidatos invertiría el default). La verdad PUBLICABLE es el `data` de
// la sección `casos_de_uso` del canvas; el pivote es estado de trabajo + input del prompt.
model BusinessCaseUseCase {
  id             String       @id @default(cuid())
  businessCaseId String
  businessCase   BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  useCaseId      String
  useCase        UseCase      @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  selected       Boolean      @default(true)
  priceOverride  String? // precio negociado para ESTE caso (texto)
  createdAt      DateTime     @default(now())

  @@unique([businessCaseId, useCaseId])
  @@index([businessCaseId])
}

model BusinessCaseSession {
  id             String       @id @default(cuid())
  businessCaseId String
  businessCase   BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  sessionId      String // FirefliesSession.id (sin FK dura: la sesión puede no existir aún)
  included       Boolean      @default(true) // el vendedor incluye/excluye del contexto de generación
  createdAt      DateTime     @default(now())

  @@unique([businessCaseId, sessionId])
  @@index([businessCaseId])
}

model BusinessCaseBlock {
  id               String                @id @default(cuid())
  businessCaseId   String
  businessCase     BusinessCase          @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  blockType        BusinessCaseBlockType
  order            Int                   @default(0)
  content          Json // estructurado por blockType (ver lib/business-cases/schema.ts)
  previousContent  Json? // deshacer de 1 nivel
  status           BlockStatus           @default(DRAFT)
  source           BlockSource           @default(AGENT)
  isVisible        Boolean               @default(true)
  needsValidation  Boolean               @default(false) // el agente no tuvo contexto suficiente
  confirmedAt      DateTime?
  confirmedByEmail String?
  agentRunId       String? // provenance (sin FK dura)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([businessCaseId])
}

model BusinessCaseTranscript {
  id             String                       @id @default(cuid())
  businessCaseId String
  businessCase   BusinessCase                 @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  source         BusinessCaseTranscriptSource
  rawText        String                       @db.Text // pegado, o texto extraído del archivo
  fileName       String?
  fileUrl        String? // path en Supabase Storage (UPLOADED)
  fileSize       Int?
  mimeType       String?
  processedAt    DateTime?
  createdAt      DateTime                     @default(now())

  @@index([businessCaseId])
}

model BusinessCaseExternalAccess {
  id             String       @id @default(cuid())
  businessCaseId String       @unique
  businessCase   BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  accessToken    String       @unique // 64 hex (crypto.randomBytes(32))
  passwordHash   String // bcrypt(12)
  accessPassword String? // texto plano para que el vendedor lo comparta

  // ── Modo de acceso (2026-08-20) ─────────────────────────────────────────────
  // false (default) = la URL ES el secreto: /external/propuesta/{token} renderiza directo,
  // sin contraseña ni cookie. true = el flujo histórico (verify + contraseña + cookie).
  // Ventas pidió el default abierto para bajar la fricción; el check es la excepción.
  //
  // `passwordHash` sigue siendo NOT NULL a propósito: la contraseña se genera SIEMPRE,
  // el bit que gobierna es este. Así encender el check es instantáneo y no hay una
  // columna nullable que cada lector tenga que acordarse de chequear.
  //
  // El token NO rota al cambiar de modo: cada URL redirige a la del modo vigente
  // (ver lib/business-cases/access-url.ts), así ningún link ya enviado queda muerto.
  requiresPassword Boolean @default(false)

  // Caducidad del link (null = no caduca). Vencido ⇒ el prospecto ve un mensaje de
  // "caducada, contactá a tu asesor", NO un 404: es el único fallo del módulo que se
  // distingue, y solo con un token válido en la mano. Una propuesta ya APROBADA no
  // caduca (el cliente tiene derecho a releer lo que aprobó).
  expiresAt DateTime?

  enabledAt      DateTime  @default(now())
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accessToken])
  @@index([businessCaseId])
}

// Token EFÍMERO (TTL 60s) para que Puppeteer (server-to-server, mismo contenedor)
// autentique su navegación a /print/doc/[type]/[id] SIN reenviar las cookies reales
// de sesión Supabase (que pueden venir partidas en varias cookies `sb-*`) — mismo
// principio que BusinessCaseExternalAccess, pero con TTL de segundos en vez de una
// sesión de acceso duradera. Reusable mientras no expire: exigir un solo uso rompía
// el PDF ante cualquier recarga de la página. Ver lib/print/job-token.ts.
// Rate-limit PERSISTIDO del verify-access externo (proyecto y business case).
// Antes era un Map en memoria: cada deploy lo reseteaba y un atacante podía
// re-intentar tras cada restart. Una fila por token atacado; el job
// maintenance-daily barre filas viejas.
model ExternalVerifyAttempt {
  token         String    @id // el accessToken al que se intenta entrar (64 hex)
  count         Int       @default(0)
  windowStartAt DateTime
  blockedUntil  DateTime?
  updatedAt     DateTime  @updatedAt
}

model PrintJobToken {
  id             String    @id @default(cuid())
  token          String    @unique // 64 hex (crypto.randomBytes(32))
  // QUÉ documento imprime este token. TEXT libre a propósito: el vocabulario lo define
  // lib/print/doc-types.ts y lo valida la app contra el registro ANTES de tocar la base —
  // un enum de Postgres obligaría a una migración cada vez que se suma un tipo.
  docType        String?
  // El id de ESE documento: businessCaseId, projectId, roleId… según el tipo.
  docId          String?
  // DEPRECATED — eliminar después del 2026-09-30. Reemplazada por `docType`/`docId`
  // (2026-07-28, al generalizar el PDF a los 8 tipos de documento). Se sigue escribiendo
  // para el business case (dual-write) y se lee como fallback, así que un token minteado
  // por el código viejo se consume con el nuevo. Cuando no queden lectores, se dropea.
  businessCaseId String?
  canvasId       String? // null = canvas activo al momento de generar
  createdByEmail String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

// ─── TeamMember ───────────────────────────────────────────────────────────────
// Identidad interna del equipo de Smarteam. El email es la llave que cruza
// con AppUser.email (que a su vez se vincula con auth.users de Supabase Auth).
// El roleEnum reemplaza al string legacyRole; el viejo se mantiene para
// auditoría de migración y se elimina cuando estabilice el roleEnum.

model TeamMember {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  // ÁREA FUNCIONAL — eje de ANÁLISIS de sesiones, NO permisos. Valores: Ventas,
  // CSE, CSL, Marketing, Development, PM, Admin, RevOps (set abierto). Antes se
  // llamaba `role`; se renombró a `area` para no confundir con roleEnum (permisos).
  // Marco Salas, p.ej., es roleEnum=SUPER_ADMIN pero area=Ventas (análisis).
  area                String?
  // ROL DE PERMISO — única fuente de verdad de acceso/capacidades. Ver lib/auth/roles.ts.
  roleEnum            TeamRole  @default(CSE)
  // Foto de la persona (bucket público, subida desde /team). Se muestra en el
  // selector de equipo del Kickoff (snapshoteada al seleccionar). nullable = sin foto → iniciales.
  photoUrl            String?
  // Visibilidad total HOY se deriva del rol (todos menos CSE ven todo). Este flag
  // queda como override excepcional (ej. un CSE con acceso temporal a todo).
  canViewAllClients   Boolean   @default(false)
  canViewAllExpiresAt DateTime?
  // Overrides de PERMISOS por usuario (matriz sección×acción, lib/auth/permissions):
  // Json SPARSE {v:1, sections:{[seccion]:{[accion]:bool}}} — solo las celdas que el
  // SUPER_ADMIN pineó para ESTE usuario; ausencia = hereda la plantilla del rol
  // (RolePermission) o el default de código. null = hereda todo. Lectura tolerante.
  permissionOverrides Json?
  // VISTA DE FINANZAS (2026-10-03, docs/finanzas-rediseno-plan.md): solo cuenta para un SUPER_ADMIN. null o SUPERVISA =
  // el panel completo (revisar, decidir, cerrar el mes); DIRECCION = solo los reportes. Decide el MENÚ y la pantalla de
  // entrada, no los permisos. CHECK en el SQL. ⚠ La lee cada página (el usuario se carga con su fila entera).
  // Desde 2026-10-04 se DESPRENDE de los frentes: la escribe quien guarda los frentes (vistaFinanzasDeFrentes). Ya no
  // se elige aparte en Equipo.
  vistaFinanzas       String?
  // LO QUE LLEVA (2026-10-04, «Para ti», lib/para-ti/frentes.ts): los frentes que la persona sigue, aparte de su ROL de
  // acceso. No dan permisos: deciden qué le llega en «Para ti». frentesEditadosAt null = nadie los eligió → salen del
  // rol (FRENTES_POR_DEFECTO); con fecha, la lista manda aunque esté vacía. Texto y no enum: sumar un frente no toca
  // la base. ⚠ Como vistaFinanzas, la lee cada página: el SQL va ANTES del deploy.
  frentes             String[]  @default([])
  frentesEditadosAt   DateTime?
  frentesEditadosPor  String?
  // LOS SPRINTS QUE LIDERA (2026-10-16, fase 0.1 de docs/nexus-sistema-de-trabajo-plan.md): claves de
  // lib/tareas/equipos.ts (cs, desarrollo, marketing…). Una persona puede liderar más de uno y uno que no es el de su
  // área (Alex Vanegas lidera CS y Desarrollo). Reemplaza al override `tareas.manage`, que solo valía en su área. Se
  // elige en Equipo. ⚠ La lee cada página (el usuario se carga con su fila entera): el SQL va ANTES del deploy.
  lideraEquipos       String[]  @default([])
  // Baja blanda: si != null, el miembro pierde acceso (login bloqueado) y desaparece
  // de los listados de personas, pero su histórico (sesiones/handoffs/runs) queda intacto.
  deactivatedAt       DateTime?
  deactivatedReason   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Inversas
  appUser                 AppUser?
  clientAssignments       ClientAssignment[]      @relation("AssignedTo")
  grantedAssignments      ClientAssignment[]      @relation("GrantedBy")
  externalAccessesCreated ProjectExternalAccess[] @relation("ExternalAccessCreator")
  // SUPER_ADMIN-only (salarios estimados, Cobranza fase 4) — JAMÁS incluir esta
  // relación desde endpoints no-costos; Prisma no la trae sin include explícito.
  costosRecurrentes       CostoRecurrente[]       @relation("CostosDePersona")
  // Documentos de /roles compartidos con esta persona (solo lectura).
  roleShares              RoleProfileShare[]
  // ⚠ SUPER_ADMIN-only, MISMA regla que costosRecurrentes: estas cuatro llevan
  // lo que se le PAGA a la persona (quincenas, comisiones) o de qué tarjeta de
  // la empresa es titular. Ninguna entra a TEAM_MEMBER_SAFE_SELECT — hay un
  // test que lo afirma por nombre.
  tarjetas                TarjetaCredito[]        @relation("TarjetasDePersona")
  pagosPlanilla           PagoPlanilla[]          @relation("PagosDePlanilla")
  reglasComision          ReglaComisionVendedor[] @relation("ReglasDeComision")
  comisionesVendedor      ComisionVendedor[]      @relation("ComisionesDeVendedor")
  cuotasComisionVendedor  CuotaComisionVendedor[] @relation("CuotasDeComisionVendedor") // ⚠ remuneración (2026-10-06)
  ventasAtribuidas        AtribucionVenta[]       @relation("VentasAtribuidas")
  aguinaldosPagados       AguinaldoPago[]         @relation("AguinaldosDePersona")
  // Lo vendido y las metas comerciales de la persona (2026-10-08): dato general, no remuneración.
  ventasGanadas           VentaGanada[]           @relation("VentasDelVendedor")
  ventasCompartidas       VentaGanada[]           @relation("VentasCompartidas")
  metasComerciales        MetaComercial[]         @relation("MetasDelVendedor")
  negociosAbiertos        NegocioAbierto[]        @relation("NegociosDelVendedor")
  propuestasDeDatos       PropuestaDeDato[]       @relation("PropuestasDeDatosDelAutor") // R1: lo que propuso de los datos de una empresa
  decisionesDeDatos       PropuestaDeDato[]       @relation("DecisionesDeDatos") // R1: lo que decidió
}

// ─── Aviso ────────────────────────────────────────────────────────────────────
// «Para ti» (2026-10-04, lib/para-ti): algo que PASÓ y que una persona debería saber — el cliente aprobó, te
// devolvieron un pago, te compartieron un documento. Lo que te toca HACER no vive acá: se calcula del estado y se va
// solo cuando se resuelve. Un aviso se guarda, se marca leído y se borra a los 90 días de leído. Nunca se le escribe a
// quien hizo la acción (lib/para-ti/avisos-server.ts). Sin FKs: el destinatario va por correo, como toda la autoría
// del repo (*ByEmail), y el enlace es una ruta.
model Aviso {
  id         String    @id @default(cuid())
  // Destinatario, por correo en minúsculas.
  paraEmail  String
  // Qué pasó, con punto ("finanzas.devuelto"). Texto y no enum (INV4): sumar un tipo no toca la base.
  tipo       String
  titulo     String
  detalle    String?
  // Adónde lleva: una ruta interna.
  href       String
  // Por qué le llegó: la clave del frente, o null = era personal.
  frente     String?
  actorEmail String?
  // El mismo hecho le avisa UNA vez a cada persona.
  dedupeKey  String
  creadoAt   DateTime  @default(now())
  leidoAt    DateTime?

  @@unique([paraEmail, dedupeKey])
  @@index([paraEmail, leidoAt, creadoAt])
}

enum TeamRole {
  CSE // scoped: solo sus clientes asignados (owner) + los compartidos
  VENTAS // ve todo + handoff en cualquiera; NO comparte
  CSL // ve todo + handoff en cualquiera + comparte; NO gestiona equipo
  MARKETING // capacidades = CSL (etiqueta distinta para análisis/UI)
  DEV // equipo técnico: capacidades = VENTAS (ve todo + cronogramas + handoffs) + área Ventas
  ADMIN // asistente administrativo (Finanzas): SOLO Cobranza (via COBRANZA_ROLES) — 0 capacidades de la matriz
  SUPER_ADMIN // todo + ÚNICO que gestiona el equipo (alta/baja/cambio de rol)
}

// ─── RolePermission ───────────────────────────────────────────────────────────
// PLANTILLA de permisos por rol, editable vía UI (/team, solo SUPER_ADMIN).
// `permissions` = PermissionMap COMPLETO {v:1, sections:{[seccion]:{[accion]:bool}}}
// validado contra el registry (lib/auth/permissions). Precedencia efectiva:
// DEFAULT_MATRIX (código) ← esta fila (DB, cache TTL 60s) ← TeamMember.permissionOverrides.
// Fila ausente o Json inválido → default de código (deploy-safe con tabla vacía).
// SUPER_ADMIN nunca se lee de acá: all-true hardcodeado en el engine (anti-lockout).

model RolePermission {
  role           TeamRole @id
  permissions    Json
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

// ─── AppUser ──────────────────────────────────────────────────────────────────
// Identidad unificada que vincula auth.users (Supabase Auth) con el modelo
// de Nexus. Hay dos kinds:
//   - INTERNAL: equipo de Smarteam. teamMemberId set, clientId null.
//   - EXTERNAL: cliente final (onboarding). clientId set, teamMemberId null.
// El authUserId se vincula en el primer login (callback de Google OAuth).

model AppUser {
  id           String      @id @default(cuid())
  authUserId   String?     @unique // FK suave a auth.users.id de Supabase (null hasta primer login)
  email        String      @unique
  kind         AppUserKind
  teamMemberId String?     @unique
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
  @@index([authUserId])
}

enum AppUserKind {
  INTERNAL
  EXTERNAL
}

/// Qué es una empresa para Smarteam. Solo `CLIENTE` entra a los listados y métricas de CS
/// (ver `lib/clients/kind.ts`); el resto son empresas reales que NO son cartera:
///   PROSPECTO — Ventas la creó para un business case; todavía no compró.
///   ALIADO    — aliado comercial / partner (ej. una agencia con la que se co-vende).
///   INTERNO   — Smarteam misma y sus entidades: no somos nuestro propio cliente.
enum ClientKind {
  CLIENTE
  PROSPECTO
  ALIADO
  INTERNO
}

// ─── ClientAssignment ─────────────────────────────────────────────────────────
// Overrides manuales bidireccionales para la asignación CSE↔Cliente, en
// adición al default automático (hubspotOwnerEmail). GRANT da acceso a un
// CSE a un cliente que no es su owner; REVOKE quita acceso a un CSE que sí
// es owner (raro). Solo ADMIN/SUPER_ADMIN puede crearlos (grantedById).

model ClientAssignment {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Target del compartir: a UNA persona (teamMemberId) O a un ROL entero
  // (targetRole, ej. CSE = "todo el equipo CSE"). Exactamente uno de los dos.
  teamMemberId String?
  teamMember   TeamMember?    @relation("AssignedTo", fields: [teamMemberId], references: [id], onDelete: Cascade)
  targetRole   TeamRole?
  kind         AssignmentKind
  grantedById  String // FK al TeamMember (CSL/SUPER_ADMIN) que compartió
  grantedBy    TeamMember     @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  reason       String?        @db.Text
  createdAt    DateTime       @default(now())

  // NULLs son distintos en PG → la unicidad real la garantizan los scripts esta
  // vuelta (no hay UI). Se reforzará con constraint parcial cuando llegue la UI.
  @@unique([clientId, teamMemberId, targetRole])
  @@index([teamMemberId])
  @@index([clientId])
}

enum AssignmentKind {
  GRANT
  REVOKE
}

// ============================================
// KNOWLEDGE BASE — Documentos de conocimiento
// ============================================

enum KnowledgeType {
  PROCESS // Procesos operativos (cómo ejecutar una fase, cadencia semanal, etc.)
  METHODOLOGY // Metodologías (Inbound, Loop Framework, gestión del cambio)
  HUBSPOT_SPEC // Features y specs de HubSpot (releases, capacidades, limitaciones)
  BEST_PRACTICE // Mejores prácticas descubiertas en proyectos anteriores
  TEMPLATE // Plantillas reutilizables (agendas, estructuras de informes, etc.)
}

enum KnowledgeStatus {
  DRAFT // En borrador, no visible para agentes
  PUBLISHED // Activo, los agentes lo consultan
  ARCHIVED // Obsoleto, no se consulta pero se conserva
}

enum TagCategory {
  SERVICE // Servicio: loop_marketing, loop_sales, loop_service, proyecto_temporal
  STAGE // Etapa: diagnostico, mvp, adopcion
  SUBSTAGE // Subetapa: analisis_inicial, funnel, mapeo, kickoff, piloto, escalamiento, etc.
  DOMAIN // Dominio funcional: marketing, sales, service, cross_department
  HUBSPOT_AREA // Área de HubSpot: crm, automation, reporting, breeze, workflows, pipelines
  TOPIC // Tema libre: gestion_cambio, liderazgo, onboarding, data_quality, etc.
}

model KnowledgeDocument {
  id     String          @id @default(cuid())
  type   KnowledgeType
  status KnowledgeStatus @default(DRAFT)

  title   String
  summary String? // Resumen corto para listados y contexto rápido de agentes
  content String  @db.Text // Contenido completo en Markdown

  version Int @default(1)

  // Autoría (sin modelo User — usamos email de sesión)
  createdByEmail String?
  updatedByEmail String?

  tags       KnowledgeTag[]
  embeddings KnowledgeEmbedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([createdAt])
}

// ============================================
// SISTEMA DE TAGS — Taxonomía para filtrado
// ============================================

model KnowledgeTag {
  id       String      @id @default(cuid())
  category TagCategory
  value    String // Ej: "loop_marketing"
  label    String // Ej: "Loop Marketing"

  documents KnowledgeDocument[]

  @@unique([category, value])
  @@index([category])
}

// ============================================
// EMBEDDINGS — Para búsqueda semántica futura
// ============================================

model KnowledgeEmbedding {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int    @default(0)
  chunkText  String @db.Text

  // El vector se agrega vía SQL directo en Supabase (pgvector, 1024 dims)
  // ALTER TABLE "KnowledgeEmbedding" ADD COLUMN embedding vector(1024);

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ── FirefliesSession — caché local de sesiones de Fireflies y Google Meet ─────

model FirefliesSession {
  id                   String    @id
  title                String
  date                 DateTime
  duration             Float     @default(0)
  participants         String[]
  summary              Json?
  transcript           String?   @db.Text
  enrichedAt           DateTime? // cuándo se trajo transcript/summary (null = pendiente)
  // Procedencia del enriquecimiento (2026-08-08). Un fallo de lectura YA NO sella la fila:
  // attempts cuenta los fallos (0 = sano; 1-4 = en cola del job de reintento; 5 = sellado con
  // procedencia) y error guarda el último {error,status,at} o el diagnóstico del parser
  // ({tabsVistos,motivo}) cuando la lectura fue exitosa sin transcript.
  enrichAttempts       Int       @default(0)
  enrichError          String?
  syncedAt             DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  source               String    @default("google_meet") // "google_meet" (Fireflies eliminado; "fireflies" solo en filas históricas)
  googleDocId          String? // ID del Google Doc de la reunión (Meet)
  googleEventId        String? // ID del evento de Google Calendar (Meet)
  organizerEmail       String? // Email del organizador (para impersonación en enriquecimiento)
  // Ficha G (2026-10-17): la descripción del evento del calendario, limpia (sin el bloque de Google Meet ni el HTML).
  // Es la AGENDA de la reunión: lo que se iba a tratar. La escribe la sync de Meet (lib/sessions/descripcion-del-evento.ts).
  descripcionDelEvento String?   @db.Text
  // U1 (2026-10-25): el código de Meet de la reunión (abc-defg-hij), del evento del calendario. U3 lo cruza con el
  // registro de conferencia de la API de Meet. Lo escribe la sync de Meet; null = el evento no lo traía.
  conferenceId         String?
  // U1 (2026-10-25): cuándo vio la sync que el evento se canceló en TODOS los calendarios donde estaba. Nunca se borra
  // la fila: la cancelada con texto, minuta, hechos o tareas queda para revisar; la que no tiene nada sale de las
  // lecturas (lib/sessions/canceladas.ts). null = vigente (si el evento vuelve, la sync la desmarca).
  canceladaEn          DateTime?
  // T4 (2026-10-25): POR QUÉ no dejó texto (un `MotivoDeLaFalta` de lib/google/por-que-falta.ts) y cuándo se calculó.
  // Lo escribe SOLO el job `reuniones-motivos` (lib/sessions/motivo-sin-texto-server.ts) y lo borra cuando la reunión
  // tiene texto. TEXT y no enum a propósito: la lista vive en el código y crece (ver el .sql). null = tiene texto o no
  // se calculó todavía.
  motivoSinTexto       String?
  motivoSinTextoAt     DateTime?
  // U3 (2026-10-25): lo que dice la API de Meet de la conferencia de esta reunión. Lo escribe SOLO lib/google/conferencias.ts.
  // null = todavía no se miró. SIN_ACCESO = la organizó alguien de fuera y nadie del equipo entró: Meet no dice nada.
  estadoDeConferencia  EstadoDeConferencia?
  // La hora REAL de la conferencia (la primera entrada y la última salida). No pisa `date`, que es la del evento.
  conferenciaInicio    DateTime?
  conferenciaFin       DateTime?
  // Cuándo se le preguntó a Meet por última vez, y cuándo ya no quedaba nada que esperar (INV53: antes de los 25 días).
  conferenciaRevisadaEn DateTime?
  conferenciaCerradaEn DateTime?
  // Los Docs que Meet dice que generó para esta conferencia: la lectura va a ellos por su id, no por el título.
  docDeTranscripcionId String?
  docDeNotasId         String?
  manualClientId       String? // override manual del matching automático de cliente
  // R7 (2026-10-24): llave de verdad. Si la empresa se borra, el override se cae solo (SET NULL).
  manualClient         Client?   @relation("ReunionesAsignadasAMano", fields: [manualClientId], references: [id], onDelete: SetNull)
  // ── QUIÉN puso ese override, y si fue una decisión o un efecto secundario ──────
  // `manualClientId` lo escriben DOS gestos que se ven idénticos en la base: alguien eligiendo
  // el cliente a mano, y la ADOPCIÓN automática al agregar una reunión huérfana a un proyecto.
  // Sin distinguirlos no se puede deshacer lo segundo sin pisar lo primero — y en un demo una
  // reunión desapareció para siempre por exactamente eso. NUNCA se backfillea: afirmar una
  // procedencia que no se conoce es peor que no saberla, así que `null` = legacy = humano.
  manualClientSource   String? // 'humano' | 'adopcion' | null (legacy)
  manualClientBy       String? // email de quien lo puso
  manualClientAt       DateTime?
  resolvedClientId     String? // PERF #1: cliente resuelto (materializado de categorizeSession) para "última actividad"/bookends sin cargar todas las sesiones. Re-resuelto en write/override/mutación de Client.
  // R7 (2026-10-24): LA dueña de la reunión, como llave de verdad. RESTRICT: borrar una empresa con reuniones es un
  // error visible, nunca reuniones apuntando a una lápida (el DELETE de la empresa y la fusión las sueltan antes).
  resolvedClient       Client?   @relation("ReunionesResueltas", fields: [resolvedClientId], references: [id], onDelete: Restrict)

  // F5: sub-topics detectados por IA (lead-scoring, workflow-builder, etc.).
  // Lista canónica viva en lib/sessions/topic-vocabulary.ts y se sesga por
  // serviceType del proyecto primario.
  detectedTopics String[] @default([])

  // Relaciones del ciclo de reunión (minuta post + acciones derivadas)
  minute                SessionMinute?
  actionItems           ActionItem[]
  pedidosFueraDeAlcance PedidoFueraDeAlcance[]
  projects              SessionProject[]
  tareas                Tarea[]                 @relation("TareasDeLaReunion") // Tareas internas: se leen SOLO por el chokepoint (SET NULL)
  tareasPlaneadas       Tarea[]                 @relation("ReunionPlaneada") // la reunión planeada en Tareas que se hizo acá
  proyectosDeTareas     ProyectoDeTareas[]      @relation("ProyectosDeTareasDeLaReunion")
  eventosDeTareas       TareaEvento[]           @relation("EventosDeTareasDeLaReunion")
  lecturaDeTareas       LecturaDeReunion?       @relation("LecturaDeLaReunion")
  hechos                HechoDeReunion[]        @relation("HechosDeLaReunion") // memoria de la cuenta: se leen SOLO por lib/seguimiento (CASCADE)
  turnos                TurnoDeReunion[]        @relation("TurnosDeLaReunion") // la búsqueda en las reuniones (etapa 4c): CASCADE
  indexada              ReunionIndexada?        @relation("ReunionIndexada")
  notasParaHubspot      NotaDeLaCuenta[]        @relation("NotasDeLaReunion") // la nota para HubSpot que se sugirió después de la reunión (SET NULL)
  seguimiento           SeguimientoDeReunion?   @relation("SeguimientoDeLaReunion") // ficha G: agenda escrita, correo y próxima reunión (CASCADE)
  invitados             ParticipanteDeReunion[] @relation("ParticipantesDeLaReunion") // U1: cada invitado con su respuesta; U3 suma la asistencia (CASCADE)
  propuestaDeEmpresa    PropuestaDeEmpresa?    @relation("PropuestaDeLaReunion") // T3: a qué empresa la propone Nexus (CASCADE)
  audio                 AudioDeReunion?        @relation("AudioDeLaReunion") // T5: el audio de la reunión presencial (CASCADE)
  analisisDeVenta       AnalisisDeVenta?       @relation("AnalisisDeVentaDeLaReunion") // S3: el análisis de la reunión de venta (CASCADE)
  referenciaDeVenta     ReunionDeReferenciaDeVenta? @relation("ReferenciaDeVenta") // S1: marcada como ejemplo de lo consultivo (CASCADE)
  frases                FraseDeReunion[]       @relation("FrasesDeLaReunion") // U3: la transcripción por frases de la API de Meet (CASCADE)

  // Índices para los queries principales:
  //   /sessions: findMany({ where: { date: { lt: now } }, orderBy: { date: desc } })
  //   override manual: filtros por manualClientId al matchear sesiones
  // Sin esto, Postgres hace seq scan + sort en cada render.
  @@index([date(sort: Desc)])
  @@index([manualClientId])
  @@index([resolvedClientId, date(sort: Desc)])
  @@index([conferenceId])
}

/// La respuesta de un invitado al evento del calendario (`responseStatus` de Google Calendar).
enum RespuestaAlEvento {
  ACEPTO
  TENTATIVA
  RECHAZO
  SIN_RESPONDER
}

/// U1 (2026-10-25) · Un invitado de una reunión, con su respuesta al evento y si es del equipo. Lo escribe SOLO la sync
/// de Meet (lib/google/meet-sync.ts), y solo lo que cambió. `entro`, `salio` y `minutos` nacen vacíos: los llena U3 con
/// la asistencia de la API de Meet (T7 la lee). ⚠ Google pide no usar la asistencia para medir desempeño: los minutos de
/// cada persona no van a ninguna evaluación.
model ParticipanteDeReunion {
  id          String             @id @default(cuid())
  sessionId   String
  session     FirefliesSession   @relation("ParticipantesDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  /// En minúsculas.
  correo      String
  /// Su dominio es uno de los de las cuentas del Workspace de Smarteam.
  esDelEquipo Boolean            @default(false)
  /// null = el calendario no la dijo (el organizador sin fila de invitado).
  respuesta   RespuestaAlEvento?
  /// U3: la primera entrada, la última salida y los minutos adentro, de la API de Meet. ⚠ Google pide no usar la
  /// asistencia para medir desempeño: los minutos no van a ninguna evaluación.
  entro       DateTime?
  salio       DateTime?
  minutos     Int?
  /// U3: el nombre con el que entró a Meet y su id ahí (`users/{id}` o el del participante).
  nombre      String?
  idEnMeet    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([sessionId, correo])
  @@index([correo])
}

/// T3 (2026-10-25) · A qué empresa propone Nexus una reunión con texto que no tiene dueña. La saca el resolver único
/// (`categorizeSession`, lib/sessions/categorize.ts: sin matching nuevo) y la escribe SOLO el job `reuniones-propuestas`
/// (lib/sessions/propuesta-de-empresa-server.ts). La decide una persona por lib/sessions/empresa-de-la-reunion-server.ts,
/// que escribe el dueño por `asignarDuenioManual` y anota aquí qué decidió. Mide «2 de cada 3 confirmadas en 48 horas».
model PropuestaDeEmpresa {
  id               String                   @id @default(cuid())
  sessionId        String                   @unique
  session          FirefliesSession         @relation("PropuestaDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  tipo             TipoDePropuestaDeEmpresa
  /// CLIENTE: la empresa que ya está en Nexus. nullable porque una propuesta HUBSPOT todavía no tiene ficha (y si la
  /// empresa se borra, la propuesta queda sin ella: SET NULL).
  clientId         String?
  client           Client?                  @relation("PropuestasDeEmpresa", fields: [clientId], references: [id], onDelete: SetNull)
  /// HUBSPOT: la empresa del HubSpot de Smarteam del dominio (id externo, sin llave).
  hubspotCompanyId String?
  nombre           String
  dominio          String?
  propuestaAt      DateTime                 @default(now())
  /// null = nadie decidió todavía.
  decision         DecisionDeLaPropuesta?
  decididaAt       DateTime?
  decididaPor      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([decision])
}

/// Qué propone Nexus: una empresa que ya está, o una de HubSpot que se crea como prospecto al confirmar.
enum TipoDePropuestaDeEmpresa {
  CLIENTE
  HUBSPOT
}

/// Lo que decidió la persona: la propuesta, u otra empresa.
enum DecisionDeLaPropuesta {
  CONFIRMADA
  OTRA
}

/// S3 (2026-10-26) · El análisis de UNA reunión de venta (docs/analizador-reuniones-venta-plan.md): qué tan consultiva
/// fue, con cada juicio citado de la transcripción. Es una PROPUESTA de coaching, no una evaluación (S4 suma los
/// comentarios y la confirmación). Lo escribe SOLO lib/analizador-venta/analizar-server.ts. `clientId` es la dueña de la
/// reunión al analizarla; INV57 vigila que siga siéndolo (invariante 1).
model AnalisisDeVenta {
  id          String                   @id @default(cuid())
  sessionId   String                   @unique
  session     FirefliesSession         @relation("AnalisisDeVentaDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client                   @relation("AnalisisDeVentaDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  estado      EstadoDelAnalisisDeVenta @default(PROPUESTO)
  /// `ResultadoDelAnalisis` (lib/analizador-venta/analisis.ts): los juicios con sus citas ya verificadas.
  resultado   Json?
  /// `QuienHablo` (lib/analizador-venta/quien-hablo.ts), calculado.
  quienHablo  Json?
  /// `VERSION_DEL_CRITERIO` con que se hizo.
  criterio    String
  /// Juicios que el modelo dio sin una cita que esté en la transcripción: se descartaron.
  descartados Int                      @default(0)
  error       String?
  /// La corrida (`AgentRun.id`), sin llave: la corrida puede limpiarse sin tocar el análisis.
  agentRunId  String?
  /// Quién lo pidió; null = lo analizó el job.
  pedidoPor   String?
  analizadoAt DateTime                 @default(now())
  /// S4 (2026-10-27): `ComentarioDelAnalisis[]` (lib/analizador-venta/revision.ts): el vendedor comenta o discrepa.
  comentarios        Json?
  /// S4: quién lo confirmó (una persona); null = sigue siendo propuesta. Volver a analizar lo borra.
  confirmadoPor      String?
  confirmadoAt       DateTime?
  notaDeConfirmacion String?
  /// S4: `string[]`, lo que la persona confirmó para la próxima sesión (sale de las recomendaciones y de lo sin explorar).
  paraLaProxima      Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([clientId])
}

enum EstadoDelAnalisisDeVenta {
  PROPUESTO
  ERROR
}

/// S1 (2026-10-26) · Una reunión marcada a mano como ejemplo de una reunión de venta consultiva. Se muestra al lado del
/// análisis para comparar; el agente NO la lee (es de otra empresa: invariante 1).
model ReunionDeReferenciaDeVenta {
  id         String           @id @default(cuid())
  sessionId  String           @unique
  session    FirefliesSession @relation("ReferenciaDeVenta", fields: [sessionId], references: [id], onDelete: Cascade)
  marcadaPor String
  nota       String?
  createdAt  DateTime         @default(now())
}

/// T5 (2026-10-25) · El audio de una reunión presencial: se sube a Google Cloud Storage y lo transcribe Speech-to-Text
/// de Google en lote. Una fila por reunión (subir otro reemplaza). Lo escribe SOLO lib/sessions/audio-de-reunion-server.ts,
/// detrás de REUNIONES_AUDIO=1. El texto termina en `FirefliesSession.transcript`, con la marca `aMano` (origen audio).
model AudioDeReunion {
  id          String           @id @default(cuid())
  sessionId   String           @unique
  session     FirefliesSession @relation("AudioDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  /// gs://bucket/objeto
  objeto      String
  archivo     String
  tipo        String
  bytes       Int
  estado      EstadoDelAudio   @default(SUBIENDO)
  /// El nombre de la operación de Speech-to-Text (projects/…/operations/…).
  operacion   String?
  error       String?
  minutos     Float?
  subidoPor   String
  terminadoAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([estado])
}

enum EstadoDelAudio {
  SUBIENDO
  TRANSCRIBIENDO
  LISTO
  ERROR
}

/// U3 (2026-10-25) · Qué dice la API de Meet de la conferencia de una reunión. SQL: scripts/sql/2026-10-25-google-meet-api.sql.
enum EstadoDeConferencia {
  OCURRIO
  NO_OCURRIO
  SIN_ACCESO
}

/// U3 (2026-10-25) · La transcripción por frases de una reunión, copiada de la API de Meet antes de que Google la borre (a
/// los 30 días): quién habló y cuándo. La escribe SOLO lib/google/conferencias.ts; la lectura de la reunión arma con ella
/// el texto cuando no había otro (lib/google/meet-enrichment.ts). Se borra en cascada con su reunión. RLS en su SQL.
model FraseDeReunion {
  id        String           @id @default(cuid())
  sessionId String
  session   FirefliesSession @relation("FrasesDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  orden     Int
  /// El nombre con el que entró a Meet.
  hablante  String
  /// Solo si es del equipo (el directorio traduce su id de Google); de los de fuera Meet no da el correo.
  correo    String?
  inicio    DateTime
  fin       DateTime?
  texto     String           @db.Text
  idioma    String?
  createdAt DateTime         @default(now())

  @@unique([sessionId, orden])
}

/// Ficha G (2026-10-17) · Lo que se hace con UNA reunión después de que ocurre: la agenda que escribió una persona, el
/// correo de seguimiento (lo arma el agente a pedido, lo manda una persona: Nexus no envía nada) y la próxima reunión
/// sugerida (la persona la agenda en Google Calendar por enlace: Nexus no escribe en el calendario). Cuelga de la
/// reunión y no del cliente: el dueño sale siempre de la reunión (`duenoDeLaSesion`), así una reunión que cambia de
/// dueño no deja nada colgado de otro cliente. Se lee y se escribe SOLO por lib/seguimiento/reunion.
model SeguimientoDeReunion {
  id        String           @id @default(cuid())
  sessionId String           @unique
  session   FirefliesSession @relation("SeguimientoDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)

  /// Lo que se iba a tratar, escrito por una persona (manda sobre la descripción del evento).
  agenda         String?   @db.Text
  agendaPorEmail String?
  agendaEn       DateTime?

  /// El correo de seguimiento: { asunto, cuerpo, para, en, corridaId, editado? } (lib/exploraciones/contenido › CorreoDeSeguimiento).
  correo Json?

  /// La próxima reunión sugerida: lo que escribió el agente con el correo (objetivo) y lo que cambió la persona.
  proximaTitulo      String?
  proximaObjetivo    String?   @db.Text
  proximaInicio      DateTime?
  proximaDuracionMin Int?
  /// null = pendiente · agendada (la persona dice que la guardó en su calendario) · descartada
  proximaEstado      String?
  proximaPorEmail    String?
  proximaEn          DateTime?

  /// Sube con cada escritura (para saber si la fila cambió).
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proximaEstado, proximaInicio])
}

// ─── Ciclo de reunión: Minuta + ActionItems ──────────────────────────────────
// Estos modelos encarnan el flujo del CSE:
//   1. La reunión sucede (FirefliesSession con transcript)
//   2. El agente Post-sesión genera SessionMinute (DRAFT) + ActionItems
//   3. El CSE revisa la minuta (DRAFT → REVIEWED) y trabaja las acciones
//   4. La siguiente sesión vuelve a iterar

enum MinuteStatus {
  DRAFT // generada por agente, esperando revisión del CSE
  REVIEWED // CSE la revisó y aceptó sin cambios
  EDITED // CSE la editó manualmente (también implica aceptada)
}

// DEPRECATED — sin escritores desde 2026-10-10 (memoria de la cuenta, etapa 2: los pendientes son tareas); eliminar
// después del 2027-04-01 o cuando ningún lector quede (ARCHITECTURE §2.9). Sin DROP: lo histórico se queda.
enum ActionStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
}

model SessionMinute {
  id        String           @id @default(cuid())
  sessionId String           @unique
  session   FirefliesSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Síntesis estructurada de la reunión
  summary    String @db.Text // resumen ejecutivo (1-2 párrafos)
  agreements Json? // [{ text, source? }]
  decisions  Json? // [{ text, rationale? }]
  risks      Json? // [{ text, severity? "low" | "med" | "high" }]
  topics     Json? // ["bullet 1", "bullet 2"]

  // Estado y trazabilidad
  status                MinuteStatus @default(DRAFT)
  generatedByAgentRunId String? // FK suave (no cascade) al AgentRun que la creó
  reviewedAt            DateTime?
  reviewedByEmail       String? // email del CSE que aceptó/editó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// DEPRECATED — sin escritores desde 2026-10-10 (memoria de la cuenta, etapa 2; DECISIONS «La lectura de cada reunión
// es durable…»): los compromisos de una reunión son propuestas de Tarea y los pendientes del proyecto se leen de Tareas.
// Solo lo escribe la copia congelada lib/sessions/post-process-viejo.ts (el retroceso de SEGUIMIENTO_REUNIONES_ENABLED=0).
// Eliminar después del 2027-04-01 o cuando ningún lector quede (ARCHITECTURE §2.9). Sin DROP y sin borrar filas.
model ActionItem {
  id   String @id @default(cuid())
  text String @db.Text

  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sessionId String?
  session   FirefliesSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Asignación y plazos
  ownerEmail        String?
  dueDate           DateTime?
  // QUIÉN se comprometió (2026-10-02): el análisis post-sesión captura también los compromisos del
  // CLIENTE («Rodrigo entrega la base el miércoles»), que no tienen correo del equipo. `ownerEmail`
  // sigue siendo solo para gente de Smarteam. Lado: "CLIENTE" | "SMARTEAM".
  ladoResponsable   String?
  responsableNombre String?
  // El fragmento de la reunión que sostiene el compromiso (interno, nunca al cliente).
  cita              String?      @db.Text
  status            ActionStatus @default(PENDING)
  done              Boolean      @default(false)

  // Trazabilidad de origen
  source                String? // "agent:post-session" | "agent:sales-analysis" | "manual" | "legacy" | "agent:client-analyze"
  generatedByAgentRunId String? // FK suave al AgentRun que lo creó

  // Soft-delete: borrar una tarea NO la elimina; setea deletedAt para que siga
  // visible en el "Histórico" del modal de pendientes (tareas hechas o borradas).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, done])
  @@index([projectId, done])
  @@index([projectId, deletedAt])
  @@index([sessionId])
  @@index([ownerEmail, done])
  @@index([dueDate])
}

// Un pedido que salió en una reunión y no está en lo vendido (2026-10-02). Lo detecta el análisis
// post-sesión, que lee el transcript completo; el CSE decide qué es (cotizar, ya incluido,
// descartar) y Ventas lo ve como oportunidad. ⛔ Nunca cruza a un documento del cliente.
// La huella identifica el pedido entre reuniones: el mismo pedido dicho dos veces es UNA fila.
model PedidoFueraDeAlcance {
  id           String            @id @default(cuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sessionId    String?
  session      FirefliesSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  huella       String
  pedido       String            @db.Text
  quienLoPidio String?
  // PEDIDO (por revisar: lo detectó Nexus) | CONFIRMADO (el CSE confirmó que está fuera de lo vendido)
  // | COTIZADO | APROBADO | RECHAZADO (el cliente no la tomó) | DESCARTADO | INCLUIDO (ya estaba en lo
  // vendido). Las reglas: lib/sessions/solicitudes-fuera-de-alcance.ts.
  estado       String            @default("PEDIDO")
  monto        String?
  cita         String?           @db.Text
  decididoPor  String?
  decididoAt   DateTime?
  // El seguimiento (2026-10-07): la nota del CSE, cada cambio con quién y cuándo, y quién la sumó a
  // mano (null = la detectó la lectura de una reunión).
  nota         String?           @db.Text
  historial    Json?
  creadoPor    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([clientId, huella])
  @@index([projectId, estado])
}

// Lo que una persona carga A MANO de las licencias de HubSpot de un cliente (2026-10-02). HubSpot
// Partner ya trae plan, renovación y monto por hub (ClientPartnerSnapshot.properties); esto guarda
// la fecha de COMPRA (HubSpot no la tiene) y completa lo que falta en las cuentas que Smarteam no
// administra. Ver lib/cs/licencias.ts. Un registro por cliente y hub.
model LicenciaCliente {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // marketing | sales | service | content | operations | commerce
  hub             String
  plan            String?
  fechaCompra     DateTime?
  fechaRenovacion DateTime?
  montoMensual    Float?
  moneda          String?
  nota            String?   @db.Text
  actualizadoPor  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clientId, hub])
}

// ─── SessionProject — pivote N:N entre FirefliesSession y Project ─────────────
// Una sesión puede tocar múltiples proyectos del mismo cliente (ej. una reunión
// de "alineación general" que cubre marketing + ventas). isPrimary indica el
// proyecto principal donde se ve la minuta/cards/acciones por defecto.
// source: "agent" (clasificador automático) | "manual" (CSE) | "legacy" (migración).

model SessionProject {
  id        String           @id @default(cuid())
  sessionId String
  session   FirefliesSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  isPrimary                Boolean  @default(false)
  source                   String   @default("agent") // "agent" | "manual" | "legacy"
  confidence               Float? // 0..1, solo si source="agent"
  rationale                String?  @db.Text // por qué la IA lo asignó
  // Override del humano para el HANDOFF, independiente del filtro automático (título de
  // venta/handoff/kickoff o Ventas en la sala): null = seguí la regla; true = forzá
  // incluir (agregada a mano desde el pop-up); false = forzá excluir (la "X" del panel).
  handoffOverride          Boolean?
  // La ELECCIÓN del CSE para el CRONOGRAMA (2026-09-23, «Contexto del cronograma»): true = la
  // eligió y alimenta al cronograma; null = no elegida (la X escribe null); false = la X de la
  // primera versión, vale igual que null. Sacarla no la saca del proyecto, del handoff, de la
  // Entrega ni de las minutas. La regla vive en lib/timeline/session-feeding.ts. ⚠ true lockea el
  // link contra el clasificador (session-project-locks.ts); null y false no.
  timelineOverride         Boolean?
  // «Contexto del diagnóstico» (2026-09-28). A diferencia del cronograma, arranca SUGERIDO: null =
  // alimenta si es una reunión CON EL CLIENTE · true = agregada a mano · false = la X (sale SOLO del
  // diagnóstico). La regla vive en lib/sessions/destinos-de-contexto.ts. ⚠ true lockea el link contra
  // el clasificador (session-project-locks.ts); null y false no, por la misma razón que el cronograma.
  diagnosisOverride        Boolean?
  // Lo mismo para la PLANIFICACIÓN y la EJECUCIÓN (2026-09-29): cada documento su propio afinado,
  // con la misma regla sugerida. Sacar una reunión de uno no la saca del otro.
  planningOverride         Boolean?
  implementationOverride   Boolean?
  // Lo mismo para el KICKOFF, la EXPLORACIÓN, INTEGRACIONES y la ENTREGA (2026-10-07, «el contexto
  // adicional es de cada artefacto»). SQL: scripts/sql/2026-10-07-contexto-de-cada-documento.sql.
  // ⚠ Desde la etapa 7 de la memoria de la cuenta (2026-10-10) los seis documentos (diagnóstico,
  // planificación, ejecución, kickoff, integraciones y entrega) leen SOLO las elegidas: true = la
  // eligió una persona («Usar»); false = la descartó; null = nadie la eligió y no entra. Ya no
  // arrancan sugeridos (lib/sessions/destinos-de-contexto.ts).
  kickoffOverride          Boolean?
  // DEPRECATED — eliminar después de correr scripts/migrar-guia-de-exploracion.ts y retirar
  // lib/guia-exploracion. La exploración son sus sesiones (etapa A, 2026-10-09) y ya no lee esta
  // columna; sigue declarada y sin DROP (DECISIONS «La exploración son sus sesiones»).
  explorationOverride      Boolean?
  techRequirementsOverride Boolean?
  deliveryOverride         Boolean?
  /// L5 etapa 2 (2026-10-25): con qué EQUIPO del cliente fue la reunión, en este proyecto (las claves de
  /// lib/exploraciones/equipos.ts). null = sin equipo. Las sesiones de una exploración lo llevan en su sesión; esto es
  /// para las demás (la entrega de servicio). Lo escribe solo lib/sessions/equipo-de-la-reunion-server.ts.
  /// SQL: scripts/sql/2026-10-25-smartloop.sql.
  equipoDeLaReunion        String?

  generatedByAgentRunId String? // FK suave al AgentRun del clasificador
  createdAt             DateTime @default(now())

  // ── Membresía de contexto (plan "contexto por proyecto", 2026-07-10) ──
  // included: LA verdad de "¿esta sesión alimenta este proyecto?" que respetan
  // TODOS los consumidores (handoff/cronograma/entregas/minutas vía chokepoints).
  // false = excluida por un humano — TOMBSTONE durable: la fila queda como memoria
  // para que el clasificador IA no re-proponga el link (un DELETE sí se re-crearía).
  // handoffOverride sigue siendo el único afinado POR CONSUMIDOR (solo handoff):
  // "¿es de este proyecto?" ≠ "¿cuenta la historia de venta?".
  included   Boolean   @default(true)
  // Confirmación humana del link (IA propone, CSE confirma). Un link con reviewedAt
  // NUNCA es modificado/borrado por el clasificador (lock por link, no por sesión).
  reviewedAt DateTime?
  reviewedBy String? // email de quien curó

  @@unique([sessionId, projectId])
  @@index([projectId, isPrimary])
  @@index([sessionId])
}

// ─── Snapshot del análisis de participantes por proyecto (F5) ─────────────────
// Generado periódicamente por agent-participants-analyzer. Sobreescribible.

model ProjectParticipantSnapshot {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stats                 Json // { clientSponsorAttendance, lastSeenByRole, averageHeadcount, ... }
  sessionsAnalyzed      Int     @default(0)
  generatedByAgentRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Canvas Suggestions (aprobación de cambios al Client Canvas) ─────────────

// DEPRECATED — nadie crea ni lee sugerencias desde la Etapa 0 de la memoria (2026-10-09); solo la fusión de
// empresas mueve las filas viejas. Eliminar después de 2026-12-31
model CanvasSuggestion {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentRunId     String?
  section        String // key del canvas: "perfil", "stakeholders", etc.
  field          String? // campo específico dentro de la sección (para sugerencias granulares)
  current        Json? // valor actual de la sección al momento de la sugerencia
  suggested      Json // valor sugerido por el agente
  suggestedValue String?  @db.Text // valor sugerido como texto (alternativa a JSON)
  status         String   @default("pending") // pending | accepted | rejected
  source         String? // de dónde viene: "run:ID", "fireflies:TITLE", "manual"
  sourceLabel    String? // label legible: "Análisis inicial · 24 mar", "Sesión kickoff UCI"
  createdAt      DateTime @default(now())

  @@index([clientId, status])
}

// ─── SessionCategory — agrupación administrable de sesiones por dominio ──────
// Sirve para categorizar sesiones de Google Meet / Fireflies por el dominio
// de sus participantes (ej: "Interna" = @smarteamcr.com, "Partner HubSpot" = @hubspot.com).
// Los matching de Client.emailDomains tienen prioridad — esto categoriza el RESTO.

model SessionCategory {
  id        String   @id @default(cuid())
  name      String   @unique // "Interna", "Partner HubSpot", "Partner AtomChat"
  slug      String   @unique // "interna", "partner-hubspot" (URL-safe)
  domains   String[] // ["smarteamcr.com"], ["hubspot.com", "hubspotcr.com"]
  kind      String   @default("custom") // "internal" | "partner" | "custom" — semántica para UI/orden
  color     String? // hex (#94A3B8) para tag visual en sidebar
  order     Int      @default(0) // orden de aparición en sidebar
  isDefault Boolean  @default(false) // las default no se pueden eliminar (sí editar)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// MARKETING + CONTENIDO — módulo single-tenant (equipo Smarteam; NADA cuelga de
// Client). Insumos curados (ICP, personas, pilares, fuentes, voz) + posts de
// inspiración scrapeados de LinkedIn + salidas del agente (ideas/campañas/
// sugerencias de pilar) + corridas (ingesta/generación) + lock del cron semanal.
// ═══════════════════════════════════════════════════════════════════════════════

enum IcpSection {
  FIRMOGRAFICA_DESCRIPTOR // Firmográfica — descriptores
  FIRMOGRAFICA_INDUSTRIA // Firmográfica — industrias con validación real
  BEHAVIORAL_REVENUE // Behavioral — revenue intelligence
  BEHAVIORAL_CANALES // Behavioral — canales y comportamiento
  BEHAVIORAL_ORG // Behavioral — la organización
  BEHAVIORAL_DECISION // Behavioral — estructura de decisión
  SIGNAL_ANTI // Señales — Anti-ICP
  SIGNAL_FUERTE // Señales fuertes
  SIGNAL_MEDIA // Señales medias
  SIGNAL_DEBIL // Señales débiles
}

enum PillarOrigin {
  HUMAN // creado a mano por el equipo
  AGENT // nació de una PillarSuggestion aprobada
}

enum MarketingApprovalStatus {
  PENDING
  APPROVED
  DISCARDED
}

enum CampaignChannel {
  GOOGLE_SEARCH
  PAID_SOCIAL
  DISPLAY
  OTHER
}

enum MarketingRunKind {
  INGEST // solo scraping de fuentes
  GENERATE // solo agente de generación (sobre lo guardado)
  CHAIN // ingesta → generación (si hubo posts nuevos)
}

enum MarketingPostType {
  EMPRESA // post institucional de la página de Smarteam — escueto
  PERSONA // post de marca personal / social selling — largo, con storytelling
}

// Etapa del viaje semanal de Smarteam (guía de contenido de EMPRESA):
// Conciencia (dolor/atraer) → Estrategia (solución/educar) → Inspiración (futuro/convencer).
enum MarketingJourneyStage {
  CONCIENCIA // 🔴 Lun/Mar — dolor: caos operativo, datos aislados, tareas repetitivas, gestión del cambio
  ESTRATEGIA // 🟡 Mié/Jue — solución: transformación comercial, RevOps, arquitectura de datos, conexión de sistemas
  INSPIRACION // 🟢 Vie — futuro: IA aplicada a revenue, ROI, automatización, AEO
}

enum MarketingUsageTarget {
  PERSONAL // la usó en sus propias redes (perfil personal de quien la aceptó)
  SMARTEAM // la usó para la página/marca de Smarteam
}

enum MarketingRunTrigger {
  MANUAL // CTA en /contenido
  CRON // viernes 6:00 America Costa Rica
}

enum MarketingRunStatus {
  RUNNING
  DONE
  ERROR
}

// Config singleton del módulo (id="marketing"): voz de marca + lock del cron.
model MarketingSettings {
  id               String    @id @default("marketing")
  brandVoice       String    @db.Text // voz/posicionamiento (markdown) — editable en /marketing/voz
  // Objetivo de piezas por tanda de generación (el mini-form de /marketing/generacion los
  // escribe; buildGenerationInput y el cron los leen — fuente única). Objetivo, no mínimo:
  // el prompt prioriza calidad. 9+6=15 ≈ el ~60/40 histórico.
  genEmpresaTarget Int       @default(9) // piezas para la PÁGINA de empresa (postType=EMPRESA)
  genPersonaTarget Int       @default(6) // piezas para PERFIL personal (postType=PERSONA)
  lastCronRunAt    DateTime? // nullable porque nunca corrió — display en /contenido
  lastCronDateKey  String? // nullable ídem — "YYYY-MM-DD" (día CR) del último disparo; claim atómico anti-doble-fire
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Ítem del ICP (migrado del hardcode de app/icp/ICPSection.tsx). 1 fila = 1 bullet.
model IcpItem {
  id        String     @id @default(cuid())
  /// R13 (2026-10-25) — la empresa que usa Nexus (hoy Smarteam) de la que es este cliente ideal. nullable porque las
  /// filas de antes nacieron sin ella (las llena scripts/cargar-perfil-de-smarteam.ts) y SET NULL si se borra la ficha.
  clientId  String?
  client    Client?    @relation("ClienteIdealDeLaEmpresa", fields: [clientId], references: [id], onDelete: SetNull)
  section   IcpSection
  label     String     @db.Text
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([section, order])
  @@index([clientId])
}

// Buyer persona — insumo curado que alimenta al agente de generación.
model BuyerPersona {
  id          String   @id @default(cuid())
  /// R13 (2026-10-25) — la empresa que usa Nexus de la que es esta buyer persona. nullable ídem IcpItem.
  clientId    String?
  client      Client?  @relation("BuyerPersonasDeLaEmpresa", fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  role        String? // nullable porque el cargo/segmento puede cargarse después
  description String   @db.Text // quién es, contexto (markdown)
  pains       String?  @db.Text // nullable porque se carga incremental
  goals       String?  @db.Text // nullable ídem
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([clientId])
}

// Pilar de contenido (tema/enfoque). Los AGENT nacen al aprobar una PillarSuggestion.
model ContentPillar {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?      @db.Text // nullable porque un pilar puede ser solo un nombre al alta
  origin      PillarOrigin @default(HUMAN)
  active      Boolean      @default(true)
  isCampaign  Boolean      @default(false) // énfasis de campaña: sesga la generación hacia este tema (activa = isCampaign && active)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ideas      ContentIdea[]
  suggestion PillarSuggestion?
}

// Fuente de inspiración: perfil público de LinkedIn (se scrapea vía InspirationProvider).
model InspirationSource {
  id             String    @id @default(cuid())
  profileUrl     String    @unique
  label          String? // nullable porque al alta a veces solo hay URL
  active         Boolean   @default(true)
  lastFetchedAt  DateTime? // nullable hasta la primera ingesta
  lastFetchError String?   @db.Text // nullable = última ingesta OK; error del provider si falló
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  posts InspirationPost[]

  @@index([active])
}

// Post scrapeado de una fuente. Dedup por externalId. "Archivado" NO es campo:
// la generación filtra postedAt >= hoy-3 meses; lo viejo queda fuera del contexto.
model InspirationPost {
  id           String            @id @default(cuid())
  sourceId     String
  source       InspirationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String            @unique // id/URN del post en LinkedIn — DEDUP KEY
  url          String? // nullable porque algunos actors no devuelven permalink
  authorName   String? // nullable ídem
  text         String            @db.Text
  likeCount    Int               @default(0)
  commentCount Int               @default(0)
  repostCount  Int               @default(0)
  hasImage     Boolean           @default(false)
  postedAt     DateTime
  fetchedAt    DateTime          @default(now())

  ideaSources ContentIdeaSource[]

  @@index([postedAt])
  @@index([sourceId, postedAt])
}

// Corrida del módulo (ingesta/generación/cadena). Modelo PROPIO: AgentRun exige
// clientId (NOT NULL) y esto es single-tenant. Trazabilidad estilo regla 6.5.
model MarketingRun {
  id                     String              @id @default(cuid())
  kind                   MarketingRunKind
  trigger                MarketingRunTrigger @default(MANUAL)
  status                 MarketingRunStatus  @default(RUNNING)
  phase                  String? // nullable cuando terminó — copy de progreso ("ingesta 3/8")
  newPostsCount          Int? // nullable hasta terminar la ingesta — posts NUEVOS post-dedup
  fetchedPostsCount      Int? // total traído del provider
  sourcesOkCount         Int?
  sourcesErrorCount      Int?
  contentIdeasCount      Int? // nullable hasta terminar la generación
  campaignIdeasCount     Int?
  pillarSuggestionsCount Int?
  error                  String?             @db.Text // mensaje REAL cuando status=ERROR
  rawOutput              String?             @db.Text // JSON crudo de Claude (backup/debug)
  startedByEmail         String? // nullable porque el CRON no tiene usuario
  createdAt              DateTime            @default(now())
  finishedAt             DateTime?

  contentIdeas      ContentIdea[]
  campaignIdeas     CampaignIdea[]
  pillarSuggestions PillarSuggestion[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

// Idea de contenido generada — salida NO-CRUD: se revisa y se PODA (DELETE).
// Registro estructurado por campo para migrar a HubSpot copiando campo a campo.
model ContentIdea {
  id                  String                 @id @default(cuid())
  runId               String? // nullable porque la idea sobrevive si se borra la corrida
  run                 MarketingRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  pillarId            String? // nullable porque puede referir a un pilar SUGERIDO aún no aprobado
  pillar              ContentPillar?         @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  suggestedPillarName String? // nullable — nombre del pilar NUEVO propuesto; se linkea al aprobar
  title               String
  copy                String                 @db.Text // copy listo para red social
  imageConcept        String                 @db.Text // descripción TEXTUAL del concepto de imagen (no se genera)
  postType            MarketingPostType      @default(EMPRESA) // empresa (escueto) | persona (storytelling)
  journeyStage        MarketingJourneyStage? // nullable porque solo aplica a posts de EMPRESA (guía semanal); los de PERSONA no tienen etapa
  acceptedByEmail     String? // nullable porque solo se setea al aceptar — email del guard (patrón Cobro); un solo uso por publicación
  acceptedFor         MarketingUsageTarget? // nullable porque solo se setea al aceptar — PERSONAL | SMARTEAM (destino efectivo lo decide el server)
  selectedAt          DateTime? // nullable porque la idea arranca sugerida; set = "seleccionada"/"aceptada" (en trabajo) — timestamp de la aceptación
  usedAt              DateTime? // nullable; set = "aprobada" (lista para publicar). Estado derivado, ver lib/marketing/schema.ts ideaState()
  discardedAt         DateTime? // nullable; set = "descartada" (rechazada, reversible). Gana sobre selected/used → reabrir vuelve al estado previo
  hubspotDraftAt      DateTime? // nullable; set = ya se envió a HubSpot como borrador social (API broadcast). Ver lib/hubspot/social-broadcast.ts
  hubspotDraftGuids   String[]               @default([]) // broadcastGuid(s) de los borradores creados en HubSpot (uno por canal)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt // rastrea la edición manual/IA del copy (default cubre filas existentes)

  sources ContentIdeaSource[]

  @@index([pillarId])
  @@index([createdAt])
}

// Pivote idea ↔ posts que la inspiraron (el agente nunca inventa fuentes).
model ContentIdeaSource {
  id     String          @id @default(cuid())
  ideaId String
  idea   ContentIdea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  postId String
  post   InspirationPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([ideaId, postId])
}

// Idea de campaña (PPC / Google Search) — aprobable / descartable.
model CampaignIdea {
  id          String                  @id @default(cuid())
  runId       String? // nullable porque sobrevive a la corrida
  run         MarketingRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  title       String
  channel     CampaignChannel
  description String                  @db.Text // objetivo, audiencia, ángulo, keywords si aplica
  status      MarketingApprovalStatus @default(PENDING)
  reviewedAt  DateTime? // nullable hasta aprobar/descartar
  createdAt   DateTime                @default(now())

  @@index([status, createdAt])
}

// Sugerencia de pilar NUEVO del agente. PENDING → approve (crea ContentPillar) / discard.
model PillarSuggestion {
  id               String                  @id @default(cuid())
  runId            String? // nullable porque sobrevive a la corrida
  run              MarketingRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  name             String
  description      String?                 @db.Text
  rationale        String?                 @db.Text // evidencia del agente (posts/insumos que lo motivan)
  status           MarketingApprovalStatus @default(PENDING)
  approvedPillarId String?                 @unique // nullable hasta aprobar — FK al pilar creado
  approvedPillar   ContentPillar?          @relation(fields: [approvedPillarId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())

  @@index([status])
}

// ─── Éxito del cliente (módulo CS) ───────────────────────────────────────────
// Panel /exito-cliente: eventos crudos del cronograma (cola del watchdog),
// alertas triadas por el agente, snapshot de señales HubSpot por cliente, y
// estado de jobs del scheduler. TODO ADITIVO (regla dual-PC).

// Qué entidad del cronograma cambió.
enum CsEventEntity {
  TIMELINE
  PHASE
  TASK
}

// Qué pasó. STATUS_CHANGED cubre suspender (→SUSPENDED); MOVED = cambio de
// semana/orden material; EDITED = otros campos (título, party, type, fechas).
enum CsEventAction {
  STATUS_CHANGED
  CREATED
  DELETED
  MOVED
  EDITED
  ANCHOR_CHANGED
  PROGRESS_APPLIED
  TIMELINE_DELETED
  DETAIL_DELETED
}

// Desde qué superficie se mutó (para que el watchdog distinga edición humana
// granular, guardado bulk del editor, apply de propuesta IA y apply de avance).
enum CsEventSource {
  UI_PATCH
  UI_PUT
  AI_ASSIST_APPLY
  PROGRESS_APPLY
  SYSTEM // mutación automática del sistema (ej. re-anclaje al Kick Off real) — agregado AL FINAL (aditivo)
}

enum CsAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum CsAlertCategory {
  TIMELINE_OVERDUE
  TASK_MODIFICATION
  SESSION_MISSED
  PIPELINE_MISMATCH
  ENGAGEMENT_COLD
  SUPPORT_TICKETS
  RENEWAL_RISK
  CHURN_RISK
  EXPANSION_OPPORTUNITY
  PROACTIVE_ACTION
  OTHER
  // CS360 (agregados AL FINAL — ADD VALUE es aditivo, jamás reordenar):
  ADOPTION_RISK // uso bajo / tendencia negativa / adopción baja
  LICENSE_UNUSED // licencias pagadas sin asignar
  PROJECT_BLOCKED // proyecto bloqueado/atrasado según HubSpot (hs_status + motivo)
  // Ciclo de vida:
  STAGE_STALLED // etapa temprana estancada (kickoff sin publicar / cronograma sin consensuar / entendimiento sin cerrar)
  // Éxito del cliente, 2026-10-09 (ADD VALUE, al final):
  QUEJA // el cliente se quejó en una reunión o un correo; con la frase literal verificada pinta el color
}

enum CsAlertStatus {
  OPEN
  SEEN
  RESOLVED
  DISMISSED
}

// Evento CRUDO de mutación del cronograma — lo emiten los endpoints de timeline
// (helper lib/cs/timeline-events.ts). NO reemplaza a TimelineChange (auditoría
// D.3 por snapshot con reason): esto es la COLA del watchdog, granular y barata.
// label denormalizado → el evento se entiende aunque la tarea/fase se haya borrado.
model TimelineEvent {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId   String // denormalizado: triage por cliente sin join
  timelineId String? // sin FK dura: el timeline puede borrarse y el evento debe sobrevivir
  entityType CsEventEntity
  entityId   String? // id de la tarea/fase (puede ya no existir)
  label      String // título de tarea / nombre de fase al momento del cambio
  action     CsEventAction
  before     Json? // SOLO los campos que cambiaron (compacto)
  after      Json?
  actorEmail String? // del guard (quién lo hizo)
  source     CsEventSource
  createdAt  DateTime      @default(now())

  // Cola del watchdog: null = pendiente de triage. processedByRunId se setea
  // primero (claim atómico por updateMany); processedAt al cerrar el run.
  processedAt      DateTime?
  processedByRunId String?

  @@index([projectId, processedAt])
  @@index([createdAt])
}

// Alerta TRIADA por el watchdog (agent-cs-watchdog) para la líder de CS.
// El agente decide severidad + razón; el runner deduplica por dedupeKey
// (OPEN/SEEN existente → occurrences++/lastDetectedAt, no fila nueva).
model CsAlert {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String? // null = alerta a nivel cliente (frialdad, renovación)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  severity        CsAlertSeverity
  category        CsAlertCategory
  title           String
  reason          String          @db.Text // el "por qué" del agente
  suggestedAction String?         @db.Text // acción proactiva propuesta (expansión, rescate…)
  evidence        Json // { eventIds?, taskIds?, dealIds?, sessionIds?, … } para drill

  // Dedup (lo aplica el runner en código; index no-unique a propósito: una
  // alerta RESUELTA vieja puede reaparecer como fila nueva).
  dedupeKey       String
  occurrences     Int      @default(1)
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())

  // Ciclo de vida en el feed.
  status          CsAlertStatus @default(OPEN)
  seenAt          DateTime?
  seenByEmail     String?
  resolvedAt      DateTime?
  resolvedByEmail String?
  /// Qué se hizo, en una línea (opcional). La escribe quien la resuelve o descarta, o «sistema».
  resolutionNote  String?       @db.Text

  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, lastDetectedAt])
  @@index([clientId, status])
  @@index([dedupeKey, status])
}

// Snapshot/cache de señales HubSpot por cliente (1:1). Los Json guardan el crudo
// procesado; los escalares habilitan sort/filtros del panel sin parsear Json.
model ClientCsSignals {
  id          String   @id @default(cuid())
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fetchedAt   DateTime @default(now())
  fetchStatus String   @default("ok") // ok | partial | error
  errors      Json? // detalle por señal cuando fetchStatus != ok

  deals      Json? // { open: [...], renewals: [...], expansion: [...] }
  engagement Json? // { lastAt, counts30d/90d, lastItems: [...] }
  tickets    Json? // { supported, open: [...], recent: [...] }

  lastEngagementAt    DateTime?
  engagements90d      Int?
  openTicketCount     Int?
  ticketsSupported    Boolean   @default(false) // false = scope no autorizado (degradación)
  nextRenewalCloseAt  DateTime?
  openExpansionAmount Float?
  openDealCount       Int?

  updatedAt DateTime @updatedAt
}

// CS360 — snapshot del objeto PARTNER CLIENTS de HubSpot (portal de Smarteam como
// Solutions Partner): uso/adopción por hub, licencias, MRR, renovaciones, equipo de
// HubSpot asignado. La clave natural es el record de HubSpot (existe ANTES del match
// con Client); clientId se llena al matchear por Associated Company ID o dominio.
// `properties` guarda el crudo COMPLETO (tolerancia a internal names); los escalares
// se completan desde las properties confirmadas y alimentan charts/sorts sin parsear Json.
// ⚠ El scope del objeto NO está autorizado hoy (403) — el sync degrada con supported:false
// y todo arranca solo al re-autorizar la app OAuth (contrato ticketsSupported).
model ClientPartnerSnapshot {
  id                     String   @id @default(cuid())
  hubspotPartnerClientId String   @unique // id del record partner_clients en HubSpot
  clientId               String?  @unique // null = huérfano transitorio (pre-match)
  client                 Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fetchedAt              DateTime @default(now())
  fetchStatus            String   @default("ok") // ok | partial
  properties             Json // crudo completo del record

  domain                 String?
  associatedCompanyIds   String[]  @default([])
  uusScore               Float? // Calificación de uso unificada (UUS)
  // Tendencia últimas 4 semanas. Float directo: sondeado contra los 157 records reales
  // (2026-07-10) — todos los valores no vacíos de hs_last_4_weeks_usage_score_trend son
  // números planos (-0.18…0.01). Tipo endurecido con la tabla en 0 filas (sin migración).
  uusTrend               Float?
  // Componentes del UUS: el portal NO los expone (0 de 172 properties, verificado
  // 2026-07-10). Las columnas quedan por si HubSpot los agrega; hoy siempre null.
  activationScore        Float? // binario 0/100: ¿usó las herramientas core en los primeros 3 meses?
  toolUsageScore         Float? // 0-100: uso activo vs empresas similares
  valueMetricsScore      Float? // 0-100: resultados (deals, contactos, tráfico)
  consumptionScore       Float? // 0-100: consumo de lo pagado (seats/contactos vs límite)
  marketingScore         Float?
  salesScore             Float?
  serviceScore           Float?
  commerceScore          Float?
  seats                  Json? // { core|sales|service: { assigned, available, limit } }
  marketingContactsLimit Int?
  marketingContactsUsed  Int?
  mrrTotal               Float?
  mrrManaged             Float?
  mrrUpForRenewal        Float?
  nextRenewalAt          DateTime?
  renewalsByHub          Json? // { marketing|sales|service|ops: fecha }
  managedExpiryAt        DateTime? // caducidad estimada de la relación gestionada
  cancellationHubs       String? // hubs de próxima cancelación (señal de churn)
  revenueSignal          String? // señal de ingresos (ej. "Límite de créditos")
  revenueSignalDetail    String?   @db.Text // explicación de la señal
  hubEditions            Json? // { marketing|sales|service|ops|content|commerce: edition }
  activeProducts         String? // todos los productos activos
  hsCsmName              String? // Customer Success Manager de HubSpot
  hsCsmEmail             String?
  hsGrowthName           String? // especialista en crecimiento de HubSpot
  hsGrowthEmail          String?
  cslImplementaciones    String? // custom "CSL | Implementaciones"
  country                String?
  portalLink             String? // hs_account_link: deep-link al portal del cliente en HubSpot
  // ── U29 (2026-10-25): a columnas lo que estaba suelto en `properties` ─────────
  // Lo vendido, las fechas de la relación, la comisión y el MRR por hub. Los llena la copia
  // (lib/cs/partner-columnas.ts); los registros de antes los llena scripts/partner-columnas.ts.
  isManaged                  Boolean? // hs_is_managed: Smarteam gestiona la cuenta
  isSold                     Boolean? // hs_is_sold: Smarteam la vendió
  soldMrr                    Float? // hs_sold_mrr: el MRR vendido (la base de la comisión)
  soldProductLines           String? // hs_sold_product_lines: «sales_hub;marketing_hub»
  soldRelationshipStartAt    DateTime? // hs_sold_relationship_start_date
  soldRelationshipEndAt      DateTime? // hs_sold_relationship_end_date
  relationshipStartAt        DateTime? // hs_relationship_start_date
  relationshipEndAt          DateTime? // hs_relationship_end_date
  managedRelationshipStartAt DateTime? // hs_managed_relationship_start_date
  managedRelationshipEndAt   DateTime? // hs_managed_relationship_end_date
  // La comisión que HubSpot proyecta para la cuenta. Es MENSUAL: el 20 % del MRR vendido
  // (medido el 2026-10-24 en las 44 cuentas con comisión). La lee lib/cobranza/comision-hubspot.ts.
  projectedCommission        Float?
  projectedCommissionCurrency String?
  projectedCommissionAt      DateTime? // hs_projected_commission_calculated_at
  mrrByHub                   Json? // { marketing|sales|service|operations|content|commerce|addOns|seats: monto }

  updatedAt DateTime @updatedAt
}

// CS360 — HISTORIAL semanal de uso por partner client (el UUS se recalcula
// semanalmente en HubSpot): una fila por (record, semana ISO) — el sync diario
// upsertea la fila de la semana en curso, así queda la última foto de cada semana.
// Permite calcular tendencia PROPIA (subiendo/bajando/estancado) más allá del
// campo de tendencia que reporta HubSpot. CONFIDENCIAL (términos de partner):
// solo superficies internas CSL/SUPER_ADMIN, jamás vistas externas del cliente.
model PartnerUsageSnapshot {
  id                     String    @id @default(cuid())
  hubspotPartnerClientId String // record de partner_clients (sin FK dura)
  clientId               String? // denormalizado al momento de la captura
  weekKey                String // "YYYY-Www" (semana ISO)
  capturedAt             DateTime  @default(now())
  uusScore               Float?
  activationScore        Float?
  toolUsageScore         Float?
  valueMetricsScore      Float?
  consumptionScore       Float?
  marketingScore         Float?
  salesScore             Float?
  serviceScore           Float?
  marketingContactsUsed  Int?
  marketingContactsLimit Int?
  seats                  Json?
  mrrTotal               Float?
  nextRenewalAt          DateTime?
  // U29 (2026-10-25): la comisión y el MRR también semana a semana, para comparar el estimado
  // de cada trimestre con lo que HubSpot terminó pagando.
  isManaged              Boolean?
  mrrManaged             Float?
  soldMrr                Float?
  projectedCommission    Float?
  mrrByHub               Json?

  @@unique([hubspotPartnerClientId, weekKey])
  @@index([clientId, weekKey])
}

// CS360 — resumen ejecutivo POR CUENTA generado por agente (agent-cs-account-brief,
// prompt en DB). Cada statement CITA su fuente con fecha ("Minuta kickoff · 2 jul",
// "HubSpot Partner · hoy") — regla dura: sin fuente no hay afirmación. staleAt lo
// marca el partner-sync cuando cambian los inputs; la regeneración es on-demand.
model CsAccountBrief {
  id          String    @id @default(cuid())
  clientId    String    @unique
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  headline    String?   @db.Text // una línea: el estado de la cuenta
  statements  Json // [{ text, source: { kind, id, label, date } }]
  agentRunId  String? // AgentRun que lo generó (trazabilidad)
  generatedAt DateTime  @default(now())
  staleAt     DateTime? // inputs cambiaron después de generar → banner "desactualizado"
  updatedAt   DateTime  @updatedAt
}

// Resumen citado de UN PROYECTO. Espejo de CsAccountBrief, un nivel más abajo: aquél
// responde «cómo va la CUENTA», éste «cómo va ESTE proyecto» — que es la pregunta que
// se hace el CSE todos los días y que hoy solo se puede contestar leyendo cinco pestañas.
//
// Acá viven los BLOQUEOS y las DESALINEACIONES del eje 2 de «los cuatro contextos»: son
// statements con su cita, propuestos por el agente. La cita NO es decorativa — la valida
// `lib/cs/brief-citas.ts` y una afirmación cuya fuente no existe se descarta.
//
// ⚠ `staleAt` no es «viejo por tiempo» sino «los inputs cambiaron después de generar»:
// una sesión nueva, un handoff regenerado, un cambio de etapa. Sin eso el resumen se ve
// fresco contando algo de hace tres semanas, que es peor que no tenerlo.
model ProjectBrief {
  id          String    @id @default(cuid())
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  headline    String?   @db.Text
  // El resumen en prosa que va ARRIBA de las afirmaciones: el recorrido del cliente y lo que
  // dice el handoff. Sin cita a propósito (es una síntesis, no un hecho puntual) y nullable:
  // los briefs anteriores al 2026-09-22 no lo tienen y la pantalla simplemente no lo pinta.
  narrativa   String?   @db.Text
  statements  Json // [{ text, source: { kind, id, label, date } }]
  agentRunId  String? // AgentRun que lo generó (trazabilidad)
  generatedAt DateTime  @default(now())
  staleAt     DateTime?
  updatedAt   DateTime  @updatedAt
}

// Config singleton del módulo CS (id="cs"). watchdogEnabled = kill-switch en DB
// (apagar el watchdog sin redeploy). El estado de cron vive en CronJobState.
// Los supuestos del cálculo de la carga de Customer Success (lib/carga/config.ts): capacidad, preparación por
// reunión, horas por tipo de fase, pesos del factor de complejidad, semáforo. Append-only: cada guardado es una fila
// nueva; la más reciente manda y las anteriores son la historia de quién cambió qué. Sin filas, rigen los de fábrica.
// SQL: scripts/sql/2026-10-06-config-carga.sql (RLS + deny).
model ConfigCarga {
  id        String   @id @default(cuid())
  valores   Json
  motivo    String?
  creadoPor String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// La FOTO del margen de cada mes cerrado (Rentabilidad, E6 de docs/rentabilidad-y-carga-plan.md, 2026-10-17). Lo que el
// cálculo en vivo decía de ese mes, el día que se tomó: Rentabilidad la lee para los meses cerrados (el vivo cambia con
// cada cobro tardío o supuesto recalibrado). La escribe SOLO lib/rentabilidad/foto-server.ts, con las mismas funciones
// de la pantalla (lib/rentabilidad/foto.ts). Una por mes; volver a tomarla reemplaza el mes entero. Todo en dólares.
// ⛔ Lleva planilla y el costo de la hora de cada persona: solo dirección (SUPER_ADMIN).
// SQL: scripts/sql/2026-10-17-foto-del-margen.sql (RLS + deny).
model FotoMargenMes {
  id                   String             @id @default(cuid())
  /// «2026-09»: el mes (hora de Costa Rica).
  mes                  String             @unique
  /// La forma de lo guardado (VERSION_DE_LA_FOTO).
  version              Int                @default(1)
  /// correo | "sistema"
  tomadaPor            String
  tomadaAt             DateTime           @default(now())
  /// nullable porque solo volver a tomarla pide un motivo.
  motivo               String?
  planilla             Decimal            @db.Decimal(12, 2)
  ingreso              Decimal            @db.Decimal(12, 2)
  horasPagadas         Decimal            @db.Decimal(10, 2)
  horasConClientes     Decimal            @db.Decimal(10, 2)
  horasCalendario      Decimal            @db.Decimal(10, 2)
  horasRespondidas     Decimal            @db.Decimal(10, 2)
  horasEstimadas       Decimal            @db.Decimal(10, 2)
  /// v2 (2026-10-18, docs/rentabilidad-conectada-plan.md): la parte de horasCalendario que no es de Meet.
  horasSinMeet         Decimal            @default(0) @db.Decimal(10, 2)
  /// v2: tareas internas por sus bloques en la agenda.
  horasTareas          Decimal            @default(0) @db.Decimal(10, 2)
  /// v2: la parte de horasEstimadas que es el estimado de una tarea interna sin bloque.
  horasTareasEstimadas Decimal            @default(0) @db.Decimal(10, 2)
  horasPorSesion       Decimal            @db.Decimal(10, 4)
  // nullable porque sin horas pagadas (o sin horas con clientes) no hay costo de la hora.
  costoHoraDirecto     Decimal?           @db.Decimal(12, 2)
  costoHoraCargado     Decimal?           @db.Decimal(12, 2)
  preparacionMin       Int
  /// { id, guardadaEn, guardadaPor }: la fila de ConfigCarga que rigió.
  supuestos            Json
  /// { crcPorUsd, fuente } del mes, o null.
  tasa                 Json?
  /// { personas: CostoDeUnaPersona[], equipos: CostoDeUnEquipo[] } (lib/rentabilidad/tipos.ts).
  costos               Json
  /// { conCosto, sinCosto, fuentes }
  personas             Json
  avisos               Json
  cuentas              FotoMargenCuenta[]
  updatedAt            DateTime           @updatedAt
}

/// Una cuenta en la foto de un mes. `clientId` SIN FK a propósito: es la foto del pasado y no cambia si la ficha se
/// fusiona o se borra (el nombre queda congelado). Lo declara lib/clients/fusion-de-empresas.ts › SE_QUEDAN_A_PROPOSITO.
model FotoMargenCuenta {
  id                String        @id @default(cuid())
  fotoId            String
  foto              FotoMargenMes @relation(fields: [fotoId], references: [id], onDelete: Cascade)
  mes               String
  clientId          String
  nombre            String
  // nullable porque una cuenta puede no tener CSE.
  cse               String?
  ingreso           Decimal       @db.Decimal(12, 2)
  /// Cobranza | Odoo | null
  fuenteIngreso     String?
  horasCalendario   Decimal       @db.Decimal(10, 2)
  horasPreparacion  Decimal       @db.Decimal(10, 2)
  horasEntrega      Decimal       @db.Decimal(10, 2)
  horasRespondidas  Decimal       @db.Decimal(10, 2)
  horasEstimadas    Decimal       @db.Decimal(10, 2)
  /// v2 (2026-10-18): la parte de horasCalendario que no es de Meet, y las tareas internas (las de la agenda y en total).
  horasSinMeet      Decimal       @default(0) @db.Decimal(10, 2)
  horasTareas       Decimal       @default(0) @db.Decimal(10, 2)
  horasTareasAgenda Decimal       @default(0) @db.Decimal(10, 2)
  reuniones         Int
  // nullable porque una cuenta sin cronograma en el mes no tiene plan.
  planSesiones      Decimal?      @db.Decimal(10, 2)
  planHorasTareas   Decimal?      @db.Decimal(10, 2)
  costoPersona      Decimal       @db.Decimal(12, 2)
  costoEquipo       Decimal       @db.Decimal(12, 2)
  costoCargado      Decimal       @db.Decimal(12, 2)
  margenPersona     Decimal       @db.Decimal(12, 2)
  margenEquipo      Decimal       @db.Decimal(12, 2)
  margenCargado     Decimal       @db.Decimal(12, 2)
  factor            Decimal       @db.Decimal(5, 2)
  /// [{ email, horas }]
  porPersona        Json

  @@unique([mes, clientId])
  @@index([clientId, mes])
  @@index([fotoId])
}

// ─── La rentabilidad conectada: la meta del año y la lectura de los números (2026-10-18) ──────────────────────────
// Iniciativa C de docs/roadmap.md; plan en docs/rentabilidad-conectada-plan.md. SQL:
// scripts/sql/2026-10-18-rentabilidad-conectada.sql (RLS + RESTRICTIVE). Solo dirección (guardCostosAccess).

/// La meta de facturación de un año. APPEND-ONLY: cada vez que dirección la define es una fila; la vigente es la última
/// de su año. La edita dirección desde la pantalla (lib/finanzas/meta-server.ts): cambiarla no pide código.
model MetaDeFacturacion {
  id          String   @id @default(cuid())
  anio        Int
  /// En dólares: la meta se dice en dólares («US$2,3 millones en 2027»). Lo facturado se lee por moneda y se convierte
  /// solo para dibujar la barra (convertir, lib/finanzas/equilibrio.ts).
  montoUsd    Decimal  @db.Decimal(14, 2)
  // nullable porque la nota es opcional.
  nota        String?  @db.Text
  definidaPor String
  definidaAt  DateTime @default(now())

  @@index([anio, definidaAt])
}

/// Lo que propone la lectura de los números de Rentabilidad (lib/rentabilidad/lectura): una fila por propuesta. Nexus
/// detecta y propone; una persona la usa o la desestima. Solo lo usado vale. Vence a los 30 días (se calcula al leer).
model PropuestaDeRentabilidad {
  id            String    @id @default(cuid())
  // nullable porque la propuesta sobrevive a que se borre la corrida (el historial de corridas se limpia).
  agentRunId    String?
  agentRun      AgentRun? @relation("PropuestasDeRentabilidad", fields: [agentRunId], references: [id], onDelete: SetNull)
  /// El último mes cerrado que se leyó («2026-09»).
  mes           String
  /// solvencia | margen-cuenta | horas-sin-facturar | meta (texto: sumar un tipo no toca la base)
  tipo          String
  /// La huella de la señal que la originó: con una pendiente igual no se crea otra.
  clave         String
  // nullable porque la mayoría de las señales son de toda la empresa, no de una cuenta.
  clientId      String?
  client        Client?   @relation("PropuestasDeRentabilidad", fields: [clientId], references: [id], onDelete: SetNull)
  titulo        String
  /// Lo que detectó, con sus números.
  queVe         String    @db.Text
  /// Qué hacer.
  propuesta     String    @db.Text
  // nullable porque no toda propuesta pide plata.
  inversionUsd  Decimal?  @db.Decimal(12, 2)
  inversionNota String?   @db.Text
  /// La señal del código (lib/rentabilidad/lectura/senales.ts) con los números que vio el modelo.
  senal         Json
  /// pendiente | usado | desestimado (CHECK en el SQL). «vencido» = pendiente de más de 30 días: se deriva.
  estado        String    @default("pendiente")
  // nullable hasta que alguien decide.
  decididaPor   String?
  decididaAt    DateTime?
  motivo        String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([estado, createdAt])
  @@index([agentRunId])
  @@index([clientId])
  @@index([clave])
}

// Cómo clasifica la CSL cada cuenta de la cartera (2026-10-07): tipo de relación, potencial y momento. Guarda solo lo
// CONFIRMADO (quién y cuándo) y lo DESCARTADO; la propuesta de Nexus se calcula al leer (lib/cs/clasificacion.ts). Los
// valores son texto y no enum: sumar uno no pide ALTER TYPE. El CSE responsable no va acá: es el de HubSpot.
// SQL: scripts/sql/2026-10-07-clasificacion-de-cuenta.sql (RLS + deny).
model ClasificacionDeCuenta {
  clientId     String    @id
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relacion     String?
  relacionPor  String?
  relacionEn   DateTime?
  potencial    String?
  potencialPor String?
  potencialEn  DateTime?
  momento      String?
  momentoPor   String?
  momentoEn    DateTime?
  /// Lo descartado, por dato: { relacion: { valor, huella } }. No se vuelve a proponer hasta que cambie la huella.
  descartes    Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Las correcciones del color de una cuenta y el «en espera del cliente» (Éxito del cliente, 2026-10-09).
/// Append-only: el estado sale del último evento de cada clase (lib/cs/ajustes-de-salud.ts).
model CorreccionDeSalud {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// corregir · quitar-correccion · en-espera · quitar-espera · descartar-espera
  tipo           String
  /// El color que puso la persona (solo «corregir»).
  salud          String?
  /// La razón de la corrección o qué se espera del cliente.
  nota           String?  @db.Text
  /// Lo que decía Nexus al corregir: el color y sus razones rojas (una roja nueva deja sin efecto la corrección).
  saludDeNexus   String?
  razonesDeNexus String[] @default([])
  /// Los hechos de la propuesta de «en espera» descartada (no se vuelve a proponer hasta que cambien).
  huella         String?
  porEmail       String
  porNombre      String?
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
}

/// Una vista guardada de la pestaña «Cartera» de Éxito del cliente: un nombre y sus filtros (2026-10-09).
/// Compartida entre la CSL y dirección; solo quien la creó la borra.
model VistaDeCartera {
  id              String   @id @default(cuid())
  nombre          String
  filtros         Json     @default("{}")
  creadaPorEmail  String
  creadaPorNombre String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CsSettings {
  id                     String   @id @default("cs")
  watchdogEnabled        Boolean  @default(true)
  // Ciclo de vida — umbral UUS (0-100) para dar por cumplida VALIDACION_USO (gate
  // USO_VALIDADO). Política global del módulo, como watchdogEnabled.
  uusValidationThreshold Float    @default(60)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Estado genérico de jobs del scheduler (lib/jobs) — claim atómico anti-doble-fire
// por compare-and-set de lastRunDateKey (patrón de MarketingSettings.lastCronDateKey,
// generalizado por jobKey). Marketing conserva su claim propio por ahora.
model CronJobState {
  id             String    @id // jobKey ("cs-signals", "cs-watchdog-daily", …)
  lastRunDateKey String? // "YYYY-MM-DD" (día CR) del último disparo
  lastRunAt      DateTime?
  // Resultado del último run CONCLUYENTE del job (lo escribe el propio job, no el
  // scheduler). Primer uso: fila `cs-partner-sync-status` con {supported, total,
  // matched, unmatched, error?, at} — las corridas locked/transitorias NO lo pisan.
  // Es la fuente de verdad de "¿el scope está autorizado?" para los paneles de CS.
  lastResult     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// ═══ COBRANZA — control de cartera de cobros (Admin & Finanzas) ════════════════
// ═══════════════════════════════════════════════════════════════════════════════
// Nexus es la capa de CONTROL de cobros ("¿a quién le toca cobrar y cómo va?");
// la facturación fiscal, conciliación bancaria y contabilidad viven en Odoo/Mercury
// (ver docs/DECISIONS.md § Cobranza). Acceso: SOLO roles ADMIN + SUPER_ADMIN
// (whitelist lib/auth/cobranza-roles.ts, enforcement server-side).
//
// NAMING EN ESPAÑOL A PROPÓSITO (desviación deliberada de la convención inglesa
// del resto del schema): el dominio se opera en español (Alex/Finanzas) y los
// términos (cobro, cuota, arranque, catch-up) no traducen 1:1 sin perder
// precisión. Documentado en DECISIONS — no "corregir" a inglés.

enum CobranzaTipoCuenta {
  NACIONAL
  INTERNACIONAL
}

enum CobranzaViaCobro {
  MERCURY
  ODOO
  OTRA
}

enum CobranzaMoneda {
  CRC
  USD
}

enum CobranzaTerminosPago {
  ANTICIPADO
  VENCIDO
}

enum CobranzaEstadoCuenta {
  PENDIENTE_DATOS // falta info para operar (ej. sin fecha de arranque) — no genera cobros
  PENDIENTE_CONTRATO
  ACTIVA
  CON_ATRASO
  SUSPENDIDA
}

enum CobranzaTipoServicio {
  SUSCRIPCION
  IMPLEMENTACION
  WEB
  SOPORTE
  CRM
  CONECTOR // integraciones SaaS facturadas aparte (Hub&SAP, QuickBooks) — hoja "Conectores SAAS"
  OTRO
}

enum CobranzaModalidad {
  RECURRENTE // sin fin (suscripciones)
  PROYECTO // con fin (implementaciones)
}

enum CobranzaEstadoServicio {
  ACTIVO
  FINALIZADO
  PAUSADO
}

enum CobranzaPlanTemplate {
  PAREJO // N cuotas iguales mensuales desde el arranque
  ENTRADA_Y_RESTO // entrada X% + resto parejo en N cuotas
  SUSCRIPCION // recurrente mensual sin fin (rolling)
  PERSONALIZADO // cuotas arbitrarias (% o monto fijo + offset)
}

enum CobranzaPlanOrigen {
  AUTO_HANDOFF // pre-configurado desde el contexto de ventas (Fase 3 — enum listo, v1 no lo usa)
  MANUAL
}

enum CobranzaCuotaBase {
  PORCENTAJE // valor = % del montoTotal (0-100)
  MONTO_FIJO // valor = monto absoluto
}

enum CobranzaEstadoCobro {
  PROGRAMADO // futuro según plan (semáforo gris) o catch-up pendiente de revisión
  POR_COBRAR // toca cobrarlo / factura en curso (amarillo)
  COBRADO // plata entró — EXIGE confirmadoPor (INV3; verde)
  SIN_DATO // falta info para determinarlo (cero fabricación)
}

enum CobranzaOrigenCobro {
  PLAN // materializado desde PlanDePago
  CATCH_UP // generado por desfase arranque-vs-hoy (caso Teamnet) — requiere confirmación
  MANUAL // creado a mano por la persona
  // Cargado del histórico de facturación (hoja de Alex). Se escribe SIN pasar por el
  // engine —que clampea al ciclo corriente y no puede backfillear— pero con numCuota
  // = orden del plan, así el engine lo reconoce y no propone cambios fantasma.
  IMPORTACION
  /// Espejo de Odoo: el cobro nacio de una factura que Odoo ya tenia y Nexus no. Ver
  /// docs/odoo-integracion-plan.md. NUNCA se marca COBRADO por el sync (INV25).
  ODOO
}

enum CobranzaTipoAlerta {
  COBRO_PROXIMO // falta facturar, en ventana (Tanda B: reencuadrado a los dos relojes)
  FACTURACION_ATRASADA // falta facturar, pasó la gracia — trabajo pendiente de Alex, no mora del cliente
  COBRO_VENCIDO // ya facturado, se venció el crédito (fechaEmision + creditoDias) sin cobrar
  CUENTA_SIN_DATOS // cliente con proyecto sin cuenta/servicios/arranque
  INCONSISTENCIA_CICLO // catch-up generado pendiente de confirmación
  ARRANQUE_CAMBIADO // fechaInicioFacturacion divergió del anchorStartDate actual
  MONTOS_DESCUADRADOS // plan activo cuya expansión no suma el montoTotal (aviso, no invariante)
  PROMESA_INCUMPLIDA // la promesa de pago pasó sin que el cobro llegara a COBRADO
  /// El sync con Odoo fallo. Existe porque hoy un job roto solo va al log del contenedor y
  /// nadie se entera; INV24 exige que toda corrida fallida tenga la suya.
  SYNC_ODOO_FALLIDO
  /// Hay una factura en Odoo que ningun cobro de Nexus reclama.
  FACTURA_SIN_COBRO
}

enum CobranzaUrgencia {
  ALTA
  MEDIA
  BAJA
}

enum CobranzaAlertaEstado {
  ABIERTA
  VISTA
  RESUELTA
  DESCARTADA
}

enum BitacoraCobroTipo {
  LLAMADA
  CORREO
  NOTA
  ACTUALIZACION_IA // escrita por el sistema (ej. resumen de una materialización)
}

// ─── CuentaFinanciera ───────────────────────────────────────────────────────────
// Perfil de cobro de un cliente (1:1 con Client — idioma ClientCsSignals). Concern
// separado del Client operativo: acá vive TODO lo que Finanzas necesita saber.
model CuentaFinanciera {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tipo                     CobranzaTipoCuenta   @default(NACIONAL)
  viaCobro                 CobranzaViaCobro     @default(ODOO)
  // Quién/cuándo cambió `viaCobro` por última vez (2026-09-25, «Está en Mercury»). Las escribe SOLO
  // `cambiarViaCobroTx` (lib/cobranza/via-cobro.ts) y solo si la vía cambia de verdad. null = la vía
  // viene así de la importación o del alta, sin firma. SQL: scripts/sql/2026-09-25-1-via-de-cobro-firmada.sql
  viaCobroPor              String?
  viaCobroEn               DateTime?
  moneda                   CobranzaMoneda       @default(CRC)
  // DEPRECATED — reemplazado por creditoDias (Tanda B, 2026-07). Nunca alimentó
  // ningún cálculo del motor (0 lectores en engine.ts). Se mantiene escribible
  // (importador, alta manual) para no romper esos caminos sin necesidad; sacado
  // de los 2 formularios de configuración de cuenta.
  terminosPago             CobranzaTerminosPago @default(ANTICIPADO)
  diaCobroAncla            Int? // nullable porque el día del ciclo puede no estar definido aún (ej. 15, 16)
  // nullable → cae a DEFAULT_CREDITO_DIAS (engine.ts) cuando la cuenta no trae el
  // suyo. Días de crédito otorgados al cliente desde que se emite la factura
  // (Reloj 2 del semáforo — Tanda B). Normal 15, Colby 90.
  creditoDias              Int?
  estadoCuenta             CobranzaEstadoCuenta @default(PENDIENTE_DATOS)
  // Caso Colby: cuenta fuera del estándar — oculta del panel y del cronograma automático.
  excluidaOperacion        Boolean              @default(false)
  // Licencias de terceros (ej. Hotspot): el cliente paga directo al tercero — esto
  // documenta qué explicarle. nullable porque solo aplica a esos casos.
  responsableCobroTerceros String?
  notas                    String?              @db.Text
  // Curaduría manual del estado (idioma healthStatusOverride{By,At}): quién/cuándo
  // cambió estadoCuenta a mano por última vez (email del guard).
  estadoActualizadoPor     String?
  estadoActualizadoEn      DateTime?
  // Procedencia (regla fuente + id_externo — upsert idempotente del importador).
  // null = cuenta configurada a mano desde el panel antes de esta regla.
  fuente                   String? // "manual" | "sheet" (futuro: "hubspot" | "odoo")
  fuenteIdExterno          String?
  // Correo al que se le cobra (destino del mailto del borrador de cobro).
  // nullable porque el import puede no traerlo — se completa a mano.
  correoCobro              String?
  // Identidad legal (razón social + cédula jurídica), distinta del nombre
  // comercial (Client.name). nullable porque no toda cuenta tiene esta
  // identidad legal capturada aún — se completa a mano o vía el importador
  // del histórico. Sin @unique en cedulaJuridica: un mismo holding puede
  // facturar bajo varios nombres comerciales con la misma cédula (ver
  // DECISIONS.md).
  razonSocial              String?
  cedulaJuridica           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicios         ServicioContratado[]
  cobros            Cobro[] // vía cuentaId denormalizado en Cobro (panel sin doble join)
  alertas           AlertaCobro[]
  bitacora          BitacoraCobro[]
  ordenesDelSistema OrdenDelSistema[]

  // Espejo de Odoo (solo lectura)
  facturasOdoo        FacturaOdoo[]
  vinculosOdoo        OdooPartnerVinculo[]
  facturaLiberadas    FacturaLiberada[]
  /// Los clientes de Mercury emparejados con esta cuenta (espejo de Mercury, 2026-10-02).
  clientesMercury     ClienteMercury[]     @relation("ClientesMercuryDeLaCuenta")
  /// Los contratos que revenden licencias, con su parte de servicio y su costo (2026-10-17).
  licenciasRevendidas LicenciaRevendida[]

  @@unique([fuente, fuenteIdExterno]) // NULLs no colisionan — las cuentas manuales legacy conviven
  @@index([estadoCuenta])
}

// ─── ServicioContratado ─────────────────────────────────────────────────────────
// Un servicio facturable de la cuenta (un contrato puede traer varios: suscripción
// perpetua + implementación de 4 meses). Cada uno lleva su propio plan y cronograma.
model ServicioContratado {
  id       String           @id @default(cuid())
  cuentaId String
  cuenta   CuentaFinanciera @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  tipoServicio           CobranzaTipoServicio
  modalidad              CobranzaModalidad
  // Dinero: primer uso de Decimal en el repo (a propósito — Float acumula error en
  // montos). Prisma.Decimal NO cruza a Client Components: se serializa a number en
  // lib/cobranza/queries.ts (único punto). Para SUSCRIPCION = monto MENSUAL.
  montoTotal             Decimal                @db.Decimal(12, 2)
  moneda                 CobranzaMoneda
  // COPIA EDITABLE del ancla: default = ProjectTimeline.anchorStartDate del proyecto
  // al configurar (se LEE una vez, no se sincroniza). Si el CSE cambia el arranque
  // después, la divergencia la detecta la alerta ARRANQUE_CAMBIADO — nunca se
  // regeneran cobros emitidos/cobrados. nullable: sin ancla ⇒ PENDIENTE_DATOS, sin cobros.
  fechaInicioFacturacion DateTime?
  duracionMeses          Int? // nullable porque las suscripciones abiertas no tienen fin
  projectId              String? // nullable porque puede haber servicios sin proyecto en Nexus
  project                Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  estado                 CobranzaEstadoServicio @default(ACTIVO)
  descripcion            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planes         PlanDePago[]
  cobros         Cobro[]
  // ⚠ El DEAL GANADO de Nexus es esta fila: es lo único que tiene monto vendido,
  // una fila por venta, y es el padre OBLIGATORIO de cada Cobro — o sea que la
  // plata que entra ya sabe de qué venta viene.
  atribucion     AtribucionVenta?
  reglasComision ReglaComisionVendedor[] @relation("ReglasDeComisionServicio")

  @@index([cuentaId, estado])
  @@index([projectId])
}

// ─── PlanDePago ─────────────────────────────────────────────────────────────────
// El "arreglo de pago" con que se vendió el monto. NO es siempre monto÷N: plantillas
// configurables. Solo 1 activo por servicio (lo garantiza setPlanActivo por transacción).
model PlanDePago {
  id         String             @id @default(cuid())
  servicioId String
  servicio   ServicioContratado @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  template  CobranzaPlanTemplate
  origen    CobranzaPlanOrigen   @default(MANUAL)
  numCuotas Int? // nullable porque SUSCRIPCION no tiene N fijo
  activo    Boolean              @default(true)
  notas     String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuotas CuotaPlan[]
  cobros Cobro[] // trazabilidad: de qué plan salió cada cobro materializado

  @@index([servicioId, activo])
}

// ─── CuotaPlan ──────────────────────────────────────────────────────────────────
// La definición de cada cuota del plan (para PERSONALIZADO; las plantillas simples
// las expanden en el engine sin filas explícitas salvo la entrada de ENTRADA_Y_RESTO).
model CuotaPlan {
  id          String            @id @default(cuid())
  planId      String
  plan        PlanDePago        @relation(fields: [planId], references: [id], onDelete: Cascade)
  orden       Int // 1-based
  base        CobranzaCuotaBase
  valor       Decimal           @db.Decimal(12, 2) // 0-100 si PORCENTAJE; monto absoluto si MONTO_FIJO
  offsetMeses Int               @default(0) // 0 = mes de arranque
  descripcion String?

  @@unique([planId, orden])
}

// ─── Cobro ──────────────────────────────────────────────────────────────────────
// El corazón del módulo: una obligación de cobro concreta, materializada desde el
// plan (o catch-up/manual). INV3: estado=COBRADO exige confirmadoPor (chokepoint
// lib/cobranza/mutations.ts#cambiarEstadoCobro; red dura en check-invariants.ts).
model Cobro {
  id         String             @id @default(cuid())
  servicioId String
  servicio   ServicioContratado @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  cuentaId   String // denormalizado: última/próxima fecha del panel sin doble join
  cuenta     CuentaFinanciera   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  planId     String? // nullable porque los MANUAL pueden no salir de un plan
  plan       PlanDePago?        @relation(fields: [planId], references: [id], onDelete: SetNull)

  // El engine SIEMPRE asigna numCuota; los MANUAL van null. En Postgres los NULL no
  // colisionan en el unique compuesto → los manuales conviven sin límite y los del
  // engine quedan protegidos contra duplicación (idempotencia). NO "arreglar" con
  // un unique parcial.
  numCuota               Int?
  periodo                String // "YYYY-MM" (mes calendario UTC que cubre)
  fechaProgramada        DateTime // fecha de CALENDARIO como instante UTC (patrón anchorStartDate)
  monto                  Decimal             @db.Decimal(12, 2)
  moneda                 CobranzaMoneda
  estado                 CobranzaEstadoCobro @default(PROGRAMADO)
  origen                 CobranzaOrigenCobro @default(PLAN)
  fechaEmision           DateTime? // cuándo se emitió la factura (en Odoo/Mercury)
  // Auditoría de "Marcar facturado" (Tanda B) — mismo patrón que confirmadoPor/
  // confirmadoEn: se setea cuando fechaEmision pasa de null a no-null, se limpia
  // al revertir. nullable porque solo tiene valor mientras fechaEmision existe.
  facturadoPor           String?
  facturadoEn            DateTime?
  fechaCobro             DateTime? // cuándo entró la plata
  confirmadoPor          String? // email del guard que confirmó el estado con consecuencia monetaria
  confirmadoEn           DateTime?
  // ReconciliationPort v1: referencia externa OPCIONAL al confirmar COBRADO (id de
  // transacción Mercury / factura Odoo). Solo metadata — la conciliación real vive allá.
  // ⚠ Desde la etapa 7 el número de la FACTURA va en `numeroFactura`: esta queda para el
  // número de depósito o transferencia.
  referenciaExterna      String?
  // El número de la factura (etapa 7, 2026-09-12): nace al marcar facturado, normalizado
  // (lib/cobranza/numero-factura.ts). NO es único: una factura puede cubrir varias cuotas de
  // la misma cuenta; en dos cuentas lo frena el chokepoint (409) y lo vigila INV33.
  // nullable porque 144 cobros se facturaron antes de que existiera.
  numeroFactura          String?
  // Quién puso el número o la marca, y cuándo (INV34). Se limpia al revertir la factura.
  numeroFacturaPor       String?
  numeroFacturaEn        DateTime?
  // La marca «no tengo el número», con su motivo. Excluyente con numeroFactura (CHECK
  // Cobro_numero_o_marca, que Prisma no modela: scripts/sql/2026-09-12-7-numero-de-factura.sql).
  sinNumeroFacturaMotivo String?
  // Promesa de pago: MARCA sobre una factura emitida, no descuento (decisión de Alex,
  // 2026-09-12). No cambia el semáforo ni saca la factura del vencido, y su alerta
  // COBRO_VENCIDO sigue a la vista con la fecha; pasada sin COBRADO, la alerta sube a
  // PROMESA_INCUMPLIDA. Sin factura no cuenta. nullable porque la mayoría no tiene promesa.
  promesaPago            DateTime?
  notas                  String?             @db.Text

  // Etapa 12 (2026-09-13): dónde se emitió la factura y a qué sociedad se le facturó. Los dice quien
  // marca facturado (Vilma decide factura por factura): nunca se infieren. La sociedad es una
  // referencia, no un texto libre. nullable porque los cobros de antes no lo dicen, y porque solo
  // valen con factura (INV36). La regla: `resolverSociedad` en lib/cobranza/sociedades.ts.
  // SQL: scripts/sql/2026-09-12-12-sociedades-facturadoras.sql.
  plataformaFactura   CobranzaViaCobro?
  sociedadFacturadaId String?
  sociedadFacturada   OdooPartnerVinculo? @relation(fields: [sociedadFacturadaId], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cobroFacturaOdoos CobroFacturaOdoo[]
  ordenesDelSistema OrdenDelSistema[]

  @@unique([servicioId, numCuota])
  @@index([cuentaId, fechaProgramada])
  @@index([estado, fechaProgramada])
  @@index([numeroFactura])
  @@index([sociedadFacturadaId])
}

// ─── AlertaCobro ────────────────────────────────────────────────────────────────
// Alerta generada por el cómputo de cartera (clon del ciclo de vida de CsAlert):
// dedup por dedupeKey (merge si sigue ABIERTA/VISTA; supresión 7d si RESUELTA/DESCARTADA).
/// Una factura que se soltó de su cobro porque el acuerdo de pago cambió.
///
/// ── DOS TRABAJOS EN UNA TABLA ───────────────────────────────────────────────────
/// 1. **Archiva la autoría** que `cambiarEstadoCobro` destruye al revertir: pone
///    `facturadoPor`/`facturadoEn` en null y el único rastro que queda es `updatedAt`, sin
///    autor ni valor anterior.
/// 2. **Es la cola de trabajo hacia el ERP.** Nexus nunca escribe allá, así que el documento
///    emitido lo tiene que anular una persona — y si eso no queda anotado de este lado, se
///    pierde.
///
/// ⚠ `cobroId` y `servicioId` NO son llaves foráneas a propósito: el cobro se BORRA al
/// regenerar. Un Cascade se llevaría el rastro de la factura que hay que anular; un SetNull
/// dejaría la fila sin saber de qué cobro venía. Por eso lleva **snapshot completo**: se lee
/// sola, sin el cobro y meses después.
model FacturaLiberada {
  id       String           @id @default(cuid())
  cuentaId String
  cuenta   CuentaFinanciera @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  /// Sueltos a propósito. Ver la nota de arriba.
  servicioId String?
  cobroId    String?

  /// El snapshot: la fila tiene que poder leerse sin el cobro ni el servicio.
  clienteNombre     String
  numCuota          Int?
  periodo           String
  monto             Decimal        @db.Decimal(12, 2)
  moneda            CobranzaMoneda
  fechaEmision      DateTime?      @db.Date
  referenciaExterna String?
  /// ⚠ Quién había facturado. Es el dato que el revert de hoy destruye.
  facturadoPor      String?

  /// En qué sistema vive el documento. Se CONFIRMA al liberar, no se hereda en silencio:
  /// `CuentaFinanciera.viaCobro` tiene ODOO por defecto y 16 cuentas internacionales lo
  /// arrastran sin que nadie lo haya elegido.
  plataforma CobranzaViaCobro
  decision   CobranzaDecisionFactura
  motivo     String?

  liberadaPor String
  liberadaEn  DateTime @default(now())

  /// ODOO se cierra solo cuando el sync ve el documento anulado. MERCURY y OTRA no tienen
  /// espejo: las cierra una persona.
  resueltaEn  DateTime?
  resueltaPor String?

  @@index([resueltaEn])
  @@index([cuentaId])
  @@index([cobroId])
}

/// CANCELAR = el documento se anula o se elimina en el ERP.
/// REVERTIR = se emite una nota de crédito que lo reversa; los dos documentos quedan.
/// Se elige una por factura, SIN default: depende de si ya salió al cliente.
enum CobranzaDecisionFactura {
  CANCELAR
  REVERTIR
}

model AlertaCobro {
  id       String           @id @default(cuid())
  cuentaId String
  cuenta   CuentaFinanciera @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  cobroId  String? // nullable porque CUENTA_SIN_DATOS es a nivel cuenta (sin cobro)

  tipo      CobranzaTipoAlerta
  urgencia  CobranzaUrgencia
  mensaje   String             @db.Text
  evidencia Json? // { cobroIds?, servicioId?, fechas? } para drill desde la UI

  // Index no-unique a propósito: una alerta RESUELTA vieja puede reaparecer como fila nueva.
  dedupeKey       String
  occurrences     Int      @default(1)
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())

  estado        CobranzaAlertaEstado @default(ABIERTA)
  vistaEn       DateTime?
  vistaPor      String? // email del guard
  resueltaEn    DateTime?
  resueltaPor   String? // email del guard
  // Snooze MANUAL («Posponer» de las alertas): loadAlertas la excluye hasta esta
  // fecha; el merge del upsert NO la resucita, salvo cuando la alerta del cobro sube a
  // PROMESA_INCUMPLIDA o pasa de «falta facturar» a COBRO_VENCIDO
  // (lib/cobranza/alertas-merge.ts). No cambia estado. Registrar una promesa de pago ya
  // no la escribe (2026-09-12).
  posponerHasta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, urgencia, lastDetectedAt])
  @@index([cuentaId, estado])
  @@index([dedupeKey, estado])
}

// ─── SnapshotCartera ────────────────────────────────────────────────────────────
// Foto del set de alertas de cada corrida del corte (lunes o disparo manual). El
// digest semanal es el DIFF contra la corrida anterior — si nada cambió, no molesta.
// Fila-por-corrida con payload Json (no hash): el demo puede correr N veces el mismo
// día sin colisión y el digest histórico queda legible. ~52 filas/año — trivial.
model SnapshotCartera {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  alertSet    Json // [{ dedupeKey, tipo, urgencia, cuentaId, cobroId?, mensaje }]
  resumen     Json // digest computado: { nuevas, resueltas, persistentes, sinCambios }
  // FASE 3: métricas agregadas del corte (shape MetricasCartera del engine, con
  // `version`). Json EXTENSIBLE a propósito — el día que se absorba tesorería
  // (FX realizado, burn) se agregan llaves sin tocar schema. null = snapshot
  // pre-fase-3 (SIN backfill — la serie histórica arranca de cero hacia adelante).
  metricas    Json?
  triggeredBy String? // "cron" | email del disparo manual

  @@index([capturedAt])
}

// ─── BitacoraCobro ──────────────────────────────────────────────────────────────
// Registro de gestión de la cuenta (llamadas, correos, notas de la persona +
// actualizaciones automáticas del sistema como los resúmenes de materialización).
model BitacoraCobro {
  id           String            @id @default(cuid())
  cuentaId     String
  cuenta       CuentaFinanciera  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  cobroId      String? // nullable porque hay entradas a nivel cuenta
  tipo         BitacoraCobroTipo
  contenido    String            @db.Text
  usuarioEmail String? // nullable porque ACTUALIZACION_IA no tiene usuario
  createdAt    DateTime          @default(now())

  @@index([cuentaId, createdAt])
}

// ─── OrdenDelSistema ────────────────────────────────────────────────────────────
// Lo que Nexus ordenó solo en una cuota desde «Lo que no cuadra» (2026-10-22): el número de su factura, y el monto
// si difería en centavos. Guarda lo que había antes para poder deshacerlo. Las reglas: lib/cobranza/libro/ordenar.ts.
// SQL: scripts/sql/2026-10-22-orden-del-sistema.sql.
model OrdenDelSistema {
  id          String           @id @default(cuid())
  cobroId     String
  cobro       Cobro            @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  cuentaId    String
  cuenta      CuentaFinanciera @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  /// Una factura = un grupo: se deshace entero.
  grupo       String
  regla       ReglaDeOrden
  fuente      CobranzaViaCobro
  numero      String
  texto       String           @db.Text
  /// Foto de los campos que se tocan, antes y después (`FotoDeLaCuota`, ordenar-server.ts). Evidencia para deshacer.
  antes       Json
  despues     Json
  creadoEn    DateTime         @default(now())
  /// nullable porque casi ninguna se deshace. Los dos juntos (CHECK OrdenDelSistema_deshecho_entero).
  deshechoEn  DateTime?
  deshechoPor String?

  @@index([cobroId])
  @@index([cuentaId])
  @@index([grupo])
  @@index([creadoEn])
}

enum ReglaDeOrden {
  NUMERO_DE_MERCURY
  VARIAS_CUOTAS
  FACTURA_REEMPLAZADA
}

enum CobranzaImportEstado {
  BORRADOR // subido + parseado; mapeo en curso
  EN_REVISION // mapeo aplicado; cola de revisión abierta
  APLICADO
  DESCARTADO
}

enum CobranzaImportFilaEstado {
  VALIDA // pasa Zod + dedup resuelto → se aplicará
  REVISAR // inválida o dudosa → edición inline en la cola
  APLICADA
  OMITIDA // descartada a mano por la persona
}

// ─── ImportacionCobranza (staging del importador CSV) ───────────────────────────
// Un batch por archivo subido. El mapeo columna→campo canónico vive acá (Json
// configurable — NO cableado al Excel de Alex: el modelo canónico manda). Las
// filas inválidas NUNCA se ingieren en silencio: quedan REVISAR hasta corregirse
// u omitirse. AccountSource "sheet" del puerto 1 (lib/cobranza/ports.ts).
model ImportacionCobranza {
  id            String               @id @default(cuid())
  archivoNombre String
  fuente        String               @default("sheet") // se estampa en Client.source / CuentaFinanciera.fuente
  mapeo         Json // { campoCanonico: nombreColumnaCSV } — editable en el wizard
  columnas      Json // string[] headers detectados por el parser
  estado        CobranzaImportEstado @default(BORRADOR)
  totalFilas    Int                  @default(0)
  creadoPor     String // email del guard
  aplicadoEn    DateTime? // nullable porque solo se setea al aplicar
  aplicadoPor   String?
  resumen       Json? // { clientsCreados, cuentasCreadas, cuentasVinculadas, serviciosCreados, omitidas, fallidas }
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  filas ImportacionFila[]
}

// ─── ImportacionFila ────────────────────────────────────────────────────────────
// Una fila del CSV: cruda (raw) + canónica (post-mapeo/edición) + resultado del
// dedup. `dedup` es Json a propósito (sugerencia efímera de staging, no vínculo
// durable) — la FK real es aplicadoClientId, que se setea recién al aplicar.
model ImportacionFila {
  id       String              @id @default(cuid())
  importId String
  import   ImportacionCobranza @relation(fields: [importId], references: [id], onDelete: Cascade)

  numFila   Int // 1-based en el CSV
  raw       Json // fila cruda parseada { header: valor }
  canonico  Json? // payload canónico (shape importFilaCanonicaSchema) — post-mapeo + ediciones inline
  estado    CobranzaImportFilaEstado @default(REVISAR)
  errores   Json? // string[] mensajes de validación (Zod + reglas de negocio)
  dedup     Json? // { clientId, tipo: "fuente_id"|"dominio"|"nombre_exacto", clienteNombre } | null
  idExterno String? // id estable resuelto (columna id del sheet o slug del nombre)

  aplicadoClientId String? // nullable porque solo se setea al aplicar
  aplicadoClient   Client? @relation(fields: [aplicadoClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([importId, numFila])
  @@index([importId, estado])
}

enum CobranzaCategoriaCosto {
  SALARIO
  HERRAMIENTA
  FIJO_OPERACION
}

enum CobranzaFrecuenciaCosto {
  MENSUAL
  ANUAL // se proyecta mensualizado (/12)
}

// ─── CostoRecurrente ────────────────────────────────────────────────────────────
// REGISTRO DE REFERENCIA ESTIMADO de costos recurrentes (burn aproximado) para la
// caja neta (entra − sale). NO es contabilidad/planilla/facturación: cero lógica
// fiscal CR (CCSS/cargas/aguinaldo/renta), cero sociedades, cero tracking de pago
// (un costo no tiene "pagado" ni semáforo — no vence). El CANÓNICO es `monto`
// (all-in estimado); montoBase/factorCargas son memoria del helper de entrada de
// salarios y el motor JAMÁS los lee. PRIVACIDAD DURA: superficie SOLO SUPER_ADMIN
// (COSTOS_ROLES + guardCostosAccess, 3 capas server-side — RLS no cuenta: Prisma
// bypassa) — los salarios son la información más sensible del sistema y por eso
// viven en entidad APARTE, nunca como columna de TeamMember.
// ⚠ ACOTADO 2026-08-14: todo lo de arriba sigue valiendo PARA ESTE MODELO y solo para
// él. Lo que se pagó de verdad, quincena por quincena, vive en `PagoPlanilla` — otra
// entidad, con estado de pago propio (ver DECISIONS §El libro de planilla). La
// prohibición fiscal y la de FX NO se levantaron: el aguinaldo se DERIVA sumando lo
// registrado en ese libro, y los montos se guardan en su moneda nativa.
model CostoRecurrente {
  id         String                  @id @default(cuid())
  categoria  CobranzaCategoriaCosto
  nombre     String
  // Monto ALL-IN ESTIMADO (lo único que proyecta el motor), en su frecuencia.
  monto      Decimal                 @db.Decimal(12, 2)
  moneda     CobranzaMoneda
  frecuencia CobranzaFrecuenciaCosto @default(MENSUAL)

  // nullable porque solo SALARIO liga persona (y un salario puede registrarse sin
  // TeamMember, ej. contratación en curso). onDelete SetNull: dar de baja a la
  // persona NO borra la historia de costos — el costo queda sin vínculo y quien
  // mantiene Finanzas lo pausa o borra a mano.
  teamMemberId String?
  teamMember   TeamMember? @relation("CostosDePersona", fields: [teamMemberId], references: [id], onDelete: SetNull)

  // Memoria del helper base+factor — NO es lógica fiscal: factorCargas es un
  // multiplicador EDITABLE por el usuario (ej. 1.35), cero tasas hardcodeadas.
  // Van juntos o ninguno; solo sirven para reabrir el form en ese modo.
  montoBase    Decimal? @db.Decimal(12, 2)
  factorCargas Decimal? @db.Decimal(6, 4)

  activo Boolean @default(true) // false = pausado (fuera de la proyección, sin borrar)
  notas  String? @db.Text

  // Baja DEFINITIVA (renuncia/desvinculación/cancelación) — distinta de la pausa
  // (activo=false, temporal). El motor proyecta el costo hasta el bucket que
  // CONTIENE esta fecha (entero, sin prorrateo diario — es referencia) y lo
  // excluye después; pasada la fecha sale del burn. nullable porque un costo
  // vigente no tiene baja.
  finalizadoEl DateTime? @db.Date

  movimientos CostoMovimiento[] @relation("MovimientosDeCosto")

  // Con qué tarjeta(s) de la empresa se paga este costo. Va por tabla PUENTE y
  // no por una columna acá: una tarjeta SÍ vence (corte, pago) y una columna
  // arrastraría ese vencimiento al costo, que por regla no vence.
  tarjetas TarjetaCreditoCosto[] @relation("CostosDeTarjeta")

  // Lo que este costo valió MES A MES (el libro de egresos). Va por relación y no por
  // columna porque son dos preguntas distintas: `monto` es cuánto cuesta hoy, y esto es
  // cuánto costó en marzo. La segunda no se puede derivar de la primera.
  egresosMensuales EgresoMensual[] @relation("EgresosDelCosto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo, categoria])
}

enum CostoMovimientoTipo {
  ALTA
  BAJA // finalizadoEl seteado (baja definitiva, ≠ pausa)
  REACTIVACION // finalizadoEl limpiado, o activo false→true
  PAUSA // activo true→false
  CAMBIO_MONTO
  ELIMINACION // hard delete — la última huella (queda con costoId null)
}

// ─── CostoMovimiento ─────────────────────────────────────────────────────────
// Historia APPEND-ONLY de altas/bajas/cambios de los costos recurrentes (patrón
// BitacoraCobro). La escriben SOLO las mutations de costos, en la misma
// transacción — nunca desde la UI. Lleva un SNAPSHOT autosuficiente
// (nombre/categoria/moneda/frecuencia/monto) para leerse sola aunque el costo
// cambie o se borre (hard delete → costoId queda null vía SetNull).
// ⚠ PRIVACIDAD: lleva montos de SALARIOS — mismas 3 capas + RLS deny que
// CostoRecurrente. JAMÁS se expone fuera de las superficies SUPER_ADMIN.
model CostoMovimiento {
  id      String           @id @default(cuid())
  // nullable porque la historia SOBREVIVE al hard delete del costo (SetNull).
  costoId String?
  costo   CostoRecurrente? @relation("MovimientosDeCosto", fields: [costoId], references: [id], onDelete: SetNull)

  tipo CostoMovimientoTipo

  // Snapshot del costo al momento del movimiento (autosuficiente).
  nombre        String
  categoria     CobranzaCategoriaCosto
  moneda        CobranzaMoneda
  frecuencia    CobranzaFrecuenciaCosto
  monto         Decimal                 @db.Decimal(12, 2) // monto DESPUÉS del movimiento, en su frecuencia
  // nullable porque solo CAMBIO_MONTO lo lleva.
  montoAnterior Decimal?                @db.Decimal(12, 2)

  fechaEfectiva DateTime @db.Date // cuándo ocurrió de verdad (retroactiva permitida)
  usuarioEmail  String? // nullable por simetría con BitacoraCobro (hoy siempre viene del guard)
  notas         String?  @db.Text // motivo libre ("renuncia", "desvinculación", "contratación")

  createdAt DateTime @default(now())

  @@index([fechaEfectiva])
  @@index([costoId, createdAt])
}

// ─── GastoPuntual ────────────────────────────────────────────────────────────
// Gasto ÚNICO/circunstancial de REFERENCIA estimada (compra de equipo, evento,
// mantenimiento) — MISMA línea dura que CostoRecurrente: no es contabilidad, sin
// estado de pago (fecha pasada = ejecutado; futura = compra planificada → entra a
// la caja neta en el bucket de su fecha), sin lógica fiscal, sin FX. Los `tags`
// son vocabulario ABIERTO normalizado a slug al escribir (normalizeGastoTag en
// lib/cobranza/schema.ts) — NO usa el catálogo cerrado de proyectos.
// ⚠ PRIVACIDAD: superficie SOLO SUPER_ADMIN (guardCostosAccess) + RLS deny.
model GastoPuntual {
  id            String         @id @default(cuid())
  nombre        String
  monto         Decimal        @db.Decimal(12, 2)
  moneda        CobranzaMoneda
  fecha         DateTime       @db.Date // día del gasto (único campo temporal con semántica)
  tags          String[]       @default([])
  notas         String?        @db.Text
  /// Quién lo anotó (2026-10-03): sin autor no se puede revisar lo que registró el equipo. Los viejos quedan vacíos.
  registradoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
}

/// La revisión de Alex sobre un registro del equipo (2026-10-03, docs/finanzas-rediseno-plan.md): un PAGO (Cobro en
/// Cobrado) o un GASTO (GastoPuntual). Guarda la HUELLA de los números al revisarlo: si cambian, vuelve a «por revisar».
/// BIEN = revisado; DEVUELTO = devuelto con comentario, le llega a quien lo registró; CORREGIDO = dice que ya lo arregló.
/// `registroId` sin FK a propósito: apunta a dos tablas distintas según el tipo.
model RevisionRegistro {
  id           String    @id @default(cuid())
  /// PAGO · GASTO (CHECK en el SQL).
  tipo         String
  registroId   String
  /// BIEN · DEVUELTO · CORREGIDO (CHECK en el SQL).
  estado       String
  huella       String
  comentario   String?   @db.Text
  revisadoPor  String
  revisadoEn   DateTime
  corregidoPor String?
  corregidoEn  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tipo, registroId])
  @@index([estado])
}

/// El cierre de un mes (2026-10-03, docs/finanzas-rediseno-plan.md). ABIERTO mientras se trabaja; CERRADO cuando Alex lo
/// cierra, con los números de ese momento en `numeros`: si después cambian, el punto de equilibrio lo dice. No congela nada.
model CierreMes {
  id               String    @id @default(cuid())
  /// YYYY-MM.
  periodo          String    @unique
  /// ABIERTO · CERRADO (CHECK en el SQL).
  estado           String    @default("ABIERTO")
  /// Dinia avisa que ya anotó todos los gastos del mes.
  gastosListosPor  String?
  gastosListosEn   DateTime?
  cerradoPor       String?
  cerradoEn        DateTime?
  numeros          Json?
  reabiertoPor     String?
  reabiertoEn      DateTime?
  motivoReapertura String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Una decisión de dirección sobre el punto de equilibrio, tomada desde la página (2026-10-05). Sin fila = sin decidir:
/// manda el valor por defecto del código. Hoy hay una sola: `aliados-cubren-piso` (SI · NO), la pregunta de si lo que
/// pagan los aliados cuenta para cubrir el piso (`PARTNERSHIP_CUBRE_EL_PISO`). SQL: 2026-10-05-decisiones-de-finanzas.sql.
model DecisionFinanzas {
  clave       String   @id
  valor       String
  decididoPor String
  decididoEn  DateTime
  nota        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── IngresoVariable ─────────────────────────────────────────────────────────
// Entrada de dinero que NO forma parte del flujo constante de cobranza quincenal
// y que NO cuelga de un servicio contratado: una cuenta rescatada que se cobró
// por fuera, un trabajo suelto, un reembolso, una devolución. Espejo simétrico de
// GastoPuntual del lado que ENTRA.
//
// ⚠ Por qué NO es un `Cobro`: el schema de Cobro exige `servicioId` y `cuentaId`
// OBLIGATORIOS (todo cobro cuelga de un servicio de una cuenta). Un ingreso "de
// forma general" —sin cliente, o de un cliente sin servicio configurado— no puede
// representarse ahí sin inventarle un servicio fantasma, que ensuciaría la cartera,
// el semáforo y la proyección de cobranza. Por eso vive aparte.
//
// LÍMITE ANTI-DOBLE-CONTEO: si la plata SÍ vino de un servicio contratado, se
// registra en Cobranza (cobro MANUAL) y aparece en la pantalla de ingresos
// variables como "detectado en Cobranza" — NO se vuelve a cargar acá. La pantalla
// lo dice explícitamente.
//
// Misma línea dura que el resto del módulo: registro de CONTROL, no contabilidad
// (sin asiento, sin impuestos, sin conciliación); CRC y USD jamás se suman.
//
// ⚠ ETAPA 10 (2026-09-12): lo registrado acá NO ES VENTA. El reporte de equilibrio lo
// suma a la caja y a nada más: ni a lo facturado, ni a los ingresos, ni a la brecha, ni
// al % de cobranza (lib/cobranza/ingresos-no-venta.ts). Nació por el fondo de marketing
// de Insider, que entró al banco sin ser venta a un cliente.
model IngresoVariable {
  id       String         @id @default(cuid())
  concepto String // qué fue ("Fondo de marketing de Insider", "Reembolso de licencia")
  monto    Decimal        @db.Decimal(12, 2)
  moneda   CobranzaMoneda
  fecha    DateTime       @db.Date // día en que entró la plata

  // nullable A PROPÓSITO: el pedido es que se pueda relacionar con un cliente
  // "o de forma general". SetNull para que borrar un cliente NUNCA borre el
  // registro de que esa plata entró — el ingreso queda sin dueño y visible.
  clientId String?
  client   Client? @relation("IngresosVariablesDeCliente", fields: [clientId], references: [id], onDelete: SetNull)

  // Qué clase de plata es. null = sin clasificar (el reporte la lista en «Lo que no
  // cuadra»). ⚠ String y no enum: el nombre de la categoría del fondo de aliado está
  // pendiente, y sumarlo no puede exigir un ALTER TYPE. Los valores válidos los fija
  // la app (CATEGORIAS_INGRESO_NO_VENTA); uno desconocido se lee como sin clasificar.
  categoria         String?
  // El número del documento o del depósito (INV-26), normalizado. El alta frena el
  // mismo número ya cargado como factura de un cobro; INV35 vigila el dato.
  // scripts/sql/2026-09-12-10-ingreso-no-venta.sql
  referenciaExterna String?

  notas         String? @db.Text
  registradoPor String // email del guard que lo registró (trazabilidad, como confirmadoPor)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([clientId])
}

// ─── TarjetaCredito ─────────────────────────────────────────────────────────────
// Una tarjeta de crédito de la empresa con su LÍMITE y su SALDO USADO.
// Disponible = límite − saldo. El saldo lo ESCRIBE una persona con su fecha de
// corte y queda auditado (`saldoAlDia`/`saldoPorEmail`, patrón confirmadoPor):
// es la única verdad. Lo que Nexus suma de los costos asignados por la tabla
// puente se muestra al lado como REFERENCIA y jamás calcula el saldo — un saldo
// es acumulado y un cargo es mensual, no son la misma unidad. Lo único que sí se
// compara: si el disponible no alcanza para el próximo mes de cargos.
// Sin semáforo y sin alertas (la prohibición transversal de costos sigue en pie).
// ⚠ PRIVACIDAD: superficie SOLO SUPER_ADMIN + RLS deny. Y `ultimos4` es
// literalmente eso — el número COMPLETO de una tarjeta no entra a esta base.
model TarjetaCredito {
  id       String         @id @default(cuid())
  alias    String // cómo la llama el equipo ("VISA de Alexander")
  emisor   String? // banco emisor
  ultimos4 String? // SOLO los últimos 4 dígitos. NUNCA el número completo.
  moneda   CobranzaMoneda
  // nullable porque una tarjeta puede cargarse antes de saber su límite.
  limite   Decimal?       @db.Decimal(12, 2)

  // nullable porque una tarjeta de la empresa puede no tener titular persona.
  // SetNull: dar de baja a alguien no borra la tarjeta.
  titularTeamMemberId String?
  titular             TeamMember? @relation("TarjetasDePersona", fields: [titularTeamMemberId], references: [id], onDelete: SetNull)

  diaCorte Int? // día del mes en que corta
  diaPago  Int? // día del mes en que se paga

  // El saldo y su fecha van JUNTOS: un saldo sin fecha de corte no dice nada.
  saldoUsado    Decimal?  @db.Decimal(12, 2)
  saldoAlDia    DateTime? @db.Date
  saldoPorEmail String?

  activa Boolean @default(true)
  notas  String? @db.Text

  costos TarjetaCreditoCosto[]
  cortes CorteTarjeta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
}

// ─── CorteTarjeta ───────────────────────────────────────────────────────────────
// El estado de cuenta del mes, transcrito por una persona: cuatro números que ya
// llegan por correo del banco. Es un DATO OBSERVADO, no un cálculo — `pagoMinimo`
// y `saldoAnterior` se COPIAN, jamás se derivan (misma doctrina que el aguinaldo).
//
// Por qué esto y no un registro transacción por transacción: `TarjetaCredito`
// tenía 0 filas cuando se diseñó, o sea que la sección que ya pedía UN número al
// mes tenía adopción cero. Una pantalla que exige 40 líneas mensuales tipeadas se
// abandona en tres semanas y queda mintiendo por vacío.
//
// ⚠ NO entra a computeCajaNeta ni al burn (mismo precedente que PagoPlanilla):
// `loadCajaNeta` ya proyecta los costos recurrentes, y sumar además el corte
// cobraría HubSpot dos veces. Tampoco tiene semáforo ni alertas.
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny.
model CorteTarjeta {
  id String @id @default(cuid())

  tarjetaId String
  tarjeta   TarjetaCredito @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)

  fechaCorte      DateTime @db.Date
  // La REAL que imprime el banco. La derivada de diaCorte/diaPago es solo el
  // default del formulario y se rotula como estimación mientras esta fila falte.
  fechaLimitePago DateTime @db.Date

  // Nada lo LEE todavía: se captura porque es lo único que haría honesta una
  // conciliación futura, y volver a buscarlo después significa releer estados de
  // cuenta que nadie guarda.
  saldoAnterior Decimal? @db.Decimal(12, 2)
  deudaAlCorte  Decimal  @db.Decimal(12, 2)
  pagoMinimo    Decimal? @db.Decimal(12, 2)

  // Van JUNTOS o ninguno (CHECK en la DB): media verdad sobre plata que salió es
  // peor que no tener el dato.
  pagadoEl    DateTime? @db.Date
  montoPagado Decimal?  @db.Decimal(12, 2)

  registradoPor String
  registradoEn  DateTime
  notas         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ⚠ Sin `moneda`: la tarjeta ya la declara y duplicarla violaría §2.1.
  @@unique([tarjetaId, fechaCorte])
  @@index([tarjetaId, fechaCorte(sort: Desc)])
  @@index([pagadoEl, fechaLimitePago])
}

// ─── AguinaldoPago ─────────────────────────────────────────────────────────────
// Que el aguinaldo se pueda marcar PAGADO, con su fecha real y quién lo confirmó.
//
// ⚠ TABLA PROPIA Y NO UNA FILA DEL LIBRO DE PLANILLA, y el riesgo es real:
// `calcularAguinaldo` suma TODA fila PAGADO cuyo `periodo` caiga en la ventana,
// sin mirar concepto. Una fila con periodo "2026-12" caería dentro de la ventana
// del aguinaldo 2027 y lo inflaría en silencio; además colisionaría con el
// @@unique del libro contra la quincena del 15 de diciembre.
//
// ⚠ SIN columna de estado: la fila EXISTE = está pagado. Un PENDIENTE sería
// indistinguible de la ausencia de fila.
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny — es remuneración.
model AguinaldoPago {
  id String @id @default(cuid())

  // El año del aguinaldo; la ventana es dic del anterior → nov de éste.
  anio Int

  // nullable + SetNull: que alguien salga del equipo no borra el registro de que
  // se le pagó. `sujetoNombre` es el snapshot que sobrevive.
  sujetoTeamMemberId String?
  sujeto             TeamMember? @relation("AguinaldosDePersona", fields: [sujetoTeamMemberId], references: [id], onDelete: SetNull)
  sujetoNombre       String

  moneda String
  // Congelado como SNAPSHOT (precedente: PagoPlanilla.monto y ComisionVendedor):
  // corregir una quincena vieja no puede moverle el monto a plata que ya salió.
  monto  Decimal @db.Decimal(12, 2)

  baseSumada        Decimal @db.Decimal(12, 2)
  quincenasContadas Int
  // Nexus no elige entre la línea de solo salario y la que incluye comisiones,
  // pero sí registra cuál eligió la persona.
  incluyeComisiones Boolean @default(false)

  pagadoEl      DateTime @db.Date
  confirmadoPor String
  confirmadoEn  DateTime
  notas         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anio, sujetoTeamMemberId, moneda])
  @@index([anio])
}

// ─── TarjetaCreditoCosto ────────────────────────────────────────────────────────
// Puente tarjeta ↔ costo recurrente. Tabla y no columna: ver el comentario de
// `CostoRecurrente.tarjetas`. Cascade en las dos puntas — el vínculo no tiene
// vida propia, si muere cualquiera de los dos extremos el vínculo sobra.
model TarjetaCreditoCosto {
  id        String          @id @default(cuid())
  tarjetaId String
  tarjeta   TarjetaCredito  @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  costoId   String
  costo     CostoRecurrente @relation("CostosDeTarjeta", fields: [costoId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([tarjetaId, costoId])
  @@index([costoId])
}

// ─── PagoPlanilla ───────────────────────────────────────────────────────────────
// EL LIBRO: lo que efectivamente se PAGÓ, una fila por persona y por quincena
// (1–15 / 16–fin). Es OTRA COSA que la hoja «Planillas», que muestra el salario
// all-in ESTIMADO de `CostoRecurrente` para el burn: una dice cuánto se calcula
// que cuesta el mes, ésta cuánto salió de verdad.
// ⚠ El monto es PROPIO y congelado como snapshot, NO derivado del costo:
// `CostoRecurrente.monto` es el all-in estimado y el motor jamás lee
// `montoBase`, así que no existe un bruto quincenal que partir.
// ⚠ Materialización CREATE-ONLY: nunca update, nunca delete. Si alguien sube el
// salario a mitad de mes, reescribir la Q2 pendiente al monto nuevo con la Q1 ya
// pagada al viejo haría que Q1+Q2 no diera ningún salario. PAGADO es intocable.
// ⚠ NO entra a `computeCajaNeta`: ahí el burn lo produce `CostoRecurrente` y
// `loadCajaNeta` no filtra categoría — sumarlo sería doble conteo garantizado.
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny, igual que CostoRecurrente.
model PagoPlanilla {
  id String @id @default(cuid())

  // nullable + SetNull: dar de baja a la persona NO borra la historia de pagos
  // (que es justo de donde salen su antigüedad y su aguinaldo).
  sujetoTeamMemberId String?
  sujeto             TeamMember? @relation("PagosDePlanilla", fields: [sujetoTeamMemberId], references: [id], onDelete: SetNull)
  // Snapshot del nombre para que la fila se lea sola aunque el vínculo muera.
  sujetoNombre       String

  periodo         String // "YYYY-MM"
  quincena        Int // 1 (1–15) | 2 (16–fin) — CHECK en la DB
  fechaProgramada DateTime @db.Date

  monto  Decimal        @db.Decimal(12, 2)
  moneda CobranzaMoneda

  estado        PagoPlanillaEstado @default(PENDIENTE)
  fechaPago     DateTime?          @db.Date
  // INV18, espejo de INV3: ningún PAGADO sin confirmadoPor.
  confirmadoPor String?
  confirmadoEn  DateTime?

  notas String? @db.Text

  // Las comisiones que se liquidaron JUNTO a esta quincena.
  comisiones ComisionVendedor[] @relation("ComisionesDelPago")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sujetoTeamMemberId, periodo, quincena])
  @@index([periodo, quincena])
  @@index([estado])
}

/// Estado de una quincena del libro de planilla. Un pago SÍ tiene estado — es la
/// diferencia con `CostoRecurrente`, que es referencia estimada y no vence.
enum PagoPlanillaEstado {
  PENDIENTE
  PAGADO
}

// ─── ComisionPartner ────────────────────────────────────────────────────────────
// Lo que Smarteam GANA de un aliado comercial (HubSpot, Atom Chat, Cooby, Nua
// talk). Es un INGRESO, así que su superficie es la de ADMIN (gate
// `cobranza.read`) y NO lleva la policy deny-all — al revés que todo lo de
// costos. Nunca comparte ruta, endpoint ni loader con `ComisionVendedor`, que es
// remuneración de una persona.
// `partner` es un string normalizado y no una FK obligatoria: ninguno de los
// cuatro existe hoy como `Client`, e inventarlos para tener la FK sería fabricar
// cartera. `clientId` se liga solo si el aliado ya existe con kind ALIADO.
// ⚠ NO entra a la caja neta en esta tanda — mismo precedente que IngresoVariable.
// ─── PartnerComercial ───────────────────────────────────────────────────────────
// El aliado que le PAGA a Smarteam (HubSpot, Atom Chat, Cooby…), con su CADENCIA.
// Nació porque `ComisionPartner.partner` era un string suelto por fila y no había
// dónde guardar "HubSpot nos paga cada 3 meses" — sin eso, el historial se leía
// mes a mes y salía lleno de meses vacíos, y no se podía saber cuándo cae el
// próximo. Decisión de Elías: la frecuencia es del ALIADO, no del pago.
// ⚠ Es configuración de un INGRESO: superficie ADMIN (`cobranza.read`), RLS
// habilitado pero SIN deny-all — igual que `ComisionPartner` e `IngresoVariable`.
model PartnerComercial {
  id String @id @default(cuid())

  /// El nombre que se muestra, con sus mayúsculas.
  nombre String
  /// La clave normalizada (`normalizePartner`): "HubSpot" y "hubspot " son el
  /// MISMO aliado. Es lo que se compara; `nombre` es lo que se lee.
  clave  String @unique

  /// Cada cuántos MESES paga. 1 mensual · 3 trimestral · 6 semestral · 12 anual.
  /// Int y no enum: agregar "cada 2 meses" no puede exigir un ALTER TYPE
  /// coordinado entre las 2 PCs que comparten esta base. CHECK 1..24 en la DB.
  frecuenciaMeses Int

  activo Boolean @default(true)
  notas  String? @db.Text

  comisiones ComisionPartner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComisionPartner {
  id String @id @default(cuid())

  /// El nombre tal cual se escribió. NO se deriva de `partner` (la relación):
  /// es el snapshot de la carga, igual que `sujetoNombre` en PagoPlanilla — la
  /// fila se explica sola aunque el aliado se renombre o se borre.
  partner String

  // nullable porque las 5 filas históricas nacieron sin aliado dado de alta y
  // porque un pago puede registrarse antes de configurarlo. SetNull: borrar el
  // aliado NO borra el registro de que esa plata entró.
  partnerId       String?
  partnerRelacion PartnerComercial? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  concepto String?

  /// El monto NETO: la plata que entró al banco. Es el que manda y el único obligatorio.
  monto             Decimal        @db.Decimal(12, 2)
  /// Lo que el aliado reporta ANTES de la retención del procesador. nullable porque no
  /// siempre se sabe — el neto es obligatorio y el bruto opcional (Elías, 2026-08-20).
  /// ⚠ La retención NO se guarda: se DERIVA (montoBruto − monto) y se declara cuando
  /// falta el bruto. Un tercer número guardado puede contradecir a los otros dos.
  montoBruto        Decimal?       @db.Decimal(12, 2)
  /// true = NADIE confirmó este número; es una estimación.
  /// Existe porque el mismo campo `monto` cambiaba de significado sin decirlo: febrero y
  /// mayo eran mediciones ($38.756,61 · $45.921,72) y agosto y noviembre decían "$51.000
  /// exactos, dos veces" — una proyección tecleada. Sin esto el panel muestra las cuatro
  /// con el mismo peso.
  montoEsProyeccion Boolean        @default(false)
  // ── El monto real de la factura del aliado (2026-10-21) ─────────────────────
  // Estimado o real ya no depende del estado: una por cobrar pasa a real cuando llega la
  // factura del aliado, antes de que entre la plata. El monto acepta cero (CHECK >= 0):
  // una real en cero es «sin comisión» ese período. Ver DECISIONS «Comisiones de aliado:
  // estimado, real de la factura y cero». Los cuatro se limpian al volver a estimado.
  /// Lo que decía el estimado antes de pasar a real. nullable porque solo existe tras ese paso.
  montoEstimado     Decimal?       @db.Decimal(12, 2)
  /// La referencia de la factura del aliado. nullable porque a veces es un aviso por correo.
  facturaAliado     String?
  /// Quién dio el monto por real (email del guard). nullable mientras siga estimado.
  montoRealPor      String?
  /// Cuándo se dio por real. nullable mientras siga estimado.
  montoRealEn       DateTime?
  // ── La estimada de HubSpot sale de HubSpot Partner (U25, 2026-10-25) ────────────
  // true = el monto lo arma el job `comisiones-hubspot-estimado` con la comisión proyectada
  // de cada cuenta (lib/cobranza/comision-hubspot.ts). Lo apaga una edición a mano del monto:
  // desde ahí manda la persona. Solo vive en filas estimadas por cobrar.
  montoDesdePartner Boolean        @default(false)
  /// El detalle por cuenta del último estimado: { calculadoEn, meses, cuentas[] }. nullable
  /// porque solo lo tienen las filas que armó Partner (y se conserva al pasar a real).
  detalleDePartner  Json?
  moneda            CobranzaMoneda
  fecha             DateTime       @db.Date

  // nullable porque el partner puede no estar en la cartera. SetNull: borrar el
  // cliente no borra el registro de que esa plata entró.
  clientId String?
  client   Client? @relation("ComisionesDePartner", fields: [clientId], references: [id], onDelete: SetNull)

  // ── Estado de cobro (2026-08-17) ─────────────────────────────────────────────
  // Hasta hoy esta tabla solo registraba plata que YA había entrado, así que las
  // comisiones prometidas (HubSpot paga trimestral: agosto y noviembre, ~$54k cada
  // una) vivían fuera del sistema y no aparecían en ninguna proyección.
  // ⚠ `fecha` NO cambia de significado: sigue siendo la fecha de la comisión y es lo
  // que agrupa los buckets de cadencia en armarHistorial. `fechaCobro` es otra cosa.
  // ⚠ DEFAULT POR_COBRAR a propósito: con default COBRADO, cualquier INSERT que se
  // olvide de `confirmadoPor` violaría INV20. Un POR_COBRAR nunca puede violarlo.
  estado        ComisionPartnerEstado @default(POR_COBRAR)
  // nullable porque un POR_COBRAR todavía no tiene el día en que entró la plata.
  fechaCobro    DateTime?             @db.Date
  // INV20, espejo exacto de INV3: ningún COBRADO sin quien lo confirmó. Lo escribe
  // SOLO el chokepoint cambiarEstadoComisionPartner, nunca el body de un request.
  confirmadoPor String?
  confirmadoEn  DateTime?

  notas         String? @db.Text
  registradoPor String // email del guard (trazabilidad, como en IngresoVariable)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([partner])
  @@index([partnerId])
  @@index([estado, fecha])
}

/// Si la comisión de un aliado ya entró o todavía se espera. Dos estados y no tres:
/// "facturada" no aplica — al aliado no se le emite factura, él liquida y paga.
enum ComisionPartnerEstado {
  POR_COBRAR // devengada o prometida — todavía NO es caja
  COBRADO // entró. EXIGE confirmadoPor (INV20)
}

// ─── ReglaComisionVendedor ──────────────────────────────────────────────────────
// El % que le toca a una persona sobre lo COBRADO (decisión de Elías: la base es
// lo cobrado, no lo facturado). `clientId` null = aplica a TODOS los clientes; la
// regla MÁS ESPECÍFICA gana. La comisión devengada NO se materializa desde acá:
// es una vista derivada (ver `ComisionVendedor`).
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny — es remuneración.
model ReglaComisionVendedor {
  id           String     @id @default(cuid())
  teamMemberId String
  vendedor     TeamMember @relation("ReglasDeComision", fields: [teamMemberId], references: [id], onDelete: Cascade)

  // nullable A PROPÓSITO: null = todos los clientes (la regla general).
  clientId String?
  client   Client? @relation("ReglasDeComisionVendedor", fields: [clientId], references: [id], onDelete: Cascade)

  // En PUNTOS PORCENTUALES: 10.0000 = 10%. No en fracción — así la fila se lee
  // como la gente dice el número. CHECK en la DB: > 0 y <= 100.
  porcentaje Decimal @db.Decimal(6, 4)

  vigenteDesde DateTime  @db.Date
  // nullable: una regla vigente no tiene fecha de fin.
  vigenteHasta DateTime? @db.Date

  // Tercer eje de especificidad, el MÁS específico: servicio > cliente > general.
  // nullable A PROPÓSITO: null = la regla no es de un deal puntual.
  // Con esto, "¿el % es de la persona o de este deal?" se contesta en la
  // interfaz y no en el DDL.
  servicioId String?
  servicio   ServicioContratado? @relation("ReglasDeComisionServicio", fields: [servicioId], references: [id], onDelete: Cascade)

  notas String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamMemberId, clientId])
  @@index([servicioId])
}

// ─── AtribucionVenta ───────────────────────────────────────────────────────────
// QUIÉN GANÓ CADA VENTA. Es el dato que decide a quién se le paga la comisión, y
// hasta el 2026-08-17 no existía en ninguna parte de Nexus: la regla era por
// CLIENTE, así que un vendedor con regla para un cliente comisionaba todo lo que
// ese cliente pagara, para siempre, aunque la segunda venta la ganara otro.
//
// ⚠ NO se puede derivar, y se midió: `Project.hubspotOwnerEmail` es el CSE que
// ENTREGA (sync-projects prioriza `csl_encargado` sobre el owner estándar) y los
// 70 valores reales son CSE/CSL/DEV, cero vendedores. Se elige a mano, que es lo
// correcto: a quién se le paga es una decisión, no una inferencia.
//
// ⚠ Es TABLA y no una columna en ServicioContratado por el mismo motivo por el
// que el salario vive en `CostoRecurrente` y no en `TeamMember`: es el dato que
// decide una remuneración y no se cuelga de la entidad que leen los loaders
// ADMIN de cobranza.
//
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny — decide remuneración.
model AtribucionVenta {
  id String @id @default(cuid())

  servicioId String             @unique
  servicio   ServicioContratado @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  teamMemberId String
  vendedor     TeamMember @relation("VentasAtribuidas", fields: [teamMemberId], references: [id], onDelete: Cascade)

  // TRES estados, no dos: sin fila = nadie la revisó · fila con true = comisiona
  // · fila con false = se revisó y acá no se paga. El vendedor se guarda igual
  // cuando no comisiona (quién ganó la venta es un hecho; que no cobre por ella
  // es otra decisión). Sin este campo, un deal decidido a conciencia se leería
  // para siempre como trabajo pendiente y el aviso de "N sin asignar" nunca
  // llegaría a cero.
  comisiona Boolean @default(true)

  asignadoPor String
  asignadoEn  DateTime
  notas       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamMemberId])
}

// ─── ComisionVendedor ───────────────────────────────────────────────────────────
// La comisión LIQUIDADA. La DEVENGADA no vive acá: es una vista derivada de los
// cobros COBRADO cruzados con la regla vigente, y se recalcula sola.
// Por qué derivada y no una fila escrita al cobrar (se refutó ese diseño):
// `cambiarEstadoCobro` NO tiene transacción, NO es el único escritor de COBRADO
// (el importador escribió 87 cobros directo) y el revert no deja bitácora — con
// eso había tres formas de tener un cobro sin su comisión y ningún invariante
// que lo viera.
// El snapshot es autosuficiente (patrón CostoMovimiento): se lee solo aunque
// después cambien la regla, el cobro o la persona.
// ⚠ PRIVACIDAD: SOLO SUPER_ADMIN + RLS deny — es remuneración.
model ComisionVendedor {
  id String @id @default(cuid())

  // nullable + SetNull: la historia sobrevive a la baja de la persona.
  teamMemberId   String?
  vendedor       TeamMember? @relation("ComisionesDeVendedor", fields: [teamMemberId], references: [id], onDelete: SetNull)
  vendedorNombre String

  periodo    String // "YYYY-MM"
  base       Decimal        @db.Decimal(12, 2) // lo cobrado sobre lo que se calculó
  porcentaje Decimal        @db.Decimal(6, 4) // puntos porcentuales, como en la regla
  monto      Decimal        @db.Decimal(12, 2)
  moneda     CobranzaMoneda

  // Qué cobros la produjeron. Es lo que consulta el freno 409 del revert.
  cobroIds String[] @default([])
  // Snapshot por cobro (cliente, fecha, monto) para que la fila se explique sola.
  detalle  Json?

  // La quincena en la que se pagó junto al salario. nullable: se puede liquidar
  // sin engancharla todavía a un pago. SetNull para no perder la comisión.
  pagoPlanillaId String?
  pagoPlanilla   PagoPlanilla? @relation("ComisionesDelPago", fields: [pagoPlanillaId], references: [id], onDelete: SetNull)

  liquidadoPor String
  liquidadoEn  DateTime @default(now())

  notas String? @db.Text

  createdAt DateTime @default(now())

  @@index([teamMemberId, periodo])
  @@index([pagoPlanillaId])
}

/// Una cuota de comisión de un vendedor: una venta en un mes (2026-10-06). Nace con el historial que se lleva en Excel
/// (la «Tabla de Comisiones» de cada vendedor: una fila por venta y una columna por mes) y es la base del módulo de
/// comisiones nuevo. Las reglas de hoy (Elías, 2026-10-06): servicio = % × monto del contrato, repartido en los meses
/// del proyecto (5% del vendedor; 2,5% = compartida con Marco, que no la cobra); licencia (Collab) = 10% en tres meses.
/// Cada cuota se paga cuando el cliente paga su factura, a mes vencido, y se corre si el cliente tiene crédito o se atrasa.
///
/// `estado`: PAGADA · NO_PAGADA · POR_CONFIRMAR (lo dudoso del Excel: Dinia o Alex lo confirman con un botón). NO se
/// cruza con `ComisionVendedor` (lo liquidado desde los cobros): son dos registros distintos hasta que el módulo nuevo
/// los una. ⚠ Remuneración: RLS deny-all y solo Super Admin o quien tenga `comisionesVendedor` por persona.
/// SQL: scripts/sql/2026-10-06-cuotas-comision-vendedor.sql.
model CuotaComisionVendedor {
  id            String         @id @default(cuid())
  teamMemberId  String
  teamMember    TeamMember     @relation("CuotasDeComisionVendedor", fields: [teamMemberId], references: [id])
  /// La venta: estable entre importaciones (cliente + fecha de ingreso + tipo, normalizados).
  ventaClave    String
  cliente       String
  /// SERVICIO | LICENCIA
  tipoVenta     String
  /// En puntos porcentuales: 5 = 5%.
  porcentaje    Decimal        @db.Decimal(6, 4)
  montoContrato Decimal?       @db.Decimal(12, 2)
  /// La comisión total de la venta, como la dice el Excel.
  montoComision Decimal?       @db.Decimal(12, 2)
  fechaIngreso  DateTime?      @db.Date
  /// "YYYY-MM": el mes en que toca pagar la cuota.
  periodo       String
  monto         Decimal        @db.Decimal(12, 2)
  moneda        CobranzaMoneda @default(USD)
  /// PAGADA | NO_PAGADA | POR_CONFIRMAR
  estado        String         @default("POR_CONFIRMAR")
  /// Quién dijo que se pagó (o que no). Un import firma «import:…».
  confirmadoPor String?
  confirmadoEn  DateTime?
  /// «import:<archivo>» o «manual».
  origen        String
  /// Lo demás de la fila del Excel (nacionalidad, tiempo de contrato, la celda tal cual).
  detalle       Json?
  notas         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([teamMemberId, ventaClave, periodo])
  @@index([periodo])
}

/// En qué rubro cae un egreso del mes. Espeja `CobranzaCategoriaCosto` y le suma los dos
/// que el burn de hoy no modela como costo recurrente: TARJETA (el cargo propio de la
/// tarjeta, no lo que se paga CON ella) y RESERVA_AGUINALDO (una provisión, no un pago).
/// Los cinco valores nacen juntos aunque hoy solo se escriban tres: un `ALTER TYPE ADD
/// VALUE` posterior no corre en transacción y obliga a coordinar las 2 PCs de esta base.
enum EgresoCategoria {
  PLANILLA // ⛔ prohibido por CHECK — vive en PagoPlanilla (ver el modelo)
  HERRAMIENTA
  FIJO_OPERACION
  TARJETA
  RESERVA_AGUINALDO // ⛔ prohibido por CHECK — se deriva del libro de planilla
}

/// De dónde salió la fila. El sembrado del Excel solo pisa lo que él mismo escribió:
/// una corrección hecha a mano NO se borra en la próxima corrida del importador.
enum EgresoOrigen {
  EXCEL_EGRESOS
  MANUAL
}

// ─── EgresoMensual ──────────────────────────────────────────────────────────────
// EL LIBRO DE EGRESOS: cuánto costó CADA MES, concepto por concepto. Hermano de
// `PagoPlanilla` ("lo que efectivamente se pagó"), no de `CostoRecurrente` ("lo que
// cuesta hoy"). Existe porque el reporte anual de equilibrio necesita la serie del año
// y `CostoRecurrente` no puede darla: guarda el monto de HOY, y `updateCosto` estampa
// `fechaEfectiva = hoy` en cada cambio, así que un burn dibujado hacia marzo mostraría
// el costo de agosto — una línea plana, creíble y falsa (DECISIONS §Planillas, historial
// y la cadencia de cada aliado).
//
// El dato NO es nuevo: el Excel de egresos ya traía la variación mes a mes y el
// importador la leía y la tiraba (`leerCostosFijos` devuelve `meses[]` y se colapsaba a
// la moda; un concepto con monto variable ni se cargaba). Esto lo persiste.
//
// ⛔ PLANILLA y RESERVA_AGUINALDO tienen prohibido entrar acá, con un CHECK en la base:
// la planilla ya vive en `PagoPlanilla` (periodo × quincena × persona) y la reserva se
// deriva de ahí. Escribirlas también acá las contaría DOS VECES en el equilibrio.
//
// ⚠ PRIVACIDAD: lleva la estructura de costos de la empresa y el cargo de las tarjetas.
// Mismo peso que `TarjetaCredito` y `CostoMovimiento`: deny-all RESTRICTIVE en
// prisma/policies.sql + `guardCostosAccess` (SUPER_ADMIN) en toda superficie.
//
// ⚠ NO lleva un flag `completo`/`parcial`: la calidad del mes se DERIVA de qué filas hay
// (lib/finanzas/equilibrio.ts#calidadDelMes). Guardarla la congelaría — el mismo mes
// cambia de calidad cuando llega el dato que le faltaba.
model EgresoMensual {
  id String @id @default(cuid())

  // "YYYY-MM" — mismo vocabulario que Cobro.periodo y PagoPlanilla.periodo, así el
  // reporte filtra los 12 meses con un solo `in` y reusa periodosEntre()/periodoDe().
  periodo   String
  categoria EgresoCategoria

  // El nombre tal como se lee ("Alquiler de Oficina"); `conceptoClave` es la versión
  // normalizada que se compara. Mismo par que PartnerComercial.nombre/clave: sin él,
  // una tilde distinta parte la serie del mismo concepto en dos.
  concepto      String
  conceptoClave String

  monto          Decimal        @db.Decimal(12, 2)
  moneda         CobranzaMoneda
  // El decodificador ya lo calcula y hasta hoy se descartaba: la hoja no siempre dice la
  // moneda y a veces se infiere del formato. Alimenta el aviso de calidad del reporte.
  monedaInferida Boolean        @default(false)

  origen EgresoOrigen @default(EXCEL_EGRESOS)

  // nullable porque el Excel nombra conceptos que ya se dieron de baja o que nunca se
  // cargaron como costo vigente. SetNull: borrar el costo no borra lo que ya se gastó.
  costoId String?
  costo   CostoRecurrente? @relation("EgresosDelCosto", fields: [costoId], references: [id], onDelete: SetNull)

  // De qué celda salió: "Egresos y Costos 2026 · Costos Fijos · fila 15 · col K".
  // nullable porque una fila MANUAL no viene de ninguna hoja. Hace que la fila se audite
  // sola sin volver a abrir el archivo.
  fuente String?
  // Por qué el importador NO lo carga como costo recurrente (monto variable mes a mes,
  // por ejemplo). La fila es un HECHO; que sume o no lo decide el módulo puro.
  notas  String? @db.Text

  registradoPor String // "import:egresos-2026" o el email del guard
  registradoEn  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotencia del sembrado: re-correr el importador actualiza, nunca duplica.
  @@unique([periodo, categoria, conceptoClave])
  @@index([periodo])
  @@index([costoId])
}

// ─── TipoCambioMes ──────────────────────────────────────────────────────────────
// UN tipo de cambio por mes, tecleado por una persona, con su fuente escrita.
//
// ⚠ Esto NO levanta la prohibición de FX del módulo: la ACOTA. La base sigue guardando
// todo en moneda nativa y NINGÚN motor convierte —engine, tarjetas, comisiones, partners,
// planilla, aguinaldo—. La única licencia para convertir es la capa de PRESENTACIÓN del
// reporte anual de equilibrio, en una sola función (lib/finanzas/equilibrio.ts#convertir),
// declarando siempre con qué tasa. Ver DECISIONS §El reporte anual de equilibrio.
//
// Sin tasa para un mes NO se aproxima con la de otro: el monto queda sin convertir, fuera
// del total, y el reporte lo lista.
//
// ⚠ SIN deny-all RESTRICTIVE, a propósito: una tasa de cambio publicada no es información
// sensible. Mismo criterio que `PartnerComercial`. RLS habilitado igual.
model TipoCambioMes {
  id      String @id @default(cuid())
  periodo String @unique // "YYYY-MM"

  // Colones por UN dólar. Decimal(12,4) y NO (12,2) como el dinero: una tasa no es un
  // monto, y truncarla a centavos mete error sistemático en cada conversión del año.
  crcPorUsd Decimal @db.Decimal(12, 4)

  // Obligatoria y en texto libre: "BCCR venta, promedio del mes", "el 500 con que se arma
  // la hoja". Un número sin procedencia no se puede auditar ni discutir.
  fuente String

  registradoPor String
  registradoEn  DateTime
  notas         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// El tipo de cambio del dólar de CADA DÍA, como lo publica el BCCR (2026-10-05, lib/finanzas/tipo-cambio.ts). Lo trae
// el job diario `tipo-cambio-daily` (del servicio del BCCR con `BCCR_TOKEN`, o del API de Hacienda). Un movimiento con
// fecha se convierte con la tasa de su día; un mes, con el promedio de sus días. `TipoCambioMes` queda de respaldo para
// los meses que todavía no tienen días traídos. Sin deny-all, como TipoCambioMes: una tasa publicada no es sensible.
model TipoCambioDia {
  fecha    String   @id // "YYYY-MM-DD", día de Costa Rica
  // Colones por dólar. La VENTA de referencia es la que se usa (la que pide Hacienda); la compra solo se muestra.
  venta    Decimal  @db.Decimal(12, 4)
  compra   Decimal? @db.Decimal(12, 4)
  fuente   String // "BCCR" | "HACIENDA" — CHECK en la DB
  traidoEn DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// En qué estado está una venta ganada respecto de HubSpot. NO es la etapa del trato:
/// es qué sabemos de él la última vez que miramos.
/// Qué es un negocio ganado para las comisiones (2026-10-21). Sale de `motion_comercial` en HubSpot: «Recuperación» es NUEVO.
enum TipoDeNegocio {
  NUEVO
  EXPANSION
  RENOVACION
}

enum VentaGanadaEstado {
  GANADA // vigente y ganada, lo normal
  REABIERTA // volvió a una etapa abierta: dejó de ser venta
  PERDIDA // pasó a perdida después de estar ganada
  DESAPARECIDA // ya no vuelve de HubSpot (borrada o fuera de alcance). NUNCA se borra la fila.
}

/// Qué cambió en una venta entre dos corridas del sync.
enum VentaGanadaCambioTipo {
  ALTA
  MONTO // el caso REAL: 27 de 49 tratos ganados de 2026 tienen el monto editado
  FECHA_CIERRE
  ESTADO
  CLIENTE // se resolvió (o cambió) a qué cliente de Nexus pertenece
}

// ─── VentaGanada ────────────────────────────────────────────────────────────────
// EL ESPEJO DE LO VENDIDO: un trato ganado de HubSpot, copiado a Nexus con su fecha de
// cierre. Es el dato que el sistema no tenía — `ServicioContratado` sabe cuánto se
// factura pero no cuándo se vendió, y `fechaInicioFacturacion` no sirve para eso (es la
// fecha del primer cobro importado, por eso los 55 servicios "arrancan" en 2026).
//
// ⚠ POR QUÉ SE COPIA Y NO SE CONSULTA EN VIVO: el reporte no puede depender de que
// HubSpot conteste. Además el vendido del año es un número VIVO —27 de 49 tratos de 2026
// tienen el monto editado después de ganarse, uno pasó por 7 versiones— así que hace
// falta bitácora para saber cuándo se movió y por qué.
//
// ⚠ MONEDA: se guarda la NATIVA (un trato está en ₡3.060.416) más el convertido que trae
// HubSpot, SOLO como control. El reporte convierte con `TipoCambioMes` como todo lo demás
// del módulo — las dos cifras difieren (HubSpot usa ~455, Nexus 500) y el reporte lo
// declara en vez de elegir en silencio.
//
// ⚠ PRIVACIDAD: son montos de venta. Deny-all RESTRICTIVE, mismo peso que EgresoMensual.
model VentaGanada {
  id String @id @default(cuid())

  /// El trato en HubSpot. Es la identidad: re-sincronizar actualiza, nunca duplica.
  hubspotDealId String @unique
  nombre        String

  /// LA FECHA QUE NO EXISTÍA EN NEXUS. Verificada contra el historial de etapas: en los
  /// 49 tratos ganados de 2026 coincide exacto con la primera transición a ganado.
  fechaCierre DateTime  @db.Date
  /// El momento en que el trato entró a una etapa ganada, leído del historial. Es la
  /// única corroboración independiente de `fechaCierre`: si dejan de coincidir es porque
  /// alguien editó la fecha a mano, y eso hay que poder verlo.
  ganadaEn    DateTime?

  /// Monto en la moneda del trato, tal como está en HubSpot.
  /// nullable porque 13 de 80 tratos ganados de 2026 NO tienen monto cargado — todos del
  /// pipeline de venta compartida. Guardarlos en cero diría que la venta vale cero, y
  /// rechazarlos los haría invisibles: la venta existe, lo que falta es el número.
  monto                  Decimal? @db.Decimal(14, 2)
  moneda                 String
  /// Lo que HubSpot dice que vale en la moneda de la casa. NO se suma: es control. Cuando
  /// difiere de lo que da TipoCambioMes, el reporte muestra las dos.
  montoConvertidoHubspot Decimal? @db.Decimal(14, 2)

  /// El pipeline crudo. Se guarda SIEMPRE, aunque hoy no se cuente: "HubSpot Shared
  /// Selling" es registro de oportunidad con HubSpot y no facturación propia, pero si
  /// mañana se decide contarlo, el dato ya está y no hay que volver a traer nada.
  pipelineId    String
  pipelineLabel String?
  etapaId       String

  estado VentaGanadaEstado @default(GANADA)

  // nullable porque 42 de 222 tratos ganados no resuelven a ningún cliente de Nexus, y
  // porque la venta existe aunque nadie la haya dado de alta en cobranza. SetNull:
  // borrar el cliente no borra el registro de que esa venta ocurrió.
  clientId         String?
  client           Client? @relation("VentasDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  /// Cómo se resolvió el cliente: por la empresa de HubSpot, o por el nombre del trato.
  /// Resolver por NOMBRE es en sí un hallazgo — significa que la venta está colgada de
  /// otra empresa que la que factura (empresa duplicada, o la madre de un grupo: la venta
  /// de Analisalab vive en "Grupo Inve", la de Corrugando en ACCCSA).
  clienteVia       String?
  /// La empresa de HubSpot asociada al trato, aunque no resuelva a ningún cliente.
  hubspotCompanyId String?

  /// Quién vendió: el dueño del trato en HubSpot (`hubspot_owner_id`), guardado aunque no sea
  /// nadie de Nexus. Es lo que permite medir lo vendido por persona (2026-10-08).
  hubspotOwnerId String?
  // nullable porque el dueño puede no estar en Nexus (o el trato no tener dueño). Se resuelve
  // por el correo del dueño, también para quien ya se fue del equipo. SetNull: borrar a la
  // persona no borra la venta.
  vendedorId     String?
  vendedor       TeamMember? @relation("VentasDelVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)

  /// Qué es el negocio (2026-10-21, modelo de comisiones): la propiedad `motion_comercial` del trato en HubSpot.
  // nullable porque nadie lo marcó todavía en la mayoría de los tratos: la simulación lo deduce.
  tipoDeNegocio               TipoDeNegocio?
  /// Con quién se compartió, según «Venta compartida con» (`venta_compartida_con`) al entrar a ganado.
  compartidaConHubspotOwnerId String?
  // nullable porque casi ninguna venta se comparte, y la persona puede no estar en Nexus. SetNull: borrar a la
  // persona no borra la venta.
  compartidaConId             String?
  compartidaCon               TeamMember?    @relation("VentasCompartidas", fields: [compartidaConId], references: [id], onDelete: SetNull)
  /// La marca de compartida se puso o cambió después de la firma: no vale, y la simulación lo dice.
  compartidaDespuesDeLaFirma  Boolean        @default(false)

  /// El nombre huele a prueba ("Negocio para prueba (Nexus)"). La regex MARCA; una
  /// persona decide. Son dos campos y no uno a propósito: sospechar no es excluir.
  sospechaPrueba Boolean @default(false)
  excluida       Boolean @default(false)
  excluidaMotivo String?

  sincronizadoEn DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cambios             VentaGanadaCambio[] @relation("CambiosDeVenta")
  /// Las fotos de la escala que se amarraron a esta venta (VersionDeLaEscala, 2026-10-18).
  versionesDeLaEscala VersionDeLaEscala[]

  @@index([fechaCierre])
  @@index([clientId])
  @@index([estado, fechaCierre])
  @@index([vendedorId])
  @@index([compartidaConId])
}

// ─── NegocioAbierto ─────────────────────────────────────────────────────────────
/// Un negocio ABIERTO de HubSpot (2026-10-14, «Para ti» por equipo, docs/mi-dia-plan.md). Espejo de solo lectura de
/// los tres pipelines de venta propia, para que «Para ti» de Ventas muestre los cierres más cerca, la cartera y lo
/// ponderado sin preguntarle a HubSpot en cada visita. Lo copia lib/ventas/sync-negocios-abiertos.ts.
/// La fila nunca se borra: un negocio que dejó de volver (ganado, perdido o borrado) queda `abierto = false`.
/// Lo ganado sigue en `VentaGanada`. SQL: scripts/sql/2026-10-14-negocios-abiertos.sql (RLS + deny).
model NegocioAbierto {
  id                     String      @id @default(cuid())
  hubspotDealId          String      @unique
  nombre                 String
  pipelineId             String
  pipelineLabel          String?
  etapaId                String
  etapaLabel             String?
  /// `hs_deal_stage_probability`, de 0 a 1. null = HubSpot no la dio.
  probabilidad           Float?
  /// La fecha de cierre, como día de calendario. null = el negocio no tiene.
  fechaCierre            DateTime?   @db.Date
  /// En la moneda del negocio, tal como está en HubSpot. null = sin monto (no es cero).
  monto                  Decimal?    @db.Decimal(14, 2)
  moneda                 String      @default("USD")
  /// `hs_next_step`: lo llena HubSpot (o la persona). Nexus lo lee como sugerencia y NUNCA lo escribe.
  siguientePasoHubspot   String?     @db.Text
  /// `notes_next_activity_date` y `notes_last_updated`: la próxima actividad agendada y la última registrada.
  proximaActividadAt     DateTime?
  ultimaActividadAt      DateTime?
  creadoEnHubspot        DateTime?
  /// El dueño del negocio en HubSpot, guardado aunque no sea nadie de Nexus.
  hubspotOwnerId         String?
  // nullable porque el dueño puede no estar en Nexus. SetNull: borrar a la persona no borra el negocio.
  vendedorId             String?
  vendedor               TeamMember? @relation("NegociosDelVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  /// La empresa primaria del negocio en HubSpot y su nombre, aunque no sea un cliente de Nexus.
  hubspotCompanyId       String?
  empresaNombre          String?
  // nullable porque la empresa puede no estar en Nexus. SetNull: borrar el cliente no borra el negocio.
  clientId               String?
  client                 Client?     @relation("NegociosDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  /// false = dejó de volver como abierto en la última copia completa (se ganó, se perdió o se borró).
  abierto                Boolean     @default(true)
  cerradoEn              DateTime?
  /// «Ahora no» de la pregunta de cierre y monto: no se vuelve a preguntar hasta esta fecha.
  preguntaPospuestaHasta DateTime?
  /// Lo que propuso Nexus para la fecha y el monto, con la frase de donde salió (lib/ventas/propuesta-de-cierre.ts).
  propuesta              Json?
  /// Quién respondió la última pregunta desde Nexus (lo que se escribió en HubSpot) y cuándo.
  respondidoPor          String?
  respondidoAt           DateTime?
  sincronizadoEn         DateTime
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([vendedorId, abierto])
  @@index([clientId])
  @@index([hubspotCompanyId])
}

// ─── SiguientePaso ──────────────────────────────────────────────────────────────
/// El siguiente paso de un equipo (Ventas, CS o Dev) sobre una empresa, un negocio o un proyecto (2026-10-15,
/// etapa 2 de docs/mi-dia-plan.md). Cada cambio es una fila: la historia queda en Nexus y el vigente de cada
/// objeto y equipo se escribe en las propiedades «siguiente_paso_<equipo>» de HubSpot (lib/siguiente-paso).
/// Un vigente por objeto y equipo: lo asegura un índice único parcial del SQL (Prisma no los modela).
/// SQL: scripts/sql/2026-10-15-siguiente-paso.sql (RLS + deny).
/// ⚠ Desde el 2026-10-16 (fase 0.2 de docs/nexus-sistema-de-trabajo-plan.md) el siguiente paso ES UNA TAREA (la próxima
/// abierta con fecha del sprint del equipo) y esta tabla es la COPIA de lo que está escrito en HubSpot, con la tarea de
/// la que salió (`tareaId`). Ya no se escribe a mano: la pone al día lib/siguiente-paso/escritura-server.ts.
model SiguientePaso {
  id                 String    @id @default(cuid())
  /// empresa | negocio | proyecto
  objeto             String
  /// El id de Nexus: Client.id, NegocioAbierto.id o Project.id. Sin FK: son tres tablas distintas.
  objetoId           String
  /// ventas | cs | dev
  equipo             String
  que                String    @db.Text
  /// Para cuándo, como día de calendario. null = sin fecha.
  fecha              DateTime? @db.Date
  /// Quién lo lleva (correo de Nexus) y su usuario de HubSpot, si lo tiene.
  responsableEmail   String?
  responsableOwnerId String?
  /// Quién lo escribió: el correo de la persona, o «hubspot» si se cambió allá.
  escritoPor         String
  /// persona | chat | reunion | hubspot
  fuente             String
  /// vigente | hecho | reemplazado
  estado             String    @default("vigente")
  cerradoPor         String?
  cerradoAt          DateTime?
  /// Dónde vive en HubSpot: companies | deals | 0-970, y su id. null = el objeto no está en HubSpot.
  hubspotObjectType  String?
  hubspotObjectId    String?
  /// pendiente | escrito | error | sin_hubspot. Lo que dice HubSpot de este paso (el vigente) o de su cierre.
  hubspotEstado      String    @default("pendiente")
  hubspotError       String?
  hubspotEscritoAt   DateTime?
  hubspotIntentos    Int       @default(0)
  // nullable porque un negocio puede no tener cliente en Nexus. SetNull: borrar el cliente no borra la historia.
  clientId           String?
  client             Client?   @relation("SiguientesPasosDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  /// Desde el 2026-10-16 (fase 0.2) el siguiente paso es una TAREA y esta tabla es la copia de lo que está escrito en
  /// HubSpot: la tarea de la que salió. null en lo de antes y en lo que escribieron en HubSpot sin tarea.
  // nullable por eso; SetNull: archivar o fusionar la tarea no borra lo que se escribió en HubSpot.
  tareaId            String?
  tarea              Tarea?    @relation("PasosEnHubspot", fields: [tareaId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([objeto, objetoId, equipo, estado])
  @@index([clientId, estado])
  @@index([tareaId])
  @@index([responsableEmail, estado])
  @@index([hubspotEstado])
}

// ─── MetaComercial ──────────────────────────────────────────────────────────────
/// Una meta comercial de HubSpot (un «goal target»): cuánto tiene que vender una persona en un tramo
/// de tiempo y cuánto lleva según HubSpot. Espejo de SOLO LECTURA (lib/ventas/metas-sync.ts), para que
/// cualquier parte de Nexus lea las metas sin preguntarle a HubSpot. Una meta anual con cadencia
/// trimestral son cuatro filas: el total de la persona se suma al leer (lib/ventas/metas.ts).
/// SQL: scripts/sql/2026-10-08-metas-y-vendedor.sql (RLS + deny).
model MetaComercial {
  id                  String      @id @default(cuid())
  hubspotGoalTargetId String      @unique
  /// `hs_group_correlation_uuid`: la meta a la que pertenece este tramo.
  hubspotGoalId       String?
  /// `hs_goal_name`, tal cual («OFICIAL | META 2026 - SMARTEAM»).
  nombre              String
  /// `hs_goal_type`: cuota de ventas, llamadas, etc. Texto: HubSpot suma tipos sin avisar.
  tipo                String?
  hubspotOwnerId      String?
  hubspotUserId       String?
  // nullable porque una meta puede ser de un equipo o de alguien que no está en Nexus. SetNull:
  // borrar a la persona no borra la meta.
  teamMemberId        String?
  teamMember          TeamMember? @relation("MetasDelVendedor", fields: [teamMemberId], references: [id], onDelete: SetNull)
  desde               DateTime
  hasta               DateTime
  monto               Decimal     @db.Decimal(14, 2)
  /// `hs_kpi_value`: lo que HubSpot dice que lleva. null = HubSpot no lo calculó.
  avance              Decimal?    @db.Decimal(14, 2)
  moneda              String      @default("USD")
  /// `hs_status`: pending · in_progress · achieved · exceeded · missed. Texto, no enum.
  estado              String?
  /// false = HubSpot dejó de devolverla (se borró o se archivó). La fila nunca se borra.
  vigente             Boolean     @default(true)
  sincronizadoEn      DateTime
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([teamMemberId])
  @@index([desde])
}

// ─── VentaGanadaCambio ──────────────────────────────────────────────────────────
// Historia APPEND-ONLY de lo que se movió en una venta (patrón CostoMovimiento).
// ⚠ Existe por el riesgo MEDIDO, no por el imaginado: cero de 121 tratos con cierre en
// 2026 fueron reabiertos, pero 27 de 49 tienen el monto editado —varios el mismo día del
// cierre o después— y uno pasó por siete versiones. Sin esta tabla, el vendido del año
// cambia solo y nadie sabe cuándo ni cuánto.
model VentaGanadaCambio {
  id String @id @default(cuid())

  // nullable + SetNull: la historia sobrevive si algún día se borra la venta.
  ventaId String?
  venta   VentaGanada? @relation("CambiosDeVenta", fields: [ventaId], references: [id], onDelete: SetNull)

  /// Snapshot autosuficiente: la fila se lee sola aunque la venta cambie o se borre.
  hubspotDealId String
  nombre        String

  tipo     VentaGanadaCambioTipo
  anterior String? // el valor de antes, como texto (sirve para monto, fecha y estado)
  nuevo    String?

  detectadoEn DateTime @default(now())

  @@index([ventaId])
  @@index([detectadoEn])
}

// ── Roles (roles y responsabilidades del equipo) ────────────────────────────────
// Documento de PUESTO libre (no atado al enum TeamRole ni a un TeamMember) que se
// documenta a mano y se renderiza como una página web resumida. DOS plantillas, que
// elige `docType`: PERFIL (11 secciones, fuente única ROLE_SECTIONS en
// lib/roles/schema.ts) y PROPUESTA (10, PROPUESTA_SECTION_DEFS). La IA PROPONE desde el
// 2026-07-20 (assist de documento, POST /api/roles/[id]/assist — el humano revisa y
// aplica; en PROPUESTA todavía 409). ESCRIBIR es solo de dirección (guardRolesAdmin);
// LEER se comparte: `RoleProfileShare` (read-only, filtro visibleRoleWhere) y el
// `publicToken` de abajo (link público sin login). La RLS deny-all sigue siendo contra el
// `anon` de Supabase — no contra roles internos (Prisma bypassa RLS).
/// Qué CLASE de documento es una fila de RoleProfile. Comparten storage (el mismo mapa Json
/// de secciones) y cambian de PLANTILLA al renderizar: PERFIL usa la config de roles,
/// PROPUESTA la de propuesta (que reusa 7 de sus secciones y suma oferta económica).
enum RoleDocType {
  PERFIL
  PROPUESTA
}

model RoleProfile {
  id             String      @id @default(cuid())
  docType        RoleDocType @default(PERFIL)
  title          String // nombre del puesto (ej. "CSE", "Asistente de Finanzas")
  area           String? // área/equipo (ej. "Customer Success") — opcional
  summary        String?     @db.Text // resumen de 1 línea (subtítulo del hero)
  // Contenido estructurado por sección: mapa { [sectionKey]: data } que consume el
  // motor de landing (LandingView + config de roles). Reemplazó a las 7 columnas markdown;
  // hoy son 11 secciones (ROLE_SECTIONS), con el bloque 4DX en el medio (WIG, medidas de
  // predicción y de arrastre, marcador y cadencia). Cada sección guarda su
  // propio shape (prose {md}, cards {items}, medidas, marcador, niveles). Ver
  // components/landing/configs/roles.defs.ts. Reusa la PRESENTACIÓN/EDICIÓN del motor,
  // NO el motor de datos (ProjectCanvas/CanvasBlock) — decisión en docs/DECISIONS.md.
  content        Json        @default("{}")
  active         Boolean     @default(true)
  order          Int         @default(0)
  createdByEmail String? // quién lo creó (auditoría liviana)

  // Link PÚBLICO oculto: `publicToken` ES la capability (64 hex = 256 bits). null = no
  // publicado; revocar = ponerlo en null. Los otros dos son AUDITORÍA y nunca se consultan
  // como gate: dos fuentes para el mismo bit divergen (§2.1).
  publicToken            String?   @unique
  publicPublishedAt      DateTime?
  publicPublishedByEmail String?

  shares RoleProfileShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// El asistente que conversa: un hilo por documento y por persona.
  hilosDeChat HiloDeChat[]

  @@index([active, order])
}

/// Un documento de /roles compartido de SOLO LECTURA con una persona del equipo.
/// Sin GRANT/REVOKE (a diferencia de ClientAssignment): acá el default es "solo Super Admin",
/// así que no hay acceso heredado que revocar — la fila ES el acceso.
model RoleProfileShare {
  id             String      @id @default(cuid())
  roleId         String
  role           RoleProfile @relation(fields: [roleId], references: [id], onDelete: Cascade)
  teamMemberId   String
  teamMember     TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  grantedByEmail String // quién lo compartió (auditoría)
  createdAt      DateTime    @default(now())

  @@unique([roleId, teamMemberId])
  // El @@unique lidera por roleId: NO sirve para el filtro por PERSONA (la lista visible y
  // el "¿tengo algo compartido?" del sidebar), que es el camino caliente.
  @@index([teamMemberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EL ASISTENTE QUE CONVERSA — un hilo por proyecto y documento.
//
// El CSE habla con el asistente ANTES de pedir un cambio: pregunta qué se puede, el
// asistente le dice qué cuesta cada cosa, y recién con el acuerdo se emite la instrucción
// que va al modificador de siempre. ⛔ EL CHAT NO ESCRIBE EL DOCUMENTO: aplicar pasa por el
// editor, con su vista previa y su aceptación por ítem. El permiso vive en el botón.
//
// ⚠ EL CONTEXTO NO SE GUARDA. Se re-arma en cada turno a propósito: guardarlo son cientos de
// KB por día que nadie lee, y miente en cuanto el CSE confirma un bloque del handoff o toca
// una fase. Lo que sí se guarda es la HUELLA del prefijo (`shaDeContexto`), para saber si
// cambió entre dos turnos sin tener que conservarlo.
// ─────────────────────────────────────────────────────────────────────────────

/// Quién habló en un turno. Sin variante de sistema: los avisos de la interfaz no son mensajes.
enum RolDeMensaje {
  CSE
  ASISTENTE
}

model HiloDeChat {
  id String @id @default(cuid())

  /// ⭐ DUEÑO FLEXIBLE: el hilo cuelga de un Project (kickoff, cronograma, entrega…), de un
  /// BusinessCase (la propuesta comercial) o de un RoleProfile (perfil de puesto y propuesta
  /// laboral). EXACTAMENTE UNO seteado — validado en código, mismo patrón que `ProjectCanvas`.
  ///
  /// ⚠ `projectId` nació NOT NULL y se aflojó el 2026-08-22: hasta entonces el chat solo existía
  /// sobre documentos de proyecto. Los otros dos usan el MISMO motor de páginas y la misma
  /// maquinaria de consenso, así que darles un hilo propio era inventar una segunda tabla para lo
  /// mismo. Las tres relaciones conservan su `Cascade`: borrar el dueño se lleva la conversación.
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessCaseId String?
  businessCase   BusinessCase? @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  roleId         String?
  role           RoleProfile?  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// La cuenta (2026-10-17, ficha H): el chat de Nexus (lib/nexus-chat) conversa sobre UNA empresa, un hilo por
  /// cuenta y por persona con la pieza «nexus». Los otros tres dueños van en null.
  clientId       String?
  client         Client?       @relation("HilosDeChatDeLaCuenta", fields: [clientId], references: [id], onDelete: Cascade)

  /// Sobre QUÉ documento se conversa — el slug de la pieza (`lib/pieces/registry.ts`).
  /// Un hilo por proyecto y documento: hablar del cronograma y del kickoff son dos
  /// conversaciones, y mezclarlas haría que el asistente arrastre contexto ajeno.
  pieza String

  /// ⚠ NOT NULL a propósito: el chat NO tiene variante de sistema. Nullable inventaría un
  /// estado que no existe y obligaría a todos los lectores a manejar un caso imposible.
  usuarioEmail String

  /// ⛔ FIJO POR HILO. El modelo es parte de la clave de la caché de prompt: cambiarlo a
  /// mitad de una conversación invalida la caché entera y se paga el prefijo de nuevo, sin
  /// error y sin log. Un hilo nuevo es la forma de cambiar de modelo.
  modelo String

  /// El último `AgentRun` que este hilo produjo, cuando el CSE aceptó una propuesta. Nullable
  /// porque la mayoría de los hilos conversan y no aplican nada — y ese es el denominador de
  /// la única métrica que importa acá: cuántas conversaciones terminan en un cambio.
  ultimoRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensajes MensajeDeChat[]

  /// El camino caliente es «el hilo abierto de ESTE documento para ESTA persona».
  @@index([projectId, pieza, usuarioEmail])
  /// El camino caliente de los otros dos dueños, igual que el de arriba.
  @@index([businessCaseId, pieza, usuarioEmail])
  @@index([roleId, pieza, usuarioEmail])
  @@index([clientId, pieza, usuarioEmail])
}

model MensajeDeChat {
  id     String     @id @default(cuid())
  hiloId String
  hilo   HiloDeChat @relation(fields: [hiloId], references: [id], onDelete: Cascade)

  rol       RolDeMensaje
  contenido String       @db.Text

  /// Huella del prefijo de contexto con el que se produjo este turno. Si cambia entre dos
  /// turnos, el asistente estuvo mirando cosas distintas — y eso explica una respuesta que
  /// de otro modo se lee como incoherente. Solo en los turnos del asistente.
  shaDeContexto String?

  /// La llamada al modelo que produjo este turno, para cruzar con el medidor de gasto
  /// (`LlmCall`). Nullable: los turnos del CSE no cuestan nada.
  llmCallId String?

  createdAt DateTime @default(now())

  /// El orden de los turnos es estricto y se lee siempre completo, del más viejo al más nuevo.
  @@index([hiloId, createdAt])
}

/// ¿Esta licitación es para nosotros?
///
/// ⛔ FUERA no es "malo": es DESTRUCTIVO. El tablero de SICOP esconde por default lo marcado
/// FUERA, así que un falso positivo no se lee como un error sino como que la licitación nunca
/// existió. El prompt empuja a DUDOSO ante cualquier duda, y el default de un dato roto
/// (enum inválido devuelto por el modelo) también es DUDOSO — nunca el que esconde.
enum SicopEncaje {
  DENTRO
  DUDOSO
  FUERA
}

/// Lo que la IA entendió leyendo un ticket del pipeline «Gobiernos»: título, descripción y
/// TODAS sus notas. Las notas son la fuente rica —ahí están los requisitos de admisibilidad,
/// la forma de cotizar, las garantías y la tecnología obligatoria— y hasta hoy solo servían
/// si alguien las leía enteras adentro de HubSpot.
///
/// ⚠ ES UN CACHÉ, NO UNA FUENTE. HubSpot sigue siendo el dueño del dato; acá vive solo la
/// interpretación. Se puede borrar entera sin perder nada que no se pueda recalcular (cuesta
/// una corrida de IA, no información). Por eso no hay FK: la identidad es el id del ticket.
model SicopLectura {
  id String @id @default(cuid())

  /// El ticket en HubSpot. Es la identidad: re-analizar actualiza, nunca duplica.
  hubspotTicketId String @unique

  /// Huella del TEXTO QUE SE LEYÓ (título + descripción + notas), no del ticket. Así una nota
  /// nueva invalida el análisis y un cambio que no toca lo leído —mover de etapa, cambiar el
  /// responsable— NO lo invalida. Sin esa distinción, arrastrar una tarjeta en HubSpot
  /// re-analizaría el pipeline entero.
  fuenteSha       String
  /// 0 = se leyó solo el título. La pantalla lo dice: una conclusión sacada de un título no
  /// vale lo mismo que una sacada del cartel resumido en las notas.
  notasLeidas     Int     @default(0)
  /// ⚠ EL CARTEL SUELE SER UN PDF: 30 de las 61 notas del pipeline no tienen texto, son
  /// archivos adjuntos. Guardar cuántos quedaron sin leer separa "no había información" de
  /// "la información está ahí y nadie se la pasó al modelo" — en pantalla se ven igual.
  adjuntosSinLeer Int     @default(0)
  /// La fuente se recortó por tamaño: hay texto que el modelo NO vio.
  fuenteTruncada  Boolean @default(false)

  // ── De qué es ─────────────────────────────────────────────────────────────────
  objeto      String?  @db.Text
  institucion String?
  /// Vocabulario CERRADO (lib/ventas/sicop-orden.ts). Array porque una contratación de
  /// "sitio web + hosting + capacitación" es las tres cosas.
  categorias  String[] @default([])

  // ── ¿Es para nosotros? ────────────────────────────────────────────────────────
  encaje        SicopEncaje @default(DUDOSO)
  encajeRazon   String?     @db.Text
  puntajeEncaje Int?

  // ── ¿Lo podemos ganar? ────────────────────────────────────────────────────────
  /// Nullable a propósito: cuando el texto no alcanza, el modelo lo OMITE en vez de adivinar.
  /// Un 50 inventado es peor que un hueco, porque ordena.
  probabilidad      Int?
  probabilidadRazon String? @db.Text
  /// [{ titulo, detalle, severidad: BLOQUEA|RIESGO }]
  bloqueantes       Json?

  // ── Cómo se evalúa y qué hay que entregar ─────────────────────────────────────
  evaluacion  String? @db.Text
  /// % del puntaje que se lleva el precio. 100 = subasta pura. null = el cartel no lo dice.
  pesoPrecio  Int?
  entregables String? @db.Text
  /// [{ etiqueta, fecha: "AAAA-MM-DD"|null, nota }]
  plazos      Json?

  // ── Plata ─────────────────────────────────────────────────────────────────────
  /// ⚠ ESTIMACIÓN leída de prosa, no un monto contratado: no se suma ni se factura. Ordena.
  monto  Decimal? @db.Decimal(16, 2)
  moneda String?

  // ── Trazabilidad ──────────────────────────────────────────────────────────────
  /// Cuánta información REAL había para leer (0-100). No es cuán segura suena la conclusión.
  confianza      Int?
  /// ¿La conclusión salió del CARTEL o solo del título y las notas? Sin esto, una ficha leída
  /// a fondo y una leída del título pelado se ven idénticas en pantalla, y no valen lo mismo.
  profundo       Boolean  @default(false)
  adjuntosLeidos Int      @default(0)
  modelo         String?
  analizadoEl    DateTime
  /// El análisis falló. La fila se guarda igual: sin ella la pantalla diría "sin analizar"
  /// para siempre y nadie sabría que se intentó.
  error          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([encaje])
}

/// En qué estado está el intento de leer un archivo adjunto de una licitación.
///
/// ⚠ SIN_TEXTO y ERROR dicen cosas distintas. SIN_TEXTO es el caso NORMAL de los carteles del
/// Estado: un PDF escaneado del que no hay nada que extraer sin OCR. ERROR es que algo se
/// rompió. Juntarlos haría que «la mitad del pipeline necesita OCR» se leyera como «la
/// integración está fallando».
enum SicopAdjuntoEstado {
  PENDIENTE
  EXTRAIDO
  SIN_TEXTO
  SIN_PERMISO
  DEMASIADO_GRANDE
  ERROR
}

/// Un archivo colgado de una nota de licitación — casi siempre EL CARTEL.
///
/// Medido el 2026-08-23: de 58 notas del pipeline «Gobiernos», 33 llevan archivo y 30 no tienen
/// una sola letra de texto. Esta tabla guarda el texto que se le extrae a cada uno.
///
/// ⛔ NO guarda el binario. El archivo vive en HubSpot; Nexus lo baja en memoria, le saca el
/// texto con `lib/documents/extract-text.ts` y lo tira.
model SicopAdjunto {
  id String @id @default(cuid())

  /// Se guarda el TICKET además de la nota porque la pantalla pregunta siempre por ticket, y
  /// las notas no se persisten (HubSpot es su dueño), así que no hay por dónde hacer el join.
  hubspotTicketId String
  hubspotNoteId   String
  hubspotFileId   String

  nombre      String?
  extension   String?
  mimeType    String?
  tamanoBytes Int?
  /// ⚠ La que devuelve la API de HubSpot, nunca armada a mano. Sin el scope `files` queda null
  /// y la pantalla enlaza al ticket, que siempre existe.
  urlHubspot  String?

  estado     SicopAdjuntoEstado @default(PENDIENTE)
  /// Lo único que se guarda del archivo. El extractor corta en 50.000 caracteres.
  texto      String?            @db.Text
  caracteres Int                @default(0)
  error      String?            @db.Text

  intentadoEl DateTime?
  extraidoEl  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// (ticket, archivo) y no el archivo solo: el mismo PDF puede colgar de dos licitaciones
  /// —pasa con los carteles marco— y con la clave en el archivo, la segunda no lo vería.
  @@unique([hubspotTicketId, hubspotFileId])
  @@index([hubspotTicketId])
  @@index([estado])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ESPEJO DE ODOO — solo lectura. Ver docs/odoo-integracion-plan.md
//
// Odoo es dueño de los HECHOS (factura emitida, pago recibido, IVA); Nexus sigue siendo
// dueño de la INTENCIÓN (qué debería facturarse y cuándo — el `Cobro` con su
// `fechaProgramada`, que Odoo no conoce). El espejo COMPLETA el modelo, no lo reemplaza,
// y Nexus NUNCA escribe hacia Odoo.
//
// Molde: `VentaGanada` — identidad por id externo con @unique de UNA columna, nunca borra
// sino que marca, y bitácora aparte. NO se usa el par fuente/fuenteIdExterno: ya está
// ocupado con "sheet" en 45 de 49 cuentas y es un solo par por fila.
// ═══════════════════════════════════════════════════════════════════════════════

enum FacturaOdooEstadoEspejo {
  VIGENTE // vuelve del sync, normal
  DESAPARECIDA // ya no vuelve de Odoo. NUNCA se borra la fila.
}

enum FacturaOdooCambioTipo {
  ALTA
  MONTO
  RESIDUAL
  ESTADO_PAGO // payment_state
  ESTADO // state (draft/posted/cancel)
  FECHA
  CUENTA // se resolvió o cambió a qué CuentaFinanciera pertenece
  DESAPARECIDA
  // ⚠ NETO y MONEDA se agregaron el 2026-09-03. Sin ellos `calcularDeltas` no los comparaba, y
  // como el UPDATE de la factura solo corre cuando hay algún delta, una corrección de esos dos
  // campos en Odoo NUNCA llegaba al espejo. `montoNeto` es el que se compara contra Cobro.monto.
  NETO
  MONEDA
}

enum OdooVinculoVia {
  CEDULA // por vat — la única señal sin falsos positivos
  MONTO // por monto exacto de factura — la más productiva (17 candidatos contra 6 del nombre)
  NOMBRE // la más débil acá: Odoo guarda razón social y Nexus nombre comercial
  MANUAL // lo resolvió una persona buscando
}

model FacturaOdoo {
  id String @id @default(cuid())

  /// La factura en Odoo. Es la identidad: re-sincronizar actualiza, nunca duplica.
  odooMoveId   Int    @unique
  numero       String
  moveType     String
  state        String
  paymentState String

  invoiceDate DateTime @db.Date

  /// Se guarda para AUDITAR la diferencia, pero el vencimiento se calcula con
  /// invoice_date + CuentaFinanciera.creditoDias: el de cabecera es el MÁXIMO de los
  /// vencimientos, y los 90 días de Colby no están configurados en ninguno de los dos lados.
  invoiceDateDue DateTime? @db.Date

  /// ESTE es el que se compara contra Cobro.monto (amount_untaxed). Los cobros de Nexus se
  /// importaron SIN IVA — medido: 12 de 13 clientes coinciden con la columna de quincena de
  /// la hoja y no con quincena por 1,13. Comparar contra montoTotal marcaría las 304 facturas
  /// como descuadradas por exactamente 13 %.
  montoNeto     Decimal @db.Decimal(14, 2)
  montoTotal    Decimal @db.Decimal(14, 2)
  montoResidual Decimal @db.Decimal(14, 2)
  montoImpuesto Decimal @db.Decimal(14, 2)

  /// Con signo: amount_total es POSITIVO también en las notas de crédito, así que sumar
  /// facturas y notas con montoTotal sobreestima la venta y nada avisa.
  /// ⚠⚠ En la moneda del DOCUMENTO: ±montoTotal según moveType (montoConSigno, espejo.ts). NO es
  /// amount_total_signed de Odoo, que está en colones: hasta el 2026-09-12 lo era y 318 facturas
  /// USD guardaban ₡241 M. Lo impide el CHECK FacturaOdoo_signo_del_documento, que Prisma no
  /// modela (scripts/sql/2026-09-12-4-espejo-odoo-moneda-del-documento.sql).
  montoTotalSigned Decimal @db.Decimal(14, 2)

  /// amount_total_signed tal cual: con signo y en la moneda de la COMPAÑÍA (colones), aunque la
  /// factura sea en dólares. Es la única evidencia del tipo de cambio con que el contador registró
  /// cada factura: nada lo suma ni lo compara contra un cobro. null = fila que escribió el código
  /// anterior después del SQL; la corrida siguiente la completa.
  montoMonedaCompania Decimal? @db.Decimal(14, 2)

  /// Moneda NATIVA del documento. NO el enum CobranzaMoneda: Odoo puede traer otras. Acá no
  /// se convierte nada — convertir() de lib/finanzas/equilibrio.ts es el único punto.
  moneda String

  odooPartnerId     Int
  odooPartnerNombre String
  cuentaId          String?
  cuenta            CuentaFinanciera? @relation(fields: [cuentaId], references: [id], onDelete: SetNull)

  estadoEspejo   FacturaOdooEstadoEspejo @default(VIGENTE)
  sincronizadoEn DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  cambios  FacturaOdooCambio[] @relation("CambiosDeFactura")
  vinculos CobroFacturaOdoo[]

  @@index([cuentaId])
  @@index([invoiceDate])
  @@index([paymentState, invoiceDate])
}

/// Historia APPEND-ONLY de lo que se movió en una factura (patrón VentaGanadaCambio).
model FacturaOdooCambio {
  id        String       @id @default(cuid())
  facturaId String?
  factura   FacturaOdoo? @relation("CambiosDeFactura", fields: [facturaId], references: [id], onDelete: SetNull)

  /// Snapshot autosuficiente: la fila se lee sola aunque la factura cambie o se borre.
  odooMoveId Int
  numero     String

  tipo     FacturaOdooCambioTipo
  anterior String?
  nuevo    String?

  /// El molde VentaGanadaCambio NO tiene este campo: su bitácora la escribe siempre el sync,
  /// sin actor humano. Acá el emparejado lo edita una persona, y sin esto no se puede
  /// distinguir "lo movió Odoo" de "lo movió Alexander".
  registradoPor String?
  detectadoEn   DateTime @default(now())

  @@index([facturaId])
  @@index([detectadoEn])
}

/// N:M a propósito: una factura puede cubrir varias cuotas, y una nota de crédito ninguna.
model CobroFacturaOdoo {
  id        String      @id @default(cuid())
  cobroId   String
  cobro     Cobro       @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  facturaId String
  factura   FacturaOdoo @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  /// false = lo propuso el sistema y nadie lo confirmó todavía.
  confirmado   Boolean  @default(false)
  vinculadoPor String?
  vinculadoEn  DateTime @default(now())

  /// Cobro y factura en monedas distintas: se MARCA y se muestran las dos cifras. Cuadrarlas
  /// exigiría convertir, y este módulo no convierte.
  monedaDispar Boolean @default(false)

  @@unique([cobroId, facturaId])
  @@index([facturaId])
}

/// N:1: varios res.partner de Odoo pueden apuntar a UNA CuentaFinanciera — un holding factura
/// con varios nombres, y hay 8 vat duplicados en Odoo que lo confirman. Por eso el @unique va
/// del lado del partner.
model OdooPartnerVinculo {
  id                String  @id @default(cuid())
  /// Etapa 12: opcional. Una sociedad de Mercury o QuickBooks no tiene ficha de Odoo. Sigue siendo única.
  odooPartnerId     Int?    @unique
  /// El nombre en factura, de cualquier plataforma. ⚠ Se llama «odoo…» porque la tabla nació para Odoo:
  /// no se renombra, lo lee el código que corre en producción.
  odooPartnerNombre String
  /// La cédula que trae la factura, de cualquier plataforma. Sin @unique: una cédula factura con varios nombres.
  odooVat           String?

  /// Etapa 12 (2026-09-13): la tabla pasó a ser «la sociedad que le factura a una cuenta». ODOO = una ficha
  /// del ERP. MERCURY y OTRA (QuickBooks) no tienen ficha: son únicas por (plataforma, claveFactura) con un
  /// índice parcial que Prisma no modela, y un CHECK exige la forma de cada una
  /// (scripts/sql/2026-09-12-12-sociedades-facturadoras.sql). ⛔ Nunca `db push`: los borraría.
  plataforma   CobranzaViaCobro @default(ODOO)
  /// `claveFactura()` del nombre (lib/cobranza/sociedades.ts). Solo en las sociedades sin ficha.
  claveFactura String?

  /// Los cobros que dicen que se le facturaron a esta sociedad. Con alguno, no se suelta ni se desvincula.
  cobrosFacturados Cobro[]

  /// Los clientes de Mercury que facturan como esta sociedad (espejo de Mercury, 2026-10-02).
  clientesMercury ClienteMercury[] @relation("SociedadDelClienteMercury")

  cuentaId String?
  cuenta   CuentaFinanciera? @relation(fields: [cuentaId], references: [id], onDelete: SetNull)

  via OdooVinculoVia?

  /// true = "este partner de Odoo no es cliente nuestro". Odoo tiene 82 clientes y Nexus 49
  /// cuentas: la diferencia es historia, no un hueco que haya que llenar.
  ignorado      Boolean   @default(false)
  confirmadoPor String?
  confirmadoEn  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cuentaId])
}

/// Existe porque CronJobState guarda ESTADO, no historia: una fila por job, el claim se
/// estampa ANTES de correr, y no hay campo de error. Con eso no se puede decir "viene fallando
/// hace tres días" — que es lo que hoy nadie puede saber cuando un job se rompe, porque el
/// error solo va al log del contenedor.
model SyncOdooCorrida {
  id           String    @id @default(cuid())
  iniciadaEn   DateTime  @default(now())
  terminadaEn  DateTime?
  ok           Boolean   @default(false)
  parcial      Boolean   @default(false)
  disparadaPor String

  facturasVistas Int @default(0)
  creadas        Int @default(0)
  actualizadas   Int @default(0)
  desaparecidas  Int @default(0)
  vinculadas     Int @default(0)

  /// Cuántas facturas devolvió Odoo que el espejo no pudo leer. 0 es lo normal.
  /// Antes este número solo salía al log del contenedor: una factura sin fecha o sin partner
  /// se congelaba con datos viejos y nadie lo veía.
  rechazadas      Int     @default(0)
  detalleRechazos String? @db.Text

  error      String? @db.Text
  duracionMs Int?

  @@index([iniciadaEn])
  @@index([ok, iniciadaEn])
}

/// La mesa de trabajo con el CFO necesita poder decir "esto está bien así". El molde
/// (InconsistenciasPanel) no guarda estado a propósito, y eso sirve cuando toda diferencia es
/// un error — acá NO lo es: Odoo tiene 82 clientes y Nexus 49 cuentas, hay notas de crédito
/// que no corrigen ningún cobro, y va a haber redondeos que alguien acepte. Sin esto, esas
/// líneas vuelven en cada sesión y a la tercera nadie mira la lista.
///
/// ⚠ DESDE EL 2026-09-25 LA PANTALLA YA NO LA USA: la marca es por fila (`DiferenciaOdooMarca`). No se borra: su
/// única fila (las 15 notas de crédito, marcadas por grupo) la lee el traspaso a marcas por fila, que compara cada
/// nota contra esta huella.
model DiferenciaOdooAceptada {
  id String @id @default(cuid())

  /// Clave estable de la diferencia, mismo criterio que el dedupeKey de las alertas.
  clave  String @unique
  motivo String @db.Text

  /// La huella de los NÚMEROS aceptados. Se acepta ESA diferencia (2.000 contra 2.260), no
  /// "este par para siempre": si el monto cambia, la línea vuelve sola. Una aceptación no
  /// puede convertirse en el lugar donde se esconde un problema nuevo.
  huella String

  aceptadaPor String
  aceptadaEn  DateTime @default(now())
}

/// «Está bien así», fila por fila (2026-09-25), y el cierre a mano «Ya está anulada» de una factura soltada. Una fila
/// de esta tabla = una marca sobre UN documento en UNA línea de Cobranza › Odoo › «Lo que no cuadra».
/// SQL: scripts/sql/2026-09-25-2-marcas-por-fila.sql (⛔ nunca `db push`).
///
/// ⭐ Atada al documento y a sus NÚMEROS, nunca a un nombre: vale mientras el documento siga en esa línea con la misma
/// `huella`. Si un número cambia, deja de valer sola y la fila vuelve; si Odoo renombra un cliente, no vuelve nada.
/// Hasta ese día la única marca era la del grupo entero (`DiferenciaOdooAceptada`): una fila nueva reabría el grupo
/// completo, con todo lo ya revisado.
///
/// ⛔ Nada se borra de acá. «Deshacer» firma `deshechaPor/En`: la historia de quién marcó y quién deshizo queda.
/// La escriben SOLO las funciones de lib/cobranza/odoo/marcas.ts (lo vigila lib/cobranza/odoo/guardas.test.ts).
model DiferenciaOdooMarca {
  id String @id @default(cuid())

  /// BIEN_ASI = «Está bien así». ANULADA = «Ya está anulada» de una factura soltada (acompaña a
  /// `FacturaLiberada.resueltaEn`, que es lo que la cierra; esta fila es su motivo y su historia).
  tipo String @default("BIEN_ASI")

  /// El código de la línea donde se marcó (ODOO-NOTA-SIN-APLICAR…). ⚠ La marca vale SOLO ahí: la misma factura
  /// en otra línea sigue a la vista.
  linea     String
  /// La clave de la fila donde se marcó. En una fila que junta varias facturas, cada factura lleva su marca con
  /// la misma `fila`: una factura nueva del mismo cliente aparece sola, sin traer las ya revisadas.
  fila      String
  /// f: factura o nota de Odoo · c: cobro · l: factura soltada · cuenta: · venta: (lib/cobranza/odoo/diferencias.ts).
  documento String
  /// Los números del documento que la persona VIO al marcar. Si no coinciden con los de ese momento, no se marca.
  huella    String @db.Text
  /// Lo que decía la fila al marcarla: queda aunque la fila ya no exista.
  texto     String @db.Text
  motivo    String @db.Text

  marcadaPor String
  marcadaEn  DateTime @default(now())

  deshechaPor String?
  deshechaEn  DateTime?

  @@index([deshechaEn])
  @@index([documento])
}

/// Una línea del banco de Odoo SIN CONCILIAR (`account.bank.statement.line`, U15, 2026-10-26): plata que entró o salió
/// de una cuenta del banco o de una tarjeta y que en Odoo no está atada a ninguna factura ni pago. La copia de Odoo la
/// trae cada hora en solo lectura (lib/cobranza/odoo/banco-copia.ts) y Alex la revisa en Cobranza › Conciliación ›
/// «Lo que no cuadra». ⛔ No cobra nada ni toca un `Cobro`: el cobro solo de lo pagado sigue siendo lib/cobranza/libro.
/// NUNCA se borra: la que se concilia en Odoo queda CONCILIADA con el día en que Nexus lo vio.
/// SQL: scripts/sql/2026-10-26-banco-odoo.sql (⛔ nunca `db push`).
model MovimientoBancoOdoo {
  id          String   @id @default(cuid())
  /// La línea en Odoo. Es la identidad: volver a copiar actualiza, nunca duplica.
  odooLineId  Int      @unique
  fecha       DateTime @db.Date
  /// Con signo, en la moneda del diario: positivo entra, negativo sale.
  monto       Decimal  @db.Decimal(14, 2)
  moneda      String
  /// Si el banco trajo otra moneda (amount_currency / foreign_currency_id). nullable porque casi nunca la hay.
  montoOtraMoneda Decimal? @db.Decimal(14, 2)
  otraMoneda      String?
  /// La referencia del banco (payment_ref): «I003938302 MULTIQUIMICA DOMINI». nullable porque Odoo la permite vacía.
  referencia  String?
  /// El cliente o proveedor si alguien lo puso en Odoo. nullable: medido el 2026-10-25, 0 de 98 lo tienen.
  odooPartnerId     Int?
  odooPartnerNombre String?
  /// El diario: «BAC Dolares (USD)», «VISA 7724 Colones»…
  odooJournalId Int
  diario        String
  /// El extracto y el asiento, para buscarla en Odoo. nullable por si Odoo no los trae.
  extracto    String?
  asiento     String?
  /// SIN_CONCILIAR · CONCILIADA (Odoo ya la ató) · DESAPARECIDA (Odoo dejó de devolverla).
  estadoEspejo String   @default("SIN_CONCILIAR")
  /// Cuándo la vio Nexus por primera vez, y cuándo la vio conciliada o desaparecida. nullable mientras siga sin conciliar.
  vistaEn      DateTime @default(now())
  cerradaEn    DateTime?
  sincronizadoEn DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estadoEspejo, fecha])
}

// ─── Espejo de Mercury (2026-10-02) ─────────────────────────────────────────────
// Lo internacional se factura en Mercury (sección de facturas) desde noviembre de 2025. Nexus copia sus facturas,
// sus clientes y los movimientos de la cuenta con un token de SOLO LECTURA: no puede escribir en Mercury aunque
// quisiera. El molde es el espejo de Odoo (lib/cobranza/odoo/); el código vive en lib/cobranza/mercury/.
// SQL: scripts/sql/2026-10-02-espejo-mercury.sql (⛔ nunca `db push`).

/// Una factura de Mercury, tal como la devuelve la API (`/ar/invoices`). NUNCA se borra: la que deja de venir queda
/// DESAPARECIDA. La cuenta de Nexus NO se copia acá: sale del cliente emparejado al leer (`ClienteMercury.cuentaId`).
model FacturaMercury {
  id                   String    @id @default(cuid())
  mercuryInvoiceId     String    @unique
  /// El número que ve el cliente («INV-53»).
  numero               String
  invoiceDate          DateTime  @db.Date
  dueDate              DateTime? @db.Date
  /// Lo que dice la factura: sus líneas más impuestos. Lo internacional va sin IVA.
  monto                Decimal   @db.Decimal(14, 2)
  moneda               String
  /// Unpaid · Paid · Cancelled · Processing, como los dice Mercury.
  estado               String
  mercuryCustomerId    String
  /// El nombre del cliente cuando se copió: la factura se lee aunque el cliente desaparezca.
  clienteNombre        String
  canceladaEn          DateTime?
  creadaEnMercury      DateTime
  /// ⚠ La API no dice CUÁNDO se pagó, y este NO es el día del pago: medido el 2026-10-22, el updatedAt de Mercury no
  /// cambia al pagarse (INV-61 e INV-5-4 lo tienen igual a la creación). El día sale de `pagadaVistaEn`.
  actualizadaEnMercury DateTime
  /// Cuándo la copia vio por primera vez la factura en «Paid» (2026-10-22, la copia corre cada hora). nullable porque
  /// las que ya estaban pagadas antes de esto no lo tienen: no se sabe cuándo pasaron a pagadas.
  pagadaVistaEn        DateTime?
  /// La última vez que la copia la vio sin pagar (o cuando se creó, si nació pagada entre dos copias): el pago ocurrió
  /// entre esto y `pagadaVistaEn`. nullable por lo mismo.
  pagadaNoVistaEn      DateTime?
  /// VIGENTE · DESAPARECIDA (CHECK en el SQL).
  estadoEspejo         String    @default("VIGENTE")
  sincronizadoEn       DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([mercuryCustomerId])
  @@index([invoiceDate])
}

/// Un cliente de Mercury (`/ar/customers`) y la cuenta de Nexus a la que corresponde. Es el emparejado: sin él, las
/// facturas de ese cliente no son de ninguna cuenta.
model ClienteMercury {
  id                String              @id @default(cuid())
  mercuryCustomerId String              @unique
  /// La razón social, como está en Mercury («SOLUCIONES, ANALITICOS Y SERVICIOS TEAM…» es Teamnet).
  nombre            String
  correo            String?
  pais              String?
  cuentaId          String?
  cuenta            CuentaFinanciera?   @relation("ClientesMercuryDeLaCuenta", fields: [cuentaId], references: [id], onDelete: SetNull)
  /// La sociedad de la cuenta a la que se le factura (OdooPartnerVinculo, plataforma MERCURY): la que eligen los cobros.
  sociedadId        String?
  sociedad          OdooPartnerVinculo? @relation("SociedadDelClienteMercury", fields: [sociedadId], references: [id], onDelete: SetNull)
  /// NUMERO · NOMBRE · MONTO · MANUAL: de dónde salió el vínculo (CHECK en el SQL).
  via               String?
  /// true = «no es cliente nuestro»: no se propone ni se acusa.
  ignorado          Boolean             @default(false)
  confirmadoPor     String?
  confirmadoEn      DateTime?
  estadoEspejo      String              @default("VIGENTE")
  sincronizadoEn    DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([cuentaId])
}

/// Un movimiento de las cuentas de Mercury (`/transactions`): entradas y salidas. Las entradas de clientes son el día en
/// que la plata llegó de verdad, que la factura no dice.
model MovimientoMercury {
  id                   String    @id @default(cuid())
  mercuryTransactionId String    @unique
  mercuryAccountId     String
  /// Con signo: positivo entra, negativo sale. En dólares.
  monto                Decimal   @db.Decimal(14, 2)
  /// pending · sent · cancelled · failed · reversed · blocked, como los dice Mercury.
  estado               String
  /// externalTransfer · internalTransfer · incomingDomesticWire · other…, como los dice Mercury.
  tipo                 String
  contraparteNombre    String?
  contraparteId        String?
  descripcionBanco     String?
  nota                 String?
  memoExterno          String?
  /// Movimiento de una tarjeta (una compra o su devolución): no es plata de un cliente.
  conTarjeta           Boolean   @default(false)
  creadoEnMercury      DateTime
  posteadoEn           DateTime?
  estadoEspejo         String    @default("VIGENTE")
  sincronizadoEn       DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([posteadoEn])
}

/// Cada copia de Mercury, buena o mala, con lo que trajo. Mismo molde que SyncOdooCorrida.
model SyncMercuryCorrida {
  id                String    @id @default(cuid())
  iniciadaEn        DateTime  @default(now())
  terminadaEn       DateTime?
  ok                Boolean   @default(false)
  parcial           Boolean   @default(false)
  disparadaPor      String
  facturasVistas    Int       @default(0)
  clientesVistos    Int       @default(0)
  movimientosVistos Int       @default(0)
  creadas           Int       @default(0)
  actualizadas      Int       @default(0)
  desaparecidas     Int       @default(0)
  clientesNuevos    Int       @default(0)
  error             String?   @db.Text
  duracionMs        Int?

  @@index([iniciadaEn])
  @@index([ok, iniciadaEn])
}

/// Una página de la base de conocimiento del EQUIPO (`/documentacion`), al estilo de Notion:
/// páginas y subpáginas que cualquiera del equipo lee y que edita quien tenga `documentacion.write`.
/// SQL: scripts/sql/2026-09-11-documentacion-paginas.sql (⛔ nunca `db push`).
///
/// ⛔ NO ES `KnowledgeDocument`. Ésa es la biblioteca que leen los AGENTES por tags; ésta es para
/// personas, y ningún agente la lee (lo vigila `lib/documentacion/guardas.test.ts`).
model PaginaDoc {
  id String @id @default(cuid())

  /// El árbol. `Restrict`: no hay borrado definitivo, y una página con hijas no puede
  /// desaparecer dejándolas colgadas. Archivar se lleva la rama entera (ver `archivadaLote`).
  parentId String?
  parent   PaginaDoc?  @relation("ArbolDePaginas", fields: [parentId], references: [id], onDelete: Restrict)
  hijas    PaginaDoc[] @relation("ArbolDePaginas")

  /// La dirección de la página (`/documentacion/<slug>`). Única y ESTABLE: renombrar no la
  /// cambia, así no se rompen los enlaces pegados en un chat.
  slug   String  @unique
  titulo String
  /// Un emoji.
  icono  String?
  /// Posición entre sus hermanas, densa (0..n-1). Se renumera en cada movimiento.
  orden  Int     @default(0)

  /// El JSON de bloques del editor (BlockNote). La forma vive en `lib/documentacion/tipos.ts`.
  contenido Json   @default("[]")
  /// El contenido en texto plano, derivado en el SERVIDOR al guardar (nunca lo manda el navegador).
  texto     String @default("")
  /// Título + texto + lo derivado de los bloques vivos, sin tildes ni mayúsculas: lo que busca Ctrl+K.
  busqueda  String @default("")

  /// ⚠ CONTROL DE CONCURRENCIA del contenido: el guardado manda la versión que leyó y la
  /// escritura es `WHERE id AND version`. Si otra persona guardó antes, avisa en vez de pisar.
  /// Renombrar, cambiar el ícono o mover NO la suben.
  version Int @default(1)

  /// Bloqueada = solo `documentacion.manage` la edita o le agrega subpáginas.
  bloqueada      Boolean @default(false)
  /// Página del sistema (las dos sembradas): no se archiva.
  fija           Boolean @default(false)
  /// La `version` que quedó al sembrar. Si hoy es distinta, una persona la editó y la siembra
  /// NO la pisa. Se compara por número y no por contenido: el editor normaliza los bloques al
  /// cargarlos, así que el JSON cambia sin que nadie edite.
  semillaVersion Int?

  /// Papelera. Archivar marca la rama entera con el MISMO lote, y restaurar devuelve ese grupo.
  archivadaAt   DateTime?
  archivadaLote String?

  creadaPorEmail  String?
  editadaPorEmail String?
  /// La última edición de una PERSONA. `updatedAt` también se mueve al reordenar, así que no
  /// sirve para "editadas hace poco".
  editadaAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versiones PaginaDocVersion[]
  hilos     HiloDeComentariosDoc[]

  @@index([parentId, orden])
  @@index([archivadaAt])
}

/// El historial de una página: fotos del contenido para poder volver atrás. El tope por página
/// vive en `lib/documentacion/tipos.ts` (TOPE_DE_VERSIONES).
model PaginaDocVersion {
  id String @id @default(cuid())

  paginaId String
  pagina   PaginaDoc @relation(fields: [paginaId], references: [id], onDelete: Cascade)

  /// La `version` de la página en el momento de la foto.
  version    Int
  titulo     String
  icono      String?
  contenido  Json
  /// autoguardado · antes-de-restaurar · semilla · antes-de-forzar (String y no enum: INV4).
  motivo     String
  autorEmail String?

  createdAt DateTime @default(now())

  @@index([paginaId, createdAt])
}

/// Un hilo de comentarios sobre una página de Documentación, como en Notion (2026-09-13).
/// SQL: scripts/sql/2026-09-13-documentacion-comentarios.sql (⛔ nunca `db push`).
///
/// ⚠ Vive FUERA del contenido: BlockNote descarta su marca de comentario al pasar la página a
/// JSON. El ancla es el id del bloque + el texto citado (con contexto antes y después); si el
/// bloque cambió de id, se busca la cita. Comentar no toca la página ni su versión.
/// Comenta todo el equipo; resuelven solo SUPER_ADMIN y CSL (`lib/documentacion/comentarios.ts`).
model HiloDeComentariosDoc {
  id String @id @default(cuid())

  paginaId String
  pagina   PaginaDoc @relation(fields: [paginaId], references: [id], onDelete: Cascade)

  /// El bloque comentado (id de BlockNote, o el derivado de su posición: `sanearBloques`).
  bloqueId String
  /// El texto marcado. Vacío = el bloque entero.
  cita     String @default("")
  /// Unas letras antes y después de la cita: desempatan cuando el mismo texto aparece dos veces.
  antes    String @default("")
  despues  String @default("")

  autorEmail String

  resueltoAt       DateTime?
  resueltoPorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comentarios ComentarioDoc[]

  @@index([paginaId, resueltoAt])
}

/// Un comentario de un hilo. Borrar el último borra el hilo (lo hace la app).
model ComentarioDoc {
  id String @id @default(cuid())

  hiloId String
  hilo   HiloDeComentariosDoc @relation(fields: [hiloId], references: [id], onDelete: Cascade)

  autorEmail String
  cuerpo     String
  editadoAt  DateTime?

  createdAt DateTime @default(now())

  @@index([hiloId, createdAt])
}

// ── Escala de Rendimiento: la versión publicada y los comentarios (2026-09-27) ──────
// SQL: scripts/sql/2026-09-27-escala-lector-y-comentarios.sql (⛔ nunca `db push`).
// La escala NO se edita desde Nexus: se publica con `scripts/publicar-escala.ts`.
// ⚠ Desde el 2026-10-05 la escala NO tiene comentarios propios: lo que se dice de ella se manda como
// Feedback, anclado al criterio (FeedbackReporte.escalaAncla, lib/feedback/escala.ts). "EscalaComentario"
// y "EscalaRespuesta" quedan quietas (la app no las lee ni las escribe); siguen en el esquema por su
// llave a Client, que reapunta scripts/merge-duplicate-clients.ts.

/// Una versión PUBLICADA de un documento de la escala, con su texto exacto. Solo se inserta.
/// La app lee la última de `documento = "escala"`; la descarga devuelve `texto` tal cual.
model EscalaDocumento {
  id String @id @default(cuid())

  /// escala · especificacion · manual
  documento     String
  /// La versión del documento (la del encabezado).
  version       String
  /// Con qué versión de la escala va (para la escala, la misma).
  escalaVersion String
  /// El nombre fijo del archivo: con él se descarga.
  archivo       String
  texto         String
  /// sha256 del texto: una versión publicada no puede cambiar de contenido.
  huella        String

  publicadaEn       DateTime @default(now())
  publicadaPorEmail String?

  @@unique([documento, version])
  @@index([documento, publicadaEn])
}

/// La escala como DATOS (2026-10-08, lib/escala/datos/): cada versión con su estructura entera.
/// `borrador` = la que se está editando (una sola: índice único parcial en el SQL); `publicada` =
/// congelada, no cambia nunca. El `.md` se genera desde `datos` y, al publicar, va a EscalaDocumento.
/// SQL: scripts/sql/2026-10-08-escala-como-datos.sql (ANTES del deploy).
model EscalaVersion {
  id String @id @default(cuid())

  /// «8.7.0». Para el borrador, la versión que va a ser.
  version  String  @unique
  /// borrador · publicada (lib/escala/datos/reglas.ts)
  estado   String
  /// FORMATO_DE_LOS_DATOS con que se guardó.
  formato  Int
  /// EscalaDatos (lib/escala/datos/tipos.ts).
  datos    Json
  /// sha256 del `.md` que generan los datos.
  huella   String
  // nullable porque la primera versión pasada a datos no sale de otra
  basadaEn String?
  /// Sube con cada cambio al borrador: dos ediciones a la vez no se pisan.
  revision Int     @default(0)

  creadaEn            DateTime  @default(now())
  // nullable porque la migración inicial la hace un script, no una persona con sesión
  creadaPorEmail      String?
  actualizadaEn       DateTime  @default(now())
  // nullable porque la migración inicial la hace un script, no una persona con sesión
  actualizadaPorEmail String?
  // nullable porque un borrador todavía no se publicó
  publicadaEn         DateTime?
  // nullable porque un borrador todavía no se publicó
  publicadaPorEmail   String?

  cambios EscalaCambio[]

  @@index([estado, publicadaEn])
}

/// La bitácora de una versión de la escala: cada cambio, anclado a lo que tocó, con el antes y el
/// después. Se escribe al importar cambios en bloque o desde el editor. SQL: el mismo de EscalaVersion.
model EscalaCambio {
  id String @id @default(cuid())

  versionId String
  version   EscalaVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// `1.7.F1` · `1.7.F` · `1.7` · `1` · `edicion:ecommerce-retail/1.7.F1` · `texto:Parte 2 — …/## …`
  ancla       String
  /// criterio · nivel · dimension · area · edicion · texto · encabezado (lib/escala/datos/reglas.ts)
  tipoDeAncla String
  /// agregado · cambiado · quitado
  accion      String
  // nullable porque agregar o quitar algo entero no cambia un campo
  campo       String?
  // nullable porque lo agregado no tenía un antes
  antes       String?
  // nullable porque lo quitado no tiene un después
  despues     String?
  /// importacion · editor
  origen      String
  // nullable porque solo los cambios en bloque van agrupados
  lote        String?
  // nullable porque el porqué es opcional
  nota        String?
  // nullable porque no todo cambio sale de un reporte. FK a FeedbackReporte en el SQL (SET NULL).
  feedbackId  String?
  autorEmail  String

  createdAt DateTime @default(now())

  @@index([versionId, createdAt])
  @@index([ancla])
}

/// Un comentario del equipo anclado a un identificador ESTABLE de la escala: la dimensión (`1.7`),
/// el nivel (`1.7.F`) o el criterio (`1.7.F1`). Guarda la versión y el texto de ese momento para
/// mostrar, en una versión nueva, si el texto cambió. El estado lo cambia solo el responsable.
model EscalaComentario {
  id String @id @default(cuid())

  ancla         String
  /// dimension · nivel · criterio
  tipoDeAncla   String
  /// `1`, y `1.7`: los contadores de la pantalla no parsean el ancla.
  area          String
  dimension     String
  versionEscala String
  /// El texto del ancla cuando se comentó (lo congela el servidor, nunca lo manda el navegador).
  textoAnclado  String

  /// no_se_entiende · no_calza · propuesta
  tipo                 String
  cuerpo               String
  decisionQueCambiaria String?

  /// «No calza con un cliente»: el de Nexus (si está) y su nombre congelado, o un nombre suelto.
  clienteId     String?
  cliente       Client? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteNombre String?
  /// El perfil de negocio que se estaba mirando (o el del cliente): `con equipo`, `única`…
  perfilCierre  String?
  perfilDespues String?
  /// Desde qué edición por industria se comentó (`ecommerce-retail`); null = la escala general.
  /// El `textoAnclado` es el de ESA edición. SQL: scripts/sql/2026-09-29-escala-comentario-edicion.sql
  edicion       String?

  autorEmail String

  /// abierto · respondido · cambio_pendiente · descartado
  estado                 String    @default("abierto")
  estadoCambiadoAt       DateTime?
  estadoCambiadoPorEmail String?
  /// La fila de «Cambios pendientes» del manual (la llena el responsable al pasarlo).
  cambioQue              String?
  cambioCaso             String?
  cambioDecision         String?
  motivoDescarte         String?

  editadoAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  respuestas EscalaRespuesta[]

  @@index([area, estado])
  @@index([ancla])
  @@index([estado, createdAt])
}

/// Una respuesta a un comentario de la escala.
model EscalaRespuesta {
  id String @id @default(cuid())

  comentarioId String
  comentario   EscalaComentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  autorEmail String
  cuerpo     String
  editadoAt  DateTime?

  createdAt DateTime @default(now())

  @@index([comentarioId, createdAt])
}

// ── Cuestionario previo (2026-09-25) ────────────────────────────────────────────
// Reemplaza el Google Sheets que el CSE mandaba al cierre del kickoff. UNO por proyecto.
// La ESTRUCTURA (pestañas y preguntas) se copia de la plantilla al generarlo y desde ahí es del
// proyecto: el CSE (o el chat) la edita sin tocar la plantilla. Cada pestaña la contesta UN
// responsable, con su propio enlace. Ver lib/cuestionario/.
model Cuestionario {
  id                 String                    @id @default(cuid())
  // Desde el 2026-10-02 hay VARIOS por proyecto: cada uno es de UNA persona y de un tipo.
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "tactico" (métricas y operación, por hubs) | "escala" (ubica al cliente en la escala de rendimiento).
  tipo               String                    @default("tactico")
  // La persona del cliente que lo contesta. null = todavía sin asignar (no se le muestra a nadie).
  personaId          String?
  persona            CuestionarioResponsable?  @relation("CuestionarioDePersona", fields: [personaId], references: [id], onDelete: SetNull)
  // Solo tipo "escala": la versión con la que se ARMÓ queda congelada (la escala sigue cambiando),
  // la edición por industria y el perfil de negocio ({cierre, despues}; null = se pregunta al cliente).
  escalaVersion      String?
  escalaHuella       String?
  edicion            String?
  perfil             Json?
  // null = el CSE todavía lo arma; el enlace de la persona no lo muestra hasta publicarlo.
  publicadoAt        DateTime?
  // != null = el CSE lo dio por terminado: se muestra lo respondido en solo lectura.
  cerradoAt          DateTime?
  // Prellenado con IA (lo que ya sabemos). Corre FUERA del request:
  // `prellenandoDesde` > `prellenadoAt` = en curso. El error queda escrito para mostrarlo.
  prellenandoDesde   DateTime?
  prellenadoAt       DateTime?
  prellenadoError    String?
  createdById        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  pestanas           CuestionarioPestana[]
  cambios            CuestionarioCambio[]
  // Restos del modelo anterior (una fila de responsable colgaba de un cuestionario). Sin uso.
  responsablesViejos CuestionarioResponsable[] @relation("ResponsableDeCuestionarioViejo")

  @@index([projectId])
  @@index([personaId])
}

model CuestionarioPestana {
  id                   String               @id @default(cuid())
  cuestionarioId       String
  cuestionario         Cuestionario         @relation(fields: [cuestionarioId], references: [id], onDelete: Cascade)
  // Identidad estable dentro del cuestionario ("general", "proceso_comercial", "p_x7k2…").
  key                  String
  titulo               String
  descripcion          String?              @db.Text
  orden                Int                  @default(0)
  // "normal" | "etapas" (lleva la «Etapa N» duplicable con las 7 preguntas fijas).
  tipo                 String               @default("normal")
  // [{ id, categoria, texto, ejemplo?, momento: "previo"|"sesion" }]
  preguntas            Json                 @default("[]")
  // { [preguntaId]: { valor, origen: "prellenado"|"cliente"|"cse", enSesion?, actualizadoAt } }
  respuestas           Json                 @default("{}")
  // [{ id, nombre, respuestas: { [preguntaId]: { … } } }] — solo tipo "etapas".
  etapas               Json                 @default("[]")
  // Lo que el cliente quiera contar que no entra en ninguna pregunta.
  contextoAdicional    String?              @db.Text
  // != null = el responsable la envió: queda BLOQUEADA hasta que el CSE la reabra.
  enviadaAt            DateTime?
  // Último guardado del cliente (lo compara su borrador local para saber cuál es más nuevo).
  clienteActualizadoAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  adjuntos             ClientDocument[]
  cambios              CuestionarioCambio[]

  @@unique([cuestionarioId, key])
}

// Una persona del cliente con su propio enlace. La URL ES el secreto (como la propuesta).
// La PERSONA del cliente en un proyecto (2026-10-02). La tabla conserva su nombre viejo para que los
// tokens ya entregados sigan abriendo: UN enlace por persona, que le muestra todos sus cuestionarios.
model CuestionarioResponsable {
  id                String               @id @default(cuid())
  projectId         String?
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Del modelo anterior (la persona colgaba de UN cuestionario). Sin uso.
  cuestionarioId    String?
  cuestionarioViejo Cuestionario?        @relation("ResponsableDeCuestionarioViejo", fields: [cuestionarioId], references: [id], onDelete: SetNull)
  nombre            String
  cargo             String?
  email             String?
  accessToken       String               @unique // 64 hex (crypto.randomBytes(32))
  revokedAt         DateTime?
  ultimoUsoAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cuestionarios     Cuestionario[]       @relation("CuestionarioDePersona")
  cambios           CuestionarioCambio[]

  @@index([cuestionarioId])
  @@index([projectId])
}

// El registro: envíos, cambios que pide el cliente después de enviar y reaperturas del CSE.
model CuestionarioCambio {
  id             String                   @id @default(cuid())
  cuestionarioId String
  cuestionario   Cuestionario             @relation(fields: [cuestionarioId], references: [id], onDelete: Cascade)
  pestanaId      String?
  enPestana      CuestionarioPestana?     @relation(fields: [pestanaId], references: [id], onDelete: SetNull)
  responsableId  String?
  responsable    CuestionarioResponsable? @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  // "ENVIO" | "SOLICITUD" | "REAPERTURA"
  tipo           String
  mensaje        String?                  @db.Text
  autorEmail     String? // CSE que reabrió (las del cliente van por responsableId)
  createdAt      DateTime                 @default(now())

  @@index([cuestionarioId, createdAt])
}

// La GUÍA DE EXPLORACIÓN del CSE (2026-10-02): reemplaza al informe. Lo confirmado (`contenido`) aparte
// de lo que propone el agente (`propuesta`), que nunca escribe en lo confirmado. Ver lib/guia-exploracion/.
model GuiaDeExploracion {
  id               String    @id @default(cuid())
  projectId        String    @unique
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contenido        Json      @default("{}")
  propuesta        Json      @default("{}")
  // Sube con cada cambio de lo CONFIRMADO: dos pestañas abiertas no se pisan (409).
  version          Int       @default(0)
  // La corrida del agente (fuera del request): `corriendoDesde` > `corridaTerminoAt` = en curso.
  corriendoDesde   DateTime?
  corridaModo      String?
  corridaTerminoAt DateTime?
  corridaError     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ── Feedback: el equipo reporta desde cualquier pantalla (2026-10-04) ────────────
// El botón «Feedback» del pie del menú guarda el reporte en el momento, con la captura de la pantalla y
// dónde estaba la persona. Lo revisa dirección en /feedback. SQL: scripts/sql/2026-10-04-feedback.sql.
// Tipos, estados y columnas son TEXT a propósito (INV4): los valores viven en lib/feedback/reglas.ts.

/// Un reporte de una persona del equipo: algo falla, una mejora o algo que no se entiende.
model FeedbackReporte {
  id     String @id @default(cuid())
  /// El número que se cita («F-128»).
  numero Int    @unique @default(autoincrement())

  autorEmail String
  /// falla · mejora · duda
  tipo       String
  cuerpo     String
  /// Solo en «falla»: si le frena el trabajo (llega como urgente).
  meFrena    Boolean @default(false)

  /// Lo que dice la pantalla (su título), para leerlo sin abrir la dirección.
  pantalla    String
  /// La dirección exacta, con sus filtros.
  ruta        String
  rol         String?
  navegador   String?
  ventana     String?
  /// El commit que corría Nexus.
  version     String?
  /// Los errores que dio la pantalla en los últimos minutos: [{ mensaje, hace }].
  errores     Json?
  /// Path en el almacén PRIVADO de documentos. Solo lo ven quien reportó y quien revisa.
  capturaPath String?
  /// Lo que señaló en la pantalla: [{ n, descripcion }].
  marcas      Json?

  /// Lo comentado desde la escala (2026-10-05, lib/feedback/escala.ts): el identificador comentado
  /// («2.6.F1») y su área («2»), en columnas para contar sin abrir el JSON. Lo demás de la escala va en
  /// `escala` (EscalaDelReporte). SQL: scripts/sql/2026-10-05-feedback-escala.sql (ANTES del deploy).
  // nullable porque un reporte de pantalla no se ancla a la escala
  escalaAncla String?
  // nullable porque un reporte de pantalla no se ancla a la escala
  escalaArea  String?
  // nullable porque un reporte de pantalla no se ancla a la escala
  escala      Json?

  /// sin_revisar · en_hoja · respondido · no_se_hara
  estado String @default("sin_revisar")

  // nullable porque un reporte sin revisar todavía no está en ningún tema
  temaId String?
  tema   FeedbackTema? @relation(fields: [temaId], references: [id], onDelete: SetNull)

  // nullable porque la mayoría de los reportes no responden a un pedido de opinión
  pedidoId String?
  pedido   FeedbackPedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  /// El motivo de «No se hará» (lo ve quien reportó).
  motivoCierre     String?
  decididoPorEmail String?
  decididoAt       DateTime?
  /// Hasta dónde leyó la conversación cada lado (para el punto de «hay algo nuevo»).
  autorLeyoAt      DateTime?
  revisorLeyoAt    DateTime?

  mensajes FeedbackMensaje[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([autorEmail, createdAt])
  @@index([temaId])
  @@index([escalaArea])
  @@index([escalaAncla])
}

/// Un mensaje de la conversación de un reporte.
model FeedbackMensaje {
  id String @id @default(cuid())

  reporteId String
  reporte   FeedbackReporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  autorEmail String
  cuerpo     String

  createdAt DateTime @default(now())

  @@index([reporteId, createdAt])
}

/// Un tema de la hoja de ruta: junta los reportes que piden lo mismo.
model FeedbackTema {
  id              String    @id @default(cuid())
  titulo          String
  detalle         String?
  /// Dónde se nota («Clientes», «Cobranza»).
  pantalla        String?
  /// decidir · planeado · curso · listo
  columna         String    @default("decidir")
  /// reporte · sugerencia · mano
  origen          String    @default("mano")
  /// El reporte desde el que se creó, si salió de la bandeja (sin FK: el reporte puede cambiar de tema).
  origenReporteId String?
  /// A nombre de quién, si lo cargó dirección a mano (lo que alguien dijo en una sesión).
  aNombreDe       String?
  creadoPorEmail  String
  movidoAt        DateTime?
  listoAt         DateTime?

  reportes FeedbackReporte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columna, createdAt])
}

/// Dirección le pide la opinión a alguien sobre una pantalla.
model FeedbackPedido {
  id             String    @id @default(cuid())
  paraEmail      String
  /// Cómo se llama la pantalla («Clientes»).
  pantalla       String
  /// El comienzo de la dirección donde aparece («/clients»).
  ruta           String
  pregunta       String
  hasta          DateTime?
  /// abierto · respondido · descartado
  estado         String    @default("abierto")
  vistoVeces     Int       @default(0)
  respondidoAt   DateTime?
  descartadoAt   DateTime?
  creadoPorEmail String

  reportes FeedbackReporte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paraEmail, estado])
}

// ─── Tiempos (2026-10-05) ─────────────────────────────────────────────────────────────────
// «¿Cuánto te tomó?» justo cuando se termina algo: al marcar una tarea del cronograma o al
// publicar un documento. Calibra las horas por tipo de fase de la carga de Customer Success;
// NO evalúa a nadie (no hay vista por persona). Lo configura dirección en Feedback › Tiempos.
// Reglas: lib/tiempos/reglas.ts. SQL: scripts/sql/2026-10-05-preguntas-de-tiempo.sql.

/// Una pregunta por momento (tarea hecha · documento publicado · cierre de semana): a quién, en qué y cada cuánto.
model EncuestaDeTiempo {
  id                  String  @id @default(cuid())
  /// TAREA_HECHA · DOCUMENTO_PUBLICADO · CIERRE_SEMANA (texto: sumar un momento no toca la base)
  momento             String  @unique
  activa              Boolean @default(false)
  /// Json versionado ({v:1,...}); se lee tolerante con leerConfig (lib/tiempos/reglas.ts)
  config              Json
  actualizadaPorEmail String?

  preguntas PreguntaDeTiempo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cada vez que se le pregunta a alguien cuánto le tomó algo, con la respuesta en minutos.
model PreguntaDeTiempo {
  id         String           @id @default(cuid())
  encuestaId String
  encuesta   EncuestaDeTiempo @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
  /// De qué es: «tarea:<id>» o «doc:<proyecto>:<documento>». Una sola pregunta por cosa.
  clave      String

  personaEmail String
  /// El rol al preguntar (para exportar sin nombres)
  rol          String?

  /// pendiente · respondida · omitida · retirada (vencida = pendiente con venceAt pasado; se deriva)
  estado          String  @default("pendiente")
  /// omitir · no_lo_hice
  motivoOmision   String?
  minutos         Int?
  /// Lo que suponía la carga al preguntar, para comparar
  estimadoMinutos Int?

  // nullable porque la pregunta sobrevive a que se borre el proyecto, el cliente o la tarea
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  taskId    String?
  task      TimelineTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// kickoff · diagnostico · planificacion · entrega (solo DOCUMENTO_PUBLICADO)
  documento String?
  /// El tipo de fase al preguntar (EXPLORACION…SEGUIMIENTO o SIN)
  tipoFase  String?
  /// Quién la hace: SMARTEAM · AMBOS · CLIENTE · DEV
  party     String?
  /// El título de la tarea o el nombre del documento, congelado
  titulo    String
  /// cronograma · avance · publicar
  origen    String
  /// Las que salieron juntas al aplicar un avance
  lote      String?

  /// Cuándo se terminó lo que se pregunta (marcada o publicada)
  ocurrioAt    DateTime
  venceAt      DateTime
  respondidaAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([encuestaId, clave])
  @@index([personaEmail, estado])
  @@index([encuestaId, ocurrioAt])
  @@index([taskId])
}

// ─── Preguntas sobre la cuenta (2026-10-13) ───────────────────────────────────────────────
// Lo que Customer Success sabe de cada cliente, preguntado al entrar a su ficha (la primera: ¿tiene apertura a la
// asesoría?). El registro de preguntas vive en lib/encuestas-de-cuenta/preguntas.ts; acá solo si está activa y cada
// evento. SQL: scripts/sql/2026-10-13-preguntas-sobre-la-cuenta.sql (RLS + RESTRICTIVE).

/// Si una pregunta sobre la cuenta está activa. Sin fila, vale el registro.
model EncuestaDeCuenta {
  id                  String   @id @default(cuid())
  clave               String   @unique
  activa              Boolean  @default(true)
  actualizadaPorEmail String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Cada vez que se mostró, se respondió o se dejó para después una pregunta sobre la cuenta. APPEND-ONLY: nunca se
/// edita ni se borra; la lectura vigente es la última respuesta de cada persona por cliente.
model RespuestaDeCuenta {
  id              String   @id @default(cuid())
  clave           String
  /// La versión y el texto de la pregunta al preguntar, congelados
  preguntaVersion Int
  preguntaTexto   String
  // nullable porque la respuesta sobrevive a que se borre el cliente (el nombre queda congelado)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientNombre    String
  personaEmail    String
  /// El rol al responder (CSE · CSL…)
  rol             String?
  /// Por qué la persona ve al cliente (hubspot-owner · granted · view-all…): distingue al encargado del resto
  motivoDeAcceso  String?
  /// mostrada · respondida · ahora_no
  evento          String
  /// si · no · no_se (solo en «respondida»)
  valor           String?
  porQue          String?
  /// De dónde se respondió (la ruta), por si hay otra puerta mañana
  contexto        Json?
  createdAt       DateTime @default(now())

  @@index([clave, clientId, personaEmail, createdAt])
  @@index([clave, createdAt])
}

/// Cuándo se le presenta cada documento al cliente (kickoff, diagnóstico, planificación y entrega), y quién lo
/// respondió (2026-10-14). APPEND-ONLY: nunca se edita ni se borra; el estado de cada documento sale de leer sus filas
/// en orden (lib/presentaciones/reglas.ts). Responde solo Customer Success. SQL: 2026-10-14-presentaciones-de-documentos.sql.
model PresentacionDeDocumento {
  id             String   @id @default(cuid())
  // nullable porque la respuesta sobrevive a que se borre el proyecto (los nombres quedan congelados)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proyectoNombre String
  clientNombre   String?
  /// kickoff · diagnostico · planificacion · entrega
  documento      String
  /// fecha · sin-fecha · presentado · listo · propuesta (la leyó Nexus en una reunión) · descarte · ahora-no
  evento         String
  /// AAAA-MM-DD, el día en Costa Rica: la fecha planeada, la de la presentación o la propuesta
  fecha          String?
  /// Quién respondió. null solo en «propuesta» (la leyó Nexus)
  porEmail       String?
  /// El rol al responder (CSE · CSL)
  rol            String?
  /// Por qué le tocaba responder: encargado · genero (generó el documento) · lider (la CSL)
  motivo         String?
  /// La reunión de donde salió la propuesta (solo en «propuesta»)
  sessionId      String?
  /// De dónde salió la fecha, la cita de la reunión o el aviso al vendedor
  detalle        Json?
  createdAt      DateTime @default(now())

  @@index([projectId, documento, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

// ─── Tareas internas ─────────────────────────────────────────────────────────
// docs/tareas-plan.md. Lo que se acuerda en una reunión termina en la semana y en la agenda de cada persona, dentro de
// espacios y proyectos, con el cliente a la vista. ⛔ Nunca llega al cliente ni al cronograma (lib/tareas/guardas.test.ts).
// Personas por CORREO y sin FK, como Aviso. Estados y tipos como texto, con su catálogo en lib/tareas/estados.ts.
// Las 13 tablas entran juntas con scripts/sql/2026-10-09-tareas.sql. Las escribe SOLO lib/tareas/mutaciones.ts.

/// Dónde vive el trabajo: el espacio de un equipo (miembros por área) o uno libre que crea cualquiera.
model EspacioDeTareas {
  id             String    @id @default(cuid())
  /// equipo | libre
  tipo           String
  /// Solo «equipo»: la clave de lib/tareas/equipos.ts. En Postgres los NULL no chocan.
  equipo         String?   @unique
  /// «Marketing» · «Evento SmartAgro 2026»
  nombre         String
  icono          String?
  /// miembros | todos (solo cuenta en uno libre)
  visibilidad    String    @default("miembros")
  /// "sistema" en los de equipo: los crea asegurarEspacio() al primer uso
  creadoPorEmail String
  version        Int       @default(0)
  archivadoAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  miembros   MiembroDeEspacio[]
  proyectos  ProyectoDeTareas[]
  plantillas PlantillaDeTareas[]
}

/// Quién está en un espacio LIBRE. Los de equipo no tienen filas: sus miembros salen del área.
model MiembroDeEspacio {
  espacioId        String
  espacio          EspacioDeTareas @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  email            String
  /// admin | miembro
  rol              String          @default("miembro")
  agregadoPorEmail String
  createdAt        DateTime        @default(now())

  @@id([espacioId, email])
  @@index([email])
}

/// Un proyecto de tareas internas («Campaña de SAP»). NO es un Project de HubSpot: a lo sumo lo referencia.
model ProyectoDeTareas {
  id               String          @id @default(cuid())
  espacioId        String
  espacio          EspacioDeTareas @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  nombre           String
  /// El nombre normalizado: un proyecto propuesto no se vuelve a proponer
  huella           String
  descripcion      String?         @db.Text
  /// propuesta | activo | en_pausa | terminado | descartado
  estado           String          @default("activo")
  // nullable porque un proyecto propuesto todavía no tiene dueño
  responsableEmail String?
  /// El ancla de los «día hábil N» de un plan
  iniciaEl         DateTime?       @db.Date
  venceEl          DateTime?       @db.Date
  // nullable: para quién. Sus tareas lo heredan
  clientId         String?
  client           Client?         @relation("ProyectosDeTareasDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  // nullable, NO único: el proyecto de HubSpot al que sirve. Invariante: project.clientId == clientId
  projectId        String?
  project          Project?        @relation("ProyectosDeTareasDelProyecto", fields: [projectId], references: [id], onDelete: SetNull)
  /// El orden de las secciones de su tablero. Agrupan, no son estados
  secciones        String[]        @default([])
  etiquetas        String[]        @default([])

  /// mano | reunion | chat | plantilla
  origen         String
  // nullable porque null = lo propuso Nexus desde una reunión
  creadoPorEmail String?
  // nullable: la lectura que lo sugirió
  lecturaId      String?
  lectura        LecturaDeReunion?  @relation(fields: [lecturaId], references: [id], onDelete: SetNull)
  // nullable: la reunión de origen. Se lee SOLO por el chokepoint
  sessionId      String?
  session        FirefliesSession?  @relation("ProyectosDeTareasDeLaReunion", fields: [sessionId], references: [id], onDelete: SetNull)
  /// Las líneas literales que lo respaldan. Se ven con la regla de lib/tareas/serializar.ts
  cita           String?            @db.Text
  // nullable: de qué plantilla salió
  plantillaId    String?
  plantilla      PlantillaDeTareas? @relation("ProyectosDeLaPlantilla", fields: [plantillaId], references: [id], onDelete: SetNull)
  /// «g:<lecturaId>:<grupo>» o «c:<turnoId>:<i>»: volver a leer o a aplicar no duplica
  origenId       String?            @unique

  /// Solo si nació propuesta: tal_cual | con_cambios | rechazada | misma | vencida
  decision         String?
  decididaPorEmail String?
  decididaAt       DateTime?
  motivo           String?

  version     Int       @default(0)
  archivadoAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tareas           Tarea[]
  vinculos         TareaVinculo[]
  eventos          TareaEvento[]
  resultados       ResultadoDeSemana[]
  plantillasHechas PlantillaDeTareas[] @relation("PlantillasDelProyecto")

  @@index([espacioId, estado])
  @@index([responsableEmail, estado])
  @@index([clientId])
  @@index([projectId])
  @@index([lecturaId])
  @@index([sessionId])
  @@index([plantillaId])
}

/// Un plan que se repite («Onboarding en 30 días»): tareas con días hábiles relativos. Usarlo no gasta IA.
model PlantillaDeTareas {
  id              String            @id @default(cuid())
  nombre          String
  descripcion     String?           @db.Text
  // nullable: el espacio del proyecto de origen; null = de toda la casa (solo lo pone un líder o un admin)
  espacioId       String?
  espacio         EspacioDeTareas?  @relation(fields: [espacioId], references: [id], onDelete: SetNull)
  /// Días hábiles
  duracionDias    Int
  /// v1, validado con Zod: [{ref, titulo, dia, minutos?, prioridad?, seccion?, para, despuesDe?, etiquetas?}], tope 40
  tareas          Json
  // nullable: el proyecto del que salió
  desdeProyectoId String?
  desdeProyecto   ProyectoDeTareas? @relation("PlantillasDelProyecto", fields: [desdeProyectoId], references: [id], onDelete: SetNull)
  creadaPorEmail  String
  version         Int               @default(0)
  archivadaAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  proyectos ProyectoDeTareas[] @relation("ProyectosDeLaPlantilla")

  @@index([espacioId, archivadaAt])
  @@index([desdeProyectoId])
}

/// Tarea interna: desde que alguien (o Nexus) la propone hasta que se cierra. Nunca llega al cliente ni al cronograma.
model Tarea {
  id        String   @id @default(cuid())
  /// «T-128», como F-128 en Feedback
  numero    Int      @unique @default(autoincrement())
  titulo    String
  /// Hash del texto normalizado ENTERO: solo iguala textos idénticos
  huella    String
  notas     String?  @db.Text
  /// Lo escribe Nexus al GENERAR la tarea (reunión, conversación, chat): para qué, para quién y qué se espera. No se
  /// edita (lo de la persona va en notas). El de una reunión se ve con la regla de la cita (lib/tareas/serializar.ts)
  contexto  String?  @db.Text
  /// [{texto, hecho}]: pasos de la misma persona (no son tareas)
  pasos     Json?
  etiquetas String[] @default([])
  /// propuesta | pendiente | en_curso | hecha | no_se_hara | rechazada | fusionada | vencida
  estado    String   @default("pendiente")
  /// alta | media | baja
  prioridad String   @default("media")
  /// puesto | apoyo
  tipo      String   @default("puesto")
  /// «Solo para mí»: en el sprint cuenta como horas, sin título
  privada   Boolean  @default(false)
  /// La sección de su proyecto en el tablero. Agrupa, no es estado
  seccion   String?
  /// Orden a mano en una columna del tablero; null = por prioridad
  orden     Float?

  /// El sprint: el equipo de CASA del responsable; sin responsable, el de la lectura («Por asignar»)
  equipo           String?
  // nullable porque null = «Por asignar» del equipo, o «Sin responsable» del proyecto
  responsableEmail String?
  /// Lunes en hora CR, siempre por semanaDestino(); null = sin semana (más adelante, por asignar, pendiente del proyecto)
  semana           DateTime? @db.Date
  venceEl          DateTime? @db.Date
  /// null = sin estimar: nunca se cuenta como 60
  minutosEstimados Int?
  /// Se escribe SOLO al pasar a hecha
  completadaAt     DateTime?

  // nullable: sin proyecto vive en el espacio de su equipo
  proyectoId       String?
  proyecto         ProyectoDeTareas? @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  // nullable: para quién. Denormalizado para filtrar y mudar
  clientId         String?
  client           Client?           @relation("TareasDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  // nullable: el proyecto de HubSpot. Invariante: project.clientId == clientId
  projectId        String?
  project          Project?          @relation("TareasDelProyecto", fields: [projectId], references: [id], onDelete: SetNull)
  // LA ACCIÓN ÚNICA (2026-10-16, fase 0.2 de docs/nexus-sistema-de-trabajo-plan.md): una tarea es la unidad de «algo
  // que hay que hacer» con una cuenta. El siguiente paso de un equipo es su próxima tarea abierta con fecha
  // (lib/siguiente-paso/desde-tareas.ts) y una reunión planeada es una tarea de clase «reunion».
  /// El contacto de HubSpot (id externo; el nombre sale de ContactoDeHubspot por cliente). Sin FK: la copia se rehace.
  hubspotContactId String?
  /// El negocio de HubSpot (id externo; NegocioAbierto lo trae mientras está abierto). Sin FK por lo mismo.
  hubspotDealId    String?
  /// smarteam | cliente: quién se comprometió. Hasta el 2026-10-16 vivía en el evento con que nació.
  lado             String            @default("smarteam")
  /// accion | reunion
  clase            String            @default("accion")
  /// Solo «reunion»: los correos de quienes se invitan (del cliente y del equipo)
  invitados        String[]          @default([])
  /// Solo «reunion»: cuándo se propone (el inicio). La fecha de la tarea es este día.
  reunionInicio    DateTime?
  /// Solo «reunion»: la reunión que se hizo (Meet). Se lee SOLO por el chokepoint de sesiones
  reunionHechaId   String?
  reunionHecha     FirefliesSession? @relation("ReunionPlaneada", fields: [reunionHechaId], references: [id], onDelete: SetNull)

  /// mano | pedido | reunion | notas | chat | plantilla | hubspot (no cambia: es la métrica «cómo entran»)
  origen          String
  // nullable porque null = la propuso Nexus
  creadaPorEmail  String?
  /// Quien la pidió o sugirió; en lo de otro equipo que sale de una reunión, quien leyó la reunión
  pedidaPorEmail  String?
  /// El equipo que la pidió, si no es el suyo
  pedidaPorEquipo String?
  /// Fuente externa o la reunión («Sprint planning de marketing»)
  pedidaPorTexto  String?
  // nullable: solo si salió de una lectura
  lecturaId       String?
  lectura         LecturaDeReunion? @relation(fields: [lecturaId], references: [id], onDelete: SetNull)
  // nullable: la reunión de origen. Se lee SOLO por el chokepoint
  sessionId       String?
  session         FirefliesSession? @relation("TareasDeLaReunion", fields: [sessionId], references: [id], onDelete: SetNull)
  /// Copia del título de la reunión, SIN enmascarar: lo enmascara serializar.ts al leer
  origenTitulo    String?
  /// La línea literal de la reunión. Se ve con la regla de serializar.ts
  cita            String?           @db.Text
  /// «l:<lectura>:<huella de la línea>» · «c:<turno>:<i>» · «p:<proyecto>:<ref>»: repetir no duplica
  origenId        String?           @unique
  // nullable: en una propuesta, la que Nexus cree que es; en una fusionada, en la que quedó
  mismaQueId      String?
  mismaQue        Tarea?            @relation("TareaMismaQue", fields: [mismaQueId], references: [id], onDelete: SetNull)

  /// Solo propuestas: tal_cual | con_cambios | mas_adelante | rechazada | misma | retirada | vencida
  decision         String?
  /// correo | "sistema"
  decididaPorEmail String?
  decididaAt       DateTime?
  motivo           String?

  /// sin_agendar | agendada | ya_no_esta
  agendaEstado       String    @default("sin_agendar")
  /// El inicio del primer bloque
  agendaInicio       DateTime?
  /// [{calendario, eventoId, inicio, fin}]: calendario = correo de la dueña del bloque
  agendaBloques      Json?
  agendadaAt         DateTime?
  agendaVerificadaAt DateTime?

  /// Las tareas de HubSpot (2026-10-15, etapa 3 de docs/mi-dia-plan.md; lib/tareas-hubspot). Solo con `origen = "hubspot"`.
  /// El id de la tarea en HubSpot.
  hubspotTaskId         String?   @unique
  /// Lo último en que Nexus y HubSpot estuvieron de acuerdo (título, estado, vencimiento, prioridad, responsable): con
  /// eso cada copia sabe qué lado cambió.
  hubspotAcordado       Json?
  /// Lo de HubSpot que se muestra y no se sincroniza: el tipo, la secuencia, la hora del vencimiento, el registro.
  hubspotDatos          Json?
  hubspotSincronizadaAt DateTime?
  /// Lo que no se pudo escribir en HubSpot; null = al día.
  hubspotError          String?

  /// El nombre corto para nombrarla fuera de Tareas («Enviar propuesta a Priscila»), lo escribe la IA (job
  /// «titulos-cortos», lib/tareas/ia/titulo-corto-server.ts). Vale solo si `tituloCortoDe` es el título de hoy.
  tituloCorto   String?
  /// El título del que salió `tituloCorto`: si el título cambió, el job lo vuelve a escribir
  tituloCortoDe String?

  /// PATCH con otra versión → 409
  version     Int       @default(0)
  /// Nada se borra
  archivadaAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  igualesAEsta   Tarea[]             @relation("TareaMismaQue")
  bloqueaA       TareaRelacion[]     @relation("RelacionDesde")
  bloqueadaPor   TareaRelacion[]     @relation("RelacionHacia")
  comentarios    TareaComentario[]
  vinculos       TareaVinculo[]
  eventos        TareaEvento[]
  resultados     ResultadoDeSemana[]
  pasosEnHubspot SiguientePaso[]     @relation("PasosEnHubspot")

  @@index([responsableEmail, estado])
  @@index([equipo, semana, estado])
  @@index([proyectoId, estado])
  @@index([clientId, completadaAt])
  @@index([projectId])
  @@index([pedidaPorEmail, estado])
  @@index([creadaPorEmail])
  @@index([sessionId])
  @@index([mismaQueId])
  @@index([lecturaId])
  @@index([huella])
  @@index([clientId, equipo, estado])
  @@index([hubspotContactId])
  @@index([hubspotDealId])
  @@index([reunionHechaId])
}

/// Relación entre dos tareas: bloquea (desde bloquea a hacia; sin ciclos) o relacionada. Pivote N:N.
model TareaRelacion {
  desdeId        String
  desde          Tarea    @relation("RelacionDesde", fields: [desdeId], references: [id], onDelete: Cascade)
  haciaId        String
  hacia          Tarea    @relation("RelacionHacia", fields: [haciaId], references: [id], onDelete: Cascade)
  /// bloquea | relacionada (par ordenado desdeId < haciaId)
  tipo           String
  creadaPorEmail String
  createdAt      DateTime @default(now())

  @@id([desdeId, haciaId, tipo])
  @@index([haciaId])
}

/// Un comentario en una tarea. Lo ve quien ve la tarea. No se borra: se archiva.
model TareaComentario {
  id          String    @id @default(cuid())
  tareaId     String
  tarea       Tarea     @relation(fields: [tareaId], references: [id], onDelete: Restrict)
  autorEmail  String
  /// Tope 4.000 caracteres
  cuerpo      String    @db.Text
  editadoAt   DateTime?
  archivadoAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tareaId, createdAt])
}

/// Un registro vinculado a una tarea o a un proyecto: algo de HubSpot, una propuesta comercial o una preventa. No sincroniza.
model TareaVinculo {
  id                      String              @id @default(cuid())
  // dueño: exactamente uno de tareaId y proyectoId
  tareaId                 String?
  tarea                   Tarea?              @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  proyectoId              String?
  proyecto                ProyectoDeTareas?   @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  /// El portal SIEMPRE explícito (lib/hubspot/urls.ts)
  hubspotPortalId         String?
  /// 0-1 contacto · 0-2 empresa · 0-3 negocio · 0-5 ticket · 0-970 proyecto · 2-… propio
  hubspotObjeto           String?
  externalHubspotRecordId String?
  // nullable: propuesta comercial
  businessCaseId          String?
  businessCase            BusinessCase?       @relation("VinculosDeTareasDeLaPropuesta", fields: [businessCaseId], references: [id], onDelete: Cascade)
  // nullable: preventa, solo DE_LA_PREVENTA
  exploracionId           String?
  exploracion             ExploracionDeVenta? @relation("VinculosDeTareasDeLaPreventa", fields: [exploracionId], references: [id], onDelete: Cascade)
  /// FOTO del nombre al vincular; sin correo ni teléfono
  etiqueta                String
  /// FOTO: tipo y etapa, sin montos
  detalle                 String?
  /// cliente | ninguno | ambiguo | pendiente: solo «cliente» se muestra fuera de quien ve toda la cartera
  empresaResuelta         String              @default("pendiente")
  // nullable: la empresa del registro, resuelta al vincular
  clientId                String?
  client                  Client?             @relation("VinculosDeTareasDelCliente", fields: [clientId], references: [id], onDelete: SetNull)
  // nullable: si es un 0-970 espejado en Nexus
  projectId               String?
  project                 Project?            @relation("VinculosDeTareasDelProyecto", fields: [projectId], references: [id], onDelete: SetNull)
  fotoAt                  DateTime            @default(now())
  /// HubSpot respondió 404 al refrescar
  ausenteAt               DateTime?
  creadoPorEmail          String
  createdAt               DateTime            @default(now())

  @@index([tareaId])
  @@index([proyectoId])
  @@index([hubspotObjeto, externalHubspotRecordId])
  @@index([clientId])
  @@index([projectId])
  @@index([businessCaseId])
  @@index([exploracionId])
}

/// Bitácora de solo agregar de una tarea o de un proyecto. La escribe SOLO lib/tareas/mutaciones.ts, en la misma transacción.
model TareaEvento {
  id         String            @id @default(cuid())
  // exactamente uno de tareaId y proyectoId
  tareaId    String?
  tarea      Tarea?            @relation(fields: [tareaId], references: [id], onDelete: Restrict)
  proyectoId String?
  proyecto   ProyectoDeTareas? @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  /// propuesta | creada | editada | asignada | no_es_mia | estado | semana | decidida | mencionada | proyecto | dependencia | vinculo | agenda | sugerido_cierre | revisada | cierre_corregido
  tipo       String
  /// correo | "sistema" | "agente"
  porEmail   String
  // nullable: la reunión de una mención o de una sugerencia de cierre
  sessionId  String?
  session    FirefliesSession? @relation("EventosDeTareasDeLaReunion", fields: [sessionId], references: [id], onDelete: SetNull)
  /// La línea de esa reunión: columna propia, NUNCA dentro de datos
  cita       String?           @db.Text
  /// { campo, desde, hacia, nombreDicho?, linea? }: sin citas ni texto de reuniones
  datos      Json
  createdAt  DateTime          @default(now())

  @@index([tareaId, createdAt])
  @@index([proyectoId, createdAt])
  @@index([porEmail])
  @@index([sessionId])
}

/// Qué pasó con una tarea en una semana: la revisión, el contador de pases y las métricas. La escribe SOLO anotarResultado().
model ResultadoDeSemana {
  tareaId           String
  tarea             Tarea             @relation(fields: [tareaId], references: [id], onDelete: Restrict)
  semana            DateTime          @db.Date
  /// foto: el sprint de esa semana
  equipo            String?
  /// foto
  responsableEmail  String?
  /// foto: el id del cliente como texto, SIN FK a propósito: si el cliente se borra, el pasado no cambia
  fotoCliente       String?
  fotoClienteNombre String?
  /// foto: cliente | prospecto | aliado | interno | sin_clasificar
  fotoAmbito        String
  /// «Interno · SmartAgro»
  fotoAmbitoNombre  String?
  // nullable: foto del proyecto de tareas
  proyectoId        String?
  proyecto          ProyectoDeTareas? @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  /// foto: un «sigue» con venceEl posterior al viernes de esa semana no cuenta como pase
  venceEl           DateTime?         @db.Date
  /// hecha | pasa | mas_adelante | no_se_hara
  resultado         String
  /// correo | "sistema"
  decididoPor       String
  decididoAt        DateTime          @default(now())
  /// foto
  minutosEstimados  Int?

  @@id([tareaId, semana])
  @@index([equipo, semana])
  @@index([responsableEmail, semana])
  @@index([fotoCliente, semana])
  @@index([proyectoId, semana])
}

/// La revisión de la semana de UNA persona. La escribe ella, su líder o el sistema.
model CierreDeSemana {
  id           String   @id @default(cuid())
  personaEmail String
  semana       DateTime @db.Date
  /// la misma persona | su líder | "sistema"
  cerradaPor   String
  cerradaAt    DateTime @default(now())

  @@unique([personaEmail, semana])
  @@index([semana])
}

/// Cada reunión (o texto pegado) se lee UNA vez para tareas.
model LecturaDeReunion {
  id                  String            @id @default(cuid())
  // nullable porque en la fase 2 se pueden pegar notas
  sessionId           String?           @unique
  session             FirefliesSession? @relation("LecturaDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  /// Solo sin sessionId: notas pegadas o un documento subido (fase 2)
  texto               String?           @db.Text
  /// Huella del transcript normalizado, o del resumen; null con menos de 200 caracteres
  huellaTexto         String?
  // nullable: la lectura gemela que sí se leyó
  copiaDeId           String?
  copiaDe             LecturaDeReunion? @relation("LecturaCopia", fields: [copiaDeId], references: [id], onDelete: SetNull)
  // nullable: la fuente que la disparó, desde 1C
  fuenteId            String?
  fuente              FuenteDeTareas?   @relation(fields: [fuenteId], references: [id], onDelete: SetNull)
  /// El de la lectura: recibe «Por asignar» y figura como «pedida por» en lo de otros equipos
  equipo              String
  /// planning | cierre | ambos
  rol                 String
  /// A dónde van las propuestas
  semana              DateTime          @db.Date
  /// Solo en cierre o ambos
  semanaQueCierra     DateTime?         @db.Date
  /// en_espera | leyendo | lista | sin_texto | copia | error | sin_ia
  estado              String            @default("leyendo")
  procesarDesde       DateTime?
  intentos            Int               @default(0)
  /// Más de 10 min leyendo = colgada
  leyendoDesde        DateTime?
  /// codigo | haiku | transcript | sin_ia
  modo                String?
  /// false en lo retroactivo de más de 7 días, salvo «Avisar igual»
  avisar              Boolean           @default(true)
  // nullable: null = automática
  pedidaPorEmail      String?
  // nullable: la corrida del modelo, si hizo falta
  agentRunId          String?
  agentRun            AgentRun?         @relation("LecturasDeTareasDelAgente", fields: [agentRunId], references: [id], onDelete: SetNull)
  /// { lineas, propuestas, proyectos, preguntas, omitidas }: sale SOLO por serializar.ts
  resumen             Json?
  error               String?           @db.Text
  leidaAt             DateTime?
  // ── La lectura de SEGUIMIENTO de la misma reunión (memoria de la cuenta, etapa 2) ──
  // Una fila, una pasada, dos salidas: `estado` es la salida de Tareas; estas 5 columnas, la del seguimiento
  // (lib/lecturas/cola.ts las escribe; SQL scripts/sql/2026-10-10-lectura-de-seguimiento.sql).
  /// en_espera | leyendo | lista | sin_texto | copia | error | omitida; null = el seguimiento no la leyó
  seguimientoEstado   String?
  /// en_espera: desde cuándo se puede tomar; leyendo: desde cuándo se lee
  seguimientoDesde    DateTime?
  seguimientoIntentos Int               @default(0)
  seguimientoLeidaAt  DateTime?
  seguimientoError    String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  copias    LecturaDeReunion[] @relation("LecturaCopia")
  tareas    Tarea[]
  proyectos ProyectoDeTareas[]
  hechos    HechoDeReunion[]   @relation("HechosDeLaLectura") // memoria de la cuenta, etapa 6 (SET NULL)

  @@index([estado, procesarDesde])
  @@index([seguimientoEstado, seguimientoDesde])
  @@index([huellaTexto])
  @@index([pedidaPorEmail, createdAt])
  @@index([copiaDeId])
  @@index([fuenteId])
  @@index([agentRunId])
}

// Un HECHO que dejó una reunión (memoria de la cuenta, etapa 6; DECISIONS «Hechos, enrutador y novedades»): una frase
// con su cita literal verificada, de la cuenta o de un proyecto vinculado, con su tipo y su estado. Lo escribe SOLO
// lib/seguimiento/hechos-server.ts; el enrutador (lib/seguimiento/enrutador.ts) decide a dónde va. Tipos y estados como
// TEXT con CHECK (scripts/sql/2026-10-10-hechos-de-reunion.sql; los valores, lib/seguimiento/hechos/tipos.ts y
// estado.ts). ⛔ Nunca cruza a nada que vea el cliente (lib/seguimiento/hechos-internos.test.ts). INV45: todo hecho es
// del cliente de su reunión.
model HechoDeReunion {
  id               String            @id @default(cuid())
  // nullable porque un hecho puede salir de un texto sumado a mano, sin reunión: entonces lo ata `lecturaId` (CHECK)
  sessionId        String?
  session          FirefliesSession? @relation("HechosDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  // nullable: la fila de la cola (LecturaDeReunion); se puede rehacer o borrar sin perder lo aprendido
  lecturaId        String?
  lectura          LecturaDeReunion? @relation("HechosDeLaLectura", fields: [lecturaId], references: [id], onDelete: SetNull)
  // nullable: la corrida «seguimiento-hechos» que lo escribió; borrarla no borra el hecho
  agentRunId       String?
  agentRun         AgentRun?         @relation("HechosDelAgente", fields: [agentRunId], references: [id], onDelete: SetNull)
  /// El dueño de la reunión al leerla (`resolvedClientId`, el manual solo si no hay). INV45 lo vigila.
  clientId         String
  client           Client            @relation("HechosDelCliente", fields: [clientId], references: [id], onDelete: Cascade)
  // nullable: null = de la cuenta; si no, un proyecto vinculado a la reunión (incluido) del mismo cliente
  projectId        String?
  project          Project?          @relation("HechosDelProyecto", fields: [projectId], references: [id], onDelete: SetNull)
  /// cuenta | persona | acuerdo | resultado | proceso_hoy | queja | riesgo | senal_cronograma | senal_etapa
  tipo             String
  /// Solo en un acuerdo: pipeline | propiedades | integracion | automatizacion | conversaciones | proceso_despues | alcance
  tema             String?
  frase            String            @db.Text
  /// La frase de la reunión, tal cual (verificada contra lo que se leyó). Puede traer lo dicho puertas adentro: interna.
  cita             String            @db.Text
  /// transcripcion | notas | texto
  citaFuente       String
  /// cliente | smarteam; null = no se sabe (una cita de las notas)
  quien            String?
  /// baja | media | alta (solo en una queja o un riesgo)
  gravedad         String?
  /// El tipo, el tema y las palabras con contenido: el mismo hecho dicho en dos reuniones tiene la misma
  huella           String
  // nullable: el mismo hecho dicho antes y todavía pendiente; este no se vuelve a mandar a ningún lado
  mismoQueId       String?
  mismoQue         HechoDeReunion?   @relation("HechoRepetido", fields: [mismoQueId], references: [id], onDelete: SetNull)
  // nullable: el acuerdo viejo que este reemplaza; reemplazar lo confirma una persona (acuerdos vigentes)
  reemplazaAId     String?
  reemplazaA       HechoDeReunion?   @relation("HechoReemplazado", fields: [reemplazaAId], references: [id], onDelete: SetNull)
  /// [{ clave, estado: pendiente | usado | desestimado | delegado, ref?, decididoPorEmail?, decididoAt?, nota? }]
  destinos         Json              @default("[]")
  /// pendiente | usado | desestimado (el general; «vencido» se calcula a los 30 días)
  estado           String            @default("pendiente")
  decididoPorEmail String?
  decididoAt       DateTime?
  nota             String?           @db.Text
  fechaDeLaReunion DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  repetidos      HechoDeReunion[] @relation("HechoRepetido")
  reemplazadoPor HechoDeReunion[] @relation("HechoReemplazado")

  @@index([clientId, estado, createdAt])
  @@index([projectId, estado])
  @@index([sessionId])
  @@index([lecturaId])
  @@index([agentRunId])
  @@index([clientId, huella])
  @@index([mismoQueId])
  @@index([reemplazaAId])
}

/// Una reunión recurrente que Nexus lee cada semana (desde 1C). Sin filas, nada se lee solo.
model FuenteDeTareas {
  id            String   @id @default(cuid())
  /// null = fuente personal («súmala para mí»)
  equipo        String?
  /// El job lee COMO esta persona
  duenoEmail    String
  /// Base del googleEventId (antes del «_»)
  serie         String
  /// Título normalizado: respaldo si la serie cambia o se duplica
  titulo        String
  /// planning | cierre | ambos
  rol           String
  /// 1 = lunes: el job solo consulta en su ventana
  diaSemana     Int?
  /// «10:30», hora CR
  finHora       String?
  /// false = pausada
  activa        Boolean  @default(true)
  pausadaMotivo String?
  /// Quiénes están en el sprint (correos en minúscula; ficha A, 2026-10-17). Vacío = los del área del equipo.
  /// Lo que la lectura le propone a uno de ellos no va como pedido de otro equipo.
  personas      String[] @default([])
  createdAt     DateTime @default(now())

  lecturas LecturaDeReunion[]

  @@index([serie])
}

// ═══ SERVICIOS RECURRENTES (SmartLoop) — docs/smartloop-plan.md ═══════════════════════════════

/// Un CICLO de un proyecto recurrente: un tramo con fechas que abre con un diagnóstico y cierra con
/// la sesión de aprendizaje. La etapa del proyecto es la etapa del ciclo abierto. Lo que se cerró se
/// conserva entero: el ciclo siguiente es una fila nueva, nunca se reescribe el anterior.
model CicloDeProyecto {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… dentro del proyecto.
  numero             Int
  /// El tramo, si lo hay ("Corregir y adoptar"). null = sin nombre.
  nombre             String?
  /// Las fechas del tramo (día, en hora de Costa Rica). null = todavía sin fecha.
  desde              DateTime? @db.Date
  hasta              DateTime? @db.Date
  /// La meta del ciclo, en palabras del resultado que persigue el cliente.
  meta               String?   @db.Text
  /// diagnostico | planificacion | implementacion | adopcion | aprendizaje (lib/servicios/ciclo.ts).
  /// En un proyecto que existe en HubSpot la etapa la mueve el equipo allá.
  etapa              String    @default("diagnostico")
  /// abierto | cerrado. Uno abierto por proyecto (índice parcial en el SQL).
  estado             String    @default("abierto")
  cerradoAt          DateTime?
  cerradoPor         String?
  /// Etapa 3 (ficha E) — la VERSIÓN APROBADA del cronograma del ciclo: la foto que se le presentó al cliente
  /// (lib/timeline/ciclo.ts › FotoDelCronogramaDelCiclo). null = todavía sin aprobar. Cada aprobación sube
  /// `versionAprobada` y reemplaza la foto; lo que cambió desde ahí se calcula al leer.
  cronogramaAprobado Json?
  versionAprobada    Int       @default(0)
  aprobadoAt         DateTime?
  aprobadoPor        String?
  /// Etapa 4 (ficha E) — la sesión de aprendizaje. Se escriben como borrador mientras el ciclo está abierto y
  /// quedan como el resultado del ciclo al cerrarlo. metaResultado: cumplida | parcial | no_cumplida.
  metaResultado      String?
  metaEvaluada       String?   @db.Text
  siguienteCiclo     String?   @db.Text
  /// Lo que quedó al cerrar (lib/servicios/cierre.ts › CierreGuardado): cada caso de uso con su criterio medido y
  /// su decisión, y la foto protegida de cada documento del ciclo. null mientras el ciclo está abierto.
  cierre             Json?
  creadoPor          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  casosDeUso          CasoDeUso[]
  versionesDeLaEscala VersionDeLaEscala[] // la foto de la escala que dejó el diagnóstico del ciclo

  @@unique([projectId, numero])
}

/// Un CASO DE USO del camino de crecimiento: qué se hace, qué resultado persigue, qué mueve en la
/// escala (puede ser más de una dimensión), por qué ahora y cómo se sabe que funcionó. Es de la
/// EMPRESA; puede estar sugerido sin proyecto, en el plan de un proyecto o dentro de un ciclo.
model CasoDeUso {
  id               String           @id @default(cuid())
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// nullable porque un caso sugerido todavía no es de ningún proyecto.
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// nullable porque está en el plan, todavía no en un ciclo.
  cicloId          String?
  ciclo            CicloDeProyecto? @relation(fields: [cicloId], references: [id], onDelete: SetNull)
  titulo           String
  /// Qué resultado del cliente persigue.
  resultado        String?          @db.Text
  /// Qué mueve en la escala: [{ area, dimension, nivel }]. Puede ser más de una.
  mueve            Json             @default("[]")
  /// Por qué ahora (la regla de prioridad, el pedido del cliente, qué destraba).
  porque           String?          @db.Text
  /// El criterio de aceptación y su métrica.
  criterio         String?          @db.Text
  metrica          String?
  /// Lo medido al cerrar el ciclo.
  criterioMedido   String?          @db.Text
  /// Etapa 4 (ficha E) — qué se decide en la sesión de aprendizaje: cumplido | no_cumplido | pasa | descartado.
  /// Se aplica al estado al cerrar el ciclo («pasa» vuelve al plan del proyecto y entra al ciclo siguiente).
  decisionAlCerrar String?
  /// Etapa 3 (ficha E) — la fase del cronograma del proyecto que es este caso de uso en su ciclo (un caso de uso
  /// = una fase). nullable porque un caso sugerido o en el plan todavía no tiene fase.
  faseId           String?
  fase             TimelinePhase?   @relation(fields: [faseId], references: [id], onDelete: SetNull)
  /// escala | pedido | propuesta | entrega | manual
  origen           String           @default("manual")
  /// sugerido | en_plan | en_ciclo | cumplido | no_cumplido | descartado
  estado           String           @default("en_ciclo")
  orden            Int              @default(0)
  creadoPor        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([cicloId])
  @@index([faseId])
}

/// La RECOMENDACIÓN de pasar un servicio temporal a un servicio recurrente (SmartLoop, etapa 6 de
/// docs/smartloop-plan.md). Solo se guarda lo que decidió una persona: sin fila y con el proyecto en su entrega o
/// recién cerrado, la recomendación está PENDIENTE (lib/servicios/recurrencia.ts). Usarla no escribe en HubSpot:
/// deja una tarea al CSE o abre el alta del servicio.
model RecomendacionDeRecurrencia {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// La clave del servicio que se recomendó (lib/servicios › ClaveDeServicio).
  servicio    String   @default("smartloop")
  /// usada | descartada
  estado      String
  /// Con «usada»: tarea | alta. null al descartar.
  accion      String?
  /// Por qué se descartó (opcional).
  motivo      String?  @db.Text
  /// La tarea que dejó «Dejar la tarea» (sin FK: una tarea se archiva, no se borra).
  tareaId     String?
  /// El porqué que vio la persona al decidir (lib/servicios/recurrencia.ts › PorqueDeRecurrencia).
  porque      Json?
  decididoPor String
  decididoEn  DateTime @default(now())
}

// ─── Uso de Nexus (etapa 4a del roadmap de «Para ti», docs/mi-dia-plan.md) ───

/// Cuántas veces abrió cada persona cada sección de Nexus, por día. Lo mínimo para saber si se usa: no guarda qué
/// cliente ni qué documento miró, ni minutos. Lo escribe solo lib/uso/registro-server.ts; lo lee dirección.
model UsoDeNexus {
  id           String   @id @default(cuid())
  personaEmail String
  /// La clave del ítem del menú (APP_NAV) o «otra» (lib/uso/secciones.ts)
  seccion      String
  /// El día en Costa Rica, AAAA-MM-DD
  dia          String
  aperturas    Int      @default(1)
  primeraAt    DateTime @default(now())
  ultimaAt     DateTime @default(now())

  @@unique([personaEmail, seccion, dia])
  @@index([dia])
}

// ─── Lo que preparas antes de una reunión (ficha D, el inicio de Ventas y del CSE, 2026-10-17) ───

/// El objetivo y las notas que una persona escribe para una reunión de SU calendario, en el panel de la reunión del
/// inicio («Para ti»). Una fila por persona y evento de Google Calendar. Lo ve solo esa persona. Lo escribe solo
/// lib/mi-dia/preparacion-server.ts. Sin FK al cliente a propósito: el evento es del calendario, no de Nexus.
model PreparacionDeReunion {
  id           String   @id @default(cuid())
  personaEmail String
  /// El id del evento en Google Calendar (en una serie, el de esa fecha)
  eventoId     String
  /// Lo que la persona quiere lograr en la reunión. null = usa el que propone Nexus
  objetivo     String?  @db.Text
  notas        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([personaEmail, eventoId])
}

/// Una sugerencia de Nexus que una persona descartó, para no volver a mostrársela (2026-10-19). Nació para el siguiente
/// paso que Nexus armaba con la reunión de una cuenta sin acción (tipo «siguiente-paso-de-la-reunion», clave
/// «<cuenta>:<evento>»), que se retiró esa misma tarde: una reunión agendada ya ES el siguiente paso (docs/DECISIONS.md
/// «Una reunión agendada es el siguiente paso»). Hoy nadie la escribe; queda para la próxima sugerencia por persona.
model SugerenciaDescartada {
  id           String   @id @default(cuid())
  personaEmail String
  tipo         String
  clave        String
  createdAt    DateTime @default(now())

  @@unique([personaEmail, tipo, clave])
}

// ─── Contactos y tickets de HubSpot (etapa 6a de docs/mi-dia-plan.md) ───

/// La copia de un contacto de HubSpot asociado a una empresa que está en Nexus. Solo lectura: la escribe la copia de
/// cada hora (lib/contactos/copia-server.ts). Una fila por contacto y cliente: un contacto de dos empresas está en las dos.
model ContactoDeHubspot {
  id                String               @id @default(cuid())
  clientId          String
  client            Client               @relation("ContactosDeHubspot", fields: [clientId], references: [id], onDelete: Cascade)
  hubspotId         String
  nombre            String
  email             String?
  cargo             String?
  /// El correo del dueño del contacto en HubSpot
  duenoEmail        String?
  /// notes_last_contacted: la última vez que alguien registró un contacto con esta persona en HubSpot
  ultimoContactoAt  DateTime?
  /// notes_last_updated: la última actividad registrada en HubSpot
  ultimaActividadAt DateTime?
  creadoEnHubspot   DateTime?
  /// false = la empresa ya no lo tiene asociado, o se borró en HubSpot. La fila no se borra.
  vigente           Boolean              @default(true)
  copiadoAt         DateTime             @default(now())
  createdAt         DateTime             @default(now())
  personas          PersonaDeLaEmpresa[] @relation("PersonaDelContacto")

  @@unique([clientId, hubspotId])
  @@index([email])
}

/// R6 (2026-10-25) · Una persona del cliente, una sola por correo y empresa, con su cargo y su rol (decide, influye, usa).
/// Une las copias que había sueltas: los contactos de HubSpot, los participantes de las reuniones y las personas de los
/// cuestionarios. La escribe SOLO lib/clients/personas-de-la-empresa-server.ts (la copia desde las fuentes y lo que decide
/// una persona del equipo); `origenes` dice de dónde se la conoce. Los textos de la ficha y del handoff no se tocan.
model PersonaDeLaEmpresa {
  id                  String             @id @default(cuid())
  clientId            String
  client              Client             @relation("PersonasDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  /// En minúsculas.
  correo              String
  /// nullable porque de un participante de una reunión a veces solo se sabe el correo.
  nombre              String?
  cargo               String?
  /// Su contacto en la copia de HubSpot. nullable porque no todos son contactos.
  contactoDeHubspotId String?
  contactoDeHubspot   ContactoDeHubspot? @relation("PersonaDelContacto", fields: [contactoDeHubspotId], references: [id], onDelete: SetNull)
  /// decide · influye · usa. null = nadie lo dijo todavía.
  rol                 String?
  /// Quién dijo el rol: persona (alguien del equipo). nullable con el rol.
  rolFuente           String?
  rolAt               DateTime?
  /// empresa = trabaja en el cliente · externa = una agencia o un consultor del cliente.
  lado                String             @default("empresa")
  /// hubspot · reunion · cuestionario: de dónde se la conoce.
  origenes            String[]           @default([])
  /// En cuántas reuniones del cliente estuvo, y la última (lo cuenta la copia, por el chokepoint de sesiones).
  reuniones           Int                @default(0)
  ultimaReunionAt     DateTime?
  /// false = ya no aparece en ninguna fuente. La fila no se borra.
  vigente             Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([clientId, correo])
  @@index([correo])
  @@index([contactoDeHubspotId])
}

/// R13 (2026-10-25) · El perfil de la empresa que usa Nexus (hoy Smarteam): lo que la preventa, las propuestas, el
/// analizador de reuniones de venta y Marketing necesitan saber de NOSOTROS. Cuelga de su ficha, no es una constante del
/// código: así otra empresa podría usar Nexus (ARCHITECTURE §0). El cliente ideal y las buyer personas siguen en sus tablas
/// (IcpItem, BuyerPersona), colgando de la misma ficha. Se lee SOLO por lib/smarteam/contexto.ts.
model PerfilDeLaEmpresa {
  id                   String   @id @default(cuid())
  clientId             String   @unique
  client               Client   @relation("PerfilDeLaEmpresa", fields: [clientId], references: [id], onDelete: Cascade)
  /// La propuesta de valor, en dos o tres frases.
  propuestaDeValor     String?  @db.Text
  /// El position statement (K3): para quién, qué problema, qué categoría, en qué es distinta.
  positionStatement    String?  @db.Text
  /// El tono de la marca. Mientras esté vacío, vale el de Marketing (MarketingSettings.brandVoice).
  tono                 String?  @db.Text
  /// [{ nombre, descripcion?, tarifa? }]: los servicios y sus tarifas (lib/smarteam/perfil.ts).
  servicios            Json     @default("[]")
  /// [{ clientId, industria, porque? }]: los clientes de referencia por industria (K4).
  clientesDeReferencia Json     @default("[]")
  actualizadoPorEmail  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// La copia de un ticket de HubSpot asociado a una empresa que está en Nexus. Solo lectura, como los contactos.
model TicketDeHubspot {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation("TicketsDeHubspot", fields: [clientId], references: [id], onDelete: Cascade)
  hubspotId           String
  asunto              String
  /// El nombre del pipeline y de la etapa (o el id, si HubSpot no devolvió las etapas)
  pipeline            String?
  etapa               String?
  abierto             Boolean
  prioridad           String?
  duenoEmail          String?
  creadoEnHubspot     DateTime?
  cerradoEnHubspot    DateTime?
  modificadoEnHubspot DateTime?
  /// false = la empresa ya no lo tiene asociado, o se borró en HubSpot. La fila no se borra.
  vigente             Boolean   @default(true)
  copiadoAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@unique([clientId, hubspotId])
  @@index([clientId, abierto])
}

// ─── Las comunicaciones de HubSpot (iniciativa B de docs/roadmap.md, 2026-10-18) ───

/// La copia de SOLO LECTURA de un correo (enviado o recibido), una nota o una llamada del timeline de HubSpot de una
/// empresa de Nexus o de sus contactos (job `comunicaciones-hubspot`). Es de UN cliente: una que es de dos no se guarda
/// (lib/comunicaciones/reglas.ts › `clienteDeLaComunicacion`). La lee la memoria interna y el chat; nunca el cliente.
model ComunicacionDeHubspot {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation("ComunicacionesDeHubspot", fields: [clientId], references: [id], onDelete: Cascade)
  /// correo | nota | llamada | reunion (U7, 2026-10-25: el resumen de Notetaker de una reunión de HubSpot)
  tipo                String
  hubspotId           String
  /// Solo un correo: enviado | recibido. null en una nota o una llamada.
  direccion           String?
  /// Cuándo pasó (hs_timestamp)
  ocurrioAt           DateTime
  /// El asunto de un correo o el título de una llamada (300 caracteres)
  asunto              String?
  /// El texto en limpio, sin HTML ni la cita del hilo (4.000 caracteres)
  texto               String?   @db.Text
  /// Quién la escribió: el dueño de HubSpot (en un correo enviado, una nota o una llamada)
  autorEmail          String?
  /// Solo un correo recibido: el remitente
  deEmail             String?
  /// Del asunto, el texto, la dirección y la fecha: si cambia, se vuelve a escribir la fila
  huella              String
  modificadoEnHubspot DateTime?
  /// false = HubSpot ya no la devuelve o dejó de ser de este cliente. La fila no se borra.
  vigente             Boolean   @default(true)
  /// Sus compromisos (solo un correo enviado): null = sin decidir · no_aplica · pendiente · leyendo · leido · error
  compromisosEstado   String?
  compromisosIntentos Int       @default(0)
  compromisosLeidoAt  DateTime?
  compromisosError    String?
  /// U7 (2026-10-25): el evento de Google Calendar de una reunión o llamada de HubSpot (sale del `eid` de su enlace) y su
  /// código de Meet: con ellos se sabe si ya llega por Meet (lib/comunicaciones/reuniones.ts). null = no lo traía.
  googleEventId       String?
  codigoDeMeet        String?
  copiadoAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@unique([tipo, hubspotId])
  @@index([clientId, ocurrioAt])
  @@index([compromisosEstado])
}

// ─── Notas de la cuenta (etapa 5 de docs/mi-dia-plan.md) ───

/// Una nota de la cuenta (2026-10-16): lo que pasó por WhatsApp, una llamada, un correo o en persona, que no quedó en
/// una reunión de Meet. También guarda la nota para HubSpot que Nexus sugiere después de una reunión, cuando alguien la
/// usa o la descarta. Nexus primero, HubSpot después: se escribe como nota de la empresa (y del negocio o el proyecto) y
/// el job `contactos-y-tickets` reintenta lo que quedó sin escribir. La escribe SOLO lib/notas/escritura-server.ts.
/// Una sugerencia por reunión: lo asegura un índice único parcial del SQL (Prisma no los modela).
/// SQL: scripts/sql/2026-10-16-notas-de-la-cuenta.sql (RLS + deny).
model NotaDeLaCuenta {
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation("NotasDeLaCuenta", fields: [clientId], references: [id], onDelete: Cascade)
  // nullable porque una nota puede ser de la cuenta entera, sin proyecto.
  projectId        String?
  project          Project?          @relation("NotasDelProyecto", fields: [projectId], references: [id], onDelete: SetNull)
  /// El negocio de HubSpot (id del trato), si la nota es de un negocio. Id externo: no hay FK.
  hubspotDealId    String?
  /// whatsapp | llamada | correo | en_persona | reunion | otro
  canal            String
  /// Cuándo pasó, como día de calendario.
  fecha            DateTime          @db.Date
  texto            String            @db.Text
  autorEmail       String
  /// persona | reunion (la sugerida después de una reunión) | chat
  origen           String            @default("persona")
  // nullable porque solo la nota sugerida después de una reunión sale de una. SetNull: borrar la reunión no borra la nota.
  sessionId        String?
  session          FirefliesSession? @relation("NotasDeLaReunion", fields: [sessionId], references: [id], onDelete: SetNull)
  /// vigente | descartada (una sugerencia que no se usó) | archivada (se sacó de Nexus; en HubSpot queda)
  estado           String            @default("vigente")
  archivadaPor     String?
  archivadaAt      DateTime?
  /// pendiente | escrita | error | sin_hubspot (la empresa no está en HubSpot) | no_va (una sugerencia descartada)
  hubspotEstado    String            @default("pendiente")
  hubspotNotaId    String?
  hubspotError     String?
  hubspotIntentos  Int               @default(0)
  hubspotEscritaAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId, estado, fecha])
  @@index([sessionId])
  @@index([hubspotEstado])
}

// ─── La búsqueda en las reuniones (etapa 4c de docs/mi-dia-plan.md) ───

/// Un turno de la transcripción de una reunión (quién habló y qué dijo), para buscar en español sin tildes. La base
/// tiene además la columna generada "tsv" (no está acá, como `KnowledgeEmbedding.embedding`). La escribe SOLO
/// lib/busqueda/indexar-server.ts; se busca por lib/busqueda/buscar-server.ts.
model TurnoDeReunion {
  id        String           @id @default(cuid())
  sessionId String
  session   FirefliesSession @relation("TurnosDeLaReunion", fields: [sessionId], references: [id], onDelete: Cascade)
  orden     Int
  hablante  String
  texto     String           @db.Text

  @@unique([sessionId, orden])
}

/// Qué reuniones ya se partieron en turnos, con la huella de su transcripción: si cambia, se vuelve a partir.
model ReunionIndexada {
  sessionId  String           @id
  session    FirefliesSession @relation("ReunionIndexada", fields: [sessionId], references: [id], onDelete: Cascade)
  huella     String
  turnos     Int
  indexadoAt DateTime         @default(now())
}

// ─── La escala de la empresa en el tiempo (ficha B, 2026-10-17) ───────────────
// SQL: scripts/sql/2026-10-17-ficha-b-versiones-de-la-escala.sql (⛔ nunca `db push`). RLS encendida en su SQL.
/// Una FOTO de dónde está la empresa en la escala, con su fecha: lo CONFIRMADO de una exploración
/// (la preventa o la de un proyecto), dimensión por dimensión, con de dónde sale cada nivel. La escribe
/// SOLO lib/exploraciones/versiones-de-la-escala.ts: al confirmar un nivel (una por exploración y por
/// día, la del día se actualiza), al presentar el diagnóstico de un ciclo y con «Guardar esta versión».
/// Una foto igual a la anterior no se guarda. Interno: el cliente no la ve.
model VersionDeLaEscala {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// nullable porque una foto sobrevive a que se borre la exploración de la que salió.
  exploracionId   String?
  exploracion     ExploracionDeVenta? @relation(fields: [exploracionId], references: [id], onDelete: SetNull)
  /// nullable porque la preventa no tiene proyecto.
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// nullable porque solo la foto que deja el diagnóstico de un ciclo lo lleva.
  cicloId         String?
  ciclo           CicloDeProyecto?    @relation(fields: [cicloId], references: [id], onDelete: SetNull)
  /// nullable porque no toda empresa tiene una venta ganada en Nexus (2026-10-18, «Actualizar escala»): de qué venta sale.
  ventaGanadaId   String?
  ventaGanada     VentaGanada?        @relation(fields: [ventaGanadaId], references: [id], onDelete: SetNull)
  /// nullable porque no toda venta tiene una propuesta comercial en Nexus: de qué propuesta sale.
  businessCaseId  String?
  businessCase    BusinessCase?       @relation(fields: [businessCaseId], references: [id], onDelete: SetNull)
  /// El trato de HubSpot, aunque no esté en VentaGanada (ID externo, sin FK).
  hubspotDealId   String?
  /// al-vender | al-arrancar | hoy (lib/exploraciones/posicionar.ts › MOMENTOS_DE_LA_VERSION). null = las de antes.
  momento         String?
  /// El día de la POSICIÓN (AAAA-MM-DD), que puede ser del pasado («al vender»). `dia` es el día en que se guardó.
  diaDeLaPosicion String?
  /// cambio | diagnostico | manual (lib/exploraciones/foto-de-la-escala.ts › ORIGENES_DE_LA_VERSION).
  origen          String
  /// El día de la foto en Costa Rica (AAAA-MM-DD): una por exploración y por día con origen `cambio`.
  dia             String
  /// La versión de la escala publicada con que se midió.
  escalaVersion   String?
  edicion         String?
  /// La foto (FotoDeLaEscala, lib/exploraciones/foto-de-la-escala.ts).
  foto            Json
  /// Para no guardar dos veces la misma foto.
  huella          String
  creadoPorEmail  String?
  nota            String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([clientId, createdAt])
  @@index([exploracionId, createdAt])
  @@index([ventaGanadaId])
}

// ─── Un solo libro financiero · ficha F (2026-10-17) ───────────────────────────
// SQL: scripts/sql/2026-10-17-ficha-f-libro-financiero.sql (ANTES del deploy).

/// Un contrato que revende licencias (HubSpot, Infobip…): qué parte de lo facturado es servicio de Smarteam y cuánto se
/// le paga al proveedor por la licencia. Uno por cuenta y moneda (kölbi: el anexo en dólares y el anexo en colones).
/// Lo carga Finanzas; el punto de equilibrio lo lee (lib/finanzas/licencias.ts). Reemplaza la lista fija de
/// lib/finanzas/parte-de-servicio.ts.
model LicenciaRevendida {
  id             String           @id @default(cuid())
  cuentaId       String
  cuenta         CuentaFinanciera @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  /// La moneda en que se le factura este contrato: la parte de servicio se aplica a los cobros de esa moneda.
  moneda         String
  /// El contrato sin IVA y, de eso, cuánto es servicio de Smarteam. La parte de servicio = montoServicio / montoContrato.
  montoContrato  Decimal          @db.Decimal(14, 2)
  montoServicio  Decimal          @db.Decimal(14, 2)
  proveedor      String           @default("HubSpot")
  /// Lo que se le paga al proveedor, cada `costoCadaMeses` meses (3 = trimestral). null = todavía no se sabe.
  costoMonto     Decimal?         @db.Decimal(14, 2)
  costoMoneda    String?
  costoCadaMeses Int?
  /// Desde y hasta cuándo rige (inclusive). null = sin límite de ese lado.
  desde          DateTime?        @db.Date
  hasta          DateTime?        @db.Date
  /// De dónde salen los números («Anexo 1.0, p. 17»).
  fuente         String           @db.Text
  notas          String?          @db.Text
  /// Archivar en vez de borrar: el equilibrio de meses pasados ya se leyó con ella.
  archivadaEn    DateTime?
  archivadaPor   String?
  creadoPor      String
  actualizadoPor String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([cuentaId])
}

/// Un gasto financiero revisado movimiento por movimiento (2026-10-17): la comisión de Stripe, la de una transferencia
/// internacional o la del banco. Nace de un movimiento de la copia de Mercury que una persona revisa: «Es gasto
/// financiero» (con su monto) o «No es». Solo los GASTO suman al punto de equilibrio, como rubro propio.
/// ⛔ No toca Mercury: la copia sigue igual; esto es la decisión de una persona sobre un movimiento.
model GastoFinanciero {
  id                  String   @id @default(cuid())
  /// El movimiento de la copia (MovimientoMercury.id): la entrada que llegó con la comisión descontada, o el cargo de
  /// la comisión. Sin FK: la copia nunca borra movimientos, y uno que desaparece de Mercury queda «DESAPARECIDO».
  movimientoMercuryId String   @unique
  /// STRIPE · TRANSFERENCIA_INTERNACIONAL · BANCO (CHECK en el SQL).
  tipo                String
  /// GASTO · NO_ES (CHECK en el SQL).
  decision            String
  /// El día del movimiento: decide el mes del gasto.
  fecha               DateTime @db.Date
  /// Lo que se confirmó (≥ 0). En NO_ES, 0.
  monto               Decimal  @db.Decimal(12, 2)
  moneda              String
  /// Lo que propuso Nexus, para saber si la persona lo cambió. null = Nexus no tenía cómo calcularlo.
  montoPropuesto      Decimal? @db.Decimal(12, 2)
  descripcion         String   @db.Text
  decididoPor         String
  decididoEn          DateTime
  nota                String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([fecha])
}

/// Un MÓDULO de la biblioteca de propuestas: una sección personalizada (`custom:*`) que alguien de
/// Ventas guardó para usarla en otra propuesta. «Agregar módulo» inserta una COPIA (la sección de la
/// otra propuesta no se entera de cambios posteriores, y al revés). Lo escriben solo las rutas de
/// app/api/business-cases/modulos. Interno: el cliente no lo ve. Ver DECISIONS «La biblioteca de
/// módulos de las propuestas».
model ModuloDePropuesta {
  id                   String        @id @default(cuid())
  nombre               String
  descripcion          String?       @db.Text
  /// El tipo del catálogo de secciones creables (lib/landing/catalogo-de-secciones.ts): `html`, `tabla`…
  tipo                 String
  /// La data de la sección, copiada tal cual al guardar (sin las claves `__*`).
  data                 Json
  /// nullable porque el módulo sobrevive a que se borre la propuesta de la que salió.
  origenBusinessCaseId String?
  origenBusinessCase   BusinessCase? @relation(fields: [origenBusinessCaseId], references: [id], onDelete: SetNull)
  /// La empresa para la que se armó, congelada: es lo que «Adaptar a esta empresa» reemplaza.
  origenClienteNombre  String?
  /// Lo que se encontró de esa empresa al guardarlo (`Hallazgo[]`, lib/landing/modulos-biblioteca.ts).
  /// Se muestra cada vez que alguien lo inserta: un módulo no lleva datos de otro cliente sin avisar.
  avisos               Json
  /// Cuántas veces se insertó en otra propuesta.
  usos                 Int           @default(0)
  creadoPorEmail       String
  /// Archivado = deja de ofrecerse. No se borra: las copias ya insertadas no dependen de él.
  archivadoAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([archivadoAt, updatedAt])
  @@index([origenBusinessCaseId])
}

// ─── HubSpot como contexto y como aviso (área U: U9, U10 y B3 etapa 1, 2026-10-25) ───
// SQL: scripts/sql/2026-10-25-hubspot-contexto.sql. Plan: docs/integracion-hubspot-plan.md.

/// Un aviso de HubSpot (webhook, U10): llega por app/api/hubspot/webhooks, se guarda tal cual y lo procesa el job
/// `hubspot-eventos` (lib/hubspot/eventos-server.ts), que dispara la copia de ese registro. El aviso NUNCA decide de qué
/// cliente es nada: solo dice «volvé a copiar esto».
model EventoDeHubspot {
  id              String    @id @default(cuid())
  /// subscriptionId:eventId (o el de la fusión): HubSpot reintenta y el mismo aviso llega más de una vez
  clave           String    @unique
  /// empresa | contacto | negocio | ticket
  objeto          String
  /// creacion | cambio | asociacion | borrado | fusion | restauracion
  tipo            String
  hubspotId       String
  propiedad       String?
  valor           String?
  /// En una fusión: los ids que se absorbieron
  idsFusionados   String[]  @default([])
  idSobreviviente String?
  ocurrioAt       DateTime
  recibidoAt      DateTime  @default(now())
  /// pendiente | procesado | ignorado | error
  estado          String    @default("pendiente")
  intentos        Int       @default(0)
  procesadoAt     DateTime?
  error           String?

  @@index([estado, recibidoAt])
}

/// Una fusión de HubSpot (U9): el id que se absorbió y el que sobrevive. La escriben la búsqueda diaria
/// (lib/hubspot/fusiones-server.ts, job `hubspot-fusiones`) y el aviso de fusión. Reapuntar lo que Nexus guarda con el id
/// viejo es aparte, con simulacro (scripts/reapuntar-fusiones-de-hubspot.ts).
model FusionDeHubspot {
  id              String   @id @default(cuid())
  /// empresa | contacto | negocio | proyecto | ticket
  objeto          String
  idAbsorbido     String
  idSobreviviente String
  /// La última vez que se vio (la búsqueda o un aviso)
  vistaAt         DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([objeto, idAbsorbido])
  @@index([objeto, idSobreviviente])
}

/// Un lead de HubSpot de una empresa de Nexus (B3 etapa 1): el prospecto en calificación. Copia de solo lectura, cada
/// hora, con el job de contactos (lib/leads/copia-server.ts, el único escritor). Nunca se borra: el que deja de estar
/// asociado queda `vigente = false`.
model LeadDeHubspot {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation("LeadsDeHubspot", fields: [clientId], references: [id], onDelete: Cascade)
  hubspotId           String    @unique
  nombre              String
  pipeline            String?
  etapaId             String?
  /// El nombre de la etapa (de los pipelines de leads de HubSpot)
  etapa               String?
  /// new | in_progress | qualified | unqualified… (hs_pipeline_stage_category)
  etapaCategoria      String?
  /// NEW_BUSINESS | RELATIONSHIP… (hs_lead_type)
  tipoDeLead          String?
  /// hs_lead_source (OFFLINE, ORGANIC_SEARCH…)
  origen              String?
  duenoEmail          String?
  /// El contacto principal del lead en HubSpot
  contactoHubspotId   String?
  creadoEnHubspot     DateTime?
  modificadoEnHubspot DateTime?
  huella              String
  vigente             Boolean   @default(true)
  copiadoAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([clientId, vigente])
}

// ─── Los tests del Diagnóstico de Rendimiento (área O, 2026-10-26) ────────────
// El test público de cada departamento dentro de Nexus (docs/tests-diagnostico-plan.md). Los escribe y los lee SOLO
// lib/tests-diagnostico/repositorio-server.ts. SQL: scripts/sql/2026-10-26-tests-diagnostico.sql.

/// El banco de preguntas de una (área, versión, edición): el borrador que se edita y la versión aprobada que ve el público.
model PreguntasDelTest {
  id            String    @id @default(cuid())
  /// `1` Ventas · `2` Marketing · `3` Servicio (las áreas de la escala).
  area          String
  /// `marketing` (4 preguntas) · `web` (8). La completa vive en la exploración y el cuestionario de la escala.
  version       String
  /// La edición de la escala por industria; `general` para la escala general (no es nula: es parte de la llave).
  edicion       String    @default("general")
  escalaVersion String
  /// El borrador (lib/tests-diagnostico/tipos.ts › PreguntaDelBanco[]).
  preguntas     Json      @default("[]")
  /// La versión aprobada, la que ve el público. null = todavía sin aprobar.
  aprobadas     Json?
  editadoPor    String?
  aprobadoPor   String?
  aprobadoAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([area, version, edicion])
}

/// Un intento del test: quién, su empresa, lo que vio y eligió, el resultado que calculó Nexus y qué llegó a HubSpot.
model IntentoDelTest {
  id              String    @id @default(cuid())
  /// La dirección pública del intento y de su resultado (256 bits).
  token           String    @unique
  area            String
  version         String
  edicion         String?
  escalaVersion   String
  /// Las preguntas que vio, con su nivel (solo del lado nuestro) y sus ids opacos.
  preguntas       Json      @default("[]")
  respuestas      Json      @default("{}")
  /// En qué pregunta va (para medir dónde abandonan).
  paso            Int       @default(0)
  /// `en_curso` · `terminado` · `abandonado`.
  estado          String    @default("en_curso")
  nombre          String
  email           String
  telefono        String?
  puesto          String?
  empresa         String?
  dominio         String?
  industria       String?
  /// nullable porque el prospecto puede no tener empresa en Nexus todavía (se une por su dominio).
  clientId        String?
  client          Client?   @relation("IntentosDelTestDeLaEmpresa", fields: [clientId], references: [id], onDelete: SetNull)
  /// El resultado que calculó Nexus (lib/tests-diagnostico/resultado.ts › ResultadoDelTest).
  resultado       Json?
  /// La dirección del resultado que se deja en HubSpot (con los datos después del `#`).
  url             String?
  /// De dónde llegó (utm, página).
  origen          Json?
  hubspotFormAt   DateTime?
  hubspotNotaAt   DateTime?
  hubspotIntentos Int       @default(0)
  hubspotError    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  terminadoAt     DateTime?

  @@index([clientId])
  @@index([dominio])
  @@index([estado, createdAt])
}
